10.801 7.1992 22.801 10.801 34.801 10.801 19.199 0 38.398-8.3984 50.398-26.398 19.199-27.602 13.199-66-14.398-85.199z\"/>\n <path d=\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1781146161,"internal":false}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"groupId":"{#}kdAYles"},"{#}MaExOYr":{"id":"{#}MaExOYr","canvas":{"position":{"x":760,"y":582}},"children":[{"childId":"{#}f0w5tDy","sourcePort":"{#}MaExOYr_output_sessionHistoryOutput","targetPort":"{#}f0w5tDy_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}kdAYles"},"{#}3LuT4Ga":{"id":"{#}3LuT4Ga","canvas":{"position":{"x":512,"y":198}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}kdAYles"},"{#}7WgfJXr":{"id":"{#}7WgfJXr","canvas":{"position":{"x":1228,"y":1285}},"children":[{"childId":"{#}7kX3SzC","sourcePort":"{#}7WgfJXr_innerOutput_inner-input-input1","targetPort":"{#}7kX3SzC_input_message"}],"state":{"description":"Throws the given message as an error.","inputs":[{"index":0,"label":"message","name":"input1","type":[1,5],"position":{"x":256,"y":410}}],"outputs":[],"name":"Throw Error","type":"custom","color":"#626060","icon":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 1200\" version=\"1.1\" height=\"1200pt\" width=\"1200pt\">\n <path fill=\"#ff001b\" d=\"m373.22 900c13.922 20.953 30.656 39.891 49.641 56.25h-89.625c-3.5625 0-6.75 1.9688-8.3906 5.1094l-37.266 73.266c-7.0781 13.875-24 19.359-37.828 12.328-13.875-7.0781-19.359-24-12.328-37.828l37.312-73.266c11.203-21.984 33.797-35.859 58.5-35.859zm493.55 0c24.703 0 47.297 13.875 58.5 35.859l37.312 73.266c7.0312 13.828 1.5469 30.75-12.328 37.828-13.828 7.0312-30.75 1.5469-37.828-12.328l-37.266-73.266c-1.6406-3.1406-4.8281-5.1094-8.3906-5.1094h-89.625c18.984-16.359 35.719-35.297 49.641-56.25zm-88.641-403.13c30.609 0.75 56.25 25.031 56.25 56.25v196.87c0 129.42-104.95 234.37-234.37 234.37-129.42 0-234.37-104.95-234.37-234.37v-196.87c0-31.078 25.172-56.25 56.25-56.25zm-155.34 90.188c-9.5156-18.281-36.047-18.281-45.562 0-19.312 40.406-45.891 73.875-84.422 97.594l-21.844 13.078c-18.188 10.922-18.188 37.312 0 48.234l21.844 13.125c37.266 22.312 66.094 56.016 83.484 95.672 9.0469 21.094 38.062 19.734 47.438 0 17.484-39.656 46.172-73.312 83.484-95.672l23.484-14.156c15.984-11.109 15.984-35.016 0-46.125l-23.484-14.156c-38.766-23.25-65.297-57.234-84.422-97.594zm-294.66 162.94c0 3.1406 0.046875 6.2812 0.1875 9.375h-70.078c-3.5625 0-6.75 1.9688-8.3906 5.1094l-37.266 73.266c-7.0781 13.875-24 19.359-37.828 12.328-13.875-7.0781-19.359-24-12.328-37.828l37.312-73.266c11.203-21.984 33.797-35.859 58.5-35.859h69.891zm613.64-46.875c24.703 0 47.297 13.875 58.5 35.859l37.312 73.266c7.0312 13.828 1.5469 30.75-12.328 37.828-13.828 7.0312-30.75 1.5469-37.828-12.328l-37.266-73.266c-1.6406-3.1406-4.8281-5.1094-8.3906-5.1094h-70.078c0.09375-3.0938 0.1875-6.2344 0.1875-9.375v-46.875zm-341.76-77.344c22.734 41.156 56.391 72.141 96.328 96.094-39.938 23.953-73.594 54.984-96.328 96.094-22.734-41.109-56.391-72.141-96.328-96.094 39.75-23.859 73.641-55.031 96.328-96.094zm387.42-169.78c7.0781-13.875 24-19.359 37.828-12.328 13.875 7.0781 19.359 24 12.328 37.828l-37.312 73.266c-11.203 21.984-33.797 35.859-58.5 35.859h-69.891v-37.5c0-6.4219-0.65625-12.703-1.875-18.75h71.766c3.5625 0 6.75-1.9688 8.3906-5.1094zm-812.68-12.328c13.828-7.0312 30.75-1.5469 37.828 12.328l37.266 73.266c1.6406 3.1406 4.8281 5.1094 8.3906 5.1094h71.766c-1.2188 6.0469-1.875 12.328-1.875 18.75v37.5h-69.891c-24.703 0-47.297-13.875-58.5-35.859l-37.312-73.266c-7.0312-13.828-1.5469-30.75 12.328-37.828zm466.5-106.17c60.047 0 108.75 48.703 108.75 108.75 0 7.4062-6 12.797-13.125 13.125h-273.74c-7.2656 0-13.125-5.8594-13.125-13.125 0-60.047 48.703-108.75 108.75-108.75zm155.63-168.74c15.516 0 28.125 12.609 28.125 28.125 0 15.516-12.609 28.125-28.125 28.125-50.859 0-93.141 36.844-101.58 85.312-17.625-7.0312-36.375-10.312-55.312-10.312 13.266-74.625 78.469-131.26 156.89-131.26zm-384.37 0c78.422 0 143.63 56.625 156.89 131.26-19.078 0-37.641 1.2188-55.922 7.1719-9.7031-46.922-51.188-82.172-100.97-82.172-15.516 0-28.125-12.609-28.125-28.125s12.609-28.125 28.125-28.125z\"></path>\n</svg>\n","canvasPosition":{"x":-5.0787058061455355,"y":-129.42748409632082},"markdownHelp":"## Description\nProvides an input port that receives String types and throws an error that can be captured via a ‎`Rescue` widget (otherwise it is displayed as a general error notification).","settings":[],"protocolVersion":"2","canvasZoom":0.9931376139236254},"type":"widgetGroup","groupId":"{#}9QppsGH"},"{#}eJtorKJ":{"id":"{#}eJtorKJ","canvas":{"position":{"x":799,"y":1263}},"children":[{"childId":"{#}7WgfJXr","sourcePort":"{#}eJtorKJ_output_string","targetPort":"{#}7WgfJXr_input_outer-input-input1"}],"state":{"text":"Please select a valid agent","dispatchOnSet":false,"size":{"width":257,"height":44}},"type":"text","groupId":"{#}9QppsGH"},"{#}7kX3SzC":{"id":"{#}7kX3SzC","canvas":{"position":{"x":435,"y":304}},"children":[],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Throw Error","description":"Throws the given message as an error."},"pages":{"main":{"code":"/**\n * Name: Throw Error\n * Description: Throws the given message as an error.\n */\n\nconst getWidgetInputs = () => [{\n  name: 'message',\n  type: [DataType.String, DataType.JsonObj]\n}];\n\nconst getWidgetOutputs = () => [\n  // No outputs are produced by this script.\n];\n\nconst onParentEvent = async ({\n  targetPort,\n  event\n}) => {\n  if (targetPort.name === 'message') {\n    console.log('the value: ', event.data.value)\n    const message = event.data.value?.error?.message || event.data.value?.message || event.data.value;\n    // Throw an error using the input string as the error message.\n    throw new Error(message);\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}7WgfJXr"},"{#}NxmkTuR":{"id":"{#}NxmkTuR","canvas":{"position":{"x":-6217,"y":-5963}},"children":[{"childId":"{#}mWREOYN","targetPort":"{#}mWREOYN_input_config","sourcePort":"{#}NxmkTuR_innerOutput_inner-input-config-NPd1HB"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":1179,"y":1044}}],"outputs":[],"name":"Style Negotiator","type":"custom","color":"#ab47bd","icon":"robot","canvasPosition":{"x":1342.4408389585274,"y":796.3773658095711},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":1},"type":"widgetGroup"},"{#}lNG1MiZ":{"id":"{#}lNG1MiZ","canvas":{"position":{"x":-6230,"y":-5856}},"children":[{"childId":"{#}AqLEh39","targetPort":"{#}AqLEh39_input_config","sourcePort":"{#}lNG1MiZ_innerOutput_inner-input-config-NPd1HB"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":1179,"y":1044}}],"outputs":[],"name":"Profile Builder","type":"custom","color":"#ab47bd","icon":"robot","canvasPosition":{"x":1263.4037085483492,"y":505.62236685364917},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":0.648944713554577},"type":"widgetGroup"},"{#}HsZ0oZN":{"id":"{#}HsZ0oZN","canvas":{"position":{"x":-6164,"y":-5776}},"children":[{"childId":"{#}jKgGwEq","targetPort":"{#}jKgGwEq_input_config","sourcePort":"{#}HsZ0oZN_innerOutput_inner-input-config-NPd1HB"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":1179,"y":1044}}],"outputs":[],"name":"Skills Curator","type":"custom","color":"#ab47bd","icon":"robot","canvasPosition":{"x":1130.6231163254756,"y":977.4595653314145},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":1},"type":"widgetGroup"},"{#}FAl6iuW":{"id":"{#}FAl6iuW","canvas":{"position":{"x":-5773,"y":-5932}},"children":[{"childId":"{#}tbze5Ak","targetPort":"{#}tbze5Ak_input_config","sourcePort":"{#}FAl6iuW_innerOutput_inner-input-config-NPd1HB"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":1179,"y":1044}}],"outputs":[],"name":"Credentials Formatter","type":"custom","color":"#ab47bd","icon":"robot","canvasPosition":{"x":1368.3137932237598,"y":868.1007904892072},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":1},"type":"widgetGroup","disabled":false},"{#}Z7nx0mo":{"id":"{#}Z7nx0mo","canvas":{"position":{"x":-5776,"y":-5858}},"children":[{"childId":"{#}6GdbHAb","targetPort":"{#}6GdbHAb_input_config","sourcePort":"{#}Z7nx0mo_innerOutput_inner-input-config-NPd1HB"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":1179,"y":1044}}],"outputs":[],"name":"Cover Letter Writer","type":"custom","color":"#ab47bd","icon":"robot","canvasPosition":{"x":1636.4199614885802,"y":904.8635775084686},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":0.7573892005725748},"type":"widgetGroup"},"{#}Fwnhjku":{"id":"{#}Fwnhjku","canvas":{"position":{"x":-5766,"y":-5773}},"children":[{"childId":"{#}DlaeLJZ","targetPort":"{#}DlaeLJZ_input_config","sourcePort":"{#}Fwnhjku_innerOutput_inner-input-config-NPd1HB"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":1179,"y":1044}}],"outputs":[],"name":"Style Reviewer","type":"custom","color":"#ab47bd","icon":"robot","canvasPosition":{"x":1250.4387966324005,"y":1067.6292335984508},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":1},"type":"widgetGroup"},"{#}Jf5V5eX":{"id":"{#}Jf5V5eX","canvas":{"position":{"x":-5768,"y":-5688}},"children":[{"childId":"{#}QAq3x24","targetPort":"{#}QAq3x24_input_config","sourcePort":"{#}Jf5V5eX_innerOutput_inner-input-config-NPd1HB"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":1179,"y":1044}}],"outputs":[],"name":"Integrity Checker","type":"custom","color":"#ab47bd","icon":"robot","canvasPosition":{"x":1582.1664807407783,"y":449.95523527039074},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":0.6011803907592405},"type":"widgetGroup"},"{#}mWREOYN":{"id":"{#}mWREOYN","canvas":{"position":{"x":1604,"y":982}},"children":[{"childId":"{#}774JPgu","sourcePort":"{#}mWREOYN_output_tools","targetPort":"{#}774JPgu_input_outer-input-input1"},{"childId":"{#}jpc2cfs","sourcePort":"{#}mWREOYN_output_history","targetPort":"{#}jpc2cfs_input_outer-input-input1"},{"childId":"{#}kPbGrkL","sourcePort":"{#}mWREOYN_output_reasoning","targetPort":"{#}kPbGrkL_input_setValue"},{"childId":"{#}SE4ImR6","sourcePort":"{#}mWREOYN_output_debug","targetPort":"{#}SE4ImR6_input_setValue"},{"childId":"{#}ufKS1iJ","sourcePort":"{#}mWREOYN_output_text","targetPort":"{#}ufKS1iJ_input_setValue"},{"childId":"{#}1qMxDDs","sourcePort":"{#}mWREOYN_output_text","targetPort":"{#}1qMxDDs_input_event"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"selectedModel":{"id":"openai/gpt-5.3-codex","slug":"openai/gpt-5.3-codex-20260224","name":"OpenAI: GPT-5.3-Codex","description":"GPT-5.3-Codex is OpenAI’s most advanced agentic coding model, combining the frontier software engineering performance of GPT-5.2-Codex with the broader reasoning and professional knowledge capabilities of GPT-5.2. It achieves state-of-the-art results...","inputModalities":["text","image","file"],"outputModalities":["text"],"supportsTools":true,"supportsReasoning":true,"promptPrice":0.00000175,"completionPrice":0.000014,"maxTokens":128000,"contextLength":400000,"provider":"openai"},"systemInstructions":"# Style Negotiator v3.0 — System Instructions\n\n**Version:** 3.0\n**Last Updated:** 2026-06-11\n**Role:** CV Style Analyst (single-fire stylist)\n**Pipeline Position:** Assembly Phase 1\n**Trigger:** Server sends `__style_analyze__` after REVIEW_COMPLETE\n**Output:** Writes `sn_groups.json` — the server drives the user interview, merge, and final output\n\n---\n\n## Role\n\nYou are a CV **stylist**. You fire **exactly once** per session. You read what the Tone Analyst found about this candidate's writing, decide which style dimensions are genuinely worth raising with the user, and for each one write a tailored, plain-language recommendation. You write a single file (`sn_groups.json`) and end your turn.\n\nYou do **NOT** run a multi-turn interview, you do **NOT** collect the user's choices, and you do **NOT** merge anything. The server presents your dimensions to the user as a card deck, collects their choices, and builds the final output. Your only job is genuine style judgment.\n\nYou do NOT write CV content. You only propose style preferences that downstream assembly agents will apply.\n\n---\n\n## Authority\n\n### READ Access\n- `style_findings.json` (Tone Analyst forensic output — `flagged_issues`, `style_patterns`, `seniority`)\n- `tone_validator_verdict.json` (Tone Validator notes — `findings_for_sn`; optional, may be absent)\n- `project_meta.json` (role/company context)\n- `gap_analysis.json` (candidate strengths context; optional)\n\n### WRITE Access\n- `sn_groups.json` (your proposed style dimensions — the ONLY file you write)\n\n### NEVER Modify\n- `cv_assembly_state.json`, `candidate_profile.json`, `style_findings.json`, `sn_output.json`, `sn_working.json`\n\n---\n\n## Tools\n\n| Tool | Usage |\n| --- | --- |\n| **ReadFile** | Read JSON files by bare filename |\n| **WriteFile** | Write JSON strings by bare filename |\n\n**⚠️ CRITICAL:** WriteFile accepts STRINGS only: `JSON.stringify(data, null, 2)`. Bare filenames only — no path prefix.\n\n```javascript\n// ✅ CORRECT — positional params\nWriteFile(\"sn_groups.json\", JSON.stringify(groups, null, 2))\n\n// ❌ WRONG — named params create a directory on KEMU, not a file\nWriteFile({ fileName: \"sn_groups.json\", content: JSON.stringify(groups) })\n```\n\n---\n\n## Execution (single turn)\n\nThe input message is always `__style_analyze__`. There is no input routing, no phases, no re-invocation. Do all of the following in one turn, then end.\n\n### Step 1 — Read your inputs\n\nRead these files (use ReadFile; treat any missing/optional file as absent and carry on):\n\n- **`style_findings.json`** — the Tone Analyst's forensic read. The fields you care about:\n  - `style_patterns` — `voice`, `tense`, `bullet_format`, `uses_pronouns_i`, `uses_full_sentences`, `avg_bullet_word_count`, `formality_level`.\n  - `flagged_issues` — array of concrete issues, each with a `category` (tense / punctuation / formatting / passive_voice / verbose / grammar) and the candidate's `original` text.\n  - `seniority` — `level`, `relevant_years_experience`, `years_experience`, `evidence`.\n  - `source_files.cover_letter` — present only if a cover letter was analyzed.\n- **`tone_validator_verdict.json`** (optional) — `findings_for_sn`, an array of validator cautions, each tagged with an `axis` (e.g. `\"seniority\"`).\n- **`project_meta.json`** — `position_title` (the role you're tailoring for).\n- **`gap_analysis.json`** (optional) — candidate strengths for context.\n\n### Step 2 — Decide which dimensions to raise\n\nLook at what the Tone Analyst actually found for **this** candidate and select the dimensions worth a conversation. Don't pad — only raise a dimension if there's a real signal. Typical dimensions (raise the ones that apply):\n\n- **Seniority & Career Level** — MANDATORY, always include (see Step 3).\n- **Formatting & Bullet Style** — if `flagged_issues` has tense/punctuation/formatting items, or first-person \"I\" pronouns are present, or the CV uses full sentences instead of telegraphic bullets.\n- **Linguistic Strength** — if there are passive_voice/verbose/grammar flags, or the overall voice reads passive or mixed.\n- **Structural & Visual Density** — if bullets run long (average over ~18 words) or there are multiple verbose flags.\n- **Cover Letter Style** — only if a cover letter was analyzed.\n- **Key Achievements Section** — MANDATORY for senior roles (see Step 3).\n- You **may** add a discretionary dimension beyond these if the candidate's writing clearly warrants it.\n\nFor each dimension you raise, write — in plain language, grounded in this candidate's own CV — the four authored fields:\n- `finding` — what the analysis found, with the candidate's own examples where possible (not generic).\n- `recommendation` — what to do about it.\n- `insight` — the *why* in one short sentence (recruiter behavior, ATS, role fit). This is the value the user pays you for.\n- `recommended_overrides` — an **object** of `{ key: \"directive sentence\" }` the downstream assembly agents will read and apply.\n\n### Step 3 — Mandatory dimensions\n\n- **`id: \"seniority\"` — ALWAYS include**, first. The server overwrites your `recommended_overrides.seniority_level` with the authoritative number from `style_findings.seniority`, so you do **not** need to get the years exactly right — focus on framing the `finding`/`recommendation`/`insight` well. If a tone-validator note is tagged with the seniority axis, fold its caution into your `finding`/`recommendation`.\n- **`id: \"key_achievements\"` — include when the role is senior** (e.g. title matches grade 4+/band 4+/CNS/specialist/senior/manager/director/lead/principal/head of). The server enforces this too as a safety net, but author it yourself with richer prose when you can.\n\n### Step 4 — Write `sn_groups.json` and end\n\n`sn_groups.json` is a JSON **array** of group objects:\n\n```json\n[\n  {\n    \"id\": \"seniority\",\n    \"title\": \"Seniority & Career Level\",\n    \"finding\": \"Your history reads as Mid-Level — 6 years across two delivery roles.\",\n    \"examples\": [],\n    \"recommendation\": \"Confirm as Mid-Level — this sets tone and how strongly responsibilities are framed.\",\n    \"insight\": \"Seniority framing is the biggest single lever on how a recruiter reads every bullet.\",\n    \"recommended_overrides\": { \"seniority_level\": \"Mid-Level (confirmed by user)\" }\n  },\n  {\n    \"id\": \"structural\",\n    \"title\": \"Structural & Visual Density\",\n    \"finding\": \"Bullets average 24 words — e.g. \\\"Was responsible for coordinating the rollout…\\\"\",\n    \"examples\": [\"\\\"Was responsible for coordinating the rollout across three teams\\\"\"],\n    \"recommendation\": \"Lead with the verb; cut the windup. Target under 18 words.\",\n    \"insight\": \"Recruiters scan in ~6 seconds — density is what gets you read.\",\n    \"recommended_overrides\": {\n      \"cv_density\": \"Keep CV to 2 pages max — cut verbose phrasing\",\n      \"improve_conciseness\": \"Tighten bullets over 18 words for scan-speed readability\"\n    }\n  }\n]\n```\n\n```javascript\nWriteFile(\"sn_groups.json\", JSON.stringify(groups, null, 2))\n```\n\nThen output a brief one-line acknowledgement (e.g. `Style analysis complete.`) and **END TURN**. The server reads `sn_groups.json`, applies the mandatory floor, stamps the seniority number, and opens the style interview modal. You will not be invoked again this session.\n\n---\n\n## Critical Rules\n\n1. **Bare filenames** — `\"sn_groups.json\"` not `\"/sn_groups.json\"`.\n2. **Always stringify** — `JSON.stringify(groups, null, 2)` before WriteFile.\n3. **`sn_groups.json` is an ARRAY** of group objects, not an object.\n4. **`recommended_overrides` is an Object** — `{ key: \"description\" }`, not an array.\n5. **Always include the `seniority` group first.** Include `key_achievements` for senior roles.\n6. **Single fire, single file.** Do NOT write `sn_output.json`, `sn_working.json`, or `cv_assembly_state.json`. Do NOT call `SwitchAgent` or any validator. The server owns merge, validation, and display.\n7. **No multi-turn loop.** The only input you ever receive is `__style_analyze__`.\n8. **Genuine, candidate-specific prose** — use the candidate's real examples; do not emit generic boilerplate.\n\n---\n","query":"","jsonResponse":false,"jsonFormat":"","jsonSchemaMode":"typescript","fileParser":"native","imageAspectRatio":"1:1","maxIterations":10,"reasoningEffort":"medium","allowFallbacks":true,"temperature":1,"webSearch":false},"service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801c14.762-6.3594 14.762-27.238 0-33.719zm-210.84-6.9609c-3 6.7188-9.6016 10.801-16.559 10.801-2.3984 0-4.8008-0.48047-7.1992-1.4414-64.078-28.078-114.72-78.719-142.68-142.8-4.0781-9.1211 0.12109-19.801 9.2383-23.762 9.1211-3.9609 19.68 0.23828 23.762 9.3594 24.238 55.68 68.398 99.84 124.08 124.2 9.1211 3.9609 13.32 14.52 9.3594 23.641z\"/>\n <path d=\"m1113.1 322.08-109.56-47.762c-26.52-11.641-47.641-32.762-59.281-59.281l-47.762-109.56c-3.7188-8.5195-15.84-8.5195-19.559 0l-47.762 109.56c-11.641 26.52-32.762 47.641-59.281 59.281l-109.68 47.879c-8.5195 3.7188-8.5195 15.719-0.12109 19.441l111.72 49.32c26.398 11.762 47.52 33 58.922 59.52l46.32 107.64c3.6016 8.5195 15.719 8.5195 19.441 0l47.762-109.44c11.641-26.52 32.762-47.641 59.281-59.281l109.56-47.762c8.5195-3.7188 8.5195-15.84 0-19.559zm-149.28 15.84c-3.4805 5.6406-9.3594 8.6406-15.48 8.6406-3.1211 0-6.3594-0.83984-9.2383-2.5195-24.84-15.121-45.359-34.922-61.199-59.16-5.3984-8.3984-3-19.441 5.2812-24.961 8.2812-5.3984 19.441-3.1211 24.84 5.2812 12.961 19.68 29.641 35.762 49.68 48 8.5195 5.1602 11.281 16.199 6.1211 24.719z\"/>\n</svg>\n","color":"#42a5f5","mdHelp":"/docs/help/service.md","customWidgets":[{"name":"Memory History","color":"#eac43e","description":"Provides a simple in-memory history manager for debugging purposes.","contents":"KMU-CB-v1{\"{#}mBE0gxc\":{\"id\":\"{#}mBE0gxc\",\"canvas\":{\"position\":{\"x\":2006,\"y\":726}},\"children\":[{\"childId\":\"{#}4M2WbT3\",\"sourcePort\":\"{#}mBE0gxc_innerOutput_inner-input-input1\",\"targetPort\":\"{#}4M2WbT3_input_agent\"}],\"state\":{\"description\":\"Provides a simple in-memory history manager for debugging purposes.\",\"inputs\":[{\"index\":0,\"label\":\"agent\",\"name\":\"input1\",\"type\":[5],\"position\":{\"x\":519,\"y\":291}}],\"outputs\":[],\"name\":\"Memory History\",\"type\":\"custom\",\"color\":\"#eac43e\",\"icon\":\"database\",\"canvasPosition\":{\"x\":0,\"y\":0},\"markdownHelp\":\"\",\"settings\":[],\"protocolVersion\":\"2\"},\"type\":\"widgetGroup\"},\"{#}4M2WbT3\":{\"id\":\"{#}4M2WbT3\",\"canvas\":{\"position\":{\"x\":659,\"y\":341}},\"children\":[{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_getHistory\",\"targetPort\":\"{#}jCnteeA_input_read\"},{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_updateHistory\",\"targetPort\":\"{#}jCnteeA_input_update\"}],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{\"includeAttachments\":false,\"timeout\":60},\"variantId\":\"history\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>