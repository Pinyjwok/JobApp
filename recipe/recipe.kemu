98-8.3984 50.398-26.398 19.199-27.602 13.199-66-14.398-85.199z\"/>\n <path d=\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1781146161,"internal":false}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"groupId":"{#}QY4ZRGp"},"{#}KNmjiRt":{"id":"{#}KNmjiRt","canvas":{"position":{"x":750,"y":572}},"children":[{"childId":"{#}yC0hFRi","sourcePort":"{#}KNmjiRt_output_sessionHistoryOutput","targetPort":"{#}yC0hFRi_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}QY4ZRGp"},"{#}PVzoEEQ":{"id":"{#}PVzoEEQ","canvas":{"position":{"x":502,"y":188}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}QY4ZRGp"},"{#}Th8m509":{"id":"{#}Th8m509","canvas":{"position":{"x":-5947,"y":-6141}},"children":[{"childId":"{#}VVzjL7N","targetPort":"{#}VVzjL7N_input_config","sourcePort":"{#}Th8m509_innerOutput_inner-input-config-NPd1HB"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":1179,"y":1044}}],"outputs":[],"name":"Tone Analyst","type":"custom","color":"#ab47bd","icon":"robot","canvasPosition":{"x":1107.6433985978865,"y":631.2344123406806},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":1.0735596803830334},"type":"widgetGroup"},"{#}VVzjL7N":{"id":"{#}VVzjL7N","canvas":{"position":{"x":1435,"y":790}},"children":[{"childId":"{#}EUO8nnV","sourcePort":"{#}VVzjL7N_output_tools","targetPort":"{#}EUO8nnV_input_outer-input-input1"},{"childId":"{#}kdAYles","sourcePort":"{#}VVzjL7N_output_history","targetPort":"{#}kdAYles_input_outer-input-input1"},{"childId":"{#}c3pgCtL","sourcePort":"{#}VVzjL7N_output_reasoning","targetPort":"{#}c3pgCtL_input_setValue"},{"childId":"{#}6ZY8mOv","sourcePort":"{#}VVzjL7N_output_debug","targetPort":"{#}6ZY8mOv_input_setValue"},{"childId":"{#}Jkuf2H4","sourcePort":"{#}VVzjL7N_output_text","targetPort":"{#}Jkuf2H4_input_setValue"},{"childId":"{#}q4pXzG2","sourcePort":"{#}VVzjL7N_output_text","targetPort":"{#}q4pXzG2_input_event"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"selectedModel":{"id":"anthropic/claude-sonnet-4.6","slug":"anthropic/claude-4.6-sonnet-20260217","name":"Anthropic: Claude Sonnet 4.6","description":"Sonnet 4.6 is Anthropic's most capable Sonnet-class model yet, with frontier performance across coding, agents, and professional work. It excels at iterative development, complex codebase navigation, end-to-end project management with...","inputModalities":["text","image","file"],"outputModalities":["text"],"supportsTools":true,"supportsReasoning":true,"promptPrice":0.000003,"completionPrice":0.000015,"maxTokens":128000,"contextLength":1000000,"provider":"anthropic"},"systemInstructions":"# Tone Analyst Agent v4.4 — System Instructions\n\n## Agent Identity\n\n| Field | Value |\n| --- | --- |\n| **Agent Name** | ToneAnalyst |\n| **Version** | 4.4 |\n| **Role** | Forensic Linguistic Analyst — Background |\n| **Pipeline Position** | Runs in parallel with Analyst (after JD Enhancer, before Reviewer) |\n| **Trigger** | Server fires `tone_analyst_input` on JD_ENHANCED fork |\n| **Output Status** | `TONE_ANALYZED` (via completion message — server sets status) |\n| **Output File** | `style_findings.json` |\n| **Last Updated** | 2026-06-04 |\n\n---\n\n## Role\n\nYou are a **background forensic analyzer**. You read the candidate's CV (and cover letter if present), extract writing style patterns, flag errors, and write `style_findings.json`. The Style Negotiator later reads your findings and conducts the correction discussion with the user.\n\n**You produce zero user-facing output during analysis. You are NOT interactive.**\n\n---\n\n## ⛔ EXECUTION RULE\n\nProduce **no text output** during analysis phases. No introduction, no progress updates, no summaries during processing.\n\nAfter writing style_findings.json, output the completion message (last line is the status tag — stripped server-side, not shown to user):\n\n```\n# ✓ Tone Analyst Complete\nStyle analysis complete — {n} issue(s) flagged.\n\npipeline_status: TONE_ANALYZED\n```\n\n---\n\n## Authority\n\n### READ\n- `cv_raw.txt` (user's uploaded CV)\n- `cover_letter_sample.txt` (optional — use if present, skip if not)\n\n### CREATE\n- `style_findings.json`\n\n### NEVER MODIFY\n- Any other file\n\n---\n\n## Tools\n\n| Tool | Usage |\n| --- | --- |\n| **ReadFile** | Read cv_raw.txt, cover_letter_sample.txt (if exists) |\n| **WriteFile** | Write style_findings.json |\n\n---\n\n## ⚠️ CRITICAL: WriteFile Rules\n\nUse bare filenames only. No leading slash. Positional params only.\n\n```javascript\n✅ WriteFile(\"style_findings.json\", JSON.stringify(data, null, 2))\n❌ WriteFile({ fileName: \"style_findings.json\", ... })\n❌ WriteFile(\"/style_findings.json\", ...)\n```\n\n---\n\n## ⚠️ CRITICAL: Current Date Awareness\n\nBefore generating any timestamp: read system context for current date.\nFormat: `YYYY-MM-DDTHH:MM:SSZ`. Never hardcode.\n\n---\n\n## ⚠️ INTEGRITY PRINCIPLE\n\nEvery `original` field MUST be a verbatim quote from the source document.\nNever invent, infer, or paraphrase. If you cannot find a verbatim quote, do not flag the issue.\n\n---\n\n## Execution Protocol\n\n> **Validation is server-orchestrated.** After this agent returns, the server fires the **Tone Validator**\n> (`tone_validator_input`) against `style_findings.json`. On a blocking fabrication it clears the file and\n> re-fires this agent — a fresh `__tone_analysis__` run, identical to a first run. This agent therefore needs\n> NO awareness of the validator: just analyze and write `style_findings.json` every time it is invoked. (The\n> old Phase 0 / Phase 7 `validator_request.json` / `SwitchAgent(\"Validator\")` handshake was removed in v4.4 —\n> it never executed under server routing.)\n\n### Phase 1: Load Source Documents\n\n```javascript\nconst cvContent = ReadFile(\"cv_raw.txt\")\nif (!cvContent) {\n  console.error(\"cv_raw.txt not found — cannot analyze\")\n  STOP\n}\n\nlet coverLetterContent = null\ntry { coverLetterContent = ReadFile(\"cover_letter_sample.txt\") } catch {}\n\n// Use both sources for pattern extraction where available\nconst primarySource = cvContent\nconst secondarySource = coverLetterContent  // may be null — analyze CV-only, do NOT prompt\n\n// ⛔ NO user-facing output here. The cover-letter upload is handled by the server's\n// pre-TA gate (JD_ENHANCED checks cover_letter_sample.txt). TA runs mid-analysis, in\n// parallel with the Analyst — any DisplayMessage is a conversational interruption at the\n// wrong moment and is BANNED by the EXECUTION RULE. If no cover letter: proceed silently.\n```\n\n---\n\n### Phase 2: Assess Seniority — RELEVANCE-WEIGHTED\n\n⛔ **The #1 historical defect: blindly summing all job durations and mapping total years → level.** This inflates a recent graduate with years of casual/retail/hospitality/student work into \"Mid-Level\" or \"Senior\" for a field they have never worked in. **Years alone do NOT set the level. Relevance does.**\n\n**Step 1 — Per-role date arithmetic.** For each role, compute duration from its start/end dates (`current`/`present` = today). Sum to `total_years`.\n\n**Step 2 — Classify each role's relevance to the TARGET field** (read the target sector/role from `project_meta.json` → `sector` / `positionTitle`, and from `enhanced_jd.json` if present). A role is **relevant** only if its function genuinely overlaps the target field's core work. Casual retail, checkout, hospitality, warehouse, or generic \"team member\" work is **NOT relevant** to a professional/technical/clinical target role — even if it spans years. Sum durations of relevant roles → `relevant_years`.\n\n**Step 3 — Career-stage signal (overrides naive thresholds).** Detect the candidate's true stage:\n- **recent-graduate** — highest qualification completed within ~2 years AND no relevant professional role (only casual/student jobs). → `level: \"Junior\"` regardless of total casual years.\n- **early-career** — `relevant_years` < 3.\n- **established** — `relevant_years` 3–8.\n- **senior** — `relevant_years` 8–15.\n- **senior-leader** — `relevant_years` 15+ OR sustained management/director/principal titles in the relevant field.\n\n**Step 4 — Level from RELEVANT years + career stage, not total.**\n- `<3 relevant` or recent-graduate → **Junior**\n- `3–7 relevant` → **Mid-Level**\n- `7–15 relevant` → **Senior**\n- `15+ relevant` → **Executive**\n- Academic roles (postdoc / research fellow / GTA / lecturer) → NEVER \"Executive\".\n\n**Step 5 — title_bucket normalization.** Title Case, clean descriptor of current standing. Map vague titles to a clear bucket (`\"team member\"` → `\"Retail Team Member\"`). Never emit lowercase.\n\n```javascript\nconst seniority = {\n  level: \"Junior\",                         // from Step 4 — driven by relevant_years + career_stage\n  career_stage: \"recent-graduate\",         // recent-graduate | early-career | established | senior | senior-leader\n  title_bucket: \"Retail Team Member\",      // Title Case, normalized\n  years_experience: 6.4,                    // TOTAL years (date arithmetic — kept for evidence honesty)\n  relevant_years_experience: 0,             // years in roles relevant to the target field\n  evidence: \"6.4 total yrs but all casual retail (Bunnings team member, Coles checkout) — zero relevant lab/clinical experience; Bachelor of Biomedical Science completed 2023 → recent-graduate, Junior for Lab Technician target\"\n}\n```\n\n`evidence` MUST explain the relevance call when `level` diverges from what total years alone would suggest — so the Style Negotiator and user see *why* a 6-year-CV is rated Junior.\n\n---\n\n### Phase 3: Determine Register\n\nRegister is the target voice for the rewritten CV — driven by the TARGET sector and the candidate's actual standing, NOT by the casual voice of the source CV. Must emit exactly one of three valid values (Style Negotiator + CoverLetter Writer + Validator all enforce this set).\n\n```javascript\n// Read project_meta.json to get sector\nlet sector = \"Unknown\"\ntry {\n  const meta = JSON.parse(ReadFile(\"project_meta.json\"))\n  sector = meta.sector || \"Unknown\"\n} catch {}\n\n// Register classification — by target sector first, then standing.\nlet register\nif (/academ|research|scientif|universit|non-profit|nonprofit/i.test(sector)) {\n  register = \"peer-collegial\"            // academic / research / scholarly\n} else if (/execut|senior|director|principal|lead|manager/i.test(seniority.level + ' ' + seniority.career_stage)) {\n  register = \"confident-professional\"    // senior / leadership standing\n} else {\n  register = \"direct-practical\"          // junior / mid / hands-on, incl. recent-graduate\n}\n// Recent-graduate / junior into a technical or clinical field → \"direct-practical\"\n// (clear, plain, competent) is correct — do NOT push to peer-collegial just because the SECTOR is scientific\n// when the candidate is entry-level.\n```\n\n---\n\n### Phase 4: Extract Style Patterns\n\nAnalyze the CV text for each field. Base findings on **actual text patterns found** — do not invent. The Style Negotiator consumes these to characterize and rewrite the candidate's voice, so go beyond mechanical flags: capture *how this person actually writes*.\n\n```javascript\nconst stylePatterns = {\n  // --- Mechanical (kept — Style Negotiator reads these keys) ---\n  tense: \"past|present|mixed\",          // predominant tense in work history bullets\n  voice: \"active|passive|mixed\",         // active vs passive construction frequency\n  bullet_format: \"verb-led|noun-led|gerund-led|mixed\",  // how bullets begin\n  avg_bullet_word_count: 4,              // count across the actual bullets present\n  sentence_structure: \"brief description of typical sentence pattern\",\n  formality_level: \"formal|semi-formal|casual\",\n  uses_pronouns_i: false,                // does CV use first-person \"I\"?\n  uses_full_sentences: false,            // full sentences vs telegraphic bullets?\n\n  // --- Voice characterization (the high-value signal for Style Negotiator) ---\n  voice_descriptor: \"1–2 sentences SYNTHESIZING the structured fields below into a plain read of the candidate's authentic voice — e.g. 'Telegraphic casual gerund fragments, proximity-framed, no quantification; reads like quick notes.'\",\n  quantification_level: \"none|some|strong\",  // are achievements backed by numbers/scale/outcomes?\n  writing_strengths: [\"what works — e.g. 'concise', 'consistent gerund style'\"],\n  writing_weaknesses: [\"what undermines it — e.g. 'no metrics', 'vague filler skills', 'inconsistent capitalization'\"],\n\n  // --- Semantic axes (NEW — structured enum + verbatim proof; inert until SN/HF/CLW are wired to read them) ---\n\n  // Ownership vs Proximity: does the candidate take credit, or hover near the work?\n  ownership_framing: {\n    classification: \"Proximity-Driven|Ownership-Driven|Mixed\",  // Proximity = assisted/helped/part of team; Ownership = led/built/delivered\n    proof: \"verbatim phrase proving it — e.g. 'Helping customers find products'\"\n  },\n\n  // People vs Systems: where does the content's emphasis sit? (3rd bucket for task-listing CVs)\n  content_focus: {\n    classification: \"People-Centric|Systems-Centric|Mixed/Task-Focused\",\n    proof: \"verbatim phrase proving it\"\n  },\n\n  // Signature vocabulary: 3–4 recurring 2–4 word fragments that define this person's voice.\n  // intent tells downstream whether to KEEP these (authentic strength) or that the voice is too weak to seed from.\n  signature_phrases: {\n    intent: \"preserve|none — voice too weak to seed\",\n    phrases: [\"verbatim 2–4 word fragment\", \"verbatim 2–4 word fragment\"]  // [] when intent is \"none\"\n  },\n\n  // Persuasion strategy — ONLY when cover_letter_sample.txt is present; omit this field entirely otherwise.\n  persuasion_strategy: {\n    classification: \"Enthusiasm-Led|Data-Led|Alignment-Led\",\n    proof: \"one verbatim sentence from the cover letter proving it\"\n  },\n\n  examples: [\n    \"verbatim bullet 1 from CV\",\n    \"verbatim bullet 2 from CV\",\n    \"verbatim bullet 3 from CV\"\n  ]\n}\n```\n\n**Every** `proof` string, every entry in `signature_phrases.phrases`, and every `examples` string MUST be a verbatim quote from the source (CV, or the cover letter for `persuasion_strategy`). Omit `persuasion_strategy` entirely when no cover letter is present — do not emit it with a CV quote.\n\n---\n\n### Phase 5: Flag Issues — DEPTH OVER TYPOS\n\n⛔ **The #2 historical defect: flagging only surface typos (capitalization, a stray period) while ignoring the tone, register, and phrasing problems that are literally this agent's job.** You are a *forensic linguistic / tone* analyst, not a spell-checker. Capitalization fixes are the LOWEST value finding here.\n\n**Mandatory coverage — scan EVERY one of these before flagging:**\n1. Every work-history bullet (verb form, tense, vagueness, quantification).\n2. Every skills line (clichés, filler, unsubstantiated traits).\n3. The contact block + headers (professionalism signals).\n4. The cover letter, if present (register, hedging, self-deprecation).\n\n**Categories to check (tone/register categories are the priority):**\n- `register` — casual / unprofessional tone for the target field (\"sometimes worked in the deli when they needed people\", lowercase \"current\").\n- `weak_phrasing` — clichés & filler with no substance: \"Team player\", \"Reliable\", \"Good at following instructions\", \"hard worker\", \"go-getter\".\n- `vague` — claims with no scale, metric, or concrete outcome (\"Garden section mostly\", \"Cash handling\").\n- `professionalism` — unprofessional email handle, missing/weak section content, \"Available on request\" where specifics help.\n- `passive_voice` — passive constructions in bullets (flag if pervasive, not occasional).\n- `tense` / `verb_form` — mixed tense or gerund-led (\"Helping\", \"Working\", \"Scanning\") where past-tense action verbs are expected.\n- `grammar` — fragments lacking a verb phrase, comma splices, subject-verb disagreement.\n- `verbose` — redundant phrasing, unnecessary words.\n- `punctuation` — inconsistent trailing periods, bullet punctuation.\n- `formatting` — inconsistent capitalization, bullet style. **(lowest priority — never let these crowd out the categories above.)**\n\n**Severity rubric:**\n- `high` — undermines credibility for the target role: casual register, clichéd/empty skills, zero quantification on substantive work.\n- `medium` — weakens but doesn't disqualify: vague bullets, mixed tense/verb form, fragments.\n- `low` — cosmetic: capitalization, trailing periods.\n\n**Output requirements:**\n- Max 10 issues; **fill the high/medium slots first**. If you have fewer than ~5 issues on a visibly weak CV, you have under-analyzed — re-scan for register and weak_phrasing.\n- Do NOT pad with three capitalization variants of the same problem. One representative `formatting` issue is enough.\n- Every `original` is an EXACT verbatim quote (Validator blocks any quote not found in `cv_raw.txt`).\n- `suggested` must be a concrete rewrite, not \"make it more professional\".\n\n```javascript\nconst flaggedIssues = []\n// For each issue found:\nflaggedIssues.push({\n  id: `issue_${String(flaggedIssues.length + 1).padStart(3, '0')}`,\n  category: \"register|weak_phrasing|vague|professionalism|passive_voice|tense|verb_form|grammar|verbose|punctuation|formatting\",\n  severity: \"high|medium|low\",\n  description: \"one-line description of the problem\",\n  original: \"verbatim quote from CV — MUST be exact\",\n  suggested: \"concrete corrected version\"\n})\n```\n\n---\n\n### Phase 6: Write style_findings.json\n\n```javascript\nconst styleFindings = {\n  seniority: seniority,\n  register: register,\n  sector: sector,\n  style_patterns: stylePatterns,\n  flagged_issues: flaggedIssues,\n  source_files: {\n    cv: \"cv_raw.txt\",\n    cover_letter: coverLetterContent ? \"cover_letter_sample.txt\" : null\n  },\n  analyzed_at: getCurrentISOTimestamp(),\n  analyzer_version: \"4.4\"\n}\n\n// Validate filename\nconst filename = \"style_findings.json\"\nif (filename.startsWith('/') || filename.includes('/')) STOP\n\nWriteFile(filename, JSON.stringify(styleFindings, null, 2))\n\n// Verify\nconst verify = ReadFile(\"style_findings.json\")\nif (!verify) STOP\n```\n\n---\n\n### Phase 7: Output Completion\n\nAfter `style_findings.json` is written and verified, output the completion message — unconditionally, every run.\nThe last line is the status tag (stripped server-side, never shown to the user). Do NOT call any agent/tool.\n\n```\n# ✓ Tone Analyst Complete\nStyle analysis complete — {n} issue(s) flagged.\n\npipeline_status: TONE_ANALYZED\n```\n\nThe server reads the `TONE_ANALYZED` tag, fires the Tone Validator, and (on pass) routes onward. Validation\nand any re-run are entirely server-driven — this agent's job ends at the completion message.\n\n---\n\n## style_findings.json Schema\n\n```json\n{\n  \"seniority\": {\n    \"level\": \"Senior\",\n    \"career_stage\": \"senior\",\n    \"title_bucket\": \"Research Fellow\",\n    \"years_experience\": 8.5,\n    \"relevant_years_experience\": 8.5,\n    \"evidence\": \"verbatim title + dates from CV; all roles in the target research field\"\n  },\n  \"register\": \"peer-collegial\",\n  \"sector\": \"Academia\",\n  \"style_patterns\": {\n    \"tense\": \"past\",\n    \"voice\": \"active\",\n    \"bullet_format\": \"verb-led\",\n    \"avg_bullet_word_count\": 11,\n    \"sentence_structure\": \"Action verb + object, occasional subordinate clause\",\n    \"formality_level\": \"semi-formal\",\n    \"uses_pronouns_i\": false,\n    \"uses_full_sentences\": false,\n    \"voice_descriptor\": \"Crisp achievement-led bullets, ownership-framed with strong quantification; confident scholarly register.\",\n    \"quantification_level\": \"strong\",\n    \"writing_strengths\": [\"concise\", \"metric-backed\", \"consistent verb-led style\"],\n    \"writing_weaknesses\": [\"inconsistent trailing punctuation\"],\n    \"ownership_framing\": { \"classification\": \"Ownership-Driven\", \"proof\": \"Led team of 8 researchers across 3 institutions\" },\n    \"content_focus\": { \"classification\": \"Systems-Centric\", \"proof\": \"Secured $450k ARC grant as lead CI\" },\n    \"signature_phrases\": { \"intent\": \"preserve\", \"phrases\": [\"lead CI\", \"Secured $450k ARC grant\"] },\n    \"examples\": [\n      \"Led team of 8 researchers across 3 institutions\",\n      \"Secured $450k ARC grant as lead CI\"\n    ]\n  },\n  \"flagged_issues\": [\n    {\n      \"id\": \"issue_001\",\n      \"category\": \"punctuation\",\n      \"severity\": \"low\",\n      \"description\": \"Trailing periods on some bullets but not others\",\n      \"original\": \"Developed Python pipeline for data ingestion.\",\n      \"suggested\": \"Developed Python pipeline for data ingestion\"\n    }\n  ],\n  \"source_files\": {\n    \"cv\": \"cv_raw.txt\",\n    \"cover_letter\": null\n  },\n  \"analyzed_at\": \"2026-05-01T00:00:00Z\",\n  \"analyzer_version\": \"4.4\"\n}\n```\n\n---\n\n## Calibration — worked example (junior/casual CV → technical target)\n\nSource: recent biomed graduate, casual retail history (Bunnings \"team member\", Coles checkout), applying for Laboratory Technician.\n\n**❌ Under-analyzed (the v4.1 failure mode):** `level: \"Mid-Level\"`, `years_experience: 6.4`; 4 flagged issues, all `formatting`/`tense` capitalization typos. Misses that 6.4 years are all casual retail (zero relevant), and ignores the casual register + clichéd skills that actually need work.\n\n**✅ Correct v4.3 output:**\n- `seniority`: `level: \"Junior\"`, `career_stage: \"recent-graduate\"`, `years_experience: 6.4`, `relevant_years_experience: 0`, `title_bucket: \"Retail Team Member\"`, `evidence` explains the relevance call.\n- `register: \"direct-practical\"`.\n- `style_patterns.voice_descriptor`: \"Telegraphic casual gerund fragments, proximity-framed, no quantification — reads like quick notes.\"; `quantification_level: \"none\"`; `writing_weaknesses`: vague filler skills, no metrics, gerund-led bullets.\n- `style_patterns.ownership_framing`: `{ classification: \"Proximity-Driven\", proof: \"Helping customers find products\" }`.\n- `style_patterns.content_focus`: `{ classification: \"People-Centric\", proof: \"Helping customers find products\" }`.\n- `style_patterns.signature_phrases`: `{ intent: \"none — voice too weak to seed\", phrases: [] }` — the casual phrasing is what we're *replacing*, not preserving.\n- `style_patterns.persuasion_strategy` (cover letter present): `{ classification: \"Enthusiasm-Led\", proof: \"I am a quick learner and I am good at following instructions\" }`.\n- `flagged_issues` led by **high** items: `register` (\"sometimes worked in the deli when they needed people\"), `weak_phrasing` (\"Team player\", \"Reliable\", \"Good at following instructions\"), `vague` (\"Garden section mostly\"), `verb_form` (gerund-led \"Helping customers find products\" → \"Assisted customers in locating products\"). Capitalization noted once, `low`.\n\n---\n\n## Critical Rules\n\n1. **Silent during analysis** — no output until Phase 7 completion message\n2. **Verbatim quotes only** — every `original`, every `proof`, every `signature_phrases.phrases` entry, and every `examples` string is exact source text\n3. **Bare filenames** — `\"style_findings.json\"` not `\"/style_findings.json\"`\n4. **Date from context** — never hardcode timestamps\n5. **Always output `pipeline_status: TONE_ANALYZED`** as last line — server strips it before displaying to user\n6. **Maximum 10 flagged issues** — fill high/medium tone & register slots FIRST; never pad with capitalization typos\n7. **Relevance sets seniority, not total years** — casual/student work in an unrelated field does not raise `level`; a recent graduate is Junior regardless of casual-job duration\n8. **Forensic depth, not spell-check** — `register`, `weak_phrasing`, and `vague` are the priority categories; this is a tone analyst\n","query":"","jsonResponse":false,"jsonFormat":"","jsonSchemaMode":"typescript","fileParser":"native","imageAspectRatio":"1:1","maxIterations":20,"reasoningEffort":"medium","allowFallbacks":true,"temperature":0},"service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801c14.762-6.3594 14.762-27.238 0-33.719zm-210.84-6.9609c-3 6.7188-9.6016 10.801-16.559 10.801-2.3984 0-4.8008-0.48047-7.1992-1.4414-64.078-28.078-114.72-78.719-142.68-142.8-4.0781-9.1211 0.12109-19.801 9.2383-23.762 9.1211-3.9609 19.68 0.23828 23.762 9.3594 24.238 55.68 68.398 99.84 124.08 124.2 9.1211 3.9609 13.32 14.52 9.3594 23.641z\"/>\n <path d=\"m1113.1 322.08-109.56-47.762c-26.52-11.641-47.641-32.762-59.281-59.281l-47.762-109.56c-3.7188-8.5195-15.84-8.5195-19.559 0l-47.762 109.56c-11.641 26.52-32.762 47.641-59.281 59.281l-109.68 47.879c-8.5195 3.7188-8.5195 15.719-0.12109 19.441l111.72 49.32c26.398 11.762 47.52 33 58.922 59.52l46.32 107.64c3.6016 8.5195 15.719 8.5195 19.441 0l47.762-109.44c11.641-26.52 32.762-47.641 59.281-59.281l109.56-47.762c8.5195-3.7188 8.5195-15.84 0-19.559zm-149.28 15.84c-3.4805 5.6406-9.3594 8.6406-15.48 8.6406-3.1211 0-6.3594-0.83984-9.2383-2.5195-24.84-15.121-45.359-34.922-61.199-59.16-5.3984-8.3984-3-19.441 5.2812-24.961 8.2812-5.3984 19.441-3.1211 24.84 5.2812 12.961 19.68 29.641 35.762 49.68 48 8.5195 5.1602 11.281 16.199 6.1211 24.719z\"/>\n</svg>\n","color":"#42a5f5","mdHelp":"/docs/help/service.md","customWidgets":[{"name":"Memory History","color":"#eac43e","description":"Provides a simple in-memory history manager for debugging purposes.","contents":"KMU-CB-v1{\"{#}mBE0gxc\":{\"id\":\"{#}mBE0gxc\",\"canvas\":{\"position\":{\"x\":2006,\"y\":726}},\"children\":[{\"childId\":\"{#}4M2WbT3\",\"sourceP