t"}},"groupId":"{#}NYYm2ZP"},"{#}SSnA0TX":{"id":"{#}SSnA0TX","canvas":{"position":{"x":780,"y":602}},"children":[{"childId":"{#}BfSCUMi","sourcePort":"{#}SSnA0TX_output_sessionHistoryOutput","targetPort":"{#}BfSCUMi_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}NYYm2ZP"},"{#}uiBMjXb":{"id":"{#}uiBMjXb","canvas":{"position":{"x":532,"y":218}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}NYYm2ZP"},"{#}EcrEUuG":{"id":"{#}EcrEUuG","canvas":{"position":{"x":1238.8172726076455,"y":1370.6042567302688}},"children":[{"childId":"{#}5DcMjgF","sourcePort":"{#}EcrEUuG_output_out","targetPort":"{#}5DcMjgF_input_abort"}],"state":{},"type":"play","groupId":"{#}cd0HlNC"},"{#}ZoWqfqL":{"id":"{#}ZoWqfqL","canvas":{"position":{"x":1382.4786419411878,"y":1113.1137350282097}},"children":[{"childId":"{#}0n05eSY","sourcePort":"{#}ZoWqfqL_output_out","targetPort":"{#}0n05eSY_input_abort"}],"state":{},"type":"play","groupId":"{#}QzzS04E"},"{#}B6Je1aq":{"id":"{#}B6Je1aq","canvas":{"position":{"x":1292,"y":1336}},"children":[{"childId":"{#}6Oaej4Q","sourcePort":"{#}B6Je1aq_output_out","targetPort":"{#}6Oaej4Q_input_abort"}],"state":{},"type":"play","groupId":"{#}Cs7chRY"},"{#}348Jg0V":{"id":"{#}348Jg0V","canvas":{"position":{"x":1687.924920585875,"y":1399.9696359410805}},"children":[{"childId":"{#}Qhwfpk6","sourcePort":"{#}348Jg0V_output_out","targetPort":"{#}Qhwfpk6_input_abort"}],"state":{},"type":"play","groupId":"{#}VM6YrUA"},"{#}WBJBHkV":{"id":"{#}WBJBHkV","canvas":{"position":{"x":-7044,"y":-6401}},"children":[{"childId":"{#}t2Gx6xh","sourcePort":"{#}WBJBHkV_output_output","targetPort":"{#}t2Gx6xh_input_outer-input-input-NmOLSO"}],"s