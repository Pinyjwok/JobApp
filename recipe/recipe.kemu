0 38.398-8.3984 50.398-26.398 19.199-27.602 13.199-66-14.398-85.199z\"/>\n <path d=\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1781146161,"internal":false}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"groupId":"{#}ueaPD15"},"{#}ut9cgRk":{"id":"{#}ut9cgRk","canvas":{"position":{"x":750,"y":571}},"children":[{"childId":"{#}9lQeupQ","sourcePort":"{#}ut9cgRk_output_sessionHistoryOutput","targetPort":"{#}9lQeupQ_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}ueaPD15"},"{#}X78Ja18":{"id":"{#}X78Ja18","canvas":{"position":{"x":235,"y":178}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}ueaPD15"},"{#}qEadH7A":{"id":"{#}qEadH7A","canvas":{"position":{"x":1292,"y":1336}},"children":[{"childId":"{#}3X8AmDm","sourcePort":"{#}qEadH7A_output_out","targetPort":"{#}3X8AmDm_input_abort"}],"state":{},"type":"play","groupId":"{#}YetwAO9"},"{#}G6LNEyg":{"id":"{#}G6LNEyg","canvas":{"position":{"x":1942,"y":895}},"children":[],"state":{"name":"Agent Outputs.validator_output","reactive":false,"lastConfiguration":{"controlType":"multilineText","controlSettings":{"value":"","placeholder":"Enter text..."},"group":"Agent Outputs","order":22}},"type":"globalVariable","groupId":"{#}YetwAO9"},"{#}L8Jv4Ea":{"id":"{#}L8Jv4Ea","canvas":{"position":{"x":1932,"y":1018}},"children":[],"state":{"name":"agentReasoning.validator_reasoning","reactive":false,"lastConfiguration":{"controlType":"multilineText","controlSettings":{"value":"","placeholder":"Enter text..."},"group":"agentReasoning","order":23}},"type":"globalVariable","groupId":"{#}YetwAO9"},"{#}DLkWcdi":{"id":"{#}DLkWcdi","canvas":{"position":{"x":1949,"y":1161}},"children":[],"state":{"name":"Agent Debug.validator_debug","reactive":false,"lastConfiguration":{"controlType":"anything","controlSettings":{"value":null},"group":"Agent Debug","order":26}},"type":"globalVariable","groupId":"{#}YetwAO9"},"{#}5NN8ZT7":{"id":"{#}5NN8ZT7","canvas":{"position":{"x":1879,"y":956}},"children":[],"state":{},"type":"output","groupId":"{#}YetwAO9"},"{#}QEevhYV":{"id":"{#}QEevhYV","canvas":{"position":{"x":-5436,"y":-6738}},"children":[{"childId":"{#}YetwAO9","sourcePort":"{#}QEevhYV_output_output","targetPort":"{#}YetwAO9_input_outer-input-config-NPd1HB"}],"state":{"inputName":"assembly_validator_input"},"type":"input"},"{#}G5PqWCD":{"id":"{#}G5PqWCD","canvas":{"position":{"x":-5545,"y":-6649}},"children":[{"childId":"{#}PRizcrd","sourcePort":"{#}G5PqWCD_innerOutput_inner-input-config-NPd1HB","targetPort":"{#}PRizcrd_input_config"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":832,"y":951}}],"outputs":[],"name":"Analyst Validator","type":"custom","color":"#68bb6c","icon":"check-circle","canvasPosition":{"x":756.6322093032763,"y":596.8123179364688},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":1},"type":"widgetGroup","disabled":false},"{#}980j3mt":{"id":"{#}980j3mt","canvas":{"position":{"x":-5407.176619970887,"y":-6628.297487289248}},"children":[{"childId":"{#}G5PqWCD","sourcePort":"{#}980j3mt_output_output","targetPort":"{#}G5PqWCD_input_outer-input-config-NPd1HB"}],"state":{"inputName":"analyst_validator_input"},"type":"input"},"{#}PRizcrd":{"id":"{#}PRizcrd","canvas":{"position":{"x":1445,"y":830}},"children":[{"childId":"{#}GQTls8Y","sourcePort":"{#}PRizcrd_output_tools","targetPort":"{#}GQTls8Y_input_outer-input-input1"},{"childId":"{#}htBxrfa","sourcePort":"{#}PRizcrd_output_history","targetPort":"{#}htBxrfa_input_outer-input-input1"},{"childId":"{#}sR2hWJq","sourcePort":"{#}PRizcrd_output_reasoning","targetPort":"{#}sR2hWJq_input_setValue"},{"childId":"{#}7R3zNbv","sourcePort":"{#}PRizcrd_output_debug","targetPort":"{#}7R3zNbv_input_setValue"},{"childId":"{#}qgc5sVf","sourcePort":"{#}PRizcrd_output_text","targetPort":"{#}qgc5sVf_input_setValue"},{"childId":"{#}YwczVri","sourcePort":"{#}PRizcrd_output_text","targetPort":"{#}YwczVri_input_event"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"selectedModel":{"id":"anthropic/claude-sonnet-4.6","slug":"anthropic/claude-4.6-sonnet-20260217","name":"Anthropic: Claude Sonnet 4.6","description":"Sonnet 4.6 is Anthropic's most capable Sonnet-class model yet, with frontier performance across coding, agents, and professional work. It excels at iterative development, complex codebase navigation, end-to-end project management with...","inputModalities":["text","image","file"],"outputModalities":["text"],"supportsTools":true,"supportsReasoning":true,"promptPrice":0.000003,"completionPrice":0.000015,"maxTokens":128000,"contextLength":1000000,"provider":"anthropic"},"systemInstructions":"# Analyst Validator — Instructions v1.0\n\n**Version:** 1.0\n**Last Updated:** 2026-06-04\n**Type:** Single-role validator — server-orchestrated, fires via `_runValidator()` in `dispatch.js`\n**Pipeline Position:** Middleman between **Analyst → Reviewer** (gates `gap_analysis.json` before the Reviewer consumes it)\n**Trigger:** Server fires `analyst_validator_input` immediately after the Analyst returns\n**Model:** Claude Sonnet 4.6\n**Input:** `agent` — always `\"analyst\"` (server constant)\n**Tools:** `ReadFile`, `WriteFile`\n\n> Split from the former monolithic Validator (v1.9). The Analyst and Tone Analyst run in **parallel**, so\n> each has its OWN validator node + verdict file. This node owns the analyst path only.\n\n---\n\n## Core Principle\n\n**You are an auditor, not a fixer.**\n\n- ✅ READ `gap_analysis.json` and the source it was derived from (`candidate_profile.json`)\n- ✅ VERIFY claims trace to the source data\n- ✅ DETECT fabricated evidence paths, invented metrics, internal inconsistencies\n- ✅ REPORT specific problems with enough detail for the Analyst to fix them\n- ❌ Do NOT rewrite, fill in, or pass fabricated content with a warning\n\n---\n\n## Verdict Scale\n\n| Verdict | Meaning |\n|---------|---------|\n| **APPROVE** | Output quality acceptable — server surfaces the Analyst's output |\n| **FLAG** | Concerns noted, not blocking — server surfaces output with warnings appended |\n| **REJECT** | Blocking problems — write the failed file, clear `gap_analysis.json`, server re-runs the Analyst once |\n\n**REJECT threshold:** any single `blocking` issue → REJECT. Only `warning` issues → FLAG. None → APPROVE.\n\n---\n\n## Execution Protocol\n\n**Step 1 — Read the files.**\n```javascript\nconst output  = JSON.parse(ReadFile(\"gap_analysis.json\"))\nconst profile = JSON.parse(ReadFile(\"candidate_profile.json\"))\nconst issues  = []\n```\n\n> **⛔ Server-owned fields — NEVER flag these:** `overall_fit_score`, `role_strictness`, `fit_rationale`.\n> The server computes the fit score AFTER you run (`applyFitScore()` in `dispatch.js`). When you read\n> `gap_analysis.json`, `overall_fit_score` still holds a placeholder (e.g. `\"__FIT_SCORE__\"`, `\"FIT_SCORE\"`).\n> This is expected and correct — do NOT report it as an unfilled/template/placeholder issue.\n\n**Step 2 — Run the mechanical checks.**\n```javascript\n// 1. Evidence path resolution — every strength's evidence_source must resolve in candidate_profile\nif (Array.isArray(output.strengths)) {\n  output.strengths.forEach((s, i) => {\n    if (!s.evidence_source) {\n      issues.push({ field: `strengths[${i}].evidence_source`, problem: \"Missing evidence_source — every strength requires a verifiable source path\", severity: \"blocking\" })\n      return\n    }\n    const pathStr = s.evidence_source.replace(/^candidate_profile\\./, '')\n    const resolved = resolvePath(profile, pathStr)\n    if (!resolved) {\n      issues.push({ field: `strengths[${i}].evidence_source`, problem: `Path \"${s.evidence_source}\" does not resolve to a value in candidate_profile.json`, severity: \"blocking\" })\n    }\n  })\n}\n\n// 2. Duplicate evidence paths\n// Same path for DIFFERENT requirement_ids is VALID — one strong evidence covers multiple JD requirements.\n// Only block when the SAME requirement_id is evidenced by the same path twice (true duplicate claim).\n// Heavy reuse (3+ distinct requirements from one path) is a non-blocking warning.\nconst pathMap = {}  // path → [{ index, requirement_id }]\n;(output.strengths || []).forEach((s, i) => {\n  if (!s.evidence_source) return\n  if (!pathMap[s.evidence_source]) pathMap[s.evidence_source] = []\n  pathMap[s.evidence_source].push({ index: i, requirement_id: s.requirement_id })\n})\nObject.entries(pathMap).forEach(([path, entries]) => {\n  if (entries.length < 2) return\n  const reqIds = entries.map(e => e.requirement_id)\n  const reqIdSet = new Set(reqIds)\n  if (reqIdSet.size < reqIds.length) {\n    entries.forEach((e, j) => {\n      if (reqIds.indexOf(e.requirement_id) !== j) {\n        issues.push({ field: `strengths[${e.index}].evidence_source`, problem: `Duplicate evidence path \"${path}\" used for the same requirement_id \"${e.requirement_id}\" — same JD requirement claimed twice`, severity: \"blocking\" })\n      }\n    })\n  }\n  if (reqIdSet.size >= 3) {\n    issues.push({ field: `strengths[${entries[0].index}].evidence_source`, problem: `Evidence path \"${path}\" supports ${reqIdSet.size} distinct strengths — verify each represents a genuinely distinct capability`, severity: \"warning\" })\n  }\n})\n\n// 3. Publication claim guard\n;(output.strengths || []).forEach((s, i) => {\n  const text = (s.strength_text || '') + ' ' + (s.evidence_source || '')\n  if (/publication|journal|paper|peer.reviewed/i.test(text)) {\n    if (!profile.publications || profile.publications.length === 0) {\n      issues.push({ field: `strengths[${i}]`, problem: `Strength references publications/journals but candidate_profile.publications is empty`, severity: \"blocking\" })\n    }\n  }\n})\n\n// 4. Grant/funding claim guard\n;(output.strengths || []).forEach((s, i) => {\n  const text = (s.strength_text || '') + ' ' + (s.evidence_source || '')\n  if (/\\bgrant\\b|chief investigator|\\bCI\\b|funding|seed fund/i.test(text)) {\n    if (!profile.grants || profile.grants.length === 0) {\n      issues.push({ field: `strengths[${i}]`, problem: `Strength references grants/funding but candidate_profile.grants is empty`, severity: \"blocking\" })\n    }\n  }\n})\n\n// 5. Gap ID naming convention\n;(output.gaps || []).forEach((g, i) => {\n  if (g.id && !/^gap_\\d+$/.test(g.id)) {\n    issues.push({ field: `gaps[${i}].id`, problem: `Non-standard gap ID \"${g.id}\" — must follow gap_N pattern`, severity: \"warning\" })\n  }\n})\n```\n\n**Step 3 — Determine verdict.**\n```javascript\nconst blockingIssues = issues.filter(i => i.severity === \"blocking\")\nconst verdict = blockingIssues.length > 0 ? \"REJECT\"\n              : issues.length > 0         ? \"FLAG\"\n              : \"APPROVE\"\n```\n\n**Step 4 — Write the verdict file (all verdicts).**\n```javascript\nWriteFile(\"analyst_validator_verdict.json\", JSON.stringify({\n  verdict, agent: \"analyst\", issues,\n  summary: `${blockingIssues.length} blocking + ${issues.length - blockingIssues.length} warning issue(s).`\n}, null, 2))\n```\n\n**REJECT only — also write the failed file and clear the output so the Analyst's re-invocation guard doesn't block the retry:**\n```javascript\nWriteFile(\"analyst_validation_failed.json\", JSON.stringify({\n  agent: \"analyst\", issues,\n  summary: `${blockingIssues.length} blocking + ${issues.length - blockingIssues.length} warning issue(s).`\n}, null, 2))\nWriteFile(\"gap_analysis.json\", \"{}\")\n```\n\n**Output a single word — the verdict — and stop:**\n```\nAPPROVE\n```\n(or `FLAG`, or `REJECT`)\n\nDo NOT call ChangeAgent/SwitchAgent. Do NOT output the Analyst's text. The server reads\n`analyst_validator_verdict.json` and handles all display and retry logic.\n\n---\n\n## Helper\n\n```javascript\n// Resolve a dot-bracket path string against an object, e.g. \"work_history[0].responsibilities[2]\"\nfunction resolvePath(obj, path) {\n  const parts = path.replace(/\\[(\\d+)\\]/g, '.$1').split('.').filter(Boolean)\n  let val = obj\n  for (const part of parts) {\n    if (val == null || typeof val !== 'object') return null\n    val = val[part]\n    if (val === undefined) return null\n  }\n  return val != null && val !== '' ? val : null\n}\n```\n\n---\n\n## Gotchas\n\n1. **Never fix the output** — write issues to `analyst_validation_failed.json`; the Analyst applies fixes on re-run.\n2. **REJECT: no output to user** — the user sees nothing until the retry passes.\n3. **Bare filenames** — `\"gap_analysis.json\"`, never a path.\n4. **No routing tools** — output the verdict word and stop; the server owns routing.\n5. **Run ONLY these mechanical checks** — `overall_fit_score`/`role_strictness`/`fit_rationale` are server-computed; their placeholder values are never a defect.\n","query":"","jsonResponse":false,"jsonFormat":"","jsonSchemaMode":"typescript","fileParser":"native","imageAspectRatio":"1:1","maxIterations":10,"reasoningEffort":"low","allowFallbacks":true,"temperature":1},"service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801c14.762-6.3594 14.762-27.238 0-33.719zm-210.84-6.9609c-3 6.7188-9.6016 10.801-16.559 10.801-2.3984 0-4.8008-0.48047-7.1992-1.4414-64.078-28.078-114.72-78.719-142.68-142.8-4.0781-9.1211 0.12109-19.801 9.2383-23.762 9.1211-3.9609 19.68 0.23828 23.762 9.3594 24.238 55.68 68.398 99.84 124.08 124.2 9.1211 3.9609 13.32 14.52 9.3594 23.641z\"/>\n <path d=\"m1113.1 322.08-109.56-47.762c-26.52-11.641-47.641-32.762-59.281-59.281l-47.762-109.56c-3.7188-8.5195-15.84-8.5195-19.559 0l-47.762 109.56c-11.641 26.52-32.762 47.641-59.281 59.281l-109.68 47.879c-8.5195 3.7188-8.5195 15.719-0.12109 19.441l111.72 49.32c26.398 11.762 47.52 33 58.922 59.52l46.32 107.64c3.6016 8.5195 15.719 8.5195 19.441 0l47.762-109.44c11.641-26.52 32.762-47.641 59.281-59.281l109.56-47.762c8.5195-3.7188 8.5195-15.84 0-19.559zm-149.28 15.84c-3.4805 5.6406-9.3594 8.6406-15.48 8.6406-3.1211 0-6.3594-0.83984-9.2383-2.5195-24.84-15.121-45.359-34.922-61.199-59.16-5.3984-8.3984-3-19.441 5.2812-24.961 8.2812-5.3984 19.441-3.1211 24.84 5.2812 12.961 19.68 29.641 35.762 49.68 48 8.5195 5.1602 11.281 16.199 6.1211 24.719z\"/>\n</svg>\n","color":"#42a5f5","mdHelp":"/docs/help/service.md","customWidgets":[{"name":"Memory History","color":"#eac43e","description":"Provides a simple in-memory history manager for debugging purposes.","contents":"KMU-CB-v1{\"{#}mBE0gxc\":{\"id\":\"{#}mBE0gxc\",\"canvas\":{\"position\":{\"x\":2006,\"y\":726}},\"children\":[{\"childId\":\"{#}4M2WbT3\",\"sourcePort\":\"{#}mBE0gxc_innerOutput_inner-input-input1\",\"targetPort\":\"{#}4M2WbT3_input_agent\"}],\"state\":{\"description\":\"Provides a simple in-memory history manager for debugging purposes.\",\"inputs\":[{\"index\":0,\"label\":\"agent\",\"name\":\"input1\",\"type\":[5],\"position\":{\"x\":519,\"y\":291}}],\"outputs\":[],\"name\":\"Memory History\",\"type\":\"custom\",\"color\":\"#eac43e\",\"icon\":\"database\",\"canvasPosition\":{\"x\":0,\"y\":0},\"markdownHelp\":\"\",\"settings\":[],\"protocolVersion\":\"2\"},\"type\":\"widgetGroup\"},\"{#}4M2WbT3\":{\"id\":\"{#}4M2WbT3\",\"canvas\":{\"position\":{\"x\":659,\"y\":341}},\"children\":[{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_getHistory\",\"targetPort\":\"{#}jCnteeA_input_read\"},{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_updateHistory\",\"targetPort\":\"{#}jCnteeA_input_update\"}],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{\"includeAttachments\":false,\"timeout\":60},\"variantId\":\"history\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=\\\"M12 12c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\\\" fill=\\\"white\\\"/>\\n  <rect x=\\\"10\\\" y=\\\"19\\\" width=\\\"4\\\" height=\\\"3\\\" rx=\\\"1\\\" fill=\\\"currentColor\\\"/>\\n</svg>\",\"color\":\"#42a5f5\",\"inputs\":[{\"name\":\"query\",\"description\":\"Query string for the agent\",\"type\":1},{\"name\":\"attachments\",\"description\":\"Attachments for the agent (String, BinaryFile, ImageData, or Array of these types)\",\"type\":[1,12,7,3]},{\"name\":\"clear\",\"description\":\"Clear input signal\",\"type\":6},{\"name\":\"abort\",\"description\":\"Abort current query signal\",\"type\":6},{\"name\":\"send\",\"description\":\"Send input signal\",\"type\":6}],\"outputs\":[{\"name\":\"tools\",\"type\":5},{\"name\":\"history\",\"type\":5},{\"name\":\"json\",\"type\":5},{\"name\":\"text\",\"type\":1},{\"name\":\"stream\",\"type\":1},{\"name\":\"images\",\"description\":\"Generated images as ImageData array\",\"type\":3}],\"supportedPlatforms\":[\"win-x86\",\"win-x64\",\"osx-x64\",\"osx-arm64\",\"linux-debian-arm64\",\"linux-debian-x64\",\"linux-rhel-arm64\",\"linux-rhel-x64\"],\"author\":\"db618814-4e68-40aa-8158-64a595fea23b\",\"defaultVariantInfo\":{\"title\":\"Agent\",\"shortTitle\":\"Agent\",\"description\":\"AI agent that processes queries with system instructions and attachments\"},\"variants\":[{\"id\":\"tool\",\"name\":\"Tool\",\"description\":\"Define tools with arguments and results for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Tool icon - wrench/settings -->\\n  <path d=\\\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Tool input data\",\"type\":5}],\"outputs\":[{\"name\":\"arguments\",\"description\":\"Tool arguments\",\"type\":5}],\"color\":\"#42a5f5\"},{\"id\":\"submit\",\"name\":\"Submit\",\"description\":\"Submit data without any processing\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Submit icon - send/arrow -->\\n  <path d=\\\"M2.01 21L23 12 2.01 3 2 10l15 2-15 2z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Data to submit\",\"type\":6}],\"color\":\"#68bb6c\"},{\"id\":\"history\",\"name\":\"History\",\"description\":\"Manage conversation history and session storage for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 16 16\\\">\\n  <path\\n    d=\\\"M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M8 3.5a.5.5 0 0 1 .5.5v4l2.5 1.5a.5.5 0 0 1-.5.866L7.5 8.866A.5.5 0 0 1 7.5 8V4a.5.5 0 0 1 .5-.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M2.5 8a5.5 5.5 0 0 1 5.5-5.5V1A7 7 0 0 0 1 8h1.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n</svg>\\n\",\"inputs\":[{\"name\":\"agent\",\"description\":\"Connect to the agent\",\"type\":5}],\"outputs\":[{\"name\":\"getHistory\",\"description\":\"Invoked when the agent needs to retrieve the conversation history\",\"type\":5},{\"name\":\"updateHistory\",\"description\":\"Invoked when the agent needs to update the conversation history\",\"type\":5}],\"color\":\"#9c27b0\"}],\"internal\":false,\"devMode\":true,\"sessionId\":1760512532}},\"type\":\"hubService\",\"groupId\":\"{#}mBE0gxc\"},\"{#}a5vxU9Y\":{\"id\":\"{#}a5vxU9Y\",\"canvas\":{\"position\":{\"x\":1235,\"y\":488}},\"children\":[],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{},\"variantId\":\"submit\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=\\\"M12 12c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\\\" fill=\\\"white\\\"/>\\n  <rect x=\\\"10\\\" y=\\\"19\\\" width=\\\"4\\\" height=\\\"3\\\" rx=\\\"1\\\" fill=\\\"currentColor\\\"/>\\n</svg>\",\"color\":\"#42a5f5\",\"inputs\":[{\"name\":\"query\",\"description\":\"Query string for the agent\",\"type\":1},{\"name\":\"attachments\",\"description\":\"Attachments for the agent (String, BinaryFile, ImageData, or Array of these types)\",\"type\":[1,12,7,3]},{\"name\":\"clear\",\"description\":\"Clear input signal\",\"type\":6},{\"name\":\"abort\",\"description\":\"Abort current query signal\",\"type\":6},{\"name\":\"send\",\"description\":\"Send input signal\",\"type\":6}],\"outputs\":[{\"name\":\"tools\",\"type\":5},{\"name\":\"history\",\"type\":5},{\"name\":\"json\",\"type\":5},{\"name\":\"text\",\"type\":1},{\"name\":\"stream\",\"type\":1},{\"name\":\"images\",\"description\":\"Generated images as ImageData array\",\"type\":3}],\"supportedPlatforms\":[\"win-x86\",\"win-x64\",\"osx-x64\",\"osx-arm64\",\"linux-debian-arm64\",\"linux-debian-x64\",\"linux-rhel-arm64\",\"linux-rhel-x64\"],\"author\":\"db618814-4e68-40aa-8158-64a595fea23b\",\"defaultVariantInfo\":{\"title\":\"Agent\",\"shortTitle\":\"Agent\",\"description\":\"AI agent that processes queries with system instructions and attachments\"},\"variants\":[{\"id\":\"tool\",\"name\":\"Tool\",\"description\":\"Define tools with arguments and results for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Tool icon - wrench/settings -->\\n  <path d=\\\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Tool input data\",\"type\":5}],\"outputs\":[{\"name\":\"arguments\",\"description\":\"Tool arguments\",\"type\":5}],\"color\":\"#42a5f5\"},{\"id\":\"submit\",\"name\":\"Submit\",\"description\":\"Submit data without any processing\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Submit icon - send/arrow -->\\n  <path d=\\\"M2.01 21L23 12 2.01 3 2 10l15 2-15 2z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Data to submit\",\"type\":6}],\"color\":\"#68bb6c\"},{\"id\":\"history\",\"name\":\"History\",\"description\":\"Manage conversation history and session storage for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 16 16\\\">\\n  <path\\n    d=\\\"M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M8 3.5a.5.5 0 0 1 .5.5v4l2.5 1.5a.5.5 0 0 1-.5.866L7.5 8.866A.5.5 0 0 1 7.5 8V4a.5.5 0 0 1 .5-.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M2.5 8a5.5 5.5 0 0 1 5.5-5.5V1A7 7 0 0 0 1 8h1.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n</svg>\\n\",\"inputs\":[{\"name\":\"agent\",\"description\":\"Connect to the agent\",\"type\":5}],\"outputs\":[{\"name\":\"getHistory\",\"description\":\"Invoked when the agent needs to retrieve the conversation history\",\"type\":5},{\"name\":\"updateHistory\",\"description\":\"Invoked when the agent needs to update the conversation history\",\"type\":5}],\"color\":\"#9c27b0\"}],\"internal\":false,\"devMode\":true,\"sessionId\":1760512532}},\"type\":\"hubService\",\"secrets\":{\"OPENROUTER_API_KEY\":{\"name\":\"OPENROUTER_API_KEY\",\"hubServiceName\":\"kemu.io.ai-agent\"}},\"groupId\":\"{#}mBE0gxc\"},\"{#}jCnteeA\":{\"id\":\"{#}jCnteeA\",\"canvas\":{\"position\":{\"x\":948,\"y\":397}},\"children\":[{\"childId\":\"{#}a5vxU9Y\",\"sourcePort\":\"{#}jCnteeA_output_sessionHistoryOutput\",\"targetPort\":\"{#}a5vxU9Y_input_input\"}],\"state\":{\"pauseExecution\":false,\"autoPauseOnError\":true,\"version\":2,\"metadata\":{\"name\":\"Memory History\",\"description\":\"Keeps the history messages in memory (this is intended for dev purposes only)\"},\"pages\":{\"main\":{\"code\":\"/**\\n * Name: Memory History\\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\\n */\\n\\nconst sessions = {};\\n\\nconst getWidgetInputs = () => [\\n  { name: 'read', type: DataType.JsonObj },\\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\\n];\\n\\nconst getWidgetOutputs = () => [\\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\\n];\\n\\nconst onParentEvent = async ({ targetPort, event }) => {\\n  const inputData = event.data.value;\\n\\n  if (targetPort.name === 'read') {\\n    const sessionId = inputData.sessionId;\\n\\n    if (sessionId === undefined || sessionId === null) {\\n      console.error(\\\"Error: 'read' event missing 'sessionId' property.\\\");\\n      return;\\n    }\\n\\n    if (!sessions[sessionId]) {\\n      sessions[sessionId] = { messages: [] };\\n    }\\n\\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\\n\\n  } else if (targetPort.name === 'update') {\\n    const sessionId = inputData.sessionId;\\n    const messagesToProcess = inputData.messages;\\n\\n    if (sessionId === undefined || sessionId === null) {\\n      console.error(\\\"Error: 'update' event missing 'sessionId' property.\\\");\\n      return;\\n    }\\n    if (messagesToProcess === undefined || messagesToProcess === null) {\\n      console.error(\\\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\\\");\\n      return;\\n    }\\n\\n    if (!sessions[sessionId]) {\\n      sessions[sessionId] = { messages: [] };\\n    }\\n\\n    if (Array.isArray(messagesToProcess)) {\\n      sessions[sessionId].messages.push(...messagesToProcess);\\n    } else {\\n      sessions[sessionId].messages.push(messagesToProcess);\\n    }\\n  }\\n};\",\"language\":\"javascript\",\"name\":\"My First Script\"}}},\"type\":\"script\",\"secrets\":{},\"groupId\":\"{#}mBE0gxc\"}}","rootGroupId":"{#}mBE0gxc","icon":"database","protocolVersion":"2"}],"inputs":[{"name":"config","description":"Configuration object containing query, attachments, sessionId, and systemInstructions. Can also be a string to be used as query or a boolean to trigger processing.","type":[5,4,1,6]},{"name":"abort","description":"Abort current query signal","type":6}],"outputs":[{"name":"tools","type":5},{"name":"history","type":5},{"name":"json","type":5},{"name":"text","type":1},{"name":"stream","type":1},{"name":"reasoning","description":"Reasoning output from models that support extended thinking","type":1},{"name":"images","description":"Generated images as ImageData array","type":3},{"name":"debug","description":"Includes debugging information for when things go wrong, including stopping reason","type":5}],"supportedPlat