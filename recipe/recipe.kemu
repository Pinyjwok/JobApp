<path d=\"m739.2 1028.4-22.801 7.1992c-32.398 8.3984-51.602 42-43.199 75.602 7.1992 27.602 32.398 45.602 58.801 45.602 4.8008 0 10.801-1.1992 15.602-2.3984 9.6016-2.3984 19.199-6 28.801-8.3984 32.398-10.801 49.199-45.602 38.398-76.801-8.4023-33.602-43.199-51.602-75.602-40.805z\"/>\n <path d=\"m532.8 1046.4-24-3.6016c-33.602-7.1992-66 14.398-72 48-7.1992 33.602 14.398 66 48 72 9.6016 2.3984 20.398 3.6016 30 4.8008 2.3984 0 6 1.1992 9.6016 1.1992 30 0 56.398-21.602 60-52.801 4.7969-33.598-18.004-64.797-51.602-69.598z\"/>\n <path d=\"m321.6 955.2c-26.398-20.398-64.801-16.801-86.398 9.6016-20.398 26.398-16.801 64.801 9.6016 86.398 8.3984 6 15.602 12 24 18 10.801 7.1992 22.801 10.801 34.801 10.801 19.199 0 38.398-8.3984 50.398-26.398 19.199-27.602 13.199-66-14.398-85.199z\"/>\n <path d=\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1784443105}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"groupId":"{#}ZT9Yi6H"},"{#}vq4dw9W":{"id":"{#}vq4dw9W","canvas":{"position":{"x":750,"y":571}},"children":[{"childId":"{#}9ExYehz","sourcePort":"{#}vq4dw9W_output_sessionHistoryOutput","targetPort":"{#}9ExYehz_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}ZT9Yi6H"},"{#}x1yTlXQ":{"id":"{#}x1yTlXQ","canvas":{"position":{"x":235,"y":178}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}ZT9Yi6H"},"{#}9bosNCU":{"id":"{#}9bosNCU","canvas":{"position":{"x":-5955,"y":-6861}},"children":[{"childId":"{#}bK5sdre","sourcePort":"{#}9bosNCU_innerOutput_inner-input-config-NPd1HB","targetPort":"{#}bK5sdre_input_config"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":1192,"y":1032}}],"outputs":[],"name":"Main Orchestrator","type":"custom","color":"#626060","icon":"sort","canvasPosition":{"x":37.587128440425204,"y":308.50875177835985},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":0.4565330930687387},"type":"widgetGroup","disabled":false},"{#}EnyQUlO":{"id":"{#}EnyQUlO","canvas":{"position":{"x":-5947,"y":-6425}},"children":[{"childId":"{#}ZsIuTRS","sourcePort":"{#}EnyQUlO_innerOutput_inner-input-config-NPd1HB","targetPort":"{#}ZsIuTRS_input_config"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":1308,"y":1723}}],"outputs":[],"name":"JD Enhancer","type":"custom","color":"#ffb834","icon":"robot","canvasPosition":{"x":1678.4735440322102,"y":1616.1288358382778},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":1.394011256411752},"type":"widgetGroup","disabled":false},"{#}GlNVXjr":{"id":"{#}GlNVXjr","canvas":{"position":{"x":3213,"y":-115}},"children":[{"childId":"{#}TqaC8L9","sourcePort":"{#}GlNVXjr_output_file","targetPort":"{#}TqaC8L9_input_contents"}],"state":{"mimeType":"application/octet-stream","fileName":"research_output.json"},"type":"dataToBinaryFile","groupId":"{#}eCMtaIp"},"{#}wxb0bAk":{"id":"{#}wxb0bAk","canvas":{"position":{"x":2584,"y":55}},"children":[{"childId":"{#}GlNVXjr","sourcePort":"{#}wxb0bAk_output_property1","targetPort":"{#}GlNVXjr_input_data"}],"state":{"properties":[{"label":"contents","name":"property1"}],"detectedProperties":{"contents":{"type":1},"filePath":{"type":1},"fileName":{"type":1}}},"type":"json","groupId":"{#}eCMtaIp"},"{#}pH3ATaQ":{"id":"{#}pH3ATaQ","canvas":{"position":{"x":2211,"y":-57}},"children":[{"childId":"{#}oI9aZYj","sourcePort":"{#}pH3ATaQ_output_1","targetPort":"{#}oI9aZYj_input_in"},{"childId":"{#}wxb0bAk","sourcePort":"{#}pH3ATaQ_output_2","targetPort":"{#}wxb0bAk_input_in"}],"state":{"outputPortCount":3},"type":"sequence","groupId":"{#}eCMtaIp"},"{#}oTKI7zl":{"id":"{#}oTKI7zl","canvas":{"position":{"x":-5946,"y":-6516}},"children":[{"childId":"{#}YgrOhyz","sourcePort":"{#}oTKI7zl_innerOutput_inner-input-config-NPd1HB","targetPort":"{#}YgrOhyz_input_config"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":1192,"y":1032}}],"outputs":[],"name":"Researcher","type":"custom","color":"#eac43e","icon":"robot","canvasPosition":{"x":1095.740145619609,"y":470.0727594132282},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":0.9520848441372486},"type":"widgetGroup","disabled":false},"{#}YgrOhyz":{"id":"{#}YgrOhyz","canvas":{"position":{"x":1592,"y":666}},"children":[{"childId":"{#}83BpzNj","sourcePort":"{#}YgrOhyz_output_tools","targetPort":"{#}83BpzNj_input_outer-input-input1"},{"childId":"{#}sIO5yK5","sourcePort":"{#}YgrOhyz_output_history","targetPort":"{#}sIO5yK5_input_outer-input-input1"},{"childId":"{#}pBMckKq","sourcePort":"{#}YgrOhyz_output_reasoning","targetPort":"{#}pBMckKq_input_setValue"},{"childId":"{#}8kOc65P","sourcePort":"{#}YgrOhyz_output_debug","targetPort":"{#}8kOc65P_input_setValue"},{"childId":"{#}MeycU9Y","sourcePort":"{#}YgrOhyz_output_text","targetPort":"{#}MeycU9Y_input_setValue"},{"childId":"{#}9ytxfUU","sourcePort":"{#}YgrOhyz_output_text","targetPort":"{#}9ytxfUU_input_event"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"selectedModel":{"id":"anthropic/claude-sonnet-4.5","slug":"anthropic/claude-4.5-sonnet-20250929","name":"Anthropic: Claude Sonnet 4.5","description":"Claude Sonnet 4.5 is Anthropic’s most advanced Sonnet model to date, optimized for real-world agents and coding workflows. It delivers state-of-the-art performance on coding benchmarks such as SWE-bench Verified, with...","inputModalities":["text","image","file"],"outputModalities":["text"],"supportsTools":true,"supportsReasoning":true,"promptPrice":0.000003,"completionPrice":0.000015,"maxTokens":64000,"contextLength":1000000,"provider":"anthropic"},"systemInstructions":"# Researcher Agent v2.3 — System Instructions\n\n**Version:** 2.3\n**Last Updated:** 2026-07-19\n**Role:** Company Intelligence Gatherer\n**Pipeline Position:** Third Worker Agent (After Extractor)\n**Trigger Status:** `INITIALIZED`\n**Output:** `research_output.json` — the server derives quality/routing from this file\n\n\n## Role\n\nYou are the **Researcher Agent** responsible for gathering comprehensive company intelligence to inform job application preparation. You collect data about company culture, values, strategic direction, interview focus areas, career growth opportunities, and employee success criteria.\n\n---\n\n## Authority\n\n### READ\n- `project_meta.json` (company_name, position_title, sector, jd_source)\n- `jd_raw.txt` (to identify the hiring unit)\n\n### WRITE\n- `research_output.json` (research_data object, or `null` when research genuinely failed)\n\n### CALL\n- ResearchCompany tool/API (Tavily — company-specific query)\n- ResearchSector tool/API (Tavily — industry archetype query)\n\n---\n\n## Tools\n\n| Tool | Usage |\n| --- | --- |\n| **ReadFile** | Read project_meta.json, jd_raw.txt |\n| **WriteFile** | Write research_output.json (bare filename, `research_output.json`) |\n| **ResearchCompany** | Tavily search — company-specific query pre-constructed by workflow template |\n| **ResearchSector** | Tavily search — industry archetype query pre-constructed by workflow template |\n| **SwitchAgent** | Return control to Orchestrator on critical errors only — never on normal completion |\n\n---\n\n## Core Principle\n\n**You are a researcher, not an analyst — and not a calculator.**\n\nYou:\n- ✅ GATHER company intelligence via two parallel Tavily calls\n- ✅ SYNTHESIZE the results into the research fields, preferring company-specific data\n- THIS IS NOT A BRIEF, BEGIN THE TASK IMMEDIATELY\n\nYou do NOT:\n- ❌ Analyze user fit, compare CV vs JD, or make recommendations\n- ❌ Count valid fields, compute a quality score, or decide the pipeline status — **the server does this from the file you write**\n\n**You ONLY collect and organize company information.**\n\n---\n\n## Workflow Architecture Note\n\nThis agent runs in a workflow where two Template String nodes construct the queries independently:\n- **ResearchCompany** — company-specific intelligence (LinkedIn, Glassdoor, news): company name, position, sector, culture/values keywords.\n- **ResearchSector** — industry archetype intelligence (sector norms, typical employer expectations, hiring standards for the role type and region): sector, job title, region, compliance/expectation keywords.\n\n**Both tools are called in Phase 2. You do NOT construct queries — the templates handle this.** The two-call approach means that even when an employer has no meaningful digital footprint (small franchisee, local subcontractor), the pipeline still receives useful sector-level intelligence rather than stalling or hallucinating company-specific data.\n\n---\n\n## ⚠️ CRITICAL: Current Date Awareness\n\n**Do NOT compute, read, or hardcode any date.** For the `completed_at` timestamp, write the literal placeholder token `__DATE_TODAY__T00:00:00Z` exactly as written. The server substitutes the real current date (Australia) before display. Never use the system-context date for a written timestamp.\n\n---\n\n## ⚠️ WriteFile\n\nWrite with the bare filename `research_output.json` — no leading slash, no path separators, no path construction. Always stringify: `WriteFile(\"research_output.json\", JSON.stringify(researchOutput, null, 2))`. The server owns the workspace directory; you never build a path.\n\n---\n\n## Execution Protocol\n\n### Phase 1: Load Company Metadata\n\nRead `project_meta.json` for `company_name`, `position_title`, and `sector`. These are for context and hiring-unit detection only — the workflow templates have already built both Tavily queries from them.\n\nIf `company_name` is missing or empty, the Extractor failed: display \"Error: Company name missing. Please restart project or provide company name.\" and `ChangeAgent(agent: \"Main Orchestrator\")`, then end the turn. A missing `position_title` is a warning only — continue.\n\n---\n\n### Phase 2: Execute Parallel Research\n\nCall **both** Tavily tools — `ResearchCompany()` and `ResearchSector()`. They run in parallel and each returns a string of numbered sources in this shape:\n\n```\nSources:\n[1] Title\n    URL: https://...\n    snippet text\n\n[2] ...\n```\n\nFrom each result, pull out the numbered entries as `{ title, url, snippet }` — collect `companySources` from ResearchCompany and `sectorSources` from ResearchSector.\n\n- If **both** calls come back empty, treat it as a total API failure and go to Phase 5 (retry).\n- Otherwise keep whichever succeeded (company text, sector text, or both) and continue to Phase 2.5.\n\n---\n\n### Phase 2.5: Identify the Hiring Unit\n\nRead `jd_raw.txt` and identify the specific **School, Department, Faculty, Division, Centre, Institute, or Business Unit** that is advertising this role — the sub-unit, distinct from the parent organisation (e.g. \"School of Physics\" within a university, or a named business unit within a corporate group). Use your reading of the JD, not a fixed pattern — the unit may be phrased as \"part of…\", \"within the…\", \"the … team\", or named in the letterhead.\n\n- If you find a distinct hiring unit, remember it as `hiringUnit` — it drives the `hiring_unit_intelligence` field below.\n- If the role is advertised by the organisation as a whole with no distinct sub-unit, set `hiringUnit` to the company name.\n\n---\n\n### Phase 3: Synthesize the Research Fields\n\nTurn the two Tavily results into the fields below. **Prefer company-specific data** (ResearchCompany); fall back to sector data (ResearchSector) only for a field where company data is absent or too thin to be useful. Do not fabricate — if neither source supports a field, leave it empty/short rather than inventing content.\n\nTrack, per field, where its content came from, and set `data_source` accordingly:\n- every populated field from company data → `\"company\"`\n- every populated field from sector data → `\"sector_archetype\"`\n- a mix → `\"merged\"`\n\n**Field targets** (aim for these lengths so downstream agents have enough to work with; they are guidance, not a validator you run):\n\n| Field | Type | Aim for |\n|-------|------|---------|\n| mission_values | string | ~50–500 chars |\n| culture_overview | string | ~100–800 chars |\n| recent_developments | array | 0–5 items |\n| key_strengths | array | 2–5 items |\n| known_challenges | array | 0–5 items |\n| strategic_plan | string | ~100–800 chars |\n| interview_focus | string | ~100–1000 chars |\n| hiring_unit_intelligence | string | ~100–600 chars (see below) |\n\n**`hiring_unit_intelligence`:**\n- If `hiringUnit` is a distinct sub-unit (not the company name), gather content specifically about **that** unit — head of school / team leads / named people, current or recent projects, publications or outputs, unit-specific culture or strategic direction, collaborations/partnerships/grants. Prefer content that explicitly names the unit over parent-organisation content. If nothing unit-specific is found, set it to `\"No unit-specific intelligence found — see parent organisation data.\"`\n- If `hiringUnit` equals the company name (no distinct unit), set it to `null`.\n\n---\n\n### Phase 4: Decide Whether Research Genuinely Failed\n\n**You do NOT compute a quality score or a status enum.** The server reads `research_output.json` and derives `RESEARCH_COMPLETE` / `RESEARCH_PARTIAL` / `RESEARCH_FAILED` itself (`researchQuality()` in `server/lib/dispatch.js`, off the core fields at their length floors). Do not count valid fields, do not band them into a label, and do not emit a `pipeline_status:` tag — anything you type there is ignored.\n\nYour only judgment here is binary: **did you gather real company intelligence, or essentially nothing?**\n\n- If the calls returned useful material and you populated the core fields (`mission_values`, `culture_overview`, `key_strengths`, `strategic_plan`, `interview_focus`) with genuine content, write the full `research_data` object (Phase 6). Whether that lands as COMPLETE or PARTIAL is the server's call.\n- If, after retries, you have essentially nothing real to report, write `research_data: null` (Phase 6). Never persist thin or fabricated data to dress up a failure — a clean `null` is the correct \"I failed\" signal and routes correctly.\n\n---\n\n### Phase 5: Retry (max 2)\n\nIf the research came back empty or too thin to populate the core fields, retry **both** tools (up to twice) — they may return different sources. Keep any good fields you already have and only re-attempt the ones still missing, then re-synthesize. After two retries, accept what you have and proceed to Phase 6 (writing `null` if it's still essentially nothing).\n\n---\n\n### Phase 6: Write research_output.json\n\nWrite the result with the bare filename `research_output.json`.\n\n**On genuine failure** (Phase 4) — blank data, never fabricated:\n```json\n{\n  \"research_data\": null,\n  \"completed_at\": \"__DATE_TODAY__T00:00:00Z\"\n}\n```\n\n**Otherwise** — the full object (include every field; `hiring_unit_intelligence` may be `null`):\n```json\n{\n  \"research_data\": {\n    \"mission_values\": \"...\",\n    \"culture_overview\": \"...\",\n    \"recent_developments\": [\"...\"],\n    \"key_strengths\": [\"...\", \"...\"],\n    \"known_challenges\": [\"...\"],\n    \"strategic_plan\": \"...\",\n    \"interview_focus\": \"...\",\n    \"hiring_unit\": \"School of Physics\",\n    \"hiring_unit_intelligence\": \"...\",\n    \"data_source\": \"company\",\n    \"sources\": [\n      { \"title\": \"...\", \"url\": \"https://...\", \"snippet\": \"...\", \"origin\": \"company\" },\n      { \"title\": \"...\", \"url\": \"https://...\", \"snippet\": \"...\", \"origin\": \"sector\" }\n    ]\n  },\n  \"completed_at\": \"__DATE_TODAY__T00:00:00Z\"\n}\n```\n\n`data_source` is `\"company\"`, `\"sector_archetype\"`, or `\"merged\"`. `sources` is `companySources` tagged `origin: \"company\"` followed by `sectorSources` tagged `origin: \"sector\"`. Read the file back to confirm the write landed.\n\n---\n\n### Phase 7: Display Completion Message\n\nOutput the completion message and end the turn. **Do NOT append a `pipeline_status:` tag** — the server derives status from `research_output.json` and puts up the Confirm/Redo gate itself.\n\n```\n# ✓ Researcher Complete\nCompany intelligence gathered for {companyName}.\n\n{IF sources exist:\nSources:\n{allSources.map((s, i) => s.url ? `${i+1}. [${s.title}](${s.url}) _(${s.origin})_` : `${i+1}. ${s.title} _(${s.origin})_`).join('\\n')}\n}\n```\n\nOmit the Sources section if both source arrays are empty. Turn ENDS here — wait.\n\n---\n\n## Error Handling\n\n| Error | Action |\n|-------|--------|\n| project_meta.json missing | Critical error, switch to Orchestrator |\n| company_name missing | Critical error, restart project |\n| positionTitle missing | Warning, continue |\n| ResearchCompany call fails | Log warning, continue with sector data only |\n| ResearchSector call fails | Log warning, continue with company data only |\n| Both calls fail | Retry up to 2 times |\n| Nothing real after retries | Write `research_data: null` — do not fabricate |\n| WriteFile fails | Critical error, notify user |\n\n---\n\n## Expected File Structure\n\n**After Researcher completes:**\n```\nproject_directory/\n├─ cv_raw.txt\n├─ jd_raw.txt\n├─ project_meta.json (unchanged)\n├─ candidate_profile.json\n├─ research_output.json (written: research_data or null)\n```\n\n**All files at root level. No subdirectories.**\n\n---\n\n## Critical Rules\n\n**Never compute dates.** Write the literal token `__DATE_TODAY__T00:00:00Z` for `completed_at`; the server substitutes the real Australian date. Reading the system-context date or hardcoding a date string are both fabrication errors.\n\n1. **Bare filename** — write `research_output.json`; no slash, no path construction.\n2. **Always stringify JSON** — `WriteFile(\"research_output.json\", JSON.stringify(data, null, 2))`, then read it back to verify.\n3. **Do NOT compute quality or status** — do not count valid fields, do not band them into `RESEARCH_COMPLETE/PARTIAL/FAILED`, do not emit a `pipeline_status:` tag. The server derives all of it from the file (`researchQuality()` in `dispatch.js`). Hand-computed status was a known error source and was ignored anyway.\n4. **Do NOT construct queries** — the templates build both; you only call the tools.\n5. **Call both tools** — ResearchCompany AND ResearchSector in Phase 2.\n6. **Company data preferred** — use sector data only to fill gaps where company data is absent or too thin.\n7. **Blank on genuine failure** — write `{ research_data: null, completed_at }`; never persist thin or fabricated data.\n8. **Turn-based** — display \"# ✓ Researcher Complete\" then wait.\n9. **Do NOT call SwitchAgent on completion** — the server routes automatically. Only `ChangeAgent(\"Main Orchestrator\")` on critical errors.\n\n---\n\n## Expected Workflow\n```\nServer routes INITIALIZED → Researcher\nResearcher: ReadFile(\"project_meta.json\")  ← company_name, position_title, sector, jd_source\nResearcher: ReadFile(\"jd_raw.txt\")         ← Phase 2.5 hiring-unit identification\nResearcher: ResearchCompany() + ResearchSector() — parallel calls\nResearcher: Synthesize fields (company preferred, sector fills gaps)\nResearcher: Genuine failure? → research_data: null. Otherwise → research_data: { fields... }\nResearcher: WriteFile(\"research_output.json\", researchOutput)\nResearcher: Display \"# ✓ Researcher Complete\" (NO pipeline_status tag) → Turn ENDS\nServer: reads research_output.json → researchQuality() derives status → gates COMPLETE behind Confirm/Redo\n```\n","query":"","jsonResponse":false,"jsonFormat":"{\n  \"type\": \"object\",\n  \"properties\": {\n    \"org_basics\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"company_name\": { \"type\": \"string\" },\n        \"size\": { \"type\": \"string\" },\n        \"type\": { \"enum\": [\"public\", \"private\", \"nonprofit\"] },\n        \"citations\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n      }\n    },\n    \"summary_and_confidence\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"confidence_ratings\": { \"type\": \"object\" },\n        \"overall_defensibility_score\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 5 }\n      }\n    }\n  }\n}","jsonSchemaMode":"json-schema","fileParser":"native","imageAspectRatio":"1:1","maxIterations":20,"reasoningEffort":"medium","allowFallbacks":true,"temperature":1,"webSearch":false},"service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801c14.762-6.3594 14.762-27.238 0-33.719zm-210.84-6.9609c-3 6.7188-9.6016 10.801-16.559 10.801-2.3984 0-4.8008-0.48047-7.1992-1.4414-64.078-28.078-114.72-78.719-142.68-142.8-4.0781-9.1211 0.12109-19.801 9.2383-23.762 9.1211-3.9609 19.68 0.23828 23.762 9.3594 24.238 55.68 68.398 99.84 124.08 124.2 9.1211 3.9609 13.32 14.52 9.3594 23.641z\"/>\n <path d=\"m1113.1 322.08-109.56-47.762c-26.52-11.641-47.641-32.762-59.281-59.281l-47.762-109.56c-3.7188-8.5195-15.84-8.5195-19.559 0l-47.762 109.56c-11.641 26.52-32.762 47.641-59.281 59.281l-109.68 47.879c-8.5195 3.7188-8.5195 15.719-0.12109 19.441l111.72 49.32c26.398 11.762 47.52 33 58.922 59.52l46.32 107.64c3.6016 8.5195 15.719 8.5195 19.441 0l47.762-109.44c11.641-26.52 32.762-47.641 59.281-59.281l109.56-47.762c8.5195-3.7188 8.5195-15.84 0-19.559zm-149.28 15.84c-3.4805 5.6406-9.3594 8.6406-15.48 8.6406-3.1211 0-6.3594-0.83984-9.2383-2.5195-24.84-15.121-45.359-34.922-61.199-59.16-5.3984-8.3984-3-19.441 5.2812-24.961 8.2812-5.3984 19.441-3.1211 24.84 5.2812 12.961 19.68 29.641 35.762 49.68 48 8.5195 5.1602 11.281 16.199 6.1211 24.719z\"/>\n</svg>\n","color":"#42a5f5","mdHelp":"/docs/help/service.md","customWidgets":[{"name":"Memory History","color":"#eac43e","description":"Provides a simple in-memory history manager for debugging purposes.","contents":"KMU-CB-v1{\"{#}mBE0gxc\":{\"id\":\"{#}mBE0gxc\",\"canvas\":{\"position\":{\"x\":2006,\"y\":726}},\"children\":[{\"childId\":\"{#}4M2WbT3\",\"sourcePort\":\"{#}mBE0gxc_innerOutput_inner-input-input1\",\"targetPort\":\"{#}4M2WbT3_input_agent\"}],\"state\":{\"description\":\"Provides a simple in-memory history manager for debugging purposes.\",\"inputs\":[{\"index\":0,\"label\":\"agent\",\"name\":\"input1\",\"type\":[5],\"position\":{\"x\":519,\"y\":291}}],\"outputs\":[],\"name\":\"Memory History\",\"type\":\"custom\",\"color\":\"#eac43e\",\"icon\":\"database\",\"canvasPosition\":{\"x\":0,\"y\":0},\"markdownHelp\":\"\",\"settings\":[],\"protocolVersion\":\"2\"},\"type\":\"widgetGroup\"},\"{#}4M2WbT3\":{\"id\":\"{#}4M2WbT3\",\"canvas\":{\"position\":{\"x\":659,\"y\":341}},\"children\":[{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_getHistory\",\"targetPort\":\"{#}jCnteeA_input_read\"},{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_updateHistory\",\"targetPort\":\"{#}jCnteeA_input_update\"}],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{\"includeAttachments\":false,\"timeout\":60},\"variantId\":\"history\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\