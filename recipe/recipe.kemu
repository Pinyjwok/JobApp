ren":[{"childId":"{#}5mBu9nI","sourcePort":"{#}L1Vk7Vp_output_arguments","targetPort":"{#}5mBu9nI_input_in"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"name":"ChangeAgent","description":"Use it to switch the target agent that will receive future user commands. After you trigger this tool, let the user know they are now talking with the requested agent (by name, e.g., “You’re now talking to the Research agent”).","arguments":[{"name":"agent","description":"The agent to transfer control to. MUST be one of these EXACT names (case-sensitive):\n\nMain Pipeline: 'Main Orchestrator', 'ProjectSetup', 'Extractor', 'Researcher', 'JD Enhancer', 'Analyst', 'Reviewer', 'Tone Analyst', 'Assembly Coordinator'\n\nCV Assembly: 'Style Negotiator', 'Profile Builder', 'Skills Curator', 'History Formatter', 'Credentials Formatter', 'Cover Letter Writer', 'Style Reviewer', 'Integrity Checker', 'Document Formatter', 'Validator'\n\nINVALID (do not use): 'Constructor', 'Interviewer', 'Research', 'Orchestrator' (use 'Main Orchestrator')","dataType":"String","typeDefinition":"","typeDefinitionMode":"typescript","required":true}],"timeout":0},"variantId":"tool","service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801