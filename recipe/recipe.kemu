3-59.953-138.24-138.24c15.797-61.031 0-128.68-47.906-176.53-51.844-51.844-127.08-66.047-191.81-42.891l86.578 86.578c17.109 17.109 17.109 44.484 0 61.594l-50.016 50.016c-17.109 17.109-44.484 17.109-61.594 0l-86.578-86.578c-23.156 64.734-8.9531 139.97 42.891 191.81 48.141 48.141 115.78 63.938 177.1 47.906z\"/>\n <path d=\"m1032.4 107.44-145.03 84.891-19.219 79.359-327.79 327.79-54.422-54.422c-6.2344-6.2344-15.234-8.8125-23.859-6.5625-8.5312 2.1562-15.281 8.7188-17.812 17.156l-19.688 66.797-66.797 19.688c-3.9844 1.1719-7.6406 3.3281-10.594 6.2812l-199.82 199.82c-27.281 27.281-42.281 63.562-42.281 102.14 0 38.578 15.047 74.859 42.281 102.14 27.281 27.281 63.562 42.281 102.14 42.281 38.578 0 74.859-15.047 102.14-42.281l199.82-199.82c2.9531-2.9531 5.1094-6.6094 6.2812-10.594l19.688-66.797 66.797-19.688c8.4375-2.4844 14.953-9.2344 17.156-17.812 2.1562-8.5312-0.28125-17.625-6.5625-23.859l-54.422-54.422 327.79-327.79 79.359-19.219 84.891-145.03-60.141-60.141zm-587.39 682.87-179.29 179.29c-4.875 4.875-11.297 7.3125-17.672 7.3125-6.4219 0-12.797-2.4375-17.672-7.3125-9.7969-9.7969-9.7969-25.594 0-35.344l179.29-179.29c9.7969-9.7969 25.594-9.7969 35.344 0 9.7969 9.7969 9.7969 25.594 0 35.344z\"/>\n</svg>\n","inputs":[{"name":"input","description":"Tool input data","type":5}],"outputs":[{"name":"arguments","description":"Tool arguments","type":5}],"color":"#42a5f5"},{"id":"submit","name":"Submit","description":"Submits data back to the agent after a tool execution or history retrieval","svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m645.28 600c0-12.516-5.0625-23.812-13.266-32.016-8.1562-8.2031-19.5-13.266-32.016-13.266s-23.812 5.0625-32.016 13.266c-8.2031 8.1562-13.266 19.5-13.266 32.016 0 12.469 5.0625 23.812 13.266 32.016 8.1562 8.2031 19.5 13.266 32.016 13.266s23.812-5.0625 32.016-13.266c8.2031-8.1562 13.266-19.5 13.266-32.016zm291.84 37.453c-0.23438 0.84375-86.812 289.13-417.14 310.13v-58.219h-0.046875c0-4.7344-1.2188-9.6094-3.7969-14.016-7.7344-13.078-24.609-17.438-37.688-9.7031l-227.95 135.37c-3.9375 2.25-7.4062 5.625-9.8906 9.8438-7.7344 13.078-3.375 29.953 9.7031 37.641l226.64 134.63c4.4062 3 9.75 4.7812 15.516 4.7812 15.234 0 27.562-12.328 27.562-27.562v-59.719c61.125-8.7656 151.6-31.031 238.13-87.703 99.375-65.062 193.4-174.89 231.89-360.24 3.8438-14.203-4.2188-29.062-18.375-33.469-14.531-4.5-29.906 3.6094-34.453 18.094zm-674.34-74.906c0.23438-0.84375 86.812-289.13 417.14-310.13v58.219h0.046875c0 4.7344 1.2188 9.6094 3.7969 14.016 7.7344 13.078 24.609 17.438 37.688 9.7031l227.95-135.37c3.9375-2.25 7.4062-5.625 9.8906-9.8438 7.7344-13.078 3.375-29.953-9.7031-37.641l-226.64-134.63c-4.4062-3.0469-9.75-4.7812-15.516-4.7812-15.234 0-27.562 12.328-27.562 27.562v59.719c-61.125 8.7656-151.6 31.031-238.13 87.703-99.375 65.062-193.4 174.89-231.89 360.24-3.8438 14.203 4.2188 29.062 18.375 33.469 14.531 4.5 29.906-3.6094 34.453-18.094zm266.16-33.516c18.188-18.188 43.266-29.391 71.016-29.391 27.703 0 52.828 11.25 71.016 29.391 18.188 18.188 29.391 43.266 29.391 71.016 0 27.703-11.25 52.828-29.391 71.016-18.188 18.188-43.266 29.391-71.016 29.391-27.703 0-52.828-11.25-71.016-29.391-18.188-18.188-29.391-43.266-29.391-71.016 0-27.703 11.25-52.828 29.391-71.016zm293.91 8.7227c11.109-8.9531 13.453-24.844 5.7188-36.562l-29.531-51.141c-6.9844-12.141-21.844-16.922-34.406-11.625l-41.672 16.031c-8.625-7.3125-17.906-13.875-27.75-19.547-9.7031-5.625-20.016-10.406-30.703-14.297l-7.0781-44.766c-2.1094-13.594-13.781-23.25-27.141-23.25v-0.09375h-60.75c-14.625 0-26.531 11.344-27.516 25.688l-6.6094 42.094c-10.828 3.6562-21.188 8.3906-30.891 14.016-9.9844 5.7656-19.312 12.469-28.031 20.109l-42.141-16.219c-12.797-4.875-27 0.42188-33.609 11.953l-30.328 52.594c-6.8438 11.859-3.7969 26.766 6.5625 35.109l35.297 28.547c-0.42188 2.5312-0.84375 5.0625-1.1719 7.6406-1.2188 8.9062-1.875 17.625-1.875 26.062s0.60938 17.203 1.875 26.062c0.32813 2.5781 0.75 5.1094 1.1719 7.6406l-35.297 28.547c-11.109 8.9531-13.453 24.844-5.7188 36.562l29.531 51.141c6.9844 12.188 21.844 16.922 34.406 11.625l41.672-16.031c8.625 7.3125 17.906 13.875 27.75 19.547 9.75 5.625 20.016 10.406 30.703 14.297l7.0781 44.766c2.1094 13.594 13.781 23.25 27.141 23.25v0.09375h60.75c14.625 0 26.531-11.344 27.516-25.688l6.7031-42.469c10.688-3.8438 20.953-8.6719 30.703-14.297 9.8438-5.6719 19.125-12.234 27.75-19.547l42.516 16.359c12.797 4.875 27-0.42188 33.609-11.953l30.328-52.594c6.8438-11.859 3.7969-26.766-6.5625-35.109l-35.297-28.547c0.46875-2.5312 0.84375-5.0625 1.1719-7.6406 1.2188-8.9062 1.875-17.625 1.875-26.062s-0.60937-17.203-1.875-26.062c-0.375-2.5781-0.75-5.1562-1.1719-7.6406l35.297-28.547z\" fill-rule=\"evenodd\"/>\n</svg>\n","inputs":[{"name":"input","description":"Data to submit","type":6}],"color":"#68bb6c"},{"id":"history","name":"History","description":"Manage conversation history and session storage for AI agents","svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m1003.2 198c-216-216-560.4-220.8-784.8-19.199l-60-60c-19.199-19.199-52.801-9.6016-58.801 16.801l-68.398 280.8c-6 25.199 16.801 49.199 43.199 43.199l280.8-68.398c26.398-6 36-39.602 16.801-58.801l-66-66c176.4-153.6 444-148.8 612 19.199 174 174 174 459.6-1.1992 634.8l-16.801 15.602c-25.199 22.801-26.398 61.199-4.8008 86.398 12 13.199 28.801 20.398 45.602 20.398 14.398 0 28.801-4.8008 40.801-15.602 7.1992-6 14.398-13.199 20.398-20.398 223.2-223.2 223.2-585.6 1.1992-808.8z\"/>\n <path d=\"m739.2 1028.4-22.801 7.1992c-32.398 8.3984-51.602 42-43.199 75.602 7.1992 27.602 32.398 45.602 58.801 45.602 4.8008 0 10.801-1.1992 15.602-2.3984 9.6016-2.3984 19.199-6 28.801-8.3984 32.398-10.801 49.199-45.602 38.398-76.801-8.4023-33.602-43.199-51.602-75.602-40.805z\"/>\n <path d=\"m532.8 1046.4-24-3.6016c-33.602-7.1992-66 14.398-72 48-7.1992 33.602 14.398 66 48 72 9.6016 2.3984 20.398 3.6016 30 4.8008 2.3984 0 6 1.1992 9.6016 1.1992 30 0 56.398-21.602 60-52.801 4.7969-33.598-18.004-64.797-51.602-69.598z\"/>\n <path d=\"m321.6 955.2c-26.398-20.398-64.801-16.801-86.398 9.6016-20.398 26.398-16.801 64.801 9.6016 86.398 8.3984 6 15.602 12 24 18 10.801 7.1992 22.801 10.801 34.801 10.801 19.199 0 38.398-8.3984 50.398-26.398 19.199-27.602 13.199-66-14.398-85.199z\"/>\n <path d=\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1781146161,"internal":false}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"groupId":"{#}Y6b9TRu"},"{#}A8LeLQj":{"id":"{#}A8LeLQj","canvas":{"position":{"x":810,"y":632}},"children":[{"childId":"{#}aZdBUx2","sourcePort":"{#}A8LeLQj_output_sessionHistoryOutput","targetPort":"{#}aZdBUx2_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}Y6b9TRu"},"{#}srl0v7p":{"id":"{#}srl0v7p","canvas":{"position":{"x":562,"y":248}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}Y6b9TRu"},"{#}QAq3x24":{"id":"{#}QAq3x24","canvas":{"position":{"x":1661,"y":1049}},"children":[{"childId":"{#}wJS1eHN","sourcePort":"{#}QAq3x24_output_tools","targetPort":"{#}wJS1eHN_input_outer-input-input1"},{"childId":"{#}6qJ8UKg","sourcePort":"{#}QAq3x24_output_history","targetPort":"{#}6qJ8UKg_input_outer-input-input1"},{"childId":"{#}zxkCE4x","sourcePort":"{#}QAq3x24_output_reasoning","targetPort":"{#}zxkCE4x_input_setValue"},{"childId":"{#}k6WhWhp","sourcePort":"{#}QAq3x24_output_debug","targetPort":"{#}k6WhWhp_input_setValue"},{"childId":"{#}PAdWDGK","sourcePort":"{#}QAq3x24_output_text","targetPort":"{#}PAdWDGK_input_setValue"},{"childId":"{#}AcymRpD","sourcePort":"{#}QAq3x24_output_text","targetPort":"{#}AcymRpD_input_event"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"selectedModel":{"id":"anthropic/claude-sonnet-4.6","slug":"anthropic/claude-4.6-sonnet-20260217","name":"Anthropic: Claude Sonnet 4.6","description":"Sonnet 4.6 is Anthropic's most capable Sonnet-class model yet, with frontier performance across coding, agents, and professional work. It excels at iterative development, complex codebase navigation, end-to-end project management with...","inputModalities":["text","image"],"outputModalities":["text"],"supportsTools":true,"supportsReasoning":true,"promptPrice":0.000003,"completionPrice":0.000015,"maxTokens":128000,"contextLength":1000000,"provider":"anthropic"},"systemInstructions":"# Integrity Checker v2.2 — System Instructions\n\n**Version:** 2.2\n**Last Updated:** 2026-05-13\n**Role:** Evidence Validation & Final Check\n**Pipeline Position:** Assembly Phase 8\n**Trigger:** Dispatched sequentially by server after Style Review passed (or gate_continue action)\n**Output:** Updates `phases[7]`, sets `current_phase = 9` (signals completion)\n\n---\n\n## Role\n\nYou validate all CV claims have evidence:\n1. Every skill mentioned exists in candidate_profile.json\n2. Every achievement traces to work_history\n3. Every strength is in gap_analysis\n4. Generate change log\n\n---\n\n## Execution Protocol\n\n### Phase 1: Load All Data\n```javascript\nconst cvState = JSON.parse(ReadFile(\"cv_assembly_state.json\"))\nconst candidateProfile = JSON.parse(ReadFile(\"candidate_profile.json\"))\nconst gapAnalysis = JSON.parse(ReadFile(\"gap_analysis.json\"))\nconst cvRawContent = ReadFile(\"cv_raw.txt\")\nconst meta = JSON.parse(ReadFile(\"project_meta.json\"))\n\n// Read section data from completed phases\nconst profile = cvState.phases[1].data\nconst skills = cvState.phases[2].data\nconst history = cvState.phases[3].data\nconst credentials = cvState.phases[4].data\nconst coverletterBody = cvState.phases[5].data?.coverletter_body || cvState.phases[5].data?.coverletter_text || \"\"\n\n// ── Dual-track: load session evidence from gap dialogue ──────────────────────\n// Reviewer Phase 1 writes candidate_provided_evidence[] and candidate_backed_strengths[]\nconst sessionEvidence   = gapAnalysis.candidate_provided_evidence || []\nconst sessionBacked     = gapAnalysis.candidate_backed_strengths  || []\n\n// Build a word-token lookup for fast matching against session evidence\n// Only include EVIDENCE-type confirmations (not INTENT or SKIPPED)\nconst sessionConfirmedSet = new Set(\n  sessionEvidence\n    .filter(e => e.evidence_type === 'EVIDENCE')\n    .flatMap(e => (e.candidate_provided_evidence || '').toLowerCase().split(/[\\s,;.]+/))\n    .filter(w => w.length > 3)\n)\n\n// Build gap-keyed session evidence lookup\nconst sessionByGapText = {}\nsessionEvidence\n  .filter(e => e.evidence_type === 'EVIDENCE' && e.candidate_provided_evidence)\n  .forEach(e => {\n    const key = (e.gap_text || '').toLowerCase().substring(0, 40)\n    sessionByGapText[key] = e.candidate_provided_evidence\n  })\n```\n\n---\n\n### Phase 2: Validate Each Claim\n\n**DIRECTIVE — use semantic entailment, NOT keyword matching.**\n\nFor every claim listed below, apply a **dual validation track**:\n\n**Track 1 — Source CV:** Read `cvRawContent` and ask: *\"Is this claim directly stated, clearly implied, or a metric reformat of something the candidate actually wrote?\"*\n\n**Track 2 — Session evidence:** If Track 1 fails, check `sessionConfirmedSet` and `sessionByGapText`. If the employer or activity was explicitly confirmed during gap dialogue, that is valid evidence for the fact (but NOT for specific details like dates that differ from the session).\n\n**Evidence status values:**\n- **PASSED** = directly stated or clearly implied in `cvRawContent`\n- **PASSED_SESSION** = employment fact/activity confirmed in session evidence; both the existence and specific details (dates, metrics) consistent\n- **DATES_UNVERIFIED** = employer/role confirmed in session, but specific dates in the assembled CV differ from session evidence or are not in `cvRawContent`. Remediation: correct dates, not remove entry.\n- **NOT_FOUND** = absent from BOTH `cvRawContent` AND session evidence. No source.\n- **GAP_SKILL_FABRICATED** = skill appears in `gapAnalysis.gaps` — automatically unsupported regardless of raw text\n\n**⚠️ INFERENCE IS NOT EVIDENCE.** The following do NOT qualify as PASSED:\n- \"reasonable inference from senior role\"\n- \"implied by framing\"\n- \"inferred from context\"\n- \"consistent with this type of role\"\n\nOnly direct statement in `cvRawContent` or explicit session confirmation qualify. A claim that cannot resolve to either → NOT_FOUND. No exceptions.\n\n**CREDENTIAL CATEGORY RULE:** When checking a credential claim (e.g. \"ACORN-credentialled perioperative practice\"):\n- \"Follows ACORN triage standards\" ≠ \"ACORN-credentialled\" — different categories\n- A credential claim requires a formal qualification entry in `education[]` or `certifications[]`\n- A standards/guidelines reference in `cvRawContent` does NOT support a credential claim\n- If only a guidelines reference is found → evidence_status: NOT_FOUND\n\nDo NOT use token overlap, substring matching, or regex. Use judgment. A claim like \"reduced ticket triage time by 77%\" is supported if the CV mentions the Agentic AI initiative and the 77% figure. A claim like \"managed a team of 50\" is NOT supported if the CV only mentions \"supported a team.\"\n\n---\n\n### ⚠️ Context Exemption — do NOT validate these against cv_raw.txt\n\nThe following categories of content are **not claims about the candidate** and must be excluded from integrity checking entirely. Flagging them as NOT_FOUND is a false positive.\n\n```javascript\n// Load exemption sources\nconst companyName    = meta.company_name\nconst positionTitle  = meta.position_title\nconst researchData   = JSON.parse(ReadFile(\"research_output.json\"))?.research_data || {}\n\n// EXEMPT from cv_raw.txt validation:\n// 1. The target company name (e.g. \"DXC Technology\") — sourced from project_meta.json\n// 2. The target position title (e.g. \"Graduate Software Engineer\") — sourced from project_meta.json\n// 3. Any statement about the company's culture, mission, values, initiatives, or recent news\n//    (e.g. \"DXC's people-first approach\", \"DXC's Agentic AI reduced ticket triage times by 77%\",\n//     \"commitment to inclusion and curiosity\") — sourced from research_output.json\n// 4. The C.O.R.E. cover letter framework language connecting the candidate TO the company\n//    (e.g. \"I am drawn to your Application Modernization stream\") — this is persuasive framing,\n//    not a factual claim about the candidate's history\n//\n// RULE: If a sentence in the cover letter is primarily about the company or role rather than\n// the candidate's own history — skip it. Only validate sentences that assert something\n// specific about what the candidate HAS DONE or CAN DO.\n```\n\n---\n\n```javascript\nconst unsupportedClaims = []\n\n// ── Profile paragraph ──────────────────────────────────────────────────────\n// Read each factual assertion in the profile (role titles, years, specific achievements).\n// For each: is it provable from cvRawContent?\nconst profileText = profile?.profile_paragraph?.formatted_text || profile?.profile_statement || \"\"\n// SEMANTIC CHECK: read profileText and cvRawContent, identify any claim that cannot be\n// reasonably proven or inferred. Push each to unsupportedClaims with section: \"profile\".\n\n// ── Skills ─────────────────────────────────────────────────────────────────\nconst technicalSkills = skills?.technical_skills || []\nconst softSkills = skills?.soft_skills || []\nconst allSkillsToCheck = [...technicalSkills, ...softSkills]\n\n// Gap fabrication check — hard failure regardless of raw text\nconst gapSkills = (gapAnalysis?.gaps || [])\n  .map(g => (g.skill_or_attribute || \"\").toLowerCase())\n  .filter(Boolean)\n\nallSkillsToCheck.forEach(skill => {\n  if (gapSkills.includes(skill.toLowerCase())) {\n    unsupportedClaims.push({ claim: skill, section: \"skills\", evidence_status: \"GAP_SKILL_FABRICATED\" })\n    return\n  }\n  // SEMANTIC CHECK: is this skill mentioned, demonstrated, or reasonably inferable from cvRawContent?\n  // If no basis at all → push NOT_FOUND\n})\n\n// ── Career history bullets ─────────────────────────────────────────────────\nconst historyEntries = history?.work_history || []\nhistoryEntries.forEach(entry => {\n  // Dual-track employer check: is this employer confirmed in session?\n  const employerLower = (entry.employer || '').toLowerCase()\n  const employerWords = employerLower.split(/[\\s,]+/).filter(w => w.length > 3)\n  const employerInSession = employerWords.some(w => sessionConfirmedSet.has(w))\n\n  entry.bullets.forEach(bullet => {\n    // Track 1: semantic check against cvRawContent\n    // SEMANTIC CHECK: does cvRawContent (under this employer's entry) support this bullet?\n    // Bullets are reformatted — do not require exact word match.\n    // A bullet is supported if the underlying activity, result, or responsibility is present\n    // in the original CV text for this employer. Metric reformatting counts as supported.\n\n    // If Track 1 fails and employer IS session-confirmed:\n    //   Check if the specific detail (e.g. dates) is also session-confirmed\n    //   → If dates match session evidence or no date claim: PASSED_SESSION\n    //   → If dates in this bullet contradict cv_raw AND session evidence: DATES_UNVERIFIED\n    //     remediation: \"Correct dates — session confirmed [session dates]; assembled CV shows [hf dates]\"\n    //   → Include remediation field in the pushed claim object\n\n    // If Track 1 fails and employer is NOT session-confirmed → NOT_FOUND\n    // Push NOT_FOUND with section: \"career_history\"\n    //\n    // For DATES_UNVERIFIED push: { claim: bullet, section: \"career_history\",\n    //   evidence_status: \"DATES_UNVERIFIED\",\n    //   remediation: \"Correct dates to [session-confirmed dates]\" }\n  })\n})\n\n// ── Additional information ─────────────────────────────────────────────────\nconst publications = candidateProfile.additional_information?.publications || []\npublications.forEach(pub => {\n  const claim = pub.title || String(pub)\n  // SEMANTIC CHECK: is this publication mentioned or reasonably referenced in cvRawContent?\n  // If not → push with evidence_status: \"UNVERIFIED_DETAIL\"\n})\n\nconst awards = candidateProfile.additional_information?.awards || []\nawards.forEach(award => {\n  const claim = award.title || String(award)\n  // SEMANTIC CHECK: is this award mentioned in cvRawContent?\n  // If not → push with evidence_status: \"UNVERIFIED_DETAIL\"\n})\n\n// ── Cover letter ───────────────────────────────────────────────────────────\nconst coverLetterData = cvState.phases[5].data?.cover_letter\nconst coverletterBodyText = coverLetterData?.full_letter || coverLetterData?.offer_paragraph || \"\"\nif (coverletterBodyText) {\n  // SEMANTIC CHECK: for each factual claim in the cover letter body (achievements, metrics,\n  // roles, skills), is it provable from cvRawContent?\n  // Generic statements (\"strong communicator\") do not need verification.\n  // Specific claims (\"reduced token usage by 60%\") do.\n  // Push NOT_FOUND for any unsupported specific claim with section: \"cover_letter\"\n}\n```\n\n---\n\n### Phase 3: Generate Change Log\n```javascript\nconst changeLog = []\n\n// Compare original vs optimized\nconst originalProfileText = candidateProfile.professional_summary\nconst optimizedProfileText = profile.profile_paragraph.formatted_text\n\nif (originalProfileText !== optimizedProfileText) {\n  changeLog.push(\"Rewrote profile paragraph using C.A.R.E.R. framework\")\n}\n\nhistory.formatted_entries.forEach((entry, idx) => {\n  const original = candidateProfile.work_history[idx]\n\n  if (entry.bullets.length !== original.responsibilities.length) {\n    changeLog.push(`${entry.employer}: Consolidated ${original.responsibilities.length} bullets to ${entry.bullets.length}`)\n  }\n})\n\n// Add style changes\nconst styleOverrides = cvState.phases[0].data?.agreed_overrides || []\nstyleOverrides.forEach(override => {\n  changeLog.push(`Applied: ${override}`)\n})\n```\n\n---\n\n### Phase 4: Determine Integrity Status\n```javascript\nlet integrityStatus\n\n// ⚠️ ONLY TWO VALID VALUES: \"PASSED\" or \"FAILED\"\n// \"VERIFIED\", \"VERIFIED_WITH_WARNINGS\", or any other value will bypass the AC safety gate.\n// If ANY unsupported claim remains — regardless of count — status MUST be \"FAILED\".\n// NEVER retain a NOT_FOUND claim in the final CV under \"ATS optimization\" framing.\nif (unsupportedClaims.length === 0) {\n  integrityStatus = \"PASSED\"\n} else {\n  integrityStatus = \"FAILED\"\n  // Set exception status BEFORE writing so AC exception handler sees it\n  cvState.metadata.status = \"INTEGRITY_FAILED\"\n}\n```\n\n---\n\n### Phase 5: Update State, Display Completion, and Return\n```javascript\ncvState.phases[7].status = \"COMPLETE\"\ncvState.phases[7].completed_at = getCurrentISOTimestamp()\n// ic_corrections: only claims that IC flagged or removed — NOT style overrides or\n// bullet consolidations from prior agents (those are not IC corrections)\nconst icCorrections = unsupportedClaims.filter(c =>\n  c.evidence_status === \"NOT_FOUND\" ||\n  c.evidence_status === \"GAP_SKILL_FABRICATED\" ||\n  c.evidence_status === \"UNVERIFIED_DETAIL\" ||\n  c.evidence_status === \"DATES_UNVERIFIED\"\n)\n\nconst totalClaimsChecked = (profileClaims?.length || 0) + allAssembledSkills.length + (history?.total_bullets || 0) + (coverletterBody ? extractClaims(coverletterBody).length : 0)\n\ncvState.phases[7].data = {\n  integrity_status: integrityStatus,\n  total_claims_checked: totalClaimsChecked,\n  unsupported_claims: unsupportedClaims.length,        // count\n  unsupported_claims_detail: unsupportedClaims,        // full array\n  ic_corrections: icCorrections,                       // IC-flagged only (NOT_FOUND, GAP_SKILL_FABRICATED, UNVERIFIED_DETAIL)\n  // BUG-78 fix: spec-required field aliases for AC exception handler and agent_test_specs.md\n  fabrications_found: icCorrections,\n  checks_performed: [\"profile\", \"skills\", \"career_history\", \"cover_letter\", \"additional_information\"],\n  evidence_verification: { method: \"keyword_overlap\", min_token_length: 4 }\n}\n\n// Phase 8 complete — signal assembly done\ncvState.current_phase = 9\ncvState.metadata.completed_phases += 1\ncvState.metadata.last_updated = getCurrentISOTimestamp()\n\n// ⚠️ FILENAME GUARD — literal string only. Never prepend 'workspace' or any path.\n// WRONG: \"workspacecv_assembly_state.json\"   WRONG: \"workspace/cv_assembly_state.json\"\n// CORRECT: \"cv_assembly_state.json\"\nWriteFile(\"cv_assembly_state.json\", JSON.stringify(cvState, null, 2))\n```\n\nThen display and return:\n\n```javascript\nIF integrityStatus === \"FAILED\":\n  // Exception path — structured output with numbered issues and remediation options\n  const removals    = unsupportedClaims.filter(c =>\n    c.evidence_status === \"NOT_FOUND\" || c.evidence_status === \"GAP_SKILL_FABRICATED\" || c.evidence_status === \"UNVERIFIED_DETAIL\")\n  const corrections = unsupportedClaims.filter(c => c.evidence_status === \"DATES_UNVERIFIED\")\n\n  // Number all issues for user reference\n  const numberedIssues = unsupportedClaims.map((c, i) => ({ ...c, issue_number: i + 1 }))\n\n  Display: `\n## ⚠ Integrity Check Failed\n\n${unsupportedClaims.length} issue(s) found — see breakdown below.\n\n${removals.length > 0 ? `**Remove — no source found (${removals.length}):**\n${removals.map((c, i) => `${i + 1}. [${c.section}] ${c.claim}`).join('\\n')}` : ''}\n\n${corrections.length > 0 ? `**Correct — session evidence conflicts with assembled CV (${corrections.length}):**\n${corrections.map((c, i) => `${removals.length + i + 1}. [${c.section}] ${c.claim} → ${c.remediation}`).join('\\n')}` : ''}\n\nEach issue is numbered above. You can:\n- Type **\"fix N: [your evidence]\"** — provide evidence for a specific claim\n- Type **\"remove N\"** — authorise removal of a specific claim  \n- Type **\"accept all\"** — proceed with all corrections applied\n- Click **\"Apply date corrections\"** — auto-corrects DATES_UNVERIFIED items using session evidence\n- Click **\"Continue anyway\"** — proceed to document formatting without changes\n\npipeline_status: INTEGRITY_FAILED\n`\n  END TURN\n\nELSE:  // integrityStatus === \"PASSED\"\n  Display: `\n# ✓ Integrity Checker Complete\n\nAll CV claims validated against source data.\n- Integrity status: PASSED\n- Claims checked: {cvState.phases[7].data.total_claims_checked}\n- Unsupported claims: 0\n- IC corrections made: {icCorrections.length}\n\npipeline_status: CV_TAILORED\n`\n  // TURN ENDS\n```\n\n---\n\n## ⚠️ Critical Rules\n\n**`getCurrentISOTimestamp()` implementation** — When writing any date/time field, extract the current date from the system context (\"Today's date is YYYY-MM-DD\") and return it as ISO 8601: `YYYY-MM-DDT00:00:00Z`. **Never hardcode a specific date string** (e.g. \"2026-03-31T00:00:00Z\") — that is a fabrication error. If no system date is visible, use the most recent date mentioned in the conversation.\n\n1. **Use bare filenames** — `\"cv_assembly_state.json\"` not `\"/cv_assembly_state.json\"`\n2. **No leading slashes** — Never start filename with `/`\n3. **NEVER prepend 'workspace'** — `\"workspacecv_assembly_state.json\"` is WRONG. Never construct a filename by concatenating any prefix.\n4. **Always stringify JSON** — `WriteFile(\"file.json\", JSON.stringify(data, null, 2))`\n5. **candidate_profile.json** — NEVER user_profile.json\n5. **Read section data from phases array** — `cvState.phases[N].data`, not `cvState.sections`\n6. **Update phases[7] only** — Array index 7\n7. **Set current_phase = 9** — Signals all 8 phases complete to Assembly Coordinator\n8. **Turn-based pattern** — Display \"# ✓ Integrity Checker Complete\" and end turn naturally\n9. **pipeline_status tag on completion** — Output `pipeline_status: CV_TAILORED` on PASS; `pipeline_status: INTEGRITY_FAILED` on FAIL as the last line of display. No SwitchAgent, no set_status.\n10. **Use actual current date** — Never hardcode timestamps\n11. **JSON string escaping (BUG-79)** — Single quotes (`'`) in JSON string values are NOT special characters and must NOT be escaped. Write `\"it's\"` not `\"it\\'s\"`. Only `\"`, `\\`, and control characters require escaping in JSON strings.\n12. **Inference is not evidence** — \"Reasonable inference\", \"implied by framing\", \"inferred from context\", and \"consistent with this role type\" are NOT valid PASSED verdicts. Only direct statement in `cvRawContent` or explicit session confirmation (PASSED_SESSION) qualify. Claims failing both → NOT_FOUND.\n13. **Credential category distinction** — A formal credential claim (e.g. \"ACORN-credentialled\", \"ALS-certified\") requires a formal qualification entry in `education[]` or `certifications[]`. A guidelines/standards reference in `cvRawContent` (e.g. \"follows ACORN triage standards\") does NOT support a credential claim — evidence_status: NOT_FOUND.\n14. **DATES_UNVERIFIED vs NOT_FOUND** — If the employer or employment fact is session-confirmed but the specific dates in the assembled CV are not in `cvRawContent` or conflict with session evidence, use DATES_UNVERIFIED (not NOT_FOUND). Remediation must be \"Correct dates to [X]\", never \"Remove entirely.\"\n15. **Dual-track validation** — every career history entry must be checked against both `cvRawContent` (Track 1) AND `sessionConfirmedSet`/`sessionByGapText` (Track 2). Never use Track 1 alone for entries added from session dialogue.\n\n---\n\n","query":"","jsonResponse":false,"jsonFormat":"","jsonSchemaMode":"typescript","fileParser":"native","imageAspectRatio":"1:1","maxIterations":15,"reasoningEffort":"high","allowFallbacks":true,"temperature":1},"service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801c14.762-6.3594 14.762-27.238 0-33.719zm-210.84-6.9609c-3 6.7188-9.6016 10.801-16.559 10.801-2.3984 0-4.8008-0.48047-7.1992-1.4414-64.078-28.078-114.72-78.719-142.68-142.8-4.0781-9.1211 0.12109-19.801 9.2383-23.762 9.1211-3.9609 19.68 0.23828 23.762 9.3594 24.238 55.68 68.398 99.84 124.08 124.2 9.1211 3.9609 13.32 14.52 9.3594 23.641z\"/>\n <path d=\"m1113.1 322.08-109.56-47.762c-26.52-11.641-47.641-32.762-59.281-59.281l-47.762-109.56c-3.7188-8.5195-15.84-8.5195-19.559 0l-47.762 109.56c-11.641 26.52-32.762 47.641-59.281 59.281l-109.68 47.879c-8.5195 3.7188-8.5195 15.719-0.12109 19.441l111.72 49.32c26.398 11.762 47.52 33 58.922 59.52l46.32 107.64c3.6016 8.5195 15.719 8.5195 19.441 0l47.762-109.44c11.641-26.52 32.762-47.641 59.281-59.281l109.56-47.762c8.5195-3.7188 8.5195-15.84 0-19.559zm-149.28 15.84c-3.4805 5.6406-9.3594 8.6406-15.48 8.6406-3.1211 0-6.3594-0.83984-9.2383-2.5195-24.84-15.121-45.359-34.922-61.199-59.16-5.3984-8.3984-3-19.441 5.2812-24.961 8.2812-5.3984 19.441-3.1211 24.84 5.2812 12.961 19.68 29.641 35.762 49.68 48 8.5195 5.1602 11.281 16.199 6.1211 24.719z\"/>\n</svg>\n","color":"#42a5f5","mdHelp":"/docs/help/service.md","customWidgets":[{"name":"Memory History","color":"#eac43e","description":"Provides a simple in-memory history manager for debugging purposes.","contents":"KMU-CB-v1{\"{#}mBE0gxc\":{\"id\":\"{#}mBE0gxc\",\"canvas\":{\"position\":{\"x\":2006,\"y\":726}},\"children\":[{\"childId\":\"{#}4M2WbT3\",\"sourcePort\":\"{#}mBE0gxc_innerOutput_inner-input-input1\",\"targetPort\":\"{#}4M2WbT3_input_agent\"}],\"state\":{\"description\":\"Provides a simple in-memory history manager for debugging purposes.\",\"inputs\":[{\"index\":0,\"label\":\"agent\",\"name\":\"input1\",\"type\":[5],\"position\":{\"x\":519,\"y\":291}}],\"outputs\":[],\"name\":\"Memory History\",\"type\":\"custom\",\"color\":\"#eac43e\",\"icon\":\"database\",\"canvasPosition\":{\"x\":0,\"y\":0},\"markdownHelp\":\"\",\"settings\":[],\"protocolVersion\":\"2\"},\"type\":\"widgetGroup\"},\"{#}4M2WbT3\":{\"id\":\"{#}4M2WbT3\",\"canvas\":{\"position\":{\"x\":659,\"y\":341}},\"children\":[{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_getHistory\",\"targetPort\":\"{#}jCnteeA_input_read\"},{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_updateHistory\",\"targetPort\":\"{#}jCnteeA_input_update\"}],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{\"includeAttachments\":false,\"timeout\":60},\"variantId\":\"history\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=\\\"M12 12c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\\\" fill=\\\"white\\\"/>\\n  <rect x=\\\"10\\\" y=\\\"19\\\" width=\\\"4\\\" height=\\\"3\\\" rx=\\\"1\\\" fill=\\\"currentColor\\\"/>\\n</svg>\",\"color\":\"#42a5f5\",\"inputs\":[{\"name\":\"query\",\"description\":\"Query string for the agent\",\"type\":1},{\"name\":\"attachments\",\"description\":\"Attachments for the agent (String, BinaryFile, ImageData, or Array of these types)\",\"type\":[1,12,7,3]},{\"name\":\"clear\",\"description\":\"Clear input signal\",\"type\":6},{\"name\":\"abort\",\"description\":\"Abort current query signal\",\"type\":6},{\"name\":\"send\",\"description\":\"Send input signal\",\"type\":6}],\"outputs\":[{\"name\":\"tools\",\"type\":5},{\"name\":\"history\",\"type\":5},{\"name\":\"json\",\"type\":5},{\"name\":\"text\",\"type\":1},{\"name\":\"stream\",\"type