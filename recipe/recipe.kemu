 <path d=\"m1003.2 198c-216-216-560.4-220.8-784.8-19.199l-60-60c-19.199-19.199-52.801-9.6016-58.801 16.801l-68.398 280.8c-6 25.199 16.801 49.199 43.199 43.199l280.8-68.398c26.398-6 36-39.602 16.801-58.801l-66-66c176.4-153.6 444-148.8 612 19.199 174 174 174 459.6-1.1992 634.8l-16.801 15.602c-25.199 22.801-26.398 61.199-4.8008 86.398 12 13.199 28.801 20.398 45.602 20.398 14.398 0 28.801-4.8008 40.801-15.602 7.1992-6 14.398-13.199 20.398-20.398 223.2-223.2 223.2-585.6 1.1992-808.8z\"/>\n <path d=\"m739.2 1028.4-22.801 7.1992c-32.398 8.3984-51.602 42-43.199 75.602 7.1992 27.602 32.398 45.602 58.801 45.602 4.8008 0 10.801-1.1992 15.602-2.3984 9.6016-2.3984 19.199-6 28.801-8.3984 32.398-10.801 49.199-45.602 38.398-76.801-8.4023-33.602-43.199-51.602-75.602-40.805z\"/>\n <path d=\"m532.8 1046.4-24-3.6016c-33.602-7.1992-66 14.398-72 48-7.1992 33.602 14.398 66 48 72 9.6016 2.3984 20.398 3.6016 30 4.8008 2.3984 0 6 1.1992 9.6016 1.1992 30 0 56.398-21.602 60-52.801 4.7969-33.598-18.004-64.797-51.602-69.598z\"/>\n <path d=\"m321.6 955.2c-26.398-20.398-64.801-16.801-86.398 9.6016-20.398 26.398-16.801 64.801 9.6016 86.398 8.3984 6 15.602 12 24 18 10.801 7.1992 22.801 10.801 34.801 10.801 19.199 0 38.398-8.3984 50.398-26.398 19.199-27.602 13.199-66-14.398-85.199z\"/>\n <path d=\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1781146161,"internal":false}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"groupId":"{#}pqYtUv9"},"{#}Hfuhk4Q":{"id":"{#}Hfuhk4Q","canvas":{"position":{"x":760,"y":582}},"children":[{"childId":"{#}0rplnjJ","sourcePort":"{#}Hfuhk4Q_output_sessionHistoryOutput","targetPort":"{#}0rplnjJ_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}pqYtUv9"},"{#}TO7izWL":{"id":"{#}TO7izWL","canvas":{"position":{"x":512,"y":198}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}pqYtUv9"},"{#}IgNZ5pR":{"id":"{#}IgNZ5pR","canvas":{"position":{"x":1215,"y":1173}},"children":[{"childId":"{#}UTw5k52","sourcePort":"{#}IgNZ5pR_output_out","targetPort":"{#}UTw5k52_input_abort"}],"state":{},"type":"play","groupId":"{#}QnrZZlY"},"{#}IZAjcjT":{"id":"{#}IZAjcjT","canvas":{"position":{"x":-6162,"y":-5688}},"children":[{"childId":"{#}Ay6QoWb","targetPort":"{#}Ay6QoWb_input_config","sourcePort":"{#}IZAjcjT_innerOutput_inner-input-config-NPd1HB"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":1179,"y":1044}}],"outputs":[],"name":"History Formatter","type":"custom","color":"#ab47bd","icon":"robot","canvasPosition":{"x":1130.6231163254756,"y":923.8284618157895},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":1},"type":"widgetGroup"},"{#}Ay6QoWb":{"id":"{#}Ay6QoWb","canvas":{"position":{"x":1622,"y":1005}},"children":[{"childId":"{#}c9rWxPN","sourcePort":"{#}Ay6QoWb_output_tools","targetPort":"{#}c9rWxPN_input_outer-input-input1"},{"childId":"{#}UrH0Gqd","sourcePort":"{#}Ay6QoWb_output_history","targetPort":"{#}UrH0Gqd_input_outer-input-input1"},{"childId":"{#}2VWesCf","sourcePort":"{#}Ay6QoWb_output_reasoning","targetPort":"{#}2VWesCf_input_setValue"},{"childId":"{#}4LJj8n5","sourcePort":"{#}Ay6QoWb_output_debug","targetPort":"{#}4LJj8n5_input_setValue"},{"childId":"{#}I7X83F4","sourcePort":"{#}Ay6QoWb_output_text","targetPort":"{#}I7X83F4_input_setValue"},{"childId":"{#}UajNZmC","sourcePort":"{#}Ay6QoWb_output_text","targetPort":"{#}UajNZmC_input_event"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"selectedModel":{"id":"~openai/gpt-mini-latest","slug":"~openai/gpt-mini-latest","name":"OpenAI GPT Mini Latest","description":"This model always redirects to the latest model in the OpenAI GPT Mini family.","inputModalities":["file","image","text"],"outputModalities":["text"],"supportsTools":true,"supportsReasoning":true,"promptPrice":7.5e-7,"completionPrice":0.0000045,"maxTokens":128000,"contextLength":400000,"provider":"~openai"},"systemInstructions":"# History Formatter v2.3 — System Instructions\n\n**Version:** 2.3\n**Last Updated:** 2026-05-13\n**Role:** Career History Formatter\n**Pipeline Position:** Assembly Phase 4\n**Trigger:** Dispatched sequentially by server after Skills Curator approved\n**Output:** Writes `hf_output.json` (server merges into phases[3], then shows Approve/Revise)\n\n---\n\n## Role\n\nYou format work history entries by:\n1. Converting to telegraphic bullets (if style override agreed)\n2. Highlighting achievements from gap_analysis.strengths\n3. Adding bold metrics where available\n4. Applying consistent structure across all job entries\n\n---\n\n## Authority\n\n### READ Access\n- `candidate_profile.json`\n- `gap_analysis.json`\n- `cv_assembly_state.json`\n\n### WRITE Access\n- `hf_output.json` (phase output — server merges into cv_assembly_state.json at join)\n\n### NEVER Modify\n- `candidate_profile.json`\n- `gap_analysis.json`\n- `style_guide.json`\n\n---\n\n## Tools\n\n| Tool | Usage |\n| --- | --- |\n| **ReadFile** | Load JSON files using bare filenames only |\n| **WriteFile** | Write JSON strings using bare filenames only |\n\n**⚠️ CRITICAL:**\n- WriteFile accepts STRINGS only: `JSON.stringify(data, null, 2)`\n- Use bare filenames: `\"hf_output.json\"` not `\"/hf_output.json\"`\n- Always return to Assembly Coordinator (NOT Main Orchestrator)\n\n---\n\n## Execution Protocol\n\n### Phase 0: Revision Mode Check\n\n```javascript\nconst inputMessage = getInputText()\n\n// ── CONFIRM CHANGE path (user has acknowledged a source contradiction) ────────\nif (inputMessage && inputMessage.startsWith('confirm change:')) {\n  const confirmedText = inputMessage.replace('confirm change:', '').trim()\n  const existing = JSON.parse(ReadFile(\"hf_output.json\"))\n  // Apply the confirmed change directly — no further contradiction check\n  // The candidate has explicitly accepted responsibility for the discrepancy\n  // Apply to the relevant entry in existing.data.work_history\n  WriteFile(\"hf_output.json\", JSON.stringify(existing, null, 2))\n  Display: \"Change applied as confirmed. Candidate has acknowledged the source CV discrepancy.\"\n  END TURN\n}\n\nif (inputMessage && inputMessage.startsWith('__revise__:')) {\n  const feedback = inputMessage.replace('__revise__:', '').trim()\n\n  // ⚠️ TARGETED EDIT ONLY — do NOT regenerate from scratch\n  const existing = JSON.parse(ReadFile(\"hf_output.json\"))\n\n  // ── SOURCE CONTRADICTION CHECK (P0 Defect 1 fix) ──────────────────────────\n  // Before applying any revision, check if the requested change contradicts cv_raw.txt.\n  // This check is mandatory for any revision touching: clinical setting, job title,\n  // employer name, or dates.\n  const cvRawContent = ReadFile(\"cv_raw.txt\")\n\n  const contradictionRiskPatterns = [\n    /ward|department|unit|clinic|centre|center|setting|theatre/i,\n    /title|position|role|grade|band/i,\n    /employer|hospital|practice|health/i,\n    /date|from|to|month|year|\\d{4}/i,\n  ]\n  const isContradictionRisk = contradictionRiskPatterns.some(p => p.test(feedback))\n\n  if (isContradictionRisk) {\n    // Determine which employer entry the feedback targets\n    // (match by employer name keywords from feedback against existing.data.work_history)\n    // Extract the proposed new value from feedback (e.g. \"Surgical Ward\" from \"change to Surgical Ward\")\n    // Find that employer's text block in cvRawContent\n    // If proposed value NOT in that block AND a contradictory value IS in that block → BLOCK\n\n    // DIRECTIVE: read feedback semantically. If you cannot find the proposed value in\n    // cvRawContent for the relevant employer, display:\n    Display: `\n⚠️ Revision blocked — source CV check failed.\n\nProposed: \"${feedback}\"\ncv_raw.txt shows: [quote the relevant section for this employer from cvRawContent]\n\nTo override (acknowledging your source CV is incorrect):\nType: \\`confirm change: [exact corrected text]\\`\n\nTo keep the source CV version: type your revised instruction.\n`\n    END TURN\n    // Do NOT write hf_output.json until 'confirm change:' is received\n  }\n\n  // Make the specific change to existing.data.work_history entries:\n  // e.g. \"strengthen bullet 2 of role 1\" → edit that specific bullet only\n  // e.g. \"add metric to Amazon role\" → append the metric to relevant bullets\n  // Preserve all other entries and bullets unchanged\n  WriteFile(\"hf_output.json\", JSON.stringify(existing, null, 2))\n  Display revised work history section showing the changed entry\n  // DO NOT call SwitchAgent — server auto-advances\n  END TURN\n}\n```\n\n---\n\n### Phase 1: Load Data\n```javascript\nconst candidateProfile = JSON.parse(ReadFile(\"candidate_profile.json\"))\nconst gapAnalysis = JSON.parse(ReadFile(\"gap_analysis.json\"))\nconst cvState = JSON.parse(ReadFile(\"cv_assembly_state.json\"))\n\nconst workHistory = candidateProfile.work_history\n// agreed_overrides is an Object (SN v1.6+) — convert to array of values for .some() checks\nconst agreed = cvState.phases[0].data?.agreed_overrides || {}\nconst styleOverrides = Array.isArray(agreed) ? agreed : Object.values(agreed)\n\nif (!cvState.phases[0].data?.agreed_overrides) {\n  Display: \"Error: Style Negotiation data missing. Cannot proceed.\"\n  END TURN\n}\n```\n\n---\n\n### Phase 2: Format Each Job Entry\n\n```javascript\n// Date formatter: converts \"YYYY-MM\" → \"Mon YYYY\" (e.g. \"2020-01\" → \"Jan 2020\")\nfunction formatDate(dateStr) {\n  if (!dateStr) return dateStr\n  const match = dateStr.match(/^(\\d{4})-(\\d{2})$/)\n  if (!match) return dateStr  // Pass through if not YYYY-MM format (e.g. \"Present\")\n  const months = [\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\",\"Dec\"]\n  return `${months[parseInt(match[2], 10) - 1]} ${match[1]}`\n}\n\nconst formattedEntries = []\n\nworkHistory.forEach(job => {\n  const startFormatted = formatDate(job.start_date)\n  const endFormatted = job.end_date?.toLowerCase() === \"present\" ? \"Present\" : formatDate(job.end_date)\n\n  // ACTING ROLE DETECTION (P1 Defect 7 fix)\n  // Acting roles must use dual-title format: \"Base Title / Acting Title (duration)\"\n  // Never present an acting title as the standalone position header — it misrepresents the basis.\n  const isActingRole = (job.position || '').toLowerCase().includes('acting') ||\n                       (job.employment_type || '').toLowerCase().includes('acting')\n  let displayPosition = job.position\n  if (isActingRole && job.base_position) {\n    const actingDuration = job.acting_duration ? ` (${job.acting_duration})` : ''\n    displayPosition = `${job.base_position} / ${job.position}${actingDuration}`\n  }\n\n  const entry = {\n    employer: job.employer,\n    position: displayPosition,\n    employment_type: job.employment_type,\n    acting_role: isActingRole || undefined,\n    acting_duration: isActingRole ? (job.acting_duration || null) : undefined,\n    duration: `${startFormatted} – ${endFormatted}`,\n    duration_years: job.duration_years,\n    bullets: []\n  }\n\n  // DIRECTIVE — rewrite each bullet as professional prose, applying the rules below.\n  // Do NOT use regex or string replacement. Edit the text semantically.\n\n  const applyImplicitFirstPerson = styleOverrides.some(o => o.toLowerCase().includes(\"implicit first-person\"))\n  const applyTelegraphic         = styleOverrides.some(o => o.toLowerCase().includes(\"telegraphic\"))\n  const applyBoldMetrics         = styleOverrides.some(o => o.toLowerCase().includes(\"bold\"))\n\n  const allBullets = [\n    ...(job.responsibilities || []),\n    ...(job.achievements || []),\n  ]\n\n  allBullets.forEach(rawBullet => {\n    // Start with the original text and apply each editorial rule in turn:\n    let bullet = rawBullet\n\n    // Rule 1 — Implicit first-person (if override active):\n    // Remove leading \"I\" pronoun and any following spaces at the start of the sentence.\n    // If the sentence begins mid-thought without \"I\", leave it as-is.\n    // Do NOT make the sentence awkward — restructure if needed for flow.\n    if (applyImplicitFirstPerson) {\n      // Apply semantically: remove \"I\" from the start, keep the action verb and object intact\n    }\n\n    // Rule 2 — Telegraphic style (if override active):\n    // Rewrite for scan-speed: start with a strong action verb, remove trailing period,\n    // cut filler (\"responsible for\", \"helped to\", \"assisted with\", \"was involved in\").\n    // Do NOT strip articles mechanically — only remove them when the result still reads naturally.\n    // The goal is professional conciseness, not caveman syntax.\n    if (applyTelegraphic) {\n      // Apply semantically: ensure bullet starts with action verb, no trailing period, no filler\n    }\n\n    // Rule 3 — Bold metrics (always apply):\n    // Identify ALL quantitative results: percentages, multipliers, currency figures, headcounts,\n    // time periods, and results expressed as words (\"halved\", \"doubled\", \"threefold\", \"one-fifth\").\n    // Wrap in **bold**. Do not miss word-form numbers.\n    if (applyBoldMetrics) {\n      // Apply semantically: identify every metric (numeric or word-form) and bold it\n    }\n\n    entry.bullets.push(bullet)\n  })\n\n  formattedEntries.push(entry)\n})\n```\n\n---\n\n### Phase 3: Highlight Strengths\n```javascript\n// Ensure bullets demonstrating gap_analysis strengths are present\ngapAnalysis.strengths.forEach(strength => {\n  const skillName = strength.skill_or_attribute.toLowerCase()\n\n  formattedEntries.forEach(entry => {\n    const hasStrength = entry.bullets.some(b => b.toLowerCase().includes(skillName))\n    // Strength is either already in bullets (from responsibilities/achievements)\n    // or noted for Profile Builder to address in the profile paragraph\n  })\n})\n```\n\n---\n\n### Phase 4: Display & Write hf_output.json\n\nDisplay ALL formatted entries in full so the user can review every entry before approving:\n\n```markdown\n## Career History Formatted\n\n{formattedEntries.length} entries | {phaseOutput.data.total_bullets} bullets total\n\n---\n\n{formattedEntries.map(entry => `\n**${entry.position}** — ${entry.employer} (${entry.duration})\n${entry.bullets.map(b => `• ${b}`).join('\\n')}\n`).join('\\n---\\n')}\n```\n\nThen immediately write the output file:\n```javascript\nconst phaseOutput = {\n  phase_number: 4,\n  phase_name: \"History Formatting\",\n  agent: \"History Formatter\",\n  status: \"COMPLETE\",\n  completed_at: getCurrentISOTimestamp(),\n  data: {\n    work_history: formattedEntries,\n    total_entries: formattedEntries.length,\n    total_bullets: formattedEntries.reduce((sum, e) => sum + e.bullets.length, 0),\n    style_overrides_applied: styleOverrides,\n    user_confirmed: true\n  }\n}\n\n// ⚠️ FILENAME GUARD — the output filename is the literal string \"hf_output.json\". Nothing prepended, nothing appended.\n// WRONG: \"workspacehf_output.json\"   WRONG: \"workspace/hf_output.json\"   WRONG: \"/hf_output.json\"\n// CORRECT: \"hf_output.json\"\nWriteFile(\"hf_output.json\", JSON.stringify(phaseOutput, null, 2))\n\nconst verified = JSON.parse(ReadFile(\"hf_output.json\"))\nif (verified.status !== \"COMPLETE\") {\n  ERROR: \"hf_output.json write failed\"\n  Display: \"Error: Failed to write phase output. Please retry.\"\n  END TURN\n}\n```\n\n---\n\n### Phase 6: Display Completion and Return to Assembly Coordinator\n\n```markdown\n# ✓ History Formatter Complete\n\nCareer history formatted and ready for CV assembly.\n- Entries formatted: {formattedEntries.length}\n- Total bullets: {phaseOutput.data.total_bullets}\n- Style overrides applied: {styleOverrides.length}\n\n```\n\n**TURN ENDS.** Server reads `hf_output.json`, merges into cv_assembly_state.json, and shows Approve/Revise buttons.\n\n---\n\n## Error Handling\n\n| Error | Action |\n| --- | --- |\n| candidate_profile.json missing | Display error, ChangeAgent(\"Main Orchestrator\") |\n| cv_assembly_state.json missing | Display error, ChangeAgent(\"Main Orchestrator\") |\n| Phase mismatch | Display error, END TURN |\n| Empty work history | Use empty array, continue with zero entries |\n| WriteFile fails | Retry once, then ChangeAgent(\"Main Orchestrator\") |\n| Filename has slash | CRITICAL ERROR, STOP |\n\n---\n\n## Critical Rules\n\n**`getCurrentISOTimestamp()` implementation** — When writing any date/time field, extract the current date from the system context (\"Today's date is YYYY-MM-DD\") and return it as ISO 8601: `YYYY-MM-DDT00:00:00Z`. **Never hardcode a specific date string** (e.g. \"2026-03-31T00:00:00Z\") — that is a fabrication error. If no system date is visible, use the most recent date mentioned in the conversation.\n\n1. **Use bare filenames** — `\"hf_output.json\"` not `\"/hf_output.json\"`\n2. **NEVER prepend 'workspace'** — `\"workspacehf_output.json\"` is WRONG. Never construct a filename by concatenating any prefix onto the output filename.\n3. **Always stringify JSON** — `JSON.stringify(data, null, 2)` before WriteFile\n3. **Verify writes** — Read file back to confirm\n4. **candidate_profile.json** — NEVER user_profile.json\n5. **Write to hf_output.json only** — Server merges into cv_assembly_state.json; do NOT write cv_assembly_state.json\n6. **Auto-write — no user confirmation** — Sequential dispatch; display formatted entries then write immediately\n7. **Turn-based pattern** — Display \"# ✓ History Formatter Complete\" and end turn naturally\n8. **No SwitchAgent on completion** — server reads `hf_output.json` and shows Approve/Revise buttons\n9. **Source contradiction check is mandatory** — any revision touching clinical setting, job title, employer, or dates must be cross-checked against `cv_raw.txt` before applying. Block and display a warning if the proposed value is absent from cv_raw.txt for that employer. Do NOT write until `confirm change:` is received.\n10. **Acting roles MUST use dual-title format** — substantive classification leads. Format: `\"Registered Nurse (Grade 2, Year 8) / Acting Clinical Nurse Specialist (6 months)\"`. Never present an acting title as a standalone position header — this misrepresents the employment basis.\n\n---\n","query":"","jsonResponse":false,"jsonFormat":"","jsonSchemaMode":"typescript","fileParser":"native","imageAspectRatio":"1:1","maxIterations":12,"reasoningEffort":"low","allowFallbacks":true,"temperature":1},"service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801c14.762-6.3594 14.762-27.238 0-33.719zm-210.84-6.9609c-3 6.7188-9.6016 10.801-16.559 10.801-2.3984 0-4.8008-0.48047-7.1992-1.4414-64.078-28.078-114.72-78.719-142.68-142.8-4.0781-9.1211 0.12109-19.801 9.2383-23.762 9.1211-3.9609 19.68 0.23828 23.762 9.3594 24.238 55.68 68.398 99.84 124.08 124.2 9.1211 3.9609 13.32 14.52 9.3594 23.641z\"/>\n <path d=\"m1113.1 322.08-109.56-47.762c-26.52-11.641-47.641-32.762-59.281-59.281l-47.762-109.56c-3.7188-8.5195-15.84-8.5195-19.559 0l-47.762 109.56c-11.641 26.52-32.762 47.641-59.281 59.281l-109.68 47.879c-8.5195 3.7188-8.5195 15.719-0.12109 19.441l111.72 49.32c26.398 11.762 47.52 33 58.922 59.52l46.32 107.64c3.6016 8.5195 15.719 8.5195 19.441 0l47.762-109.44c11.641-26.52 32.762-47.641 59.281-59.281l109.56-47.762c8.5195-3.7188 8.5195-15.84 0-19.559zm-149.28 15.84c-3.4805 5.6406-9.3594 8.6406-15.48 8.6406-3.1211 0-6.3594-0.83984-9.2383-2.5195-24.84-15.121-45.359-34.922-61.199-59.16-5.3984-8.3984-3-19.441 5.2812-24.961 8.2812-5.3984 19.441-3.1211 24.84 5.2812 12.961 19.68 29.641 35.762 49.68 48 8.5195 5.1602 11.281 16.199 6.1211 24.719z\"/>\n</svg>\n","color":"#42a5f5","mdHelp":"/docs/help/service.md","customWidgets":[{"name":"Memory History","color":"#eac43e","description":"Provides a simple in-memory history manager for debugging purposes.","contents":"KMU-CB-v1{\"{#}mBE0gxc\":{\"id\":\"{#}mBE0gxc\",\"canvas\":{\"position\":{\"x\":2006,\"y\":726}},\"children\":[{\"childId\":\"{#}4M2WbT3\",\"sourcePort\":\"{#}mBE0gxc_innerOutput_inner-input-input1\",\"targetPort\":\"{#}4M2WbT3_input_agent\"}],\"state\":{\"description\":\"Provides a simple in-memory history manager for debugging purposes.\",\"inputs\":[{\"index\":0,\"label\":\"agent\",\"name\":\"input1\",\"type\":[5],\"position\":{\"x\":519,\"y\":291}}],\"outputs\":[],\"name\":\"Memory History\",\"type\":\"custom\",\"color\":\"#eac43e\",\"icon\":\"database\",\"canvasPosition\":{\"x\":0,\"y\":0},\"markdownHelp\":\"\",\"settings\":[],\"protocolVersion\":\"2\"},\"type\":\"widgetGroup\"},\"{#}4M2WbT3\":{\"id\":\"{#}4M2WbT3\",\"canvas\":{\"position\":{\"x\":659,\"y\":341}},\"children\":[{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_getHistory\",\"targetPort\":\"{#}jCnteeA_input_read\"},{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_updateHistory\",\"targetPort\":\"{#}jCnteeA_input_update\"}],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{\"includeAttachments\":false,\"timeout\":60},\"variantId\":\"history\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=\\\"M12 12c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\\\" fill=\\\"white\\\"/>\\n  <rect x=\\\"10\\\" y=\\\"19\\\" width=\\\"4\\\" height=\\\"3\\\" rx=\\\"1\\\" fill=\\\"currentColor\\\"/>\\n</svg>\",\"color\":\"#42a5f5\",\"inputs\":[{\"name\":\"query\",\"description\":\"Query string for the agent\",\"type\":1},{\"name\":\"attachments\",\"description\":\"Attachments for the agent (String, BinaryFile, ImageData, or Array of these types)\",\"type\":[1,12,7,3]},{\"name\":\"clear\",\"description\":\"Clear input signal\",\"type\":6},{\"name\":\"abort\",\"description\":\"Abort current query signal\",\"type\":6},{\"name\":\"send\",\"description\":\"Send input signal\",\"type\":6}],\"outputs\":[{\"name\":\"tools\",\"type\":5},{\"name\":\"history\",\"type\":5},{\"name\":\"json\",\"type\":5},{\"name\":\"text\",\"type\":1},{\"name\":\"stream\",\"type\":1},{\"name\":\"images\",\"description\":\"Generated images as ImageData array\",\"type\":3}],\"supportedPlatforms\":[\"win-x86\",\"win-x64\",\"osx-x64\",\"osx-arm64\",\"linux-debian-arm64\",\"linux-debian-x64\",\"linux-rhel-arm64\",\"linux-rhel-x64\"],\"author\":\"db618814-4e68-40aa-8158-64a595fea23b\",\"defaultVariantInfo\":{\"title\":\"Agent\",\"shortTitle\":\"Agent\",\"description\":\"AI agent that processes queries with system instructions and attachments\"},\"variants\":[{\"id\":\"tool\",\"name\":\"Tool\",\"description\":\"Define tools with arguments and results for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Tool icon - wrench/settings -->\\n  <path d=\\\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Tool input data\",\"type\":5}],\"outputs\":[{\"name\":\"arguments\",\"description\":\"Tool arguments\",\"type\":5}],\"color\":\"#42a5f5\"},{\"id\":\"submit\",\"name\":\"Submit\",\"description\":\"Submit data without any processing\",\"svgIcon\":\"<svg f