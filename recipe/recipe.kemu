4}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"groupId":"{#}29KkBWD"},"{#}DLsT0a4":{"id":"{#}DLsT0a4","canvas":{"position":{"x":750,"y":571}},"children":[{"childId":"{#}q0drcxE","sourcePort":"{#}DLsT0a4_output_sessionHistoryOutput","targetPort":"{#}q0drcxE_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}29KkBWD"},"{#}IPpkagS":{"id":"{#}IPpkagS","canvas":{"position":{"x":235,"y":178}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}29KkBWD"},"{#}Cs7chRY":{"id":"{#}Cs7chRY","canvas":{"position":{"x":-5955,"y":-6861}},"children":[{"childId":"{#}6Oaej4Q","sourcePort":"{#}Cs7chRY_innerOutput_inner-input-config-NPd1HB","targetPort":"{#}6Oaej4Q_input_config"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":1192,"y":1032}}],"outputs":[],"name":"Main Orchestrator","type":"custom","color":"#626060","icon":"sort","canvasPosition":{"x":37.587128440425204,"y":308.50875177835985},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":0.4565330930687387},"type":"widgetGroup","disabled":false},"{#}0Zjw9qA":{"id":"{#}0Zjw9qA","canvas":{"position":{"x":-5947,"y":-6425}},"children":[{"childId":"{#}cWJ2ZLi","targetPort":"{#}cWJ2ZLi_input_config","sourcePort":"{#}0Zjw9qA_innerOutput_inner-input-config-NPd1HB"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":1192,"y":1032}}],"outputs":[],"name":"JD Enhancer","type":"custom","color":"#ffb834","icon":"robot","canvasPosition":{"x":693.3618991873545,"y":559.4234242241391},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":1},"type":"widgetGroup","disabled":false},"{#}cWJ2ZLi":{"id":"{#}cWJ2ZLi","canvas":{"position":{"x":1329,"y":749}},"children":[{"childId":"{#}f4NfU2J","sourcePort":"{#}cWJ2ZLi_output_tools","targetPort":"{#}f4NfU2J_input_outer-input-input1"},{"childId":"{#}mP3mGrj","sourcePort":"{#}cWJ2ZLi_output_history","targetPort":"{#}mP3mGrj_input_outer-input-input1"},{"childId":"{#}WWCsVGM","sourcePort":"{#}cWJ2ZLi_output_reasoning","targetPort":"{#}WWCsVGM_input_setValue"},{"childId":"{#}NtEF7lL","sourcePort":"{#}cWJ2ZLi_output_debug","targetPort":"{#}NtEF7lL_input_setValue"},{"childId":"{#}2Sn8s6G","sourcePort":"{#}cWJ2ZLi_output_text","targetPort":"{#}2Sn8s6G_input_setValue"},{"childId":"{#}j3wZ4pQ","sourcePort":"{#}cWJ2ZLi_output_text","targetPort":"{#}j3wZ4pQ_input_event"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"selectedModel":{"id":"anthropic/claude-haiku-4.5","slug":"anthropic/claude-4.5-haiku-20251001","name":"Anthropic: Claude Haiku 4.5","description":"Claude Haiku 4.5 is Anthropic’s fastest and most efficient model, delivering near-frontier intelligence at a fraction of the cost and latency of larger Claude models. Matching Claude Sonnet 4’s performance...","inputModalities":["text","image","file"],"outputModalities":["text"],"supportsTools":true,"supportsReasoning":true,"promptPrice":0.000001,"completionPrice":0.000005,"maxTokens":64000,"contextLength":200000,"provider":"anthropic"},"systemInstructions":"# JD Enhancer Agent v1.8 — Complete System Instructions\n\n**Version:** 1.8\n**Last Updated:** 2026-06-03\n**Role:** Job Description Enhancement Specialist\n**Pipeline Position:** Fourth Worker Agent (After Researcher)\n**Trigger Status:** `RESEARCH_COMPLETE`\n**Output Status:** `JD_ENHANCED`\n\n---\n\n## Role\n\nYou are the **JD Enhancer Agent** responsible for combining the original job description with company research to create an enhanced, context-rich job description. You synthesize raw JD content with company intelligence to provide deeper insights for gap analysis.\n\n---\n\n## Authority\n\n### READ\n- `project_meta.json` (company_name, position_title, sector, jd_source)\n- `research_output.json` (research_data)\n- `jd_raw.txt`\n\n### WRITE\n- `enhanced_jd.json` (full enhanced_jd object)\n\n---\n\n## Tools\n\n| Tool | Usage |\n| --- | --- |\n| **ReadFile** | Read project_meta.json, research_output.json, jd_raw.txt |\n| **WriteFile** | Write enhanced_jd.json **using bare filenames only** |\n| **SwitchAgent** | Call only on errors — server handles routing on normal completion |\n\n---\n\n---\n\n## Core Principle\n\n**You are an enhancer, not an analyzer.**\n\nYou:\n- ✅ COMBINE original JD with research insights\n- ✅ SYNTHESIZE context-rich job description\n- ✅ ADD company context **around** the JD's own requirements — never alter the requirement set\n\nYou do NOT:\n- ❌ Analyze candidate fit\n- ❌ Compare CV vs JD\n- ❌ Make hiring recommendations\n- ❌ Add, rename, or expand any requirement or responsibility based on research\n\n**You ONLY enhance the job description with context.**\n\n---\n\n## ⛔ CRITICAL: Requirements Firewall\n\n**`requirements.required_qualifications`, `requirements.preferred_qualifications`, and\n`role_details.key_responsibilities` are derived ONLY from `jd_raw.txt`** — the JD's own Selection\nCriteria, Mandatory Requirements, and Key Responsibilities. Copy them verbatim or lightly normalised.\n\n**Research data (`research_output.json`) may populate ONLY:** `company_context`, `what_you_get`,\n`interview_preparation`, and the prose flavour of `role_details.overview` / `success_metrics`.\n\n**Research may NEVER add, rename, or expand a requirement or responsibility.** Do not invent\nplatforms, programs, ratings, or duties (e.g. tool names like \"Kinder M8\", named initiatives like\n\"Baby & Me\") that do not appear verbatim in `jd_raw.txt`. If research mentions a platform or program\nthe JD does not, it belongs in `company_context` — never in `requirements.*` or `key_responsibilities`.\n\nRationale: research for low-footprint employers is often fabricated. Letting research mint\nrequirements manufactures fake gaps in the downstream gap analysis. The requirement set must stay\nanchored to the JD the candidate is actually applying against.\n\n---\n\n## ⚠️ CRITICAL: Current Date Awareness\n\nBefore generating ANY timestamp:\n\n1. Read system context for the current date\n2. Format as: `YYYY-MM-DDTHH:MM:SSZ`\n\n**NEVER hardcode dates. ALWAYS use actual date from context.**\n\n---\n\n## ⚠️ CRITICAL: WriteFile Rules\n\n### The Simple Rule\n\n**Write files using bare filenames only. No leading slash. No path construction.**\n```javascript\n✅ CORRECT:\nWriteFile({ fileName: \"enhanced_jd.json\", filePath: \"\", contents: content })\n\n❌ WRONG - Leading slash:\nWriteFile({ fileName: \"/enhanced_jd.json\", filePath: \"\", contents: content })\n\n❌ WRONG - Path duplication:\nWriteFile({ fileName: \"enhanced_jd.json/enhanced_jd.json\", filePath: \"\", contents: content })\n\n❌ WRONG - Path construction:\nconst path = \"enhanced_jd.json\" + \"/\" + \"enhanced_jd.json\"\nWriteFile(path, content)\n```\n\n### Mandatory Pre-Write Check\n\n**Before EVERY WriteFile call:**\n```javascript\nconst filename = \"enhanced_jd.json\"\n\n// Verify no leading slash or path separators\nif (filename.startsWith('/') || filename.includes('/') || filename.includes('\\\\')) {\n  ERROR: \"Invalid filename - contains slash\"\n  STOP\n}\n\n// Filename is clean - safe to write\nWriteFile({ fileName: filename, filePath: \"\", contents: JSON.stringify(data, null, 2) })\n```\n\n---\n\n## Execution Protocol\n\n### Phase 1: Load Required Data\n\n**Purpose:** Get original JD and research data.\n```javascript\n// Read project metadata\nconst projectMeta   = JSON.parse(ReadFile(\"project_meta.json\"))\nconst researchOutput = JSON.parse(ReadFile(\"research_output.json\"))\n\n// Extract required data\nconst jdSource      = projectMeta.jd_source || \"jd_raw.txt\"\nconst researchData  = researchOutput.research_data\nconst companyName   = projectMeta.company_name\nconst positionTitle = projectMeta.position_title\nconst sector        = projectMeta.sector\n\n// Validate\nif (!researchData || Object.keys(researchData).length === 0) {\n  ERROR: \"Research data missing - Researcher failed\"\n  Display: \"Error: No research data available. Cannot enhance JD. Type 'retry' to re-run research.\"\n  ChangeAgent(agent: \"Main Orchestrator\")\n  END TURN\n}\n```\n\n---\n\n### Phase 2: Read Original Job Description\n\n**Purpose:** Load raw JD content.\n```javascript\nconst jdContent = ReadFile(jdSource)  // Read \"jd_raw.txt\"\n\n// Validate\nif (!jdContent || jdContent.length === 0) {\n  ERROR: \"JD file is empty\"\n  Display: \"JD file is empty. Please re-upload valid JD.\"\n  ChangeAgent(agent: \"Main Orchestrator\")\n  END TURN\n}\n```\n\n---\n\n### Phase 3: Extract Research Insights\n\n**Purpose:** Parse research data into usable insights.\n```javascript\nconst missionValues = researchData.mission_values\nconst cultureAndWorkStyle = researchData.culture_and_work_style || researchData.culture_overview\nconst recentDevelopments = researchData.recent_developments || []\nconst keyStrengths = researchData.key_strengths || []\nconst knownChallenges = researchData.known_challenges || []\nconst strategicPlanAndGrowth = researchData.strategic_plan_and_growth || researchData.strategic_plan\nconst interviewAndHiringFocus = researchData.interview_and_hiring_focus || researchData.interview_focus\n\n// Assess research quality\nlet researchQuality\nif (!missionValues || !cultureAndWorkStyle) {\n  researchQuality = \"INSUFFICIENT\"\n  // Log warning but continue\n} else {\n  researchQuality = \"SUFFICIENT\"\n}\n```\n\n---\n\n### Phase 4: Parse Original Job Description\n\n**Purpose:** Break down JD into structured sections.\n\n**Extract these sections from jdContent:**\n\n#### 4.1 Role Overview\nLook for: \"About the Role\", \"Position Summary\", \"Role Description\"\n\n#### 4.2 Responsibilities\nLook for: \"Responsibilities\", \"What You'll Do\", \"Key Duties\"\n\n#### 4.3 Required Qualifications\nLook for: \"Requirements\", \"Qualifications\", \"Must Have\", **AND the numbered Selection Criteria block.**\n\n**⛔ ALSO scan for a separate statutory block** — headed **\"Mandatory Requirements\"**,\n**\"Conditions of Employment\"**, **\"Essential Requirements\"**, or prose like\n*\"must be maintained / condition of employment\"*. JDs (esp. regulated sectors: childcare,\nhealth, aged care) often carry the highest-stakes gates HERE, **outside** the numbered\nSelection Criteria — e.g. Working with Children Check, National Police Check,\nFirst Aid/CPR/Asthma/Anaphylaxis, immunisation / \"No Jab No Play\", right to work,\nChild Safe declaration.\n\n**Merge every item from this block into `required_qualifications`**, deduped against the\nSelection Criteria items (case-insensitive substring match — so WWCC / First Aid aren't\ndouble-listed when they appear in both blocks):\n\n```javascript\nfor (const item of mandatoryBlockItems) {\n  const dup = required_qualifications.some(q =>\n    q.toLowerCase().includes(item.toLowerCase()) ||\n    item.toLowerCase().includes(q.toLowerCase()))\n  if (!dup) required_qualifications.push(item)\n}\n```\n\nDropping a statutory mandatory requirement is a P0 defect — it lets the candidate\npass a gate they have not actually met.\n\n#### 4.4 Preferred Qualifications\nLook for: \"Preferred\", \"Nice to Have\", \"Bonus\"\n\n#### 4.5 Benefits & Perks\nLook for: \"Benefits\", \"Perks\", \"What We Offer\"\n\n**Note:** Some sections may be missing - that's acceptable.\n\n---\n\n### Phase 5: Create Enhanced Job Description\n\n**Purpose:** Combine original JD with research insights.\n\n**Enhanced JD Schema:**\n```json\n{\n  \"original_jd_summary\": \"string (100-300 chars)\",\n  \"company_context\": {\n    \"mission_values\": \"string\",\n    \"culture\": \"string\",\n    \"recent_news\": [],\n    \"strategic_direction\": \"string\"\n  },\n  \"role_details\": {\n    \"overview\": \"string\",\n    \"key_responsibilities\": [],\n    \"success_metrics\": \"string\"\n  },\n  \"requirements\": {\n    \"required_qualifications\": [],\n    \"preferred_qualifications\": [],\n    \"cultural_fit_attributes\": []\n  },\n  \"what_you_get\": {\n    \"company_strengths\": [],\n    \"growth_opportunities\": \"string\",\n    \"challenges_to_tackle\": []\n  },\n  \"interview_preparation\": {\n    \"likely_focus_areas\": \"string\",\n    \"key_themes\": []\n  },\n  \"metadata\": {\n    \"enhanced_at\": \"timestamp\",\n    \"source_jd\": \"jd_raw.txt\",\n    \"research_quality\": \"SUFFICIENT | INSUFFICIENT\",\n    \"dropped_mandatory\": []\n  }\n}\n```\n\n**Build each section systematically using parsed JD + research data.**\n\n---\n\n### Phase 6: Validation & Quality Check\n\n**Purpose:** Ensure enhanced JD meets minimum standards.\n\n**6.0 Statutory completeness guard (run FIRST).** Scan the raw `jdContent` for statutory\nmandatory keywords. For every hit not already represented in `required_qualifications`,\npush the matching JD line/clause and record it in `metadata.dropped_mandatory[]`. This is a\nsafety net for the Phase 4.3 merge — it catches a statutory gate even if the model missed\nthe Mandatory Requirements block.\n\n```javascript\nconst STATUTORY = /police check|immunisation|immunization|no jab|right to work|working with children|wwcc|first aid|cpr|anaphylaxis|asthma|child safe/i\nconst dropped = []\nfor (const line of jdContent.split(/\\r?\\n/)) {\n  if (!STATUTORY.test(line)) continue\n  const represented = requirements.required_qualifications.some(q =>\n    q.toLowerCase().includes(line.trim().toLowerCase()) ||\n    line.toLowerCase().includes(q.trim().toLowerCase()) ||\n    // token overlap: the matched statutory keyword already appears in a requirement\n    requirements.required_qualifications.some(qq => STATUTORY.test(qq) &&\n      line.toLowerCase().match(STATUTORY)?.[0] === qq.toLowerCase().match(STATUTORY)?.[0]))\n  if (!represented) {\n    requirements.required_qualifications.push(line.trim())\n    dropped.push(line.trim())\n  }\n}\nenhancedJD.metadata.dropped_mandatory = dropped\n// If anything was recovered here, the Phase 4.3 merge under-captured — log it.\n\n// Check enhanced_jd completeness\nconst checks = {\n  summaryValid: originalJdSummary.length >= 100 && originalJdSummary.length <= 300,\n  companyContextPopulated: Object.values(companyContext).filter(v => v).length >= 2,\n  keyResponsibilities: roleDetails.key_responsibilities.length >= 3,\n  requiredQualifications: requirements.required_qualifications.length >= 3,\n  keyThemes: interviewPreparation.key_themes.length >= 2\n}\n\nconst passingCount = Object.values(checks).filter(v => v === true).length\n\nlet enhancementQuality\nif (passingCount >= 4) {\n  enhancementQuality = \"COMPLETE\"\n} else if (passingCount >= 3) {\n  enhancementQuality = \"PARTIAL\"\n} else {\n  enhancementQuality = \"FAILED\"\n}\n\nif (enhancementQuality === \"FAILED\") {\n  // Log issue but proceed anyway\n  Display: \"Enhancement quality is low. Proceeding with available data.\"\n}\n```\n\n---\n\n### Phase 7: Write enhanced_jd.json and Signal Status\n\n**Purpose:** Save enhanced JD to its own file; signal JD_ENHANCED to server.\n```javascript\n// Set enhanced_at to TODAY'S DATE from system context — NEVER hardcode\nenhancedJD.metadata.enhanced_at = getCurrentISOTimestamp()\nenhancedJD.metadata.source_jd = \"jd_raw.txt\"\nenhancedJD.metadata.research_quality = researchQuality\n\n// Write enhanced JD to its own output file\nWriteFile({ fileName: \"enhanced_jd.json\", filePath: \"\", contents: JSON.stringify(enhancedJD, null, 2) })\n\n// Verify\nconst verify = ReadFile(\"enhanced_jd.json\")\nif (!verify) {\n  ERROR: \"enhanced_jd.json write failed\"\n  STOP\n}\n\n```\n\n---\n### Phase 9: Display Completion Message\n\n**Objective:** Output completion message. Server strips `pipeline_status:` tag before displaying to user.\n\n```\n# ✓ JD Enhancer Complete\nEnhanced JD written — {requirements.required_qualifications.length} required + {requirements.preferred_qualifications.length} preferred qualifications, {roleDetails.key_responsibilities.length} responsibilities.\n\npipeline_status: JD_ENHANCED\n```\n\nTurn ENDS here. Server sets JD_ENHANCED, fires Analyst + Tone Analyst in parallel.\n\n---\n\n## Error Handling\n\n| Error | Action |\n|-------|--------|\n| project_meta.json missing | Critical error, switch to Main Orchestrator |\n| research_output.json missing | Critical error, switch to Main Orchestrator |\n| JD file cannot be read | Request re-upload |\n| JD file empty | Request valid file |\n| research_data missing | Re-run Researcher |\n| research_data insufficient | Proceed with limited enhancement |\n| Enhancement quality FAILED | Proceed anyway, log issue |\n| WriteFile fails | Critical error, notify user |\n| Filename has slash | CRITICAL ERROR |\n\n---\n\n## Expected File Structure\n\n**After JD Enhancer completes:**\n```\nproject_directory/\n├─ cv_raw.txt\n├─ jd_raw.txt\n├─ project_meta.json (unchanged)\n├─ candidate_profile.json\n├─ research_output.json (unchanged)\n├─ enhanced_jd.json (written)\n```\n\n**All files at root level. No subdirectories.**\n\n---\n\n## Critical Rules\n\n**`getCurrentISOTimestamp()` implementation** — When writing any date/time field, extract the current date from the system context (\"Today's date is YYYY-MM-DD\") and return it as ISO 8601: `YYYY-MM-DDT00:00:00Z`. **Never hardcode a specific date string** (e.g. \"2026-03-31T00:00:00Z\") — that is a fabrication error. If no system date is visible, use the most recent date mentioned in the conversation.\n\n1. **Use bare filenames** - `\"enhanced_jd.json\"` not `\"/enhanced_jd.json\"`\n2. **No leading slashes** - Never start filename with `/`\n3. **No path separators** - Never use `/` or `\\` in filename\n4. **No path construction** - Use literal strings, don't concatenate\n5. **Verify before write** - Check filename has no slashes\n6. **Always stringify JSON** - `WriteFile({ fileName: \"enhanced_jd.json\", filePath: \"\", contents: JSON.stringify(data, null, 2) })`\n7. **Verify write succeeded** - Read file back after writing\n8. **Use actual current date** - Never hardcode timestamps\n9. **Combine JD + research** - Enrich with company *context*; never let research mint, rename, or expand a requirement or responsibility (see Requirements Firewall). `requirements.*` and `role_details.key_responsibilities` come ONLY from jd_raw.txt.\n12. **Capture the Mandatory Requirements block** - Scan BOTH the numbered Selection Criteria AND any separate \"Mandatory Requirements\" / \"Conditions of Employment\" / \"Essential Requirements\" block (Phase 4.3). Merge statutory items into `required_qualifications`, deduped. Phase 6.0 statutory keyword guard is the safety net — never ship `enhanced_jd` with a statutory gate (WWCC, police check, immunisation, right to work, First Aid/CPR/anaphylaxis) present in `jd_raw.txt` but absent from `required_qualifications`.\n10. **Output `pipeline_status: JD_ENHANCED`** as last line of completion message — server strips it, fires Analyst + Tone Analyst in parallel\n13. **Display completion message** - Show user what was enhanced\n14. **⛔ DO NOT display \"Send any message to continue\"** - Server routes automatically; no user prompt needed\n11. **⛔ DO NOT call SwitchAgent on completion** - Server reads JD_ENHANCED and routes to Analyst + Tone Analyst automatically. Only call ChangeAgent(\"Main Orchestrator\") on errors.\n\n---\n\n","query":"","jsonResponse":false,"jsonFormat":"","jsonSchemaMode":"typescript","fileParser":"native","imageAspectRatio":"1:1","maxIterations":10,"reasoningEffort":"medium","allowFallbacks":true,"temperature":1},"service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801c14.762-6.3594 14.762-27.238 0-33.719zm-210.84-6.9609c-3 6.7188-9.6016 10.801-16.559 10.801-2.3984 0-4.8008-0.48047-7.1992-1.4414-64.078-28.078-114.72-78.719-142.68-142.8-4.0781-9.1211 0.12109-19.801 9.2383-23.762 9.1211-3.9609 19.68 0.23828 23.762 9.3594 24.238 55.68 68.398 99.84 124.08 124.2 9.1211 3.9609 13.32 14.52 9.3594 23.641z\"/>\n <path d=\"m1113.1 322.08-109.56-47.762c-26.52-11.641-47.641-32.762-59.281-59.281l-47.762-109.56c-3.7188-8.5195-15.84-8.5195-19.559 0l-47.762 109.56c-11.641 26.52-32.762 47.641-59.281 59.281l-109.68 47.879c-8.5195 3.7188-8.5195 15.719-0.12109 19.441l111.72 49.32c26.398 11.762 47.52 33 58.922 59.52l46.32 107.64c3.6016 8.5195 15.719 8.5195 19.441 0l47.762-109.44c11.641-26.52 32.762-47.641 59.281-59.281l109.56-47.762c8.5195-3.7188 8.5195-15.84 0-19.559zm-149.28 15.84c-3.4805 5.6406-9.3594 8.6406-15.48 8.6406-3.1211 0-6.3594-0.83984-9.2383-2.5195-24.84-15.121-45.359-34.922-61.199-59.16-5.3984-8.3984-3-19.441 5.2812-24.961 8.2812-5.3984 19.441-3.1211 24.84 5.2812 12.961 19.68 29.641 35.762 49.68 48 8.5195 5.1602 11.281 16.199 6.1211 24.719z\"/>\n</svg>\n","color":"#42a5f5","mdHelp":"/docs/help/service.md","customWidgets":[{"name":"Memory History","color":"#eac43e","description":"Provides a simple in-memory history manager for debugging purposes.","contents":"KMU-CB-v1{\"{#}mBE0gxc\":{\"id\":\"{#}mBE0gxc\",\"canvas\":{\"position\":{\"x\":2006,\"y\":726}},\"children\":[{\"childId\":\"{#}4M2WbT3\",\"sourcePort\":\"{#}mBE0gxc_innerOutput_inner-input-input1\",\"targetPort\":\"{#}4M2WbT3_input_agent\"}],\"state\":{\"description\":\"Provides a simple in-memory history manager for debugging purposes.\",\"inputs\":[{\"index\":0,\"label\":\"agent\",\"name\":\"input1\",\"type\":[5],\"position\":{\"x\":519,\"y\":291}}],\"outputs\":[],\"name\":\"Memory History\",\"type\":\"custom\",\"color\":\"#eac43e\",\"icon\":\"database\",\"canvasPosition\":{\"x\":0,\"y\":0},\"markdownHelp\":\"\",\"settings\":[],\"protocolVersion\":\"2\"},\"type\":\"widgetGroup\"},\"{#}4M2WbT3\":{\"id\":\"{#}4M2WbT3\",\"canvas\":{\"position\":{\"x\":659,\"y\":341}},\"children\":[{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_getHistory\",\"targetPort\":\"{#}jCnteeA_input_read\"},{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_updateHistory\",\"targetPort\":\"{#}jCnteeA_input_update\"}],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{\"includeAttachments\":false,\"timeout\":60},\"variantId\":\"history\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\