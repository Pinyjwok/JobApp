14-310.13v58.219h0.046875c0 4.7344 1.2188 9.6094 3.7969 14.016 7.7344 13.078 24.609 17.438 37.688 9.7031l227.95-135.37c3.9375-2.25 7.4062-5.625 9.8906-9.8438 7.7344-13.078 3.375-29.953-9.7031-37.641l-226.64-134.63c-4.4062-3.0469-9.75-4.7812-15.516-4.7812-15.234 0-27.562 12.328-27.562 27.562v59.719c-61.125 8.7656-151.6 31.031-238.13 87.703-99.375 65.062-193.4 174.89-231.89 360.24-3.8438 14.203 4.2188 29.062 18.375 33.469 14.531 4.5 29.906-3.6094 34.453-18.094zm266.16-33.516c18.188-18.188 43.266-29.391 71.016-29.391 27.703 0 52.828 11.25 71.016 29.391 18.188 18.188 29.391 43.266 29.391 71.016 0 27.703-11.25 52.828-29.391 71.016-18.188 18.188-43.266 29.391-71.016 29.391-27.703 0-52.828-11.25-71.016-29.391-18.188-18.188-29.391-43.266-29.391-71.016 0-27.703 11.25-52.828 29.391-71.016zm293.91 8.7227c11.109-8.9531 13.453-24.844 5.7188-36.562l-29.531-51.141c-6.9844-12.141-21.844-16.922-34.406-11.625l-41.672 16.031c-8.625-7.3125-17.906-13.875-27.75-19.547-9.7031-5.625-20.016-10.406-30.703-14.297l-7.0781-44.766c-2.1094-13.594-13.781-23.25-27.141-23.25v-0.09375h-60.75c-14.625 0-26.531 11.344-27.516 25.688l-6.6094 42.094c-10.828 3.6562-21.188 8.3906-30.891 14.016-9.9844 5.7656-19.312 12.469-28.031 20.109l-42.141-16.219c-12.797-4.875-27 0.42188-33.609 11.953l-30.328 52.594c-6.8438 11.859-3.7969 26.766 6.5625 35.109l35.297 28.547c-0.42188 2.5312-0.84375 5.0625-1.1719 7.6406-1.2188 8.9062-1.875 17.625-1.875 26.062s0.60938 17.203 1.875 26.062c0.32813 2.5781 0.75 5.1094 1.1719 7.6406l-35.297 28.547c-11.109 8.9531-13.453 24.844-5.7188 36.562l29.531 51.141c6.9844 12.188 21.844 16.922 34.406 11.625l41.672-16.031c8.625 7.3125 17.906 13.875 27.75 19.547 9.75 5.625 20.016 10.406 30.703 14.297l7.0781 44.766c2.1094 13.594 13.781 23.25 27.141 23.25v0.09375h60.75c14.625 0 26.531-11.344 27.516-25.688l6.7031-42.469c10.688-3.8438 20.953-8.6719 30.703-14.297 9.8438-5.6719 19.125-12.234 27.75-19.547l42.516 16.359c12.797 4.875 27-0.42188 33.609-11.953l30.328-52.594c6.8438-11.859 3.7969-26.766-6.5625-35.109l-35.297-28.547c0.46875-2.5312 0.84375-5.0625 1.1719-7.6406 1.2188-8.9062 1.875-17.625 1.875-26.062s-0.60937-17.203-1.875-26.062c-0.375-2.5781-0.75-5.1562-1.1719-7.6406l35.297-28.547z\" fill-rule=\"evenodd\"/>\n</svg>\n","inputs":[{"name":"input","description":"Data to submit","type":6}],"color":"#68bb6c"},{"id":"history","name":"History","description":"Manage conversation history and session storage for AI agents","svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m1003.2 198c-216-216-560.4-220.8-784.8-19.199l-60-60c-19.199-19.199-52.801-9.6016-58.801 16.801l-68.398 280.8c-6 25.199 16.801 49.199 43.199 43.199l280.8-68.398c26.398-6 36-39.602 16.801-58.801l-66-66c176.4-153.6 444-148.8 612 19.199 174 174 174 459.6-1.1992 634.8l-16.801 15.602c-25.199 22.801-26.398 61.199-4.8008 86.398 12 13.199 28.801 20.398 45.602 20.398 14.398 0 28.801-4.8008 40.801-15.602 7.1992-6 14.398-13.199 20.398-20.398 223.2-223.2 223.2-585.6 1.1992-808.8z\"/>\n <path d=\"m739.2 1028.4-22.801 7.1992c-32.398 8.3984-51.602 42-43.199 75.602 7.1992 27.602 32.398 45.602 58.801 45.602 4.8008 0 10.801-1.1992 15.602-2.3984 9.6016-2.3984 19.199-6 28.801-8.3984 32.398-10.801 49.199-45.602 38.398-76.801-8.4023-33.602-43.199-51.602-75.602-40.805z\"/>\n <path d=\"m532.8 1046.4-24-3.6016c-33.602-7.1992-66 14.398-72 48-7.1992 33.602 14.398 66 48 72 9.6016 2.3984 20.398 3.6016 30 4.8008 2.3984 0 6 1.1992 9.6016 1.1992 30 0 56.398-21.602 60-52.801 4.7969-33.598-18.004-64.797-51.602-69.598z\"/>\n <path d=\"m321.6 955.2c-26.398-20.398-64.801-16.801-86.398 9.6016-20.398 26.398-16.801 64.801 9.6016 86.398 8.3984 6 15.602 12 24 18 10.801 7.1992 22.801 10.801 34.801 10.801 19.199 0 38.398-8.3984 50.398-26.398 19.199-27.602 13.199-66-14.398-85.199z\"/>\n <path d=\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1782122874}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"groupId":"{#}0lfMQFT"},"{#}lbbSd2S":{"id":"{#}lbbSd2S","canvas":{"position":{"x":810,"y":632}},"children":[{"childId":"{#}4Ji8tZo","sourcePort":"{#}lbbSd2S_output_sessionHistoryOutput","targetPort":"{#}4Ji8tZo_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}0lfMQFT"},"{#}8Aw6bVU":{"id":"{#}8Aw6bVU","canvas":{"position":{"x":562,"y":248}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}0lfMQFT"},"{#}ItaE4iK":{"id":"{#}ItaE4iK","canvas":{"position":{"x":1661,"y":1049}},"children":[{"childId":"{#}cR8gSUw","sourcePort":"{#}ItaE4iK_output_tools","targetPort":"{#}cR8gSUw_input_outer-input-input1"},{"childId":"{#}VTURa1c","sourcePort":"{#}ItaE4iK_output_history","targetPort":"{#}VTURa1c_input_outer-input-input1"},{"childId":"{#}9Y7JKT4","sourcePort":"{#}ItaE4iK_output_reasoning","targetPort":"{#}9Y7JKT4_input_setValue"},{"childId":"{#}XDfdqpb","sourcePort":"{#}ItaE4iK_output_debug","targetPort":"{#}XDfdqpb_input_setValue"},{"childId":"{#}GAdONza","sourcePort":"{#}ItaE4iK_output_text","targetPort":"{#}GAdONza_input_setValue"},{"childId":"{#}0K51WV5","sourcePort":"{#}ItaE4iK_output_text","targetPort":"{#}0K51WV5_input_event"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"selectedModel":{"id":"anthropic/claude-sonnet-4.6","slug":"anthropic/claude-4.6-sonnet-20260217","name":"Anthropic: Claude Sonnet 4.6","description":"Sonnet 4.6 is Anthropic's most capable Sonnet-class model yet, with frontier performance across coding, agents, and professional work. It excels at iterative development, complex codebase navigation, end-to-end project management with...","inputModalities":["text","image"],"outputModalities":["text"],"supportsTools":true,"supportsReasoning":true,"promptPrice":0.000003,"completionPrice":0.000015,"maxTokens":128000,"contextLength":1000000,"provider":"anthropic"},"systemInstructions":"# Integrity Checker v3.2 — System Instructions\n\n**Version:** 3.2\n**Last Updated:** 2026-06-22\n**Role:** Evidence Validation & Final Check\n**Pipeline Position:** Assembly Phase 8\n**Trigger:** Dispatched sequentially by server after Style Review passed (or gate_continue action)\n**Output:** Updates `phases[7]`, sets `current_phase = 9` (signals completion)\n\n> **v3.2 — fabrication + sector-misuse backstop (TC05).** The gate is the safety net for the source\n> fixes upstream. Two additions: (1) named worked examples of the fabrications that propagated in TC05\n> (CRM / commercialisation / market expansion / \"Implementation & Management level experience\") under\n> the invented-skill rule — these FAIL when not in `cv_raw.txt`; (2) a new `SECTOR_MISUSE` status —\n> flag sector-loaded terms used outside their real sector meaning. Verdict logic unchanged (strict\n> PASSED/FAILED; any unsupported claim fails).\n\n> **v3.1 — semantic-entailment tune.** Two changes from v3.0: (1) a claim that is a *fair\n> generalization* of a stated fact now PASSES (the upstream writers polish and synthesize prose, and\n> graceful synthesis should not be punished); FAILED is reserved for invented facts. (2) You no longer\n> have to produce an exact claim count — the **list of violations is what matters**. Everything else is\n> unchanged: same evidence statuses, same dual-track rule, same strict PASSED/FAILED gate. v3.0 was the\n> de-code (procedural JavaScript removed; only the output JSON shape and the filename/date guards remain\n> as literal specs).\n\n---\n\n## Role\n\nValidate that every claim in the assembled CV and cover letter has real evidence. A claim is\nsupported only if it is stated (or clearly implied / metric-reformatted) in the original CV, OR\nexplicitly confirmed by the candidate during the gap interview. Anything else is unsupported, and\n**one unsupported claim fails the whole check.**\n\n---\n\n## Inputs (read these)\n\n- `cv_assembly_state.json` — the assembled sections live in `phases[N].data`:\n  - `phases[1].data` profile · `phases[2].data` skills · `phases[3].data` history ·\n    `phases[4].data` credentials · `phases[5].data` cover letter · `phases[0].data` style overrides\n- `candidate_profile.json` — extracted CV data (publications, awards, work history)\n- `gap_analysis.json` — the gaps, plus the gap-interview results:\n  - `candidate_provided_evidence[]` — each entry has `candidate_provided_evidence` (the user's words),\n    `gap_text`, and `adjudication`. **Only entries with `adjudication === \"ACCEPTED\"` count as evidence.**\n  - `gaps[]` — any skill named here is a known gap (see fabrication rule below)\n- `cv_raw.txt` — the candidate's original CV. The primary source of truth.\n- `project_meta.json` — `company_name`, `position_title` (for the exemption rule)\n- `research_output.json` — company/role facts (for the exemption rule)\n\n---\n\n## How to validate (semantic judgment — NOT keyword matching)\n\nFor every claim, apply a **dual track**:\n\n- **Track 1 — Source CV.** Is the claim directly stated, clearly implied, or a metric reformat of\n  something the candidate actually wrote in `cv_raw.txt`? Bullets are reworded — do not require an\n  exact word match; the underlying activity/result/responsibility must be present.\n- **Track 2 — Session evidence.** If Track 1 fails, was the employer or activity explicitly confirmed\n  in an ACCEPTED gap answer? That confirms the *fact*, but NOT specific differing details (e.g. dates).\n\nAssign each claim one **evidence status**:\n\n| Status | Meaning |\n|--------|---------|\n| `PASSED` | stated or clearly implied in `cv_raw.txt` |\n| `PASSED_SESSION` | fact/activity confirmed in ACCEPTED session evidence; details consistent |\n| `DATES_UNVERIFIED` | employer/role session-confirmed, but assembled dates differ from session / aren't in `cv_raw.txt`. Remediation = correct the dates, never remove the entry |\n| `NOT_FOUND` | absent from BOTH `cv_raw.txt` AND session evidence. No source |\n| `GAP_SKILL_FABRICATED` | the skill appears in `gap_analysis.gaps` — unsupported regardless of raw text |\n| `UNVERIFIED_DETAIL` | a publication/award not mentioned or referenced in `cv_raw.txt` |\n| `SECTOR_MISUSE` | a sector-loaded term used outside its real meaning for the candidate's sector (see below) — credibility failure, treat as unsupported |\n\n**Sector-misuse check.** Read the candidate's sector (`project_meta.sector`). Flag a claim\n`SECTOR_MISUSE` when it uses a sector-loaded term in a sense the candidate's record does not support\nfor that sector. Higher-education lexicon: **\"commercialisation\"** = research IP / spin-outs /\ntechnology transfer (NOT revenue partnerships or business development); **\"industry partnerships\"** =\nrelationships with commercial employers / research-industry partners (NOT education-to-education\nenrolment arrangements or third-party campuses). A sectorally-misaligned term is a credibility failure,\ncounted as an unsupported claim for the verdict.\n\n**Fair generalization PASSES; invented facts FAIL.** A claim that is a reasonable, faithful\ngeneralization or rewording of something the candidate actually stated is supported — the writers\nsynthesize and polish prose, and that is allowed. Examples that PASS: \"managed a team of 5\" →\n\"leadership experience\"; \"ran the Storypark documentation\" → \"experienced with digital learning\ndocumentation\". `FAILED` is reserved for **invented facts**:\n\n- an **invented metric or number** — a figure, percentage, count, or scale not in the source (e.g. CV\n  says \"supported a team\" → assembled \"managed a team of 50\");\n- an **invented hard skill, tool, or technology** not in the source. TC05 worked examples that must\n  FAIL when absent from `cv_raw.txt`: \"CRM\" / \"CRM platforms\", \"commercialisation\" /\n  \"commercial operations\", \"market expansion\", \"industry partnerships\" asserted as a candidate\n  capability, and fabricated scope descriptors like \"Implementation & Management level experience\"\n  hung on a clearance. A job title in the record does not make any of these supported;\n- a **credential claim** with no matching entry (see the credential rule below);\n- anything that **contradicts** the source.\n\n**Pure inference is still not evidence.** \"Reasonable inference from a senior role\", \"implied by\nframing\", \"inferred from context\", \"consistent with this type of role\" do NOT support a *new* fact\nthat the candidate never stated. The line: faithfully restating/generalizing what IS there = PASS;\nasserting something that ISN'T there because the role \"suggests\" it = `NOT_FOUND`.\n\n**Credential category rule.** A formal credential claim (e.g. \"ACORN-credentialled\",\n\"ALS-certified\") needs a formal entry in `education[]` or `certifications[]`. A standards/guidelines\nreference (\"follows ACORN triage standards\") does NOT support a credential claim → `NOT_FOUND`.\n\n**Examples.** \"Reduced ticket triage time by 77%\" is supported if the CV mentions the initiative and\nthe figure. \"Managed a team of 50\" is NOT supported if the CV only says \"supported a team.\"\n\n### Context exemption — do NOT validate these against `cv_raw.txt`\nThese are not claims about the candidate; flagging them is a false positive:\n1. The target company name (`project_meta.company_name`) and position title (`position_title`).\n2. Any statement about the company's culture, mission, values, initiatives, or news (from\n   `research_output.json`) — e.g. \"DXC's people-first approach\".\n3. Cover-letter framing that connects the candidate TO the company (\"I am drawn to your\n   Application Modernization stream\") — persuasion, not a factual history claim.\n\nRule: if a cover-letter sentence is primarily about the company/role rather than what the candidate\nHAS DONE or CAN DO, skip it. Only validate sentences asserting something specific about the candidate.\n\n---\n\n## What to check\n\nWalk these sections and collect every unsupported claim (with its `section` and `evidence_status`):\n\n1. **Profile** (`phases[1].data` profile paragraph) — every factual assertion: titles, years, achievements.\n2. **Skills** (`phases[2].data` technical + soft) — any skill that is a known gap →\n   `GAP_SKILL_FABRICATED`; otherwise must be mentioned/demonstrated/inferable in `cv_raw.txt`.\n3. **Career history** (`phases[3].data` work history) — dual-track every bullet under its employer.\n   Session-confirmed employer with conflicting dates → `DATES_UNVERIFIED` (+ remediation), not removal.\n4. **Additional information** — publications & awards from `candidate_profile.json` not referenced in\n   `cv_raw.txt` → `UNVERIFIED_DETAIL`.\n5. **Cover letter** (`phases[5].data.cover_letter`) — specific factual claims only (metrics, roles,\n   skills). Generic statements (\"strong communicator\") need no verification. Apply the exemption above.\n\n---\n\n## Verdict\n\n- **Status is exactly `PASSED` or `FAILED`.** No other value (any other bypasses the AC safety gate).\n- If **any** unsupported claim remains — regardless of count or framing — status is `FAILED`. Never\n  retain a `NOT_FOUND` claim under \"ATS optimization\".\n- On FAILED, set `cv_assembly_state.metadata.status = \"INTEGRITY_FAILED\"` before writing.\n\n---\n\n## Output — write to `phases[7].data`\n\nWrite this exact shape into `cv_assembly_state.json` (`ic_corrections` = only IC-flagged statuses:\n`NOT_FOUND`, `GAP_SKILL_FABRICATED`, `UNVERIFIED_DETAIL`, `DATES_UNVERIFIED`).\n\n**The `unsupported_claims_detail` list is the authoritative output** — it must contain every\nviolation you found. The numeric counts (`total_claims_checked`, `unsupported_claims`) are\n**approximate** and exist only for the schema; do not labour over an exact tally or re-read sections to\nget a precise number. `unsupported_claims` should simply reflect the length of the detail list; set\n`total_claims_checked` to a rough estimate. Counting precision never affects the verdict — the verdict\nis driven entirely by whether the violations list is empty.\n\n```json\n{\n  \"integrity_status\": \"PASSED | FAILED\",\n  \"total_claims_checked\": 0,\n  \"unsupported_claims\": 0,\n  \"unsupported_claims_detail\": [\n    { \"claim\": \"...\", \"section\": \"career_history\", \"evidence_status\": \"NOT_FOUND\", \"remediation\": \"(only for DATES_UNVERIFIED)\" }\n  ],\n  \"ic_corrections\": [],\n  \"fabrications_found\": [],\n  \"checks_performed\": [\"profile\", \"skills\", \"career_history\", \"cover_letter\", \"additional_information\"],\n  \"evidence_verification\": { \"method\": \"semantic_entailment\" }\n}\n```\n\nThen finalize the state object:\n- `phases[7].status = \"COMPLETE\"`, `phases[7].completed_at = \"__DATE_TODAY__T00:00:00Z\"`\n- `current_phase = 9` · `metadata.completed_phases += 1` · `metadata.last_updated = \"__DATE_TODAY__T00:00:00Z\"`\n- Read-modify-write the existing `cv_assembly_state.json` — never reconstruct from scratch.\n- `WriteFile(\"cv_assembly_state.json\", JSON.stringify(cvState, null, 2))`\n\n---\n\n## Display & return\n\n**On FAILED** — number every issue and end the turn:\n\n```\n## ⚠ Integrity Check Failed\n\n{N} issue(s) found — see breakdown below.\n\n**Remove — no source found ({count}):**\n1. [section] claim\n...\n\n**Correct — session evidence conflicts with assembled CV ({count}):**\n{n}. [section] claim → remediation\n...\n\nEach issue is numbered above. You can:\n- Type **\"fix N: [your evidence]\"** — provide evidence for a specific claim\n- Type **\"remove N\"** — authorise removal of a specific claim\n- Type **\"accept all\"** — proceed with all corrections applied\n- Click **\"Apply date corrections\"** — auto-corrects DATES_UNVERIFIED items using session evidence\n- Click **\"Continue anyway\"** — proceed to document formatting without changes\n\npipeline_status: INTEGRITY_FAILED\n```\n\n**On PASSED** — end the turn:\n\n```\n# ✓ Integrity Checker Complete\n\nAll CV claims validated against source data.\n- Integrity status: PASSED\n- Claims checked: {total_claims_checked}\n- Unsupported claims: 0\n- IC corrections made: {count}\n\npipeline_status: CV_TAILORED\n```\n\n---\n\n## ⚠️ Critical Rules\n\n1. **Bare filenames only** — `\"cv_assembly_state.json\"`, never a leading slash, never prepend\n   `workspace` (`\"workspacecv_assembly_state.json\"` is WRONG), never concatenate any path prefix.\n2. **Always stringify** — `WriteFile(name, JSON.stringify(data, null, 2))`.\n3. **`candidate_profile.json`** — never `user_profile.json`.\n4. **Read section data from `phases[N].data`** — not `cvState.sections`. Update `phases[7]` only.\n5. **`current_phase = 9`** signals all 8 phases complete to the Assembly Coordinator.\n6. **Never compute dates** — write the literal token `__DATE_TODAY__T00:00:00Z`; the server\n   substitutes the real Australian date. `getCurrentISOTimestamp()` is retired.\n7. **`pipeline_status` tag is the last display line** — `CV_TAILORED` on pass, `INTEGRITY_FAILED`\n   on fail. No `SwitchAgent`, no `set_status`.\n8. **JSON escaping** — single quotes are not special in JSON; write `\"it's\"` not `\"it\\'s\"`. Only\n   `\"`, `\\`, and control characters need escaping.\n9. **Status is `PASSED` or `FAILED` only** — any other value bypasses the gate.\n10. **Inference is not evidence** · **credential ≠ standards reference** · **dual-track every history\n    entry** · **DATES_UNVERIFIED corrects dates, never removes** — see the validation rules above.\n","query":"","jsonResponse":false,"jsonFormat":"","jsonSchemaMode":"typescript","fileParser":"native","imageAspectRatio":"1:1","maxIterations":15,"reasoningEffort":"medium","allowFallbacks":true,"temperature":0},"service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801c14.762-6.3594 14.762-27.238 0-33.719zm-210.84-6.9609c-3 6.7188-9.6016 10.801-16.559 10.801-2.3984 0-4.8008-0.48047-7.1992-1.4414-64.078-28.078-114.72-78.719-142.68-142.8-4.0781-9.1211 0.12109-19.801 9.2383-23.762 9.1211-3.9609 19.68 0.23828 23.762 9.3594 24.238 55.68 68.398 99.84 124.08 124.2 9.1211 3.9609 13.32 14.52 9.3594 23.641z\"/>\n <path d=\"m1113.1 322.08-109.56-47.762c-26.52-11.641-47.641-32.762-59.281-59.281l-47.762-109.56c-3.7188-8.5195-15.84-8.5195-19.559 0l-47.762 109.56c-11.641 26.52-32.762 47.641-59.281 59.281l-109.68 47.879c-8.5195 3.7188-8.5195 15.719-0.12109 19.441l111.72 49.32c26.398 11.762 47.52 33 58.922 59.52l46.32 107.64c3.6016 8.5195 15.719 8.5195 19.441 0l47.762-109.44c11.641-26.52 32.762-47.641 59.281-59.281l109.56-47.762c8.5195-3.7188 8.5195-15.84 0-19.559zm-149.28 15.84c-3.4805 5.6406-9.3594 8.6406-15.48 8.6406-3.1211 0-6.3594-0.83984-9.2383-2.5195-24.84-15.121-45.359-34.922-61.199-59.16-5.3984-8.3984-3-19.441 5.2812-24.961 8.2812-5.3984 19.441-3.1211 24.84 5.2812 12.961 19.68 29.641 35.762 49.68 48 8.5195 5.1602 11.281 16.199 6.1211 24.719z\"/>\n</svg>\n","color":"#42a5f5","mdHelp":"/docs/help/service.md","customWidgets":[{"name":"Memory History","color":"#eac43e","description":"Provides a simple in-memory history manager for debugging purposes.","contents":"KMU-CB-v1{\"{#}mBE0gxc\":{\"id\":\"{#}mBE0gxc\",\"canvas\":{\"position\":{\"x\":2006,\"y\":726}},\"children\":[{\"childId\":\"{#}4M2WbT3\",\"sourcePort\":\"{#}mBE0gxc_innerOutput_inner-input-input1\",\"targetPort\":\"{#}4M2WbT3_input_agent\"}],\"state\":{\"description\":\"Provides a simple in-memory history manager for debugging purposes.\",\"inputs\":[{\"index\":0,\"label\":\"agent\",\"name\":\"input1\",\"type\":[5],\"position\":{\"x\":519,\"y\":291}}],\"outputs\":[],\"name\":\"Memory History\",\"type\":\"custom\",\"color\":\"#eac43e\",\"icon\":\"database\",\"canvasPosition\":{\"x\":0,\"y\":0},\"markdownHelp\":\"\",\"settings\":[],\"protocolVersion\":\"2\"},\"type\":\"widgetGroup\"},\"{#}4M2WbT3\":{\"id\":\"{#}4M2WbT3\",\"canvas\":{\"position\":{\"x\":659,\"y\":341}},\"children\":[{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_getHistory\",\"targetPort\":\"{#}jCnteeA_input_read\"},{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_updateHistory\",\"targetPort\":\"{#}jCnteeA_input_update\"}],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{\"includeAttachments\":false,\"timeout\":60},\"variantId\":\"history\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=\\\"M12 12c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\\\" fill=\\\"white\\\"/>\\n  <rect x=\\\"10\\\" y=\\\"19\\\" width=\\\"4\\\" height=\\\"3\\\" rx=\\\"1\\\" fill=\\\"currentColor\\\"/>\\n</svg>\",\"color\":\"#42a5f5\",\"inputs\":[{\"name\":\"query\",\"description\":\"Query string for the agent\",\"type\":1},{\"name\":\"attachments\",\"description\":\"Attachments for the agent (String, BinaryFile, ImageData, or Array of these types)\",\"type\":[1,12,7,3]},{\"name\":\"clear\",\"description\":\"Clear input signal\",\"type\":6},{\"name\":\"abort\",\"description\":\"Abort current query signal\",\"type\":6},{\"name\":\"send\",\"description\":\"Send input signal\",\"type\":6}],\"outputs\":[{\"name\":\"tools\",\"type\":5},{\"name\":\"history\",\"type\":5},{\"name\":\"json\",\"type\":5},{\"name\":\"text\",\"type\":1},{\"name\":\"stream\",\"type\":1},{\"name\":\"images\",\"description\":\"Generated images as ImageData array\",\"type\":3}],\"supportedPlatforms\":[\"win-x86\",\"win-x64\",\"osx-x64\",\"osx-arm64\",\"linux-debian-arm64\",\"linux-debian-x64\",\"linux-rhel-arm64\",\"linux-rhel-x64\"],\"author\":\"db618814-4e68-40aa-8158-64a595fea23b\",\"defaultVariantInfo\":{\"title\":\"Agent\",\"shortTitle\":\"Agent\",\"description\":\"AI agent that processes queries with system instructions and attachments\"},\"variants\":[{\"id\":\"tool\",\"name\":\"Tool\",\"description\":\"Define tools with arguments and results for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Tool icon - wrench/settings -->\\n  <path d=\\\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Tool input data\",\"type\":5}],\"outputs\":[{\"name\":\"arguments\",\"description\":\"Tool arguments\",\"type\":5}],\"color\":\"#42a5f5\"},{\"id\":\"submit\",\"name\":\"Submit\",\"description\":\"Submit data without any processing\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Submit icon - send/arrow -->\\n  <path d=\\\"M2.01 21L23 12 2.01 3 2 10l15 2-15 2z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Data to submit\",\"type\":6}],\"color\":\"#68bb6c\"},{\"id\":\"history\",\"name\":\"History\",\"description\":\"Manage conversation history and session storage for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 16 16\\\">\\n  <path\\n    d=\\\"M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M8 3.5a.5.5 0 0 1 .5.5v4l2.5 1.5a.5.5 0 0 1-.5.866L7.5 8.866A.5.5 0 0 1 7.5 8V4a.5.5 0 0 1 .5-.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M2.5 8a5.5 5.5 0 0 1 5.5-5.5V1A7 7 0 0 0 1 8h1.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n</svg>\\n\",\"inputs\":[{\"name\":\"agent\",\"description\":\"Connect to the agent\",\"type\":5}],\"outputs\":[{\"name\":\"getHistory\",\"description\":\"Invoked when the agent needs to retrieve the conversation history\",\"type\":5},{\"name\":\"updateHistory\",\"description\":\"Invoked when the agent needs to update the conversation history\",\"type\":5}],\"color\":\"#9c27b0\"}],\"internal\":false,\"devMode\":true,\"sessionId\":1760512532}},\"type\":\"hubService\",\"groupId\":\"{#}mBE0gxc\"},\"{#}a5vxU9Y\":{\"id\":\"{#}a5vxU9Y\",\"canvas\":{\"position\":{\"x\":1235,\"y\":488}},\"children\":[],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{},\"variantId\":\"submit\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=\\\"M12 12c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\\\" fill=\\\"white\\\"/>\\n  <rect x=\\\"10\\\" y=\\\"19\\\" width=\\\"4\\\" height=\\\"3\\\" rx=\\\"1\\\" fill=\\\"currentColor\\\"/>\\n</svg>\",\"color\":\"#42a5f5\",\"inputs\":[{\"name\":\"query\",\"description\":\"Query string for the agent\",\"type\":1},{\"name\":\"attachments\",\"description\":\"Attachments for the agent (String, BinaryFile, ImageData, or Array of these types)\",\"type\":[1,12,7,3]},{\"name\":\"clear\",\"description\":\"Clear input signal\",\"type\":6},{\"name\":\"abort\",\"description\":\"Abort current query signal\",\"type\":6},{\"name\":\"send\",\"description\":\"Send input signal\",\"type\":6}],\"outputs\":[{\"name\":\"tools\",\"type\":5},{\"name\":\"history\",\"type\":5},{\"name\":\"json\",\"type\":5},{\"name\":\"text\",\"type\":1},{\"name\":\"stream\",\"type\":1},{\"name\":\"images\",\"description\":\"Generated images as ImageData array\",\"type\":3}],\"supportedPlatforms\":[\"win-x86\",\"win-x64\",\"osx-x64\",\"osx-arm64\",\"linux-debian-arm64\",\"linux-debian-x64\",\"linux-rhel-arm64\",\"linux-rhel-x64\"],\"author\":\"db618814-4e68-40aa-8158-64a595fea23b\",\"defaultVariantInfo\":{\"title\":\"Agent\",\"shortTitle\":\"Agent\",\"description\":\"AI agent that processes queries with system instructions and attachments\"},\"variants\":[{\"id\":\"tool\",\"name\":\"Tool\",\"description\":\"Define tools with arguments and results for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Tool icon - wrench/settings -->\\n  <path d=\\\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Tool input data\",\"type\":5}],\"outputs\":[{\"name\":\"arguments\",\"description\":\"Tool arguments\",\"type\":5}],\"color\":\"#42a5f5\"},{\"id\":\"submit\",\"name\":\"Submit\",\"description\":\"Submit data without any processing\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Submit icon - send/arrow -->\\n  <path d=\\\"M2.01 21L23 12 2.01 3 2 10l15 2-15 2z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Data to submit\",\"type\":6}],\"color\":\"#68bb6c\"},{\"id\":\"history\",\"name\":\"History\",\"description\":\"Manage conversation history and session storage for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 16 16\\\">\\n  <path\\n    d=\\\"M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M8 3.5a.5.5 0 0 1 .5.5v4l2.5 1.5a.5.5 0 0 1-.5.866L7.5 8.866A.5.5 0 0 1 7.5 8V4a.5.5 0 0 1 .5-.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M2.5 8a5.5 5.5 0 0 1 5.5-5.5V1A7 7 0 0 0 1 8h1.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n</svg>\\n\",\"inputs\":[{\"name\":\"agent\",\"description\":\"Connect to the agent\",\"type\":5}],\"outputs\":[{\"name\":\"getHistory\",\"description\":\"Invoked when the agent needs to retrieve the conversation history\",\"type\":5},{\"name\":\"updateHistory\",\"description\":\"Invoked when the agent needs to update the conversation history\",\"type\":5}],\"color\":\"#9c27b0\"}],\"internal\":false,\"devMode\":true,\"sessionId\":1760512532}},\"type\":\"hubService\",\"secrets\":{\"OPENROUTER_API_KEY\":{\"name\":\"OPENROUTER_API_KEY\",\"hubServiceName\":\"kemu.io.ai-agent\"}},\"groupId\":\"{#}mBE0gxc\"},\"{#}jCnteeA\":{\"id\":\"{#}jCnteeA\",\"canvas\":{\"position\":{\"x\":948,\"y\":397}},\"children\":[{\"childId\":\"{#}a5vxU9Y\",\"sourcePort\":\"{#}jCnteeA_output_sessionHistoryOutput\",\"targetPort\":\"{#}a5vxU9Y_input_input\"}],\"state\":{\"pauseExecution\":false,\"autoPauseOnError\":true,\"version\":2,\"metadata\":{\"name\":\"Memory History\",\"description\":\"Keeps the history messages in memory (this is intended for dev purposes only)\"},\"pages\":{\"main\":{\"code\":\"/**\\n * Name: Memory History\\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\\n */\\n\\nconst sessions = {};\\n\\nconst getWidgetInputs = () => [\\n  { name: 'read', type: DataType.JsonObj },\\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\\n];\\n\\nconst getWidgetOutputs = () => [\\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\\n];\\n\\nconst onParentEvent = async ({ targetPort, event }) => {\\n  const inputData = event.data.value;\\n\\n  if (targetPort.name === 'read') {\\n    const sessionId = inputData.sessionId;\\n\\n    if (sessionId === undefined || sessionId === null) {\\n      console.error(\\\"Error: 'read' event missing 'sessionId' property.\\\");\\n      return;\\n    }\\n\\n    if (!sessions[sessionId]) {\\n      sessions[sessionId] = { messages: [] };\\n    }\\n\\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\\n\\n  } else if (targetPort.name === 'update') {\\n    const sessionId = inputData.sessionId;\\n    const messagesToProcess = inputData.messages;\\n\\n    if (sessionId === undefined || sessionId === null) {\\n      console.error(\\\"Error: 'update' event missing 'sessionId' property.\\\");\\n      return;\\n    }\\n    if (messagesToProcess === undefined || messagesToProcess === null) {\\n      console.error(\\\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\\\");\\n      return;\\n    }\\n\\n    if (!sessions[sessionId]) {\\n      sessions[sessionId] = { messages: [] };\\n    }\\n\\n    if (Array.isArray(messagesToProcess)) {\\n      sessions[sessionId].messages.push(...messagesToProcess);\\n    } else {\\n      sessions[sessionId].messages.push(messagesToProcess);\\n    }\\n  }\\n};\",\"language\":\"javascript\",\"name\":\"My First Script\"}}},\"type\":\"script\",\"secrets\":{},\"groupId\":\"{#}mBE0gxc\"}}","rootGroupId":"{#}mBE0gxc","icon":"database","protocolVersion":"2"}],"inputs":[{"name":"config","description":"Configuration object containing query, attachments, sessionId, and systemInstructions. Can also be a string to be used as query or a boolean to trigger processing.","type":[5,4,1,6]},{"name":"abort","description":"Abort current query signal","type":6}],"outputs":[{"name":"tools","type":5},{"name":"history","type":5},{"name":"json","type":5},{"name":"text","type":1},{"name":"stream","type":1},{"name":"reasoning","description":"Reasoning output from models that support extended thinking","type":1},{"name":"images","description":"Generated images as ImageData array","type":3},{"name":"debug","description":"Includes debugging information for when things go wrong, including stopping reason","type":5}],"supportedPlatforms":["win-x86","win-x64","osx-x64","osx-arm64","linux-debian-arm64","linux-debian-x64","linux-rhel-arm64","linux-rhel-x64"],"author":"0f998d5a-a8ce-4bf8-9f84-fa8c481cb40b","defaultVariantInfo":{"title":"Agent","shortTitle":"Agent","description":"AI agent that processes queries with system instructions and attachments"},"variants":[{"id":"chatInterface","name":"Chat Interface","description":"Chat window UI that can invoke an Agent and display live outputs","svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m1034.4 486-298.78-46.781v244.78c0 26.391-10.781 50.391-31.219 67.219-15.609 14.391-36 21.609-57.609 21.609-4.7812 0-9.6094 0-14.391-1.2188l-134.39-20.391v80.391c0 15.609 7.2188 30 18 39.609 12 10.781 27.609 14.391 43.219 12l309.61-48h8.4375c1.2188 0 1.2188 1.2188 2.3906 1.2188 1.2188 1.2188 2.3906 1.2188 3.6094 2.3906l111.61 96-4.7812-103.22v-4.8281c0-1.2188 1.2188-3.6094 2.3906-4.7812 0-1.2188 0-1.2188 1.2188-1.2188 1.2188-1.2188 1.2188-1.2188 2.3906-2.3906 1.2188 0 1.2188-1.2188 2.3906-1.2188 1.2188 0 1.2188-1.2188 3.6094-1.2188 1.2188 0 1.2188-1.2188 2.3906-1.2188l28.781-4.7812c26.391-3.6094 45.609-26.391 45.609-52.781l-0.09375-217.18c1.2188-26.391-18-49.219-44.391-54z\"/>\n <path d=\"m681.61 724.78c12-9.6094 18-25.219 18-39.609v-367.18c0-15.609-7.2188-30-18-40.781-12-9.6094-27.609-14.391-43.219-12l-474 74.391c-26.391 4.781