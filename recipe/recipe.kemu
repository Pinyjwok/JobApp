 1.1992 9.6016 1.1992 30 0 56.398-21.602 60-52.801 4.7969-33.598-18.004-64.797-51.602-69.598z\"/>\n <path d=\"m321.6 955.2c-26.398-20.398-64.801-16.801-86.398 9.6016-20.398 26.398-16.801 64.801 9.6016 86.398 8.3984 6 15.602 12 24 18 10.801 7.1992 22.801 10.801 34.801 10.801 19.199 0 38.398-8.3984 50.398-26.398 19.199-27.602 13.199-66-14.398-85.199z\"/>\n <path d=\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1784443105}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"disabled":false,"groupId":"{#}qTVobGq"},"{#}atnSBbr":{"id":"{#}atnSBbr","canvas":{"position":{"x":2331,"y":882}},"children":[{"childId":"{#}eMz5ATY","sourcePort":"{#}atnSBbr_output_error","targetPort":"{#}eMz5ATY_input_input"},{"childId":"{#}JcVl73H","sourcePort":"{#}atnSBbr_output_event","targetPort":"{#}JcVl73H_input_event"}],"state":{},"type":"rescue","groupId":"{#}qTVobGq"},"{#}eMz5ATY":{"id":"{#}eMz5ATY","canvas":{"position":{"x":2632.3304331452355,"y":1070.0785941463064}},"children":[{"childId":"{#}lIBuKsS","sourcePort":"{#}eMz5ATY_output_text","targetPort":"{#}lIBuKsS_input_input"}],"state":{"text":"Invalid Tool Arguments: {{input.error.message}}","format":"Text","size":{"width":461,"height":100}},"type":"templateString","groupId":"{#}qTVobGq"},"{#}CxHpUJs":{"id":"{#}CxHpUJs","canvas":{"position":{"x":3210,"y":1220}},"children":[{"childId":"{#}lIBuKsS","sourcePort":"{#}CxHpUJs_output_text","targetPort":"{#}lIBuKsS_input_input"}],"state":{"text":"Failed to conduct research: {{input.error.message}}","format":"Text","size":{"width":220,"height":135}},"type":"templateString","groupId":"{#}qTVobGq"},"{#}39AYfed":{"id":"{#}39AYfed","canvas":{"position":{"x":3359,"y":671}},"children":[{"childId":"{#}lIBuKsS","sourcePort":"{#}39AYfed_output_summary","targetPort":"{#}lIBuKsS_input_input"},{"childId":"{#}CxHpUJs","sourcePort":"{#}39AYfed_output_error","targetPort":"{#}CxHpUJs_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Tavily Search Tool","description":"Performs a token-efficient search tailored for AI agents."},"pages":{"main":{"code":"  /**                                                                                                   \n   * Name: Tavily Search Tool                                                                           \n   * Description: Performs a token-efficient search tailored for AI agents.                             \n   */\n                                                                                                        \n  const getWidgetInputs = () => [                                                                                                                                                    \n    { name: 'query', type: DataType.String },                                                                                                                                        \n    { name: 'sector', type: DataType.String }                                                                                                                                        \n  ];                                                                                                                                                                                 \n                                                                                                                                                                                     \n  const getWidgetOutputs = () => [                                                                                                                                                   \n    { name: 'summary', type: DataType.String },                                                                                                                                      \n    { name: 'error', type: DataType.String }                                                                                                                                         \n  ];                                                                                                                                                                                 \n                                                                                                                                                                                     \n  Kemu.secrets.requestAccess('TAVILY_API_KEY');                                                                                                                                      \n                                                                                                                                                                                     \n  let storedSector = \"\";                                                                                                                                                             \n                                                                                                                                                                                     \n  const onParentEvent = async ({ targetPort, event }) => {                                                                                                                           \n                                                                                                                                                                                     \n    if (targetPort.name === 'sector' && event.data.value) {                                                                                                                          \n      storedSector = event.data.value;                                                                                                                                               \n      return;                                                                                                                                                                        \n    }                                                                                                                                                                                \n                                                                                                                                                                                     \n    if (targetPort.name === 'query' && event.data.value) {                                                                                                                           \n      try {                                                                                                                                                                          \n        const searchQuery = event.data.value;                                                                                                                                        \n        const secrets = await Kemu.secrets.read(['TAVILY_API_KEY']);                                                                                                                 \n        const apiKey = secrets['TAVILY_API_KEY'];                                                                                                                                    \n                                                                                                                                                                                     \n        const response = await fetch('https://api.tavily.com/search', {                                                                                                              \n          method: 'POST',                                                                                                                                                            \n          headers: { 'Content-Type': 'application/json' },                                                                                                                           \n          body: JSON.stringify({                                                                                                                                                     \n            api_key: apiKey,                                                                                                                                                         \n            query: searchQuery,                                                                                                                                                      \n            search_depth: \"advanced\",                                                                                                                                                \n            include_answer: true,                                                                                                                                                    \n            max_results: 10,                                                                                                                                                         \n            include_domains: [                                                                                                                                                       \n              \"linkedin.com\",                                                                                                                                                        \n              \"glassdoor.com\",                                                                                                                                                       \n              \"glassdoor.com.au\",                                                                                                                                                    \n              \"indeed.com\",                                                                                                                                                          \n              \"seek.com.au\"                                                                                                                                                          \n            ]                                                                                                                                                                        \n          })                                                                                                                                                                         \n        });                                                                                                                                                                          \n                                                                                                                                                                                     \n        const data = await response.json();                                                                                                                                       \n\n        if (data && data.results) {\n          const aiAnswer = data.answer ? `AI Summary: ${data.answer}\\n\\n` : '';                                                                                                      \n          let finalContext = `${aiAnswer}Sources:\\n`;                                                                                                                                \n                                                                                                                                                                                     \n          data.results.forEach((item, i) => {                                                                                                                                        \n            finalContext += `[${i + 1}] ${item.title}\\n   URL: ${item.url}\\n   ${item.content}\\n\\n`;                                                                                 \n          });                                                                                                                                                                        \n                                                                                                                                                                                     \n          await setOutput({                                                                                                                                                          \n            port: 'summary',                                                                                                                                                         \n            data: { type: DataType.String, value: finalContext }                                                                                                                     \n          });                                                                                                                                                                        \n        } else {                                                                                                                                                                     \n          throw new Error(\"Tavily returned an empty or invalid response\");                                                                                                           \n        }                                                                                                                                                                            \n      } catch (err) {                                                                                                                                                                \n        console.error('Search Error:', err.message);                                                                                                                                 \n        await setOutput({                                                                                                                                                            \n          port: 'error',                                                                                                                                                             \n          data: { type: DataType.String, value: err.message }                                                                                                                        \n        });                                                                                                                                                                          \n      }                                                                                                                                                                           \n    }\n  };","language":"javascript","name":"My First Script"}}},"type":"script","groupId":"{#}qTVobGq","secrets":{"TAVILY_API_KEY":{"name":"TAVILY_API_KEY"}}},"{#}WoaBjj4":{"id":"{#}WoaBjj4","canvas":{"position":{"x":-6556,"y":-7053}},"children":[],"state":{"text":"\n\n","color":"#eac43e","size":{"width":300,"height":200},"locked":false},"type":"note"},"{#}83BpzNj":{"id":"{#}83BpzNj","canvas":{"position":{"x":1843,"y":504}},"children":[{"childId":"{#}gMVOSjn","sourcePort":"{#}83BpzNj_innerOutput_inner-input-input1","targetPort":"{#}gMVOSjn_input_setValue"}],"state":{"canvasPosition":{"x":-177.77778248728055,"y":198.33849266737047},"name":"Discover Tools","description":"Provides access to the project's agent tools","inputs":[{"index":0,"label":"tools","name":"input1","type":[6],"position":{"x":304,"y":629}}],"outputs":[],"settings":[],"color":"#68bb6c","markdownHelp":"","protocolVersion":"2","type":"custom","canvasZoom":1},"type":"widgetGroup","groupId":"{#}oTKI7zl"},"{#}gMVOSjn":{"id":"{#}gMVOSjn","canvas":{"position":{"x":517,"y":524}},"children":[],"state":{"name":"Settings.Scan _Tools","reactive":false,"lastConfiguration":{"controlType":"anything","controlSettings":{"value":null},"helpText":"Routes tool scanning events to all agent tools.","group":"Settings"}},"type":"globalVariable","groupId":"{#}83BpzNj"},"{#}kRW5bRy":{"id":"{#}kRW5bRy","canvas":{"position":{"x":145,"y":173}},"children":[],"state":{"text":"# Discover Tools\n\nCopy this widget to every agent you create to allow them to access the project's tools.\n","color":"#a9b8c2","size":{"width":797,"height":200},"locked":true},"type":"note","groupId":"{#}83BpzNj"},"{#}TxOMKwS":{"id":"{#}TxOMKwS","canvas":{"position":{"x":-4320,"y":-6503}},"children":[{"childId":"{#}ziy0LTS","sourcePort":"{#}TxOMKwS_innerOutput_inner-input-input1-CDDpbo","targetPort":"{#}ziy0LTS_input_input"}],"state":{"description":"","inputs":[{"name":"input1-CDDpbo","label":"tools","type":[6],"index":0,"position":{"x":