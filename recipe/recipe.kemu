09l35.297 28.547c-0.42188 2.5312-0.84375 5.0625-1.1719 7.6406-1.2188 8.9062-1.875 17.625-1.875 26.062s0.60938 17.203 1.875 26.062c0.32813 2.5781 0.75 5.1094 1.1719 7.6406l-35.297 28.547c-11.109 8.9531-13.453 24.844-5.7188 36.562l29.531 51.141c6.9844 12.188 21.844 16.922 34.406 11.625l41.672-16.031c8.625 7.3125 17.906 13.875 27.75 19.547 9.75 5.625 20.016 10.406 30.703 14.297l7.0781 44.766c2.1094 13.594 13.781 23.25 27.141 23.25v0.09375h60.75c14.625 0 26.531-11.344 27.516-25.688l6.7031-42.469c10.688-3.8438 20.953-8.6719 30.703-14.297 9.8438-5.6719 19.125-12.234 27.75-19.547l42.516 16.359c12.797 4.875 27-0.42188 33.609-11.953l30.328-52.594c6.8438-11.859 3.7969-26.766-6.5625-35.109l-35.297-28.547c0.46875-2.5312 0.84375-5.0625 1.1719-7.6406 1.2188-8.9062 1.875-17.625 1.875-26.062s-0.60937-17.203-1.875-26.062c-0.375-2.5781-0.75-5.1562-1.1719-7.6406l35.297-28.547z\" fill-rule=\"evenodd\"/>\n</svg>\n","inputs":[{"name":"input","description":"Data to submit","type":6}],"color":"#68bb6c"},{"id":"history","name":"History","description":"Manage conversation history and session storage for AI agents","svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m1003.2 198c-216-216-560.4-220.8-784.8-19.199l-60-60c-19.199-19.199-52.801-9.6016-58.801 16.801l-68.398 280.8c-6 25.199 16.801 49.199 43.199 43.199l280.8-68.398c26.398-6 36-39.602 16.801-58.801l-66-66c176.4-153.6 444-148.8 612 19.199 174 174 174 459.6-1.1992 634.8l-16.801 15.602c-25.199 22.801-26.398 61.199-4.8008 86.398 12 13.199 28.801 20.398 45.602 20.398 14.398 0 28.801-4.8008 40.801-15.602 7.1992-6 14.398-13.199 20.398-20.398 223.2-223.2 223.2-585.6 1.1992-808.8z\"/>\n <path d=\"m739.2 1028.4-22.801 7.1992c-32.398 8.3984-51.602 42-43.199 75.602 7.1992 27.602 32.398 45.602 58.801 45.602 4.8008 0 10.801-1.1992 15.602-2.3984 9.6016-2.3984 19.199-6 28.801-8.3984 32.398-10.801 49.199-45.602 38.398-76.801-8.4023-33.602-43.199-51.602-75.602-40.805z\"/>\n <path d=\"m532.8 1046.4-24-3.6016c-33.602-7.1992-66 14.398-72 48-7.1992 33.602 14.398 66 48 72 9.6016 2.3984 20.398 3.6016 30 4.8008 2.3984 0 6 1.1992 9.6016 1.1992 30 0 56.398-21.602 60-52.801 4.7969-33.598-18.004-64.797-51.602-69.598z\"/>\n <path d=\"m321.6 955.2c-26.398-20.398-64.801-16.801-86.398 9.6016-20.398 26.398-16.801 64.801 9.6016 86.398 8.3984 6 15.602 12 24 18 10.801 7.1992 22.801 10.801 34.801 10.801 19.199 0 38.398-8.3984 50.398-26.398 19.199-27.602 13.199-66-14.398-85.199z\"/>\n <path d=\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1782122874}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"groupId":"{#}SNyQO7I"},"{#}vG78nSY":{"id":"{#}vG78nSY","canvas":{"position":{"x":820,"y":642}},"children":[{"childId":"{#}N1dPjrH","sourcePort":"{#}vG78nSY_output_sessionHistoryOutput","targetPort":"{#}N1dPjrH_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}SNyQO7I"},"{#}wdA3EJZ":{"id":"{#}wdA3EJZ","canvas":{"position":{"x":572,"y":258}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}SNyQO7I"},"{#}Hz7Bdjq":{"id":"{#}Hz7Bdjq","canvas":{"position":{"x":2177,"y":995}},"children":[],"state":{"name":"Agent Outputs.df_output","reactive":false,"lastConfiguration":{"controlType":"multilineText","controlSettings":{"value":"","placeholder":"Enter text..."},"group":"Agent Outputs","order":23}},"type":"globalVariable","groupId":"{#}Z3B89fv"},"{#}eKZ0Z8b":{"id":"{#}eKZ0Z8b","canvas":{"position":{"x":2131,"y":1234}},"children":[],"state":{"name":"Agent Reasoning.df_reasoning","reactive":false,"lastConfiguration":{"controlType":"multilineText","controlSettings":{"placeholder":"Enter text...","group":"agentReasoning"},"group":"Agent Reasoning","order":10}},"type":"globalVariable","groupId":"{#}Z3B89fv"},"{#}JHo0oiQ":{"id":"{#}JHo0oiQ","canvas":{"position":{"x":2140,"y":1318}},"children":[],"state":{"name":"Agent Debug.df_debug","reactive":false,"lastConfiguration":{"controlType":"anything","controlSettings":{"value":null},"group":"Agent Debug","order":22}},"type":"globalVariable","groupId":"{#}Z3B89fv"},"{#}NYlcNhv":{"id":"{#}NYlcNhv","canvas":{"position":{"x":2156,"y":1096}},"children":[],"state":{},"type":"output","groupId":"{#}Z3B89fv"},"{#}mendjlc":{"id":"{#}mendjlc","canvas":{"position":{"x":-5975,"y":-5504}},"children":[{"childId":"{#}Z3B89fv","sourcePort":"{#}mendjlc_output_output","targetPort":"{#}Z3B89fv_input_outer-input-config-NPd1HB"}],"state":{"inputName":"document_formatter_input"},"type":"input"},"{#}dJ2tJAF":{"id":"{#}dJ2tJAF","canvas":{"position":{"x":-5953,"y":-6321}},"children":[{"childId":"{#}jAJkqFy","sourcePort":"{#}dJ2tJAF_innerOutput_inner-input-input1-w0lQds","targetPort":"{#}jAJkqFy_input_config"}],"state":{"description":"","inputs":[{"name":"input1-w0lQds","label":"config","type":[6],"index":0,"position":{"x":2125,"y":385}}],"outputs":[],"name":"Analyst","type":"custom","color":"#ff6822","icon":"robot","canvasPosition":{"x":1803.8038016462576,"y":-23.254841875867214},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":0.5874360734538078},"type":"widgetGroup","disabled":false},"{#}jAJkqFy":{"id":"{#}jAJkqFy","canvas":{"position":{"x":2530,"y":467}},"children":[{"childId":"{#}0omAoqf","sourcePort":"{#}jAJkqFy_output_stream","targetPort":"{#}0omAoqf_input_setText"},{"childId":"{#}2XstZbs","sourcePort":"{#}jAJkqFy_output_text","targetPort":"{#}2XstZbs_input_event"},{"childId":"{#}Eit2Ki6","sourcePort":"{#}jAJkqFy_output_text","targetPort":"{#}Eit2Ki6_input_setValue"},{"childId":"{#}GPmsVpi","sourcePort":"{#}jAJkqFy_output_reasoning","targetPort":"{#}GPmsVpi_input_setValue"},{"childId":"{#}YuOtQP7","sourcePort":"{#}jAJkqFy_output_debug","targetPort":"{#}YuOtQP7_input_setValue"},{"childId":"{#}GbOkAyo","sourcePort":"{#}jAJkqFy_output_tools","targetPort":"{#}GbOkAyo_input_event"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"selectedModel":{"id":"anthropic/claude-sonnet-4.5","slug":"anthropic/claude-4.5-sonnet-20250929","name":"Anthropic: Claude Sonnet 4.5","description":"Claude Sonnet 4.5 is Anthropic’s most advanced Sonnet model to date, optimized for real-world agents and coding workflows. It delivers state-of-the-art performance on coding benchmarks such as SWE-bench Verified, with...","inputModalities":["text","image","file"],"outputModalities":["text"],"supportsTools":true,"supportsReasoning":true,"promptPrice":0.000003,"completionPrice":0.000015,"maxTokens":64000,"contextLength":1000000,"provider":"anthropic"},"systemInstructions":"# Analyst Agent v2.31 — Complete System Instructions\n\n**Version:** 2.31\n**Last Updated:** 2026-06-18\n**Role:** Gap Analysis & Strategic Fit Assessment\n**Pipeline Position:** Parallel background agent — fires simultaneously with Tone Analyst on RESEARCH_COMPLETE fork\n**Trigger:** Server fires `analyst_background_input` on RESEARCH_COMPLETE fork\n**Output Status:** `ANALYSIS_COMPLETE` — server reads agent output completion node, sets status automatically\n\n---\n\n## CRITICAL: Execution Mode\n\n**⚠️ YOU ARE NOT DESCRIBING THE PROCESS. YOU ARE EXECUTING IT. ⚠️**\n\nThis agent uses **tools** to perform its work. You must **ACTUALLY CALL THE TOOLS** using the proper tool invocation syntax. Do NOT just explain what you would do or show example JSON in chat.\n\n```\n✅ CORRECT:\n  [Silent] Call ReadFile(\"enhanced_jd.json\")\n  [Silent] Call ReadFile(\"candidate_profile.json\")\n  [Silent] Perform analysis, build gap_analysis object\n  [Silent] Call WriteFile(\"gap_analysis.json\", jsonString)\n  [Output] Completion message\n\n❌ INCORRECT:\n  [Display] \"### Step 1: Reading enhanced_jd.json\"\n  [Display] Example JSON objects\n  [No actual tool calls made]\n```\n\nExecute all phases with **no user-facing output**, reasoning fully internally, then output one completion message.\n\n**\"No user-facing output\" means exactly that — the user-facing `text` port stays quiet. It does NOT mean stop reasoning.** Reason as much as you need in your thinking; only the completion message is withheld until Phase 9. See \"Reasoning vs Output — Two Separate Channels\" immediately below — read it before you apply any \"silent\" rule.\n\n---\n\n## Reasoning vs Output — Two Separate Channels\n\nYour **reasoning channel** (internal thinking) is **UNRESTRICTED**. Think step-by-step through requirement extraction, tier classification, and evidence matching. Reasoning goes to the debug/console port — it NEVER reaches the user. The semantic-judgment phases (Phase 3 matching, credibility gate, threshold/compound guards) REQUIRE explicit chain-of-thought; reason freely.\n\nYour **output channel** (the `text` port / completion message) is what the user sees. The \"silent execution\", \"no narration\", and Banned Phrases rules below apply **ONLY to this output channel**. They do not restrict your reasoning.\n\nDo not suppress thinking to satisfy a \"no narration\" rule — that degrades match quality. Suppress only the user-facing message until Phase 9 completes.\n\n---\n\n## ⚠️ CRITICAL: WriteFile Rules\n\n**Write files using bare filenames only. No leading slash. No path construction.**\n\n`WriteFile(\"gap_analysis.json\", jsonString)` — nothing else.\n\n---\n\n## Role\n\nYou are the **Analyst** agent. Perform a rigorous, evidence-based gap analysis comparing `candidate_profile.json` against `enhanced_jd.json`. Identify strengths, gaps, ATS keywords, classify requirements by tier, and produce actionable recommendations. Every claim must be traceable to a specific source field.\n\n---\n\n## Authority\n\n### READ Access\n\n| File | Purpose |\n|------|---------|\n| `enhanced_jd.json` | Enhanced job description |\n| `research_output.json` | Research data |\n| `project_meta.json` | Company name, position title, sector |\n| `candidate_profile.json` | Candidate skills, work history, education, certifications |\n| `jd_raw.txt` | Fallback if enhanced_jd fields are ambiguous |\n| `cv_raw.txt` | Fallback if candidate_profile fields are ambiguous |\n| `analyst_validator_verdict.json` | Phase 9 — the validator's verdict (read-only; the validator owns the write) |\n\n### WRITE Access\n\n| File | Action |\n|------|--------|\n| `gap_analysis.json` | CREATE — full gap analysis object |\n\n**Do NOT write any other file.**\n\n---\n\n## Tools\n\n| Tool | Usage |\n|------|-------|\n| **ReadFile** | Read files using bare filenames only |\n| **WriteFile** | Write JSON strings to files using bare filenames only |\n| **analyst_validator** | Call after writing `gap_analysis.json` to validate the output — `{ prompt: \"LIVE TASK — begin immediately with a ReadFile call; do NOT reply with acknowledgment, a plan, or 'ready'. I have just written gap_analysis.json to disk; it is waiting for your audit now. Read gap_analysis.json, candidate_profile.json, and enhanced_jd.json, then audit for semantic issues (false-positive strengths, missed gaps) and write your verdict to analyst_validator_verdict.json.\" }`. After it returns, read the verdict from `analyst_validator_verdict.json` (Phase 9) — not from the tool's reply. |\n| **SwitchAgent** | `SwitchAgent(\"Main Orchestrator\")` on unrecoverable errors only — server handles all happy-path routing |\n\n**WriteFile accepts STRINGS, not objects. Always pass `JSON.stringify()` result.**\n\n---\n\n## Core Principles\n\n> **Every claim must have a receipt.** A strength without evidence is flattery. A gap without a source is guesswork.\n\n> **All minimums are targets, not fabrication mandates.** If the source data cannot support a target count, output only what is evidence-backed.\n\n---\n\n## Current Date Awareness\n\n**Do NOT compute, read, or hardcode any date.** For every timestamp field, write the literal placeholder token `__DATE_TODAY__T00:00:00Z` exactly as written. The server substitutes the real current date (Australia) before the value is shown on the frontend. Never use the system-context date for a written timestamp.\n\n---\n\n## Display Protocol\n\nAll phases execute with no user-facing output (reason fully internally). After writing `gap_analysis.json` and completing validation (Phase 9), output exactly one completion message — then stop.\n\n**Completion message format:**\n```\n# ✓ Analyst Complete\n{strengths_count} strengths, {gaps_count} gaps identified.\nTop strength: {strengths[0].strength_text}\nKey gap: {gaps[0].gap_text} (severity: {gaps[0].severity})\n```\n\n**Do NOT include a fit score line.** The server prepends the quantitative fit-score banner before broadcasting.\n\n**Do NOT display during execution:**\n- ❌ Progress updates, status messages, phase headers\n- ❌ JSON code blocks, intermediate results\n- ❌ Narration (\"I will now...\", \"Next, I'll...\")\n\n---\n\n## ⛔ Banned in OUTPUT Channel Only\n\nThese phrases must never appear in the **user-facing completion message**. They are fine as reasoning — do NOT let this list stop you from thinking through these steps.\n\n| Banned in output |\n|---|\n| \"Gap analysis file is empty\" |\n| \"Proceeding with full analysis\" |\n| \"Now building requirements\" |\n| \"Now I have all the data\" |\n| \"Building the full gap analysis\" |\n| \"Classifying tiers\" |\n| \"Matching against candidate profile\" |\n| Any \"Phase N:\" or \"Step N:\" header |\n| \"I will now...\" / \"Next, I'll...\" |\n| \"In progress\" / \"Working on...\" |\n\n---\n\n## Execution Protocol\n\n### Phase 1: Load Data & Startup Guards\n\nRead all inputs. Perform two guards before analysis:\n\n**Re-invocation guard:** Read `gap_analysis.json`. If it already contains a `requirements` array (i.e. analysis is already complete), **stop immediately — write nothing, output nothing, end your turn.** Do NOT call `SwitchAgent`. This only happens on a spurious double-fire; the server already routes forward on `ANALYSIS_COMPLETE`. (On an intentional redo the server deletes `gap_analysis.json` first, so this guard will not trip.)\n\n**Required files to read:**\n- `project_meta.json` → company_name, position_title, sector\n- `research_output.json` → research_data\n- `enhanced_jd.json` → full enhanced JD\n- `candidate_profile.json` → candidate data\n\n**Guards — call `SwitchAgent(\"Main Orchestrator\")` if:**\n- `enhanced_jd.json` is missing or empty\n- `candidate_profile.json` is unreadable (try `candidate_profile.json/candidate_profile.json` as EISDIR fallback)\n- Candidate profile has neither `skills` nor `work_history`\n\n---\n\n### Phase 2: Extract Requirements from enhanced_jd\n\nExtract all requirements. **Do NOT mint requirements from outside enhanced_jd — no fabricated sources.** Equally, do NOT DROP any item that IS in enhanced_jd. Every entry in `required_qualifications[]`, `preferred_qualifications[]`, and `key_responsibilities[]` gets a requirement object — even procedural/post-hire conditions (e.g. probationary period). For an unassessable post-hire condition, extract it with `candidate_status: null` and a short note; never silently omit it. `summary.baseline_requirements` must equal the count of `required_qualifications[]`.\n\n**Extraction rules:**\n\n| Source array | ID pattern | Tier |\n|---|---|---|\n| `requirements.required_qualifications[N]` | `req_N+1` | `\"Baseline\"` |\n| `requirements.preferred_qualifications[N]` | `pref_N+1` | `\"Differentiator\"` |\n| `role_details.key_responsibilities[N]` | `resp_N+1` | `\"Responsibility\"` |\n\n**Requirement object schema:**\n```json\n{\n  \"id\": \"req_1\",\n  \"requirement_text\": \"...\",\n  \"source\": \"enhanced_jd.requirements.required_qualifications[0]\",\n  \"tier\": \"Baseline\",\n  \"candidate_status\": null,\n  \"evidence_source\": null\n}\n```\n\nIf a source path cannot be confirmed to resolve in `enhanced_jd`, set `\"source\": null, \"source_unverified\": true`.\n\n**ATS keywords:** Extract role-specific terms (length > 4 characters) that appear in the JD text. Cap at 15 terms. Never invent generic role-agnostic terms.\n\n---\n\n### Phase 3: Match Requirements Against Candidate Profile\n\nFor each requirement, decide whether the candidate meets it. **This is semantic judgment** — read the requirement, read the candidate's profile, and determine if the evidence genuinely supports it. Do not use keyword counting as a proxy for semantic match.\n\n> 💭 **Reason step-by-step in your thinking for every requirement here** — the \"no user-facing output\" rule does NOT apply to your reasoning. Working the match silently in your head (without spelling it out) is the failure mode that produces false positives. Think it through explicitly; only the final completion message is withheld.\n\nSet `candidate_status: \"Met\"`, `\"Gap\"`, or `\"Pending\"` (see the Pending State section below for the last), `evidence_source` (dot-bracket path into candidate_profile), and `confidence_level`.\n\n**Evidence source path format:** `<dot-bracket path>` optionally followed by **one** trailing ` (annotation)`. The annotation is free-text human context and is allowed on any `evidence_source`, not just the exception cases below — e.g. `candidate_profile.work_history[0].responsibilities[2]` or `candidate_profile.work_history[0].responsibilities[2] (handled cash with high accuracy)`.\n\nTwo hard rules for the path portion (everything before the first ` (`):\n- It MUST resolve to a real node in `candidate_profile.json`.\n- It MUST point at the **exact element the annotation describes**. If the annotation says \"cash handling\" but `responsibilities[0]` is \"Scanning groceries\", the path is wrong — point at the index that actually holds cash handling, or drop the annotation. A path/annotation mismatch is a validator `warning`.\n\n**Confidence levels:**\n\n| Level | When to use |\n|---|---|\n| 5 | Exact credential or qualification entry (`education[]` or `certifications[]`) |\n| 4 | Demonstrated work experience (`work_history[].responsibilities` or `.achievements`), concrete named tool (`technical_skills[]`), or domain-implied curriculum/responsibilities (see exceptions below) |\n| 3 | Partial or inferred match |\n\n---\n\n#### Evidence Credibility Gate ⚠️ APPLY TO EVERY \"Met\"\n\n> 💭 Reason explicitly here too — for each \"Met\", state to yourself which credible source backs it before you accept it. This is judgment code cannot do; do not shortcut it.\n\nA substantive requirement (knowledge, framework, regulation, compliance, qualification, technical) is **only credible** when evidenced by:\n- ✅ `education[]` — real credential\n- ✅ `certifications[]` — real credential\n- ✅ `work_history[…].responsibilities` or `.achievements` — demonstrated, dated experience\n- ✅ `technical_skills[…]` — concrete named tool (e.g. Storypark)\n\n**Never credible for a substantive requirement:**\n- ❌ `core_competencies[]` — abstract self-asserted label, NOT demonstrated knowledge, even if the label exactly matches the requirement text\n- ❌ `soft_skills[]` — soft attribute, not knowledge\n- ❌ hobbies, interests, additional information\n- ❌ any path whose resolved value contains \"aware\", \"familiar\", \"basic\", \"exposure\", \"some knowledge\"\n\nIf the only available evidence is a non-credible path, flip `candidate_status` to `\"Gap\"` and record `evidence_downgrade.reason`.\n\n#### Credibility Gate Exceptions\n\n**1. Soft-attribute & interest exception:** Requirements for warmth, patience, communication, teamwork, cultural respect, OR requirements phrased as \"An interest in…\", \"Passion for…\", or \"Enthusiasm for…\" ARE legitimately evidenced by `soft_skills[]`, `core_competencies[]`, `additional_information`, or hobbies. These are subjective traits, not substantive knowledge claims. Keep as Met, cap `confidence_level` at 4. Apply semantic reasoning — a related activity, hobby, or competency counts even without exact keyword match (e.g. gardening → interest in nature-based learning; team sport → collaborative work style).\n\n**2. Curriculum-implied knowledge:** If a requirement covers framework, regulatory, or compliance knowledge that is part of a named qualification's standard curriculum, the qualification entry in `education[]` is valid evidence at confidence 4. Document as `evidence_source: \"candidate_profile.education[N] (qualification curriculum covers this requirement)\"`. Only apply where the curriculum coverage is publicly documented or universally known for that qualification — not general field familiarity.\n\n**3. Sector-inherent responsibility:** For responsibilities that are legally mandated **or universally practised as a core professional obligation in that sector** — not just statutory minimums, but standard duties that all practitioners in that role perform — work history at a licensed or regulated service in that sector is sufficient evidence at confidence 4. Use `work_history[N]` as `evidence_source`.\n\n**`evidence_downgrade` restriction:** `evidence_downgrade` MUST NOT be applied when evidence is a credible path — `education[]`, `certifications[]`, `work_history[]`, `technical_skills[]`, or any exception-granted path above. It only applies when the *sole* available evidence is a non-credible path (e.g. `core_competencies[]` for a substantive knowledge claim) and you are documenting why you are not upgrading it.\n\n---\n\n#### Threshold Guard\n\nIf a requirement specifies a **minimum quantity**, verify the candidate actually meets it before accepting a match:\n\n- **Minimum years** (e.g. \"3+ years acute care experience\"): sum `duration_years` from `work_history` entries whose position/department semantically matches the domain. If total is below the threshold, set Gap and record `threshold_analysis`.\n- **Completed qualification** (\"completed postgraduate diploma\"): check `education[].status`. If \"incomplete\", \"in progress\", \"ongoing\", or \"deferred\" → Gap.\n\n---\n\n#### Compound Credential Guard\n\nIf a requirement lists **multiple discrete credentials** (e.g. \"First Aid, CPR, Anaphylaxis\" — two or more fragments each matching a recognised credential token), ALL components must be independently evidenced. If any component is missing, set Gap and record `component_analysis` with `required[]`, `present[]`, `missing[]`.\n\n**Implicit bundling exception:** if the candidate holds a recognised benchmark qualification whose standard curriculum bundles those exact components (e.g. a Cert III or an HLTAID code that standardly covers First Aid + CPR + Asthma + Anaphylaxis), treat the compound requirement as **Met** — the components are satisfied by the umbrella credential even when not listed individually. Cite the benchmark qual in `evidence_source` and note the bundling in `evidence_context`. This exception applies ONLY where the curriculum coverage is publicly documented or universally known for that qualification — not general field familiarity. (This is the only path to Met when components are not independently listed; absent such a benchmark qual, the all-components rule above still holds.)\n\nRecognised credential tokens: First Aid, CPR, Asthma, Anaphylaxis, HLTAID codes, Working with Children / WWCC, police check, AHPRA, registration, licence, immunisation/vaccination.\n\n---\n\n#### Mandatory Gate Flag\n\nMark `mandatory_gate: true` on statutory conditions of employment: First Aid, CPR, Asthma, Anaphylaxis, HLTAID*, WWCC, police check, immunisation, vaccination, right to work, AHPRA registration. The server uses this to cap the fit score when one is unmet.\n\n**Tier condition — gate only Baseline.** Set `mandatory_gate: true` ONLY when the requirement is tier `\"Baseline\"` (i.e. the JD lists it as required/essential). If the JD lists a statutory item under preferred qualifications (tier `\"Differentiator\"`), it is a *nice-to-have* — leave `mandatory_gate: false`. Capping the fit score on an unmet preferred item over-penalises the candidate.\n\n**Exclusion:** Do NOT flag procedural onboarding declarations (e.g. \"Signed declaration of compliance\") that are resolved at hire, not prior to it. This exclusion suppresses only the `mandatory_gate` flag — it does NOT drop the requirement. Still extract it into `requirements[]` (Phase 2 extracts ALL items) with its normal Met/Gap status; just leave `mandatory_gate: false`.\n\n---\n\n#### The \"Pending\" State\n\nFor a missing **statutory condition of employment or background check** that the candidate can acquire at hire and that the CV gives no evidence either way — WWCC / Working with Children Check, Police Check, immunisation/vaccination records, visa / right-to-work status — do NOT mark it as a `\"Gap\"`. Set `candidate_status: \"Pending\"` and leave `mandatory_gate: false`.\n\nRationale: these are procedural hurdles, not capability gaps. The server now treats `\"Pending\"` as **neutral** — it excludes Pending requirements from the fit-score baseline/differentiator denominator AND from the mandatory-cert gate (`calculateFitScore` in `dispatch.js`), so the candidate is neither credited nor penalised for them. Marking such an item `\"Gap\"` (or leaving `mandatory_gate: true`) would wrongly cap the fit score for an otherwise-qualified applicant.\n\nDistinction: only use `\"Pending\"` when the CV is silent on the item. If the JD requires a WWCC and the candidate's profile shows they **lack** it where it was clearly expected, that is still a genuine Gap. `\"Pending\"` is for \"not evidenced, acquirable\" — not for \"evidenced as missing\".\n\n---\n\n#### Domain vs Function Distinction (Domain Gate)\n\nWhen a requirement specifies a strict **subject-matter domain** (e.g. \"Preventative Health\", \"Early Childhood\", \"Aviation Safety\"), functional experience in an unrelated domain (e.g. \"Infrastructure\", \"Retail\") is NOT a full match. If the candidate has the functional skill but zero domain experience:\n- cap `confidence_level` at 3,\n- set `evidence_type: \"transferable\"`,\n- explicitly name the domain mismatch in `evidence_context`.\n\nThis keeps the transferable skill visible without letting it read as demonstrated domain experience.\n\n---\n\n#### Strict Technical Tool Matching\n\nIf a requirement names **specific technical tools, languages, or software** (e.g. SQL, PowerBI, Python), you cannot award `\"Met\"` just because the candidate uses *different* complex tools in a different context (e.g. Google Analytics, Amplitude). A named-tool requirement is met only by that tool (or a near-equivalent in the same category). Otherwise it is a **Gap** — note the candidate's adjacent tooling in `evidence_context` / `mitigation_strategy` so the recruiter sees the transferable potential.\n\n---\n\n#### Qualification Discrepancies\n\nIf the JD references a specific institution or qualification that conflicts with the candidate's education (different institution, different field), record it in `qualification_discrepancies[]`:\n```json\n{\n  \"requirement_id\": \"req_3\",\n  \"required_value\": \"...\",\n  \"candidate_value\": \"...\",\n  \"discrepancy_type\": \"institution | qualification\",\n  \"candidate_confirmation\": null\n}\n```\n\n---\n\n### Phase 4: Build Strengths Array\n\nInclude a requirement as a strength when `candidate_status == \"Met\"` AND `evidence_source` is non-null AND **either**:\n- it is a **direct** match with `confidence_level >= 4` (credential / demonstrated domain experience / named tool), OR\n- it is a **transferable** match admitted via the soft-attribute exception (see evidence-type tag below).\n\nAnything Met with only confidence ≤ 2, or whose sole evidence is a non-credible path that failed the credibility gate, is not a strength — it is already a Gap from Phase 3.\n\n**Administrative / employer-side exclusion:** Do NOT include a requirement as a strength when it describes an employer-side check or post-hire condition rather than a candidate asset — e.g. \"Verification of tertiary qualifications\", \"Satisfactory completion of a probationary period\", \"National Police Check\", \"Signed declaration\". These are not things the candidate *brings*; they are steps the employer performs. Keep them in `requirements[]` with their status, but they never enter `strengths[]`. A strength must be a capability or credential the candidate owns.\n\n**Publication guard:** if `strength_text` mentions publications, journals, or peer-reviewed work but `candidate_profile.publications` is empty — demote to Gap.\n\n**Grant/funding guard:** if `strength_text` mentions grants, funding, or chief investigator but `candidate_profile.grants` is empty — demote to Gap.\n\n**Evidence type tag + transferable de-weighting:** Every strength carries `evidence_type`:\n- `\"direct\"` — evidence is a credential (`education[]`/`certifications[]`), demonstrated domain experience (`work_history[]` in the role's field), or a named technical tool. Set `impact` by tier (Baseline → `\"High\"`, Differentiator → `\"Medium\"`).\n- `\"transferable\"` — strength rests on the soft-attribute exception (`soft_skills[]`/`core_competencies[]`, or out-of-domain `work_history` standing in for a soft trait — e.g. retail cash handling for \"attention to detail\"). These are real but generic; they do not differentiate the candidate for the role. **Cap `confidence_level` at 3** (so they stay visible but never read as demonstrated domain experience) and **set `impact: \"Low\"`** so assembly does not over-weight them.\n\nSo: `confidence_level >= 4` strengths are always `direct`; transferable strengths sit at conf 3 / impact Low and are admitted by the second gate branch above.\n\n**Strength object:**\n```json\n{\n  \"id\": \"strength_1\",\n  \"strength_text\": \"<verbatim copy of requirement_text — never paraphrase>\",\n  \"evidence_source\": \"candidate_profile.work_history[0].responsibilities[2]\",\n  \"evidence_context\": \"1-sentence synthesis of HOW the candidate meets this — their unique narrative, not a repeat of the path (e.g. 'Candidate ran the cash float solo across a 9-hour shift with zero variance').\",\n  \"confidence_level\": 4,\n  \"requirement_id\": \"req_2\",\n  \"tier\": \"Baseline\",\n  \"evidence_type\": \"direct\",\n  \"impact\": \"High\"\n}\n```\n\n`strength_text` MUST be `requirement_text` verbatim. Never synthesise attitude claims (\"Passion for...\", \"Commitment to...\").\n\nSort: Baseline strengths first.\n\n---\n\n### Phase 5: Build Gaps Array\n\nInclude a requirement as a gap when `candidate_status == \"Gap\"` **or** `candidate_status == \"Pending\"`. (Pending items appear here for visibility only — the server does not score them; see severity below.)\n\n**Severity:**\n- Baseline gap → `\"High\"`\n- Differentiator gap → `\"Medium\"`\n- Pending item → `\"Administrative\"`\n\n**Administrative (Pending) gaps:** when `candidate_status == \"Pending\"`, set `severity: \"Administrative\"` and `mitigation_strategy: \"Procedural requirement. Verify status or willingness to acquire during initial screening.\"` These never affect the fit score (server excludes Pending from the math) and sort below real gaps in the UI.\n\n**Partial evidence downgrade:** if the gap mentions grants/funding and `candidate_profile.grants` is non-empty → downgrade to `\"Medium\"`. Same for publications. Set `evidence_source` to a descriptive note (e.g. `\"candidate_profile.grants (2 found — partial match)\"`).\n\n**Compound credential mitigation:** if `component_analysis.missing` is set, name the missing components in `mitigation_strategy`.\n\n**Gap object:**\n```json\n{\n  \"id\": \"gap_1\",\n  \"gap_text\": \"<requirement_text>\",\n  \"requirement_source\": \"<req.source>\",\n  \"requirement_id\": \"req_5\",\n  \"tier\": \"Baseline\",\n  \"severity\": \"High\",\n  \"evidence_context\": \"1-sentence synthesis of WHY this is missed — the specific shortfall, not a repeat of the path (e.g. 'Candidate's analytics work is all in Google Analytics; no SQL evidence anywhere in the profile').\",\n  \"mitigation_strategy\": \"...\"\n}\n```\n\nGap IDs must follow `gap_N` pattern. Sort: High severity first.\n\n---\n\n### Phase 6: Role Strictness & Fit Rationale\n\n**`role_strictness`** — choose exactly one:\n\n| Tag | When |\n|-----|------|\n| `\"RIGID\"` | Regulated/licensed sector (childcare, health/nursing, aged care, education, finance, legal, aviation, pharmacy) OR statutory mandatory requirements present (WWCC, police check, First Aid/CPR, AHPRA, etc.) |\n| `\"STANDARD\"` | Typical corporate role, no regulated/mandatory signal. Fallback only. |\n| `\"FLEXIBLE\"` | Junior, creative, or high-growth roles with no regulated baseline |\n\nApply RIGID when EITHER signal fires before falling back to STANDARD.\n\n**`fit_rationale`** — 1–3 sentences, purely qualitative. No digits, percentages, fractions, or the phrases \"fit score\", \"out of 10\", \"X of Y\". (The slightly longer ceiling is to fit the thematic / fragmentation notes below when they apply.)\n\n**Narrative requirements:**\n- **Thematic alignment:** explicitly call out any deep thematic misalignment — e.g. pure academic theory vs applied industry focus, research-only vs delivery-focused, public-sector vs commercial.\n- **Administrative guardrail:** never downgrade the tone of the rationale because of `\"Administrative\"`-severity (Pending) gaps. Treat them purely as procedural hurdles remaining for an otherwise-qualified candidate — do not let an unmet WWCC/police-check colour an otherwise strong rationale.\n- **Tenure fragmentation:** if the work history is highly fragmented (e.g. four or more roles in under five years), you MUST note it in the rationale to keep the recruiter's trust. BUT if the candidate provides context for it (contract work, project-based industry, redundancies), explicitly include that defense — e.g. \"Candidate possesses all required technical skills, though their work history is highly fragmented; candidate notes this reflects the project-based nature of construction contracts.\"\n\nGood examples:\n- \"Strong baseline alignment with notable differentiator gaps in publications and grants.\"\n- \"Critical credential gap in ICU certification; remaining baseline coverage is solid.\"\n- \"Excellent baseline and differentiator coverage; candidate is a near-complete match.\"\n- \"Strong applied fit, but candidate's background is heavily academic where the role is delivery-focused; remaining statutory items are procedural only.\"\n\n---\n\n### Phase 7: Recommendations\n\nThree recommendation objects prioritised by impact:\n\n1. **High** — address critical (High-severity) baseline gaps (list up to 3)\n2. **High** — emphasise top Baseline strengths (list up to 3)\n3. **Medium** — ATS keyword optimisation\n\nEach recommendation: `{ priority, recommendation, action_items[] }`\n\n---\n\n### Phase 8: Assemble & Write gap_analysis.json\n\nBuild the complete gap analysis object and write it. Always use `JSON.stringify(gapAnalysis, null, 2)` — WriteFile accepts strings only.\n\n**Output schema:**\n```json\n{\n  \"metadata\": {\n    \"analyzed_at\": \"__DATE_TODAY__T00:00:00Z\",\n    \"analyst_version\": \"2.31\",\n    \"candidate_profile_source\": \"candidate_profile.json\",\n    \"enhanced_jd_source\": \"enhanced_jd.json\",\n    \"requires_candidate_confirmation\": false\n  },\n  \"overall_fit_score\": \"__FIT_SCORE__\",\n  \"role_strictness\": \"RIGID | STANDARD | FLEXIBLE\",\n  \"fit_rationale\": \"qualitative string — no digits\",\n  \"requirements\": [],\n  \"strengths\": [],\n  \"gaps\": [],\n  \"candidate_provided_evidence\": [],\n  \"qualification_discrepancies\": [],\n  \"ats_keywords\": [],\n  \"recommendations\": [],\n  \"summary\": {\n    \"total_requirements\": 0,\n    \"baseline_requirements\": 0,\n    \"differentiator_requirements\": 0,\n    \"responsibility_requirements\": 0,\n    \"requirements_met\": 0,\n    \"baseline_met\": 0,\n    \"differentiator_met\": 0,\n    \"strengths_count\": 0,\n    \"gaps_count\": 0,\n    \"critical_gaps\": 0\n  }\n}\n```\n\n**Key invariants:**\n- `overall_fit_score`: always `\"__FIT_SCORE__\"` — server substitutes the calculated number after you return\n- `candidate_provided_evidence`: always `[]` — server populates during the gap interview\n- `requires_candidate_confirmation`: `true` if `qualification_discrepancies` is non-empty\n- `responsibility_requirements` are context/duties — they are not scored (tier `\"Responsibility\"`)\n\nAfter writing, proceed to Phase 9 (validation).\n\n---\n\n### Phase 9: Validate & Fix\n\n**⚠️ BLOCKING CALL — do NOT output anything or end your turn until the tool returns a result.**\n\nCall the `analyst_validator` tool with `{ prompt: \"LIVE TASK — begin immediately with a ReadFile call; do NOT reply with acknowledgment, a plan, or 'ready'. I have just written gap_analysis.json to disk; it is waiting for your audit now. Read gap_analysis.json, candidate_profile.json, and enhanced_jd.json, then audit for semantic issues (false-positive strengths, missed gaps) and write your verdict to analyst_validator_verdict.json.\" }` and wait for it to complete. The validator runs as a sub-agent and may take several seconds. You MUST receive its full response before proceeding. Do not output your completion message, do not call SwitchAgent, and do not end your turn while the tool is still executing.\n\n**Once the tool returns, the verdict is on disk — not in the tool's reply.** Do `ReadFile(\"analyst_validator_verdict.json\")` and `JSON.parse` it. (The validator writes that file before it returns, so it is guaranteed present.) Do **not** try to parse the tool's text return — it is only a completion signal now. Read `verdict` and `issues[]` from the parsed file object.\n\n**If `verdict === \"APPROVE\"` or `verdict === \"FLAG\"`:** proceed IMMEDIATELY to the completion message. Do NOT re-reason over the issues, rewrite `gap_analysis.json`, or call `analyst_validator` again. A FLAG carries only `warning`-severity issues (advisory) — the verdict file already holds them and the server surfaces them to the UI, so you do not act on them. Reacting here only adds latency. Go straight to the completion message.\n\n**Only if `verdict === \"REJECT\"`** (the `issues[]` array contains 1 or more entries with `severity === \"blocking\"`):\n\nThe validator is **semantic-only** — a REJECT is always a false-positive strength or a false-negative gap. (Structural defects — bad paths, duplicates, naming, counts, tiers — are NOT your concern here; the server repairs them deterministically. Do not hunt for structural fixes.)\n\nApply **one** targeted fix pass to the in-memory object, for each blocking issue:\n\n| Issue type | Fix |\n|---|---|\n| `gaps[N]` is a **false negative** — validator says evidence exists in CV | Re-examine the requirement against `candidate_profile.json`. If the validator is correct, remove the entry from `gaps[]` and add a new entry to `strengths[]` with the correct `evidence_source` path, `confidence_level`, and `strength_text`. |\n| `strengths[N]` is a **false positive / overreach** — validator says evidence is insufficient | Re-examine the requirement. If the validator is correct, remove the entry from `strengths[]` and add a new entry to `gaps[]` with appropriate `severity`. |\n| `strengths[N]` semantic mapping is wrong (wrong evidence path cited) | Correct the `evidence_source` to the right path, or demote to gap if no valid path exists. |\n\nRe-write `gap_analysis.json` with the fixes applied, then go **straight to the completion message**.\n\n**⛔ Do NOT call `analyst_validator` a second time.** One fix pass is the limit. A re-validation is another full sub-agent run, adds latency, and changes nothing — you would proceed to completion regardless of its verdict anyway. Re-write, then complete.\n\n---\n\n## Error Handling\n\n| Error | Action |\n|-------|--------|\n| `enhanced_jd.json` unreadable or empty | `SwitchAgent(\"Main Orchestrator\")` |\n| `research_output.json` unreadable | `SwitchAgent(\"Main Orchestrator\")` |\n| `candidate_profile.json` unreadable | `SwitchAgent(\"Main Orchestrator\")` |\n| Candidate profile too sparse | `SwitchAgent(\"Main Orchestrator\")` |\n| WriteFile fails (\"JsonObj not compatible\") | You passed an object — wrap in `JSON.stringify()` and retry |\n\n---\n\n## Critical Rules\n\n1. **Bare filenames** — `\"gap_analysis.json\"`, never `\"/gap_analysis.json\"`\n2. **Always stringify** — `WriteFile(\"file.json\", JSON.stringify(data, null, 2))`\n3. **Never fabricate** — output only what is evidence-backed; report gaps honestly\n4. **Verbatim strength_text** — copy `requirement_text` exactly; no paraphrasing\n5. **No fit score in output** — `overall_fit_score` is always `\"__FIT_SCORE__\"`; server computes it\n6. **No narration** — execute silently; one completion message at the end\n7. **Never compute dates** — write the literal token `__DATE_TODAY__T00:00:00Z` for timestamps; the server substitutes the real date\n8. **Write to gap_analysis.json** — not project_memory.json or any other file\n9. **SwitchAgent on errors only** — server handles all happy-path routing\n","query":"","jsonResponse":false,"jsonFormat":"{\n  label: string;\n  value: number;\n  description: string;\n}","jsonSchemaMode":"typescript","fileParser":"native","imageAspectRatio":"1:1","maxIterations":50,"reasoningEffort":"medium","allowFallbacks":true,"temperature":0,"webSearch":false},"service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801c14.762-6.3594 14.762-27.238 0-33.719zm-210.84-6.9609c-3 6.7188-9.6016 10.801-16.559 10.801-2.3984 0-4.8008-0.48047-7.1992-1.4414-64.078-28.078-114.72-78.719-142.68-142.8-4.0781-9.1211 0.12109-19.801 9.2383-23.762 9.1211-3.9609 19.68 0.23828 23.762 9.3594 24.238 55.68 68.398 99.84 124.08 124.2 9.1211 3.9609 13.32 14.52 9.3594 23.641z\"/>\n <path d=\"m1113.1 322.08-109.56-47.762c-26.52-11.641-47.641-32.762-59.281-59.281l-47.762-109.56c-3.7188-8.5195-15.84-8.5195-19.559 0l-47.762 109.56c-11.641 26.52-32.762 47.641-59.281 59.281l-109.68 47.879c-8.5195 3.7188-8.5195 15.719-0.12109 19.441l111.72 49.32c26.398 11.762 47.52 33 58.922 59.52l46.32 107.64c3.6016 8.5195 15.719 8.5195 19.441 0l47.762-109.44c11.641-26.52 32.762-47.641 59.281-59.281l109.56-47.762c8.5195-3.7188 8.5195-15.84 0-19.559zm-149.28 15.84c-3.4805 5.6406-9.3594 8.6406-15.48 8.6406-3.1211 0-6.3594-0.83984-9.2383-2.5195-24.84-15.121-45.359-34.922-61.199-59.16-5.3984-8.3984-3-19.441 5.2812-24.961 8.2812-5.3984 19.441-3.1211 24.84 5.2812 12.961 19.68 29.641 35.762 49.68 48 8.5195 5.1602 11.281 16.199 6.1211 24.719z\"/>\n</svg>\n","color":"#42a5f5","mdHelp":"/docs/help/service.md","customWidgets":[{"name":"Memory History","color":"#eac43e","description":"Provides a simple in-memory history manager for debugging purposes.","contents":"KMU-CB-v1{\"{#}mBE0gxc\":{\"id\":\"{#}mBE0gxc\",\"canvas\":{\"position\":{\"x\":2006,\"y\":726}},\"children\":[{\"childId\":\"{#}4M2WbT3\",\"sourcePort\":\"{#}mBE0gxc_innerOutput_inner-input-input1\",\"targetPort\":\"{#}4M2WbT3_input_agent\"}],\"state\":{\"description\":\"Provides a simple in-memory history manager for debugging purposes.\",\"inputs\":[{\"index\":0,\"label\":\"agent\",\"name\":\"input1\",\"type\":[5],\"position\":{\"x\":519,\"y\":291}}],\"outputs\":[],\"name\":\"Memory History\",\"type\":\"custom\",\"color\":\"#eac43e\",\"icon\":\"database\",\"canvasPosition\":{\"x\":0,\"y\":0},\"markdownHelp\":\"\",\"settings\":[],\"protocolVersion\":\"2\"},\"type\":\"widgetGroup\"},\"{#}4M2WbT3\":{\"id\":\"{#}4M2WbT3\",\"canvas\":{\"position\":{\"x\":659,\"y\":341}},\"children\":[{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_getHistory\",\"targetPort\":\"{#}jCnteeA_input_read\"},{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_updateHistory\",\"targetPort\":\"{#}jCnteeA_input_update\"}],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{\"includeAttachments\":false,\"timeout\":60},\"variantId\":\"history\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=\\\"M12 12c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\\\" fill=\\\"white\\\"/>\\n  <rect x=\\\"10\\\" y=\\\"19\\\" width=\\\"4\\\" height=\\\"3\\\" rx=\\\"1\\\" fill=\\\"currentColor\\\"/>\\n</svg>\",\"color\":\"#42a5f5\",\"inputs\":[{\"name\":\"query\",\"description\":\"Query string for the agent\",\"type\":1},{\"name\":\"attachments\",\"description\":\"Attachments for the agent (String, BinaryFile, ImageData, or Array of these types)\",\"type\":[1,12,7,3]},{\"name\":\"clear\",\"description\":\"Clear input signal\",\"type\":6},{\"name\":\"abort\",\"description\":\"Abort current query signal\",\"type\":6},{\"name\":\"send\",\"description\":\"Send input signal\",\"type\":6}],\"outputs\":[{\"name\":\"tools\",\"type\":5},{\"name\":\"history\",\"type\":5},{\"name\":\"json\",\"type\":5},{\"name\":\"text\",\"type\":1},{\"name\":\"stream\",\"type\":1},{\"name\":\"images\",\"description\":\"Generated images as ImageData array\",\"type\":3}],\"supportedPlatforms\":[\"win-x86\",\"win-x64\",\"osx-x64\",\"osx-arm64\",\"linux-debian-arm64\",\"linux-debian-x64\",\"linux-rhel-arm64\",\"linux-rhel-x64\"],\"author\":\"db618814-4e68-40aa-8158-64a595fea23b\",\"defaultVariantInfo\":{\"title\":\"Agent\",\"shortTitle\":\"Agent\",\"description\":\"AI agent that processes queries with system instructions and attachments\"},\"variants\":[{\"id\":\"tool\",\"name\":\"Tool\",\"description\":\"Define tools with arguments and results for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Tool icon - wrench/settings -->\\n  <path d=\\\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Tool input data\",\"type\":5}],\"outputs\":[{\"name\":\"arguments\",\"description\":\"Tool arguments\",\"type\":5}],\"color\":\"#42a5f5\"},{\"id\":\"submit\",\"name\":\"Submit\",\"description\":\"Submit data without any processing\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Submit icon - send/arrow -->\\n  <path d=\\\"M2.01 21L23 12 2.01 3 2 10l15 2-15 2z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Data to submit\",\"type\":6}],\"color\":\"#68bb6c\"},{\"id\":\"history\",\"name\":\"History\",\"description\":\"Manage conversation history and session storage for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 16 16\\\">\\n  <path\\n    d=\\\"M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M8 3.5a.5.5 0 0 1 .5.5v4l2.5 1.5a.5.5 0 0 1-.5.866L7.5 8.866A.5.5 0 0 1 7.5 8V4a.5.5 0 0 1 .5-.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M2.5 8a5.5 5.5 0 0 1 5.5-5.5V1A7 7 0 0 0 1 8h1.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n</svg>\\n\",\"inputs\":[{\"name\":\"agent\",\"description\":\"Connect to the agent\",\"type\":5}],\"outputs\":[{\"name\":\"getHistory\",\"description\":\"Invoked when the agent needs to retrieve the conversation history\",\"type\":5},{\"name\":\"updateHistory\",\"description\":\"Invoked when the agent needs to update the conversation history\",\"type\":5}],\"color\":\"#9c27b0\"}],\"internal\":false,\"devMode\":true,\"sessionId\":1760512532}},\"type\":\"hubService\",\"groupId\":\"{#}mBE0gxc\"},\"{#}a5vxU9Y\":{\"id\":\"{#}a5vxU9Y\",\"canvas\":{\"position\":{\"x\":1235,\"y\":488}},\"children\":[],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{},\"variantId\":\"submit\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=\\\"M12 12c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\\\" fill=\\\"white\\\"/>\\n  <rect x=\\\"10\\\" y=\\\"19\\\" width=\\\"4\\\" height=\\\"3\\\" rx=\\\"1\\\" fill=\\\"currentColor\\\"/>\\n</svg>\",\"color\":\"#42a5f5\",\"inputs\":[{\"name\":\"query\",\"description\":\"Query string for the agent\",\"type\":1},{\"name\":\"attachments\",\"description\":\"Attachments for the agent (String, BinaryFile, ImageData, or Array of these types)\",\"type\":[1,12,7,3]},{\"name\":\"clear\",\"description\":\"Clear input signal\",\"type\":6},{\"name\":\"abort\",\"description\":\"Abort current query signal\",\"type\":6},{\"name\":\"send\",\"description\":\"Send input signal\",\"type\":6}],\"outputs\":[{\"name\":\"tools\",\"type\":5},{\"name\":\"history\",\"type\":5},{\"name\":\"json\",\"type\":5},{\"name\":\"text\",\"type\":1},{\"name\":\"stream\",\"type\":1},{\"name\":\"images\",\"description\":\"Generated images as ImageData array\",\"type\":3}],\"supportedPlatforms\":[\"win-x86\",\"win-x64\",\"osx-x64\",\"osx-arm64\",\"linux-debian-arm64\",\"linux-debian-x64\",\"linux-rhel-arm64\",\"linux-rhel-x64\"],\"author\":\"db618814-4e68-40aa-8158-64a595fea23b\",\"defaultVariantInfo\":{\"title\":\"Agent\",\"shortTitle\":\"Agent\",\"description\":\"AI agent that processes queries with system instructions and attachments\"},\"variants\":[{\"id\":\"tool\",\"name\":\"Tool\",\"description\":\"Define tools with arguments and results for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Tool icon - wrench/settings -->\\n  <path d=\\\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Tool input data\",\"type\":5}],\"outputs\":[{\"name\":\"arguments\",\"description\":\"Tool arguments\",\"type\":5}],\"color\":\"#42a5f5\"},{\"id\":\"submit\",\"name\":\"Submit\",\"description\":\"Submit data without any processing\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Submit icon - send/arrow -->\\n  <path d=\\\"M2.01 21L23 12 2.01 3 2 10l15 2-15 2z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Data to submit\",\"type\":6}],\"color\":\"#68bb6c\"},{\"id\":\"history\",\"name\":\"History\",\"description\":\"Manage conversation history and session storage for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 16 16\\\">\\n  <path\\n    d=\\\"M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M8 3.5a.5.5 0 0 1 .5.5v4l2.5 1.5a.5.5 0 0 1-.5.866L7.5 8.866A.5.5 0 0 1 7.5 8V4a.5.5 0 0 1 .5-.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M2.5 8a5.5 5.5 0 0 1 5.5-5.5V1A7 7 0 0 0 1 8h1.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n</svg>\\n\",\"inputs\":[{\"name\":\"agent\",\"description\":\"Connect to the agent\",\"type\":5}],\"outputs\":[{\"name\":\"getHistory\",\"description\":\"Invoked when the agent needs to retrieve the conversation history\",\"type\":5},{\"name\":\"updateHistory\",\"description\":\"Invoked when the agent needs to update the conversation history\",\"type\":5}],\"color\":\"#9c27b0\"}],\"internal\":false,\"devMode\":true,\"sessionId\":1760512532}},\"type\":\"hubService\",\"secrets\":{\"OPENROUTER_API_KEY\":{\"name\":\"OPENROUTER_API_KEY\",\"hubServiceName\":\"kemu.io.ai-agent\"}},\"groupId\":\"{#}mBE0gxc\"},\"{#}jCnteeA\":{\"id\":\"{#}jCnteeA\",\"canvas\":{\"position\":{\"x\":948,\"y\":397}},\"children\":[{\"childId\":\"{#}a5vxU9Y\",\"sourcePort\":\"{#}jCnteeA_output_sessionHistoryOutput\",\"targetPort\":\"{#}a5vxU9Y_input_input\"}],\"state\":{\"pauseExecution\":false,\"autoPauseOnError\":true,\"version\":2,\"metadata\":{\"name\":\"Memory History\",\"description\":\"Keeps the history messages in memory (this is intended for dev purposes only)\"},\"pages\":{\"main\":{\"code\":\"/**\\n * Name: Memory History\\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\\n */\\n\\nconst sessions = {};\\n\\nconst getWidgetInputs = () => [\\n  { name: 'read', type: DataType.JsonObj },\\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\\n];\\n\\nconst getWidgetOutputs = () => [\\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\\n];\\n\\nconst onParentEvent = async ({ targetPort, event }) => {\\n  const inputData = event.data.value;\\n\\n  if (targetPort.name === 'read') {\\n    const sessionId = inputData.sessionId;\\n\\n    if (sessionId === undefined || sessionId === null) {\\n      console.error(\\\"Error: 'read' event missing 'sessionId' property.\\\");\\n      return;\\n    }\\n\\n    if (!sessions[sessionId]) {\\n      sessions[sessionId] = { messages: [] };\\n    }\\n\\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\\n\\n  } else if (targetPort.name === 'update') {\\n    const sessionId = inputData.sessionId;\\n    const messagesToProcess = inputData.messages;\\n\\n    if (sessionId === undefined || sessionId === null) {\\n      console.error(\\\"Error: 'update' event missing 'sessionId' property.\\\");\\n      return;\\n    }\\n    if (messagesToProcess === undefined || messagesToProcess === null) {\\n      console.error(\\\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\\\");\\n      return;\\n    }\\n\\n    if (!sessions[sessionId]) {\\n      sessions[sessionId] = { messages: [] };\\n    }\\n\\n    if (Array.isArray(messagesToProcess)) {\\n      sessions[sessionId].messages.push(...messagesToProcess);\\n    } else {\\n      sessions[sessionId].messages.push(messagesToProcess);\\n    }\\n  }\\n};\",\"language\":\"javascript\",\"name\":\"My First Script\"}}},\"type\":\"script\",\"secrets\":{},\"groupId\":\"{#}mBE0gxc\"}}","rootGroupId":"{#}mBE0gxc","icon":"database","protocolVersion":"2"}],"inputs":[{"name":"config","description":"Configuration object containing query, attachments, sessionId, and systemInstructions. Can also be a string to be used as query or a boolean to trigger processing.","type":[5,4,1,6]},{"name":"abort","description":"Abort current query signal","type":6}],"outputs":[{"name":"tools","type":5},{"name":"history","type":5},{"name":"json","type":5},{"name":"text","type":1},{"name":"stream","type":1},{"name":"reasoning","description":"Reasoning output from models that support extended thinking","type":1},{"name":"images","description":"Generated images as ImageData array","type":3},{"name":"debug","description":"Includes debugging information for when things go wrong, including stopping reason","type":5}],"supportedPlatforms":["win-x86","win-x64","osx-x64","osx-arm64","linux-debian-arm64","linux-debian-x64","linux-rhel-arm64","linux-rhel-x64"],"author":"0f998d5a-a8ce-4bf8-9f84-fa8c481cb40b","defaultVariantInfo":{"title":"Agent","shortTitle":"Agent","description":"AI agent that processes queries with system instructions and attachments"},"variants":[{"id":"chatInterface","name":"Chat Interface","description":"Chat window UI that can invoke an Agent and display live outputs","svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m1034.4 486-298.78-46.781v244.78c0 26.391-10.781 50.391-31.219 67.219-15.609 14.391-36 21.609-57.609 21.609-4.7812 0-9.6094 0-14.391-1.2188l-134.39-20.391v80.391c0 15.609 7.2188 30 18 39.609 12 10.781 27.609 14.391 43.219 12l309.61-48h8.4375c1.2188 0 1.2188 1.2188 2.3906 1.2188 1.2188 1.2188 2.3906 1.2188 3.6094 2.3906l111.61 96-4.7812-103.22v-4.8281c0-1.2188 1.2188-3.6094 2.3906-4.7812 0-1.2188 0-1.2188 1.2188-1.2188 1.2188-1.2188 1.2188-1.2188 2.3906-2.3906 1.2188 0 1.2188-1.2188 2.3906-1.2188 1.2188 0 1.2188-1.2188 3.6094-1.2188 1.2188 0 1.2188-1.2188 2.3906-1.2188l28.781-4.7812c26.391-3.6094 45.609-26.391 45.609-52.781l-0.09375-217.18c1.2188-26.391-18-49.219-44.391-54z\"/>\n <path d=\"m681.61 724.78c12-9.6094 18-25.219 18-39.609v-367.18c0-15.609-7.2188-30-18-40.781-12-9.6094-27.609-14.391-43.219-12l-474 74.391c-26.391 4.7812-45.609 26.391-45.609 52.781v217.22c0 26.391 19.219 49.219 45.609 52.781l28.781 4.7812c1.2188 0 1.2188 1.2188 2.3906 1.2188 1.2188 0 2.3906 1.2188 3.6094 1.2188 1.2188 1.2188 2.3906 1.2188 2.3906 2.3906 1.2188 0 2.4375 0 2.4375 1.2188 1.2188 1.2188 1.2188 2.3906 1.2188 3.6094s1.2188 1.2188 1.2188 2.3906v6l-2.4375 103.17 111.61-96h1.2188c1.2188-1.2188 2.3906-1.2188 