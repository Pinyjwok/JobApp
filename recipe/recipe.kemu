1-9.6016-58.801 16.801l-68.398 280.8c-6 25.199 16.801 49.199 43.199 43.199l280.8-68.398c26.398-6 36-39.602 16.801-58.801l-66-66c176.4-153.6 444-148.8 612 19.199 174 174 174 459.6-1.1992 634.8l-16.801 15.602c-25.199 22.801-26.398 61.199-4.8008 86.398 12 13.199 28.801 20.398 45.602 20.398 14.398 0 28.801-4.8008 40.801-15.602 7.1992-6 14.398-13.199 20.398-20.398 223.2-223.2 223.2-585.6 1.1992-808.8z\"/>\n <path d=\"m739.2 1028.4-22.801 7.1992c-32.398 8.3984-51.602 42-43.199 75.602 7.1992 27.602 32.398 45.602 58.801 45.602 4.8008 0 10.801-1.1992 15.602-2.3984 9.6016-2.3984 19.199-6 28.801-8.3984 32.398-10.801 49.199-45.602 38.398-76.801-8.4023-33.602-43.199-51.602-75.602-40.805z\"/>\n <path d=\"m532.8 1046.4-24-3.6016c-33.602-7.1992-66 14.398-72 48-7.1992 33.602 14.398 66 48 72 9.6016 2.3984 20.398 3.6016 30 4.8008 2.3984 0 6 1.1992 9.6016 1.1992 30 0 56.398-21.602 60-52.801 4.7969-33.598-18.004-64.797-51.602-69.598z\"/>\n <path d=\"m321.6 955.2c-26.398-20.398-64.801-16.801-86.398 9.6016-20.398 26.398-16.801 64.801 9.6016 86.398 8.3984 6 15.602 12 24 18 10.801 7.1992 22.801 10.801 34.801 10.801 19.199 0 38.398-8.3984 50.398-26.398 19.199-27.602 13.199-66-14.398-85.199z\"/>\n <path d=\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1784443105}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"groupId":"{#}jjSSTfb"},"{#}F3DSLJ6":{"id":"{#}F3DSLJ6","canvas":{"position":{"x":820,"y":642}},"children":[{"childId":"{#}KmkNOS8","sourcePort":"{#}F3DSLJ6_output_sessionHistoryOutput","targetPort":"{#}KmkNOS8_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}jjSSTfb"},"{#}dwV4pU8":{"id":"{#}dwV4pU8","canvas":{"position":{"x":572,"y":258}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}jjSSTfb"},"{#}ItfSUDv":{"id":"{#}ItfSUDv","canvas":{"position":{"x":830,"y":993}},"children":[{"childId":"{#}C1Z0k9W","sourcePort":"{#}ItfSUDv_output_1","targetPort":"{#}C1Z0k9W_innerInput_inner-output-output10-VaxXpy"},{"childId":"{#}6Hy2NWo","sourcePort":"{#}ItfSUDv_output_else","targetPort":"{#}6Hy2NWo_input_trigger"},{"childId":"{#}C1Z0k9W","sourcePort":"{#}ItfSUDv_output_3","targetPort":"{#}C1Z0k9W_innerInput_inner-output-output12-IdLBly"},{"childId":"{#}C1Z0k9W","sourcePort":"{#}ItfSUDv_output_4","targetPort":"{#}C1Z0k9W_innerInput_inner-output-output13-q1iOCM"},{"childId":"{#}C1Z0k9W","sourcePort":"{#}ItfSUDv_output_5","targetPort":"{#}C1Z0k9W_innerInput_inner-output-output14-zDHC9L"},{"childId":"{#}C1Z0k9W","sourcePort":"{#}ItfSUDv_output_7","targetPort":"{#}C1Z0k9W_innerInput_inner-output-output16-ss1i2k"},{"childId":"{#}C1Z0k9W","sourcePort":"{#}ItfSUDv_output_8","targetPort":"{#}C1Z0k9W_innerInput_inner-output-output17-luyRFQ"},{"childId":"{#}C1Z0k9W","sourcePort":"{#}ItfSUDv_output_9","targetPort":"{#}C1Z0k9W_innerInput_inner-output-output18-VkVcfY"}],"state":{"conditions":[{"expression":"$vars.AgentSelector === 'Style Negotiator'","output":"input","$lastOutputType":5},{"expression":"$vars.AgentSelector === 'Profile Builder'","output":"input","$lastOutputType":5},{"expression":"$vars.AgentSelector === 'Skills Curator'","output":"input","$lastOutputType":5},{"expression":"$vars.AgentSelector === 'Credentials Formatter'","output":"input","$lastOutputType":5},{"expression":"$vars.AgentSelector === 'Cover Letter Writer'","output":"input","$lastOutputType":5},{"expression":"$vars.AgentSelector === 'History Formatter'","output":"input"},{"expression":"$vars.AgentSelector === 'Style Reviewer'","output":"input","$lastOutputType":5},{"expression":"$vars.AgentSelector === 'Integrity Checker'","output":"input","$lastOutputType":5},{"expression":"$vars.AgentSelector === 'Document Formatter'","output":"input"}],"multipleOutputs":true,"size":{"width":357,"height":307}},"type":"switch","groupId":"{#}C1Z0k9W"},"{#}38YqbIz":{"id":"{#}38YqbIz","canvas":{"position":{"x":-6163,"y":-5688}},"children":[{"childId":"{#}yWG5Iie","targetPort":"{#}yWG5Iie_input_config","sourcePort":"{#}38YqbIz_innerOutput_inner-input-config-NPd1HB"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":1179,"y":1044}}],"outputs":[],"name":"History Formatter","type":"custom","color":"#ab47bd","icon":"robot","canvasPosition":{"x":1130.6231163254756,"y":923.8284618157895},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":1},"type":"widgetGroup"},"{#}yWG5Iie":{"id":"{#}yWG5Iie","canvas":{"position":{"x":1622,"y":1004}},"children":[{"childId":"{#}xcu2fuX","sourcePort":"{#}yWG5Iie_output_tools","targetPort":"{#}xcu2fuX_input_outer-input-input1"},{"childId":"{#}b20ssSY","sourcePort":"{#}yWG5Iie_output_history","targetPort":"{#}b20ssSY_input_outer-input-input1"},{"childId":"{#}1TcqpnG","sourcePort":"{#}yWG5Iie_output_reasoning","targetPort":"{#}1TcqpnG_input_setValue"},{"childId":"{#}CfYSYwt","sourcePort":"{#}yWG5Iie_output_debug","targetPort":"{#}CfYSYwt_input_setValue"},{"childId":"{#}TlepQhM","sourcePort":"{#}yWG5Iie_output_text","targetPort":"{#}TlepQhM_input_setValue"},{"childId":"{#}OdoJVQE","sourcePort":"{#}yWG5Iie_output_text","targetPort":"{#}OdoJVQE_input_event"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"selectedModel":{"id":"~anthropic/claude-haiku-latest","slug":"~anthropic/claude-haiku-latest","name":"Anthropic Claude Haiku Latest","description":"This model always redirects to the latest model in the Anthropic Claude Haiku family.","inputModalities":["text","image","file"],"outputModalities":["text"],"supportsTools":true,"supportsReasoning":true,"promptPrice":0.000001,"completionPrice":0.000005,"maxTokens":64000,"contextLength":200000,"provider":"~anthropic"},"systemInstructions":"# History Formatter v2.4 — System Instructions\n\n**Version:** 2.4\n**Last Updated:** 2026-06-19\n**Role:** Career History Formatter\n**Pipeline Position:** Assembly Phase 4\n**Trigger:** Dispatched sequentially by server after Skills Curator approved\n**Output:** Writes `hf_output.json` (server merges into `phases[3]`, then shows Approve/Revise)\n\n---\n\n## Output discipline (read first)\n\nYou emit **only** the user-facing content defined in \"Display & finish\" — the formatted-history bubble\nand the completion summary. **Never narrate your process:** no \"loading files\", \"formatting each\nentry\", \"writing hf_output.json\", no `✅` ticks, no field names, no regex, no code, no filenames, no\nphase numbers. The user sees a finished history section, not a build log.\n\n---\n\n## Role\n\nFormat the candidate's work history into a clean, readable career section:\n1. Rewrite each bullet as a strong **Power Bullet** in the agreed style.\n2. Surface the achievements that demonstrate `gap_analysis` strengths.\n3. **Bold** the metrics.\n4. Apply consistent structure across every entry.\n\n---\n\n## Inputs (read these)\n\n- `candidate_profile.json` — `work_history` (`employer`, `position`, `employment_type`,\n  `start_date`, `end_date`, `duration_years`, `responsibilities[]`, `achievements[]`, and for acting\n  roles `base_position` / `acting_duration`).\n- `gap_analysis.json` — strengths to surface.\n- `cv_assembly_state.json` — agreed style overrides at `phases[0].data.agreed_overrides`.\n- `cv_raw.txt` — the candidate's original CV (the source of truth for the contradiction check).\n\n**Write access:** `hf_output.json` only (the server merges it into `phases[3]`). Never modify\n`candidate_profile.json`, `gap_analysis.json`, or `style_guide.json`. You do not route — never call\n`SwitchAgent`.\n\n**Existence gate:** if `phases[0].data.agreed_overrides` is missing, display \"Error: Style Negotiation\ndata missing. Cannot proceed.\" and end the turn.\n\n---\n\n## Revision mode\n\nIf the incoming message starts with `__revise__:`, treat the rest as targeted feedback. Load the\nexisting `hf_output.json` and make **only** the requested change (e.g. \"strengthen bullet 2 of role 1\",\n\"add the metric to the Amazon role\"), preserving every other entry and bullet. Write it back, display\nthe changed entry, and end the turn. Do not regenerate from scratch and do not call `SwitchAgent`.\n\n**Source-contradiction guard (mandatory).** Before applying any revision that touches a clinical/\noperational setting, job title, employer name, or dates, check the proposed value against `cv_raw.txt`.\nIf the proposed value is absent from the relevant employer's section in `cv_raw.txt` and a\ncontradictory value is present there, **block** — do not write. Display:\n\n```\n⚠️ Revision blocked — source CV check failed.\n\nProposed: \"{the requested change}\"\ncv_raw.txt shows: {quote the relevant section for this employer}\n\nTo override (acknowledging your source CV is incorrect):\nType: `confirm change: [exact corrected text]`\n\nTo keep the source CV version: type your revised instruction.\n```\n\nIf the incoming message starts with `confirm change:`, the candidate has accepted responsibility for\nthe discrepancy — apply the confirmed text directly (no further contradiction check), write\n`hf_output.json` back, confirm the change, and end the turn.\n\n---\n\n## Format each entry\n\nBuild one entry per role, preserving the candidate's real facts:\n\n- **Dates** — render `YYYY-MM` as `Mon YYYY` (e.g. `2020-01` → `Jan 2020`); keep `Present` as-is; pass\n  through anything not in `YYYY-MM` form. Show as `{start} – {end}`.\n- **Acting roles** — if the position or employment type is an acting role and a `base_position`\n  exists, use the dual-title format `{base_position} / {acting position} ({acting_duration})`. Never\n  present an acting title as a standalone header — it misrepresents the employment basis.\n\n**Power Bullet formula — Action + Task + Impact.** Rewrite each responsibility and achievement as a\nstrong, readable bullet:\n\n- **Lead with a strong action verb;** state the task/scope, then the impact or result.\n- **Write fluid, professional prose.** You **may** smooth grammar and add connective words so each\n  bullet reads naturally — the goal is a polished, scannable bullet, not a staccato fragment with the\n  articles and pronouns hacked out. Drop dead filler (\"responsible for\", \"helped to\", \"assisted with\",\n  \"was involved in\") and trailing full stops where the agreed style calls for it.\n- **If an \"implicit first-person\" override is active,** phrase bullets without a leading \"I\" — but\n  restructure for natural flow rather than mechanically deleting the pronoun.\n- **Facts are frozen.** You may rephrase and smooth, but you may **not** invent or alter any metric,\n  number, clinical/operational setting, job title, employer, or date. Every figure and fact must trace\n  to the candidate's record.\n- **Bold the metrics** — wrap every quantitative result in `**bold**`: percentages, currency,\n  headcounts, multipliers, timeframes, and word-form results (\"**halved**\", \"**doubled**\",\n  \"**threefold**\"). Don't miss word-form numbers.\n\nWhere a `gap_analysis` strength is already demonstrated by a responsibility or achievement, make sure\nthat bullet is present and clear (do not fabricate a bullet to manufacture a strength).\n\n---\n\n## Display & finish\n\nFirst, display all formatted entries in full so the user can review before approving:\n\n```markdown\n## Career History Formatted\n\n{N} entries | {total bullets} bullets total\n\n---\n\n**{position}** — {employer} ({duration})\n• {bullet}\n• {bullet}\n\n---\n{…remaining entries…}\n```\n\nThen write `hf_output.json` with this exact shape:\n\n```json\n{\n  \"phase_number\": 4,\n  \"phase_name\": \"History Formatting\",\n  \"agent\": \"History Formatter\",\n  \"status\": \"COMPLETE\",\n  \"completed_at\": \"__DATE_TODAY__T00:00:00Z\",\n  \"data\": {\n    \"work_history\": [\n      {\n        \"employer\": \"...\",\n        \"position\": \"...\",\n        \"employment_type\": \"...\",\n        \"acting_role\": true,\n        \"acting_duration\": \"...\",\n        \"duration\": \"Mon YYYY – Mon YYYY\",\n        \"duration_years\": 0,\n        \"bullets\": [\"...\"]\n      }\n    ],\n    \"total_entries\": 0,\n    \"total_bullets\": 0,\n    \"style_overrides_applied\": [],\n    \"user_confirmed\": true\n  }\n}\n```\n\n(`acting_role` / `acting_duration` only appear on acting roles; omit them otherwise.) Verify the write\nby reading `hf_output.json` back and confirming its status is `COMPLETE`; if not, display \"Error:\nFailed to write hf_output.json.\" and end the turn.\n\nThen display the completion summary and **end the turn natively** — no `SwitchAgent`, no validator\nhandshake. The server reads `hf_output.json`, merges it, and shows Approve/Revise.\n\n```markdown\n# ✓ History Formatter Complete\n\nCareer history formatted and ready for CV assembly.\n- Entries formatted: {N}\n- Total bullets: {total bullets}\n```\n\n**TURN ENDS.**\n\n---\n\n## Error handling\n\n| Situation | Action |\n| --- | --- |\n| `candidate_profile.json` or `cv_assembly_state.json` missing | Display error, end turn |\n| Empty work history | Write an empty array, continue |\n| Write fails | Retry once, then display error and end turn |\n\n---\n\n## ⚠️ Critical Rules\n\n1. **Output discipline** — emit only the formatted-history + completion messages. No process\n   narration, no code, no field names, no filenames.\n2. **Bare filenames only** — `\"hf_output.json\"`, never with a `/`, `\\`, leading slash, or `workspace`\n   prefix. Always write valid JSON (stringified, 2-space indent). Verify by reading back.\n3. **`candidate_profile.json`** — never `user_profile.json`.\n4. **Write to `hf_output.json` only** — never write `cv_assembly_state.json`; the server merges.\n5. **No `SwitchAgent`, no validator handshake** — display, write, end the turn; the server shows\n   Approve/Revise.\n6. **Power Bullets, facts frozen** — rephrase and smooth for flow, but never invent or alter a metric,\n   setting, title, employer, or date.\n7. **Source-contradiction guard is mandatory** on revisions touching setting, title, employer, or\n   dates — block and require `confirm change:` if the proposed value isn't in `cv_raw.txt`.\n8. **Acting roles use the dual-title format** — never a standalone acting header.\n9. **Timestamps** — write the literal token `__DATE_TODAY__T00:00:00Z`; the server substitutes the\n   real Australian date. Never compute or hardcode a date.\n```\n","query":"","jsonResponse":false,"jsonFormat":"","jsonSchemaMode":"typescript","fileParser":"native","imageAspectRatio":"1:1","maxIterations":12,"reasoningEffort":"low","allowFallbacks":true,"temperature":0.6},"service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801c14.762-6.3594 14.762-27.238 0-33.719zm-210.84-6.9609c-3 6.7188-9.6016 10.801-16.559 10.801-2.3984 0-4.8008-0.48047-7.1992-1.4414-64.078-28.078-114.72-78.719-142.68-142.8-4.0781-9.1211 0.12109-19.801 9.2383-23.762 9.1211-3.9609 19.68 0.23828 23.762 9.3594 24.238 55.68 68.398 99.84 124.08 124.2 9.1211 3.9609 13.32 14.52 9.3594 23.641z\"/>\n <path d=\"m1113.1 322.08-109.56-47.762c-26.52-11.641-47.641-32.762-59.281-59.281l-47.762-109.56c-3.7188-8.5195-15.84-8.5195-19.559 0l-47.762 109.56c-11.641 26.52-32.762 47.641-59.281 59.281l-109.68 47.879c-8.5195 3.7188-8.5195 15.719-0.12109 19.441l111.72 49.32c26.398 11.762 47.52 33 58.922 59.52l46.32 107.64c3.6016 8.5195 15.719 8.5195 19.441 0l47.762-109.44c11.641-26.52 32.762-47.641 59.281-59.281l109.56-47.762c8.5195-3.7188 8.5195-15.84 0-19.559zm-149.28 15.84c-3.4805 5.6406-9.3594 8.6406-15.48 8.6406-3.1211 0-6.3594-0.83984-9.2383-2.5195-24.84-15.121-45.359-34.922-61.199-59.16-5.3984-8.3984-3-19.441 5.2812-24.961 8.2812-5.3984 19.441-3.1211 24.84 5.2812 12.961 19.68 29.641 35.762 49.68 48 8.5195 5.1602 11.281 16.199 6.1211 24.719z\"/>\n</svg>\n","color":"#42a5f5","mdHelp":"/docs/help/service.md","customWidgets":[{"name":"Memory History","color":"#eac43e","description":"Provides a simple in-memory history manager for debugging purposes.","contents":"KMU-CB-v1{\"{#}mBE0gxc\":{\"id\":\"{#}mBE0gxc\",\"canvas\":{\"position\":{\"x\":2006,\"y\":726}},\"children\":[{\"childId\":\"{#}4M2WbT3\",\"sourcePort\":\"{#}mBE0gxc_innerOutput_inner-input-input1\",\"targetPort\":\"{#}4M2WbT3_input_agent\"}],\"state\":{\"description\":\"Provides a simple in-memory history manager for debugging purposes.\",\"inputs\":[{\"index\":0,\"label\":\"agent\",\"name\":\"input1\",\"type\":[5],\"position\":{\"x\":519,\"y\":291}}],\"outputs\":[],\"name\":\"Memory History\",\"type\":\"custom\",\"color\":\"#eac43e\",\"icon\":\"database\",\"canvasPosition\":{\"x\":0,\"y\":0},\"markdownHelp\":\"\",\"settings\":[],\"protocolVersion\":\"2\"},\"type\":\"widgetGroup\"},\"{#}4M2WbT3\":{\"id\":\"{#}4M2WbT3\",\"canvas\":{\"position\":{\"x\":659,\"y\":341}},\"children\":[{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_getHistory\",\"targetPort\":\"{#}jCnteeA_input_read\"},{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_updateHistory\",\"targetPort\":\"{#}jCnteeA_input_update\"}],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{\"includeAttachments\":false,\"timeout\":60},\"variantId\":\"history\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=