 to the file to write"},{"name":"contents","type":12,"description":"The contents to write"},{"name":"write","type":6,"description":"Executes the write operation when this input is triggered","triggerPort":true}],"outputs":[{"name":"success","type":4,"description":"Whether the file was written successfully"}]},{"id":"file-to-text","name":"File To Text","description":"Converts a binary file to text using the specified encoding","svgIcon":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"23.298 16.64 439.97 473.219\" width=\"439.97px\" height=\"473.219px\">\n  <path d=\"M 136.998 229.735 C 139.146 232.955 142.365 234.029 145.584 234.029 C 148.807 234.029 152.026 232.955 154.173 229.735 L 186.373 186.801 C 189.593 182.506 188.52 174.993 184.227 171.774 C 179.934 168.552 172.419 169.627 169.2 173.92 L 156.32 191.093 L 156.32 115.952 C 156.32 109.512 160.612 105.219 167.054 105.219 L 199.254 105.219 C 205.694 105.219 209.988 100.926 209.988 94.485 C 209.988 88.045 205.694 83.751 199.254 83.751 L 167.054 83.751 C 148.807 83.751 134.852 97.704 134.852 115.952 L 134.852 191.093 L 121.973 173.92 C 118.751 169.627 111.237 168.552 106.945 171.774 C 102.651 174.993 101.577 182.506 104.799 186.801 L 136.998 229.735 Z M 454.715 281.257\" style=\"\" transform=\"matrix(1, 0, 0, 1, 1.1368683772161603e-13, 0)\"/>\n  <path d=\"M 257.168 294.967 L 257.168 450.881 C 257.168 472.968 240.278 489.859 218.19 489.859 L 62.276 489.859 C 40.189 489.859 23.298 472.968 23.298 450.881 L 23.298 294.967 C 23.298 272.879 40.189 255.989 62.276 255.989 L 218.19 255.989 C 240.278 255.989 257.168 272.879 257.168 294.967 Z M 192.205 333.948 C 192.205 326.149 187.008 320.952 179.209 320.952 L 101.255 320.952 C 93.46 320.952 88.264 326.149 88.264 333.948 L 88.264 346.938 C 88.264 354.735 93.46 359.931 101.255 359.931 C 109.051 359.931 114.248 354.735 114.248 346.938 L 127.241 346.938 L 127.241 398.909 C 119.443 398.909 114.248 404.106 114.248 411.902 C 114.248 