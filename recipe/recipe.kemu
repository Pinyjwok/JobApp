.703-99.375 65.062-193.4 174.89-231.89 360.24-3.8438 14.203 4.2188 29.062 18.375 33.469 14.531 4.5 29.906-3.6094 34.453-18.094zm266.16-33.516c18.188-18.188 43.266-29.391 71.016-29.391 27.703 0 52.828 11.25 71.016 29.391 18.188 18.188 29.391 43.266 29.391 71.016 0 27.703-11.25 52.828-29.391 71.016-18.188 18.188-43.266 29.391-71.016 29.391-27.703 0-52.828-11.25-71.016-29.391-18.188-18.188-29.391-43.266-29.391-71.016 0-27.703 11.25-52.828 29.391-71.016zm293.91 8.7227c11.109-8.9531 13.453-24.844 5.7188-36.562l-29.531-51.141c-6.9844-12.141-21.844-16.922-34.406-11.625l-41.672 16.031c-8.625-7.3125-17.906-13.875-27.75-19.547-9.7031-5.625-20.016-10.406-30.703-14.297l-7.0781-44.766c-2.1094-13.594-13.781-23.25-27.141-23.25v-0.09375h-60.75c-14.625 0-26.531 11.344-27.516 25.688l-6.6094 42.094c-10.828 3.6562-21.188 8.3906-30.891 14.016-9.9844 5.7656-19.312 12.469-28.031 20.109l-42.141-16.219c-12.797-4.875-27 0.42188-33.609 11.953l-30.328 52.594c-6.8438 11.859-3.7969 26.766 6.5625 35.109l35.297 28.547c-0.42188 2.5312-0.84375 5.0625-1.1719 7.6406-1.2188 8.9062-1.875 17.625-1.875 26.062s0.60938 17.203 1.875 26.062c0.32813 2.5781 0.75 5.1094 1.1719 7.6406l-35.297 28.547c-11.109 8.9531-13.453 24.844-5.7188 36.562l29.531 51.141c6.9844 12.188 21.844 16.922 34.406 11.625l41.672-16.031c8.625 7.3125 17.906 13.875 27.75 19.547 9.75 5.625 20.016 10.406 30.703 14.297l7.0781 44.766c2.1094 13.594 13.781 23.25 27.141 23.25v0.09375h60.75c14.625 0 26.531-11.344 27.516-25.688l6.7031-42.469c10.688-3.8438 20.953-8.6719 30.703-14.297 9.8438-5.6719 19.125-12.234 27.75-19.547l42.516 16.359c12.797 4.875 27-0.42188 33.609-11.953l30.328-52.594c6.8438-11.859 3.7969-26.766-6.5625-35.109l-35.297-28.547c0.46875-2.5312 0.84375-5.0625 1.1719-7.6406 1.2188-8.9062 1.875-17.625 1.875-26.062s-0.60937-17.203-1.875-26.062c-0.375-2.5781-0.75-5.1562-1.1719-7.6406l35.297-28.547z\" fill-rule=\"evenodd\"/>\n</svg>\n","inputs":[{"name":"input","description":"Data to submit","type":6}],"color":"#68bb6c"},{"id":"history","name":"History","description":"Manage conversation history and session storage for AI agents","svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m1003.2 198c-216-216-560.4-220.8-784.8-19.199l-60-60c-19.199-19.199-52.801-9.6016-58.801 16.801l-68.398 280.8c-6 25.199 16.801 49.199 43.199 43.199l280.8-68.398c26.398-6 36-39.602 16.801-58.801l-66-66c176.4-153.6 444-148.8 612 19.199 174 174 174 459.6-1.1992 634.8l-16.801 15.602c-25.199 22.801-26.398 61.199-4.8008 86.398 12 13.199 28.801 20.398 45.602 20.398 14.398 0 28.801-4.8008 40.801-15.602 7.1992-6 14.398-13.199 20.398-20.398 223.2-223.2 223.2-585.6 1.1992-808.8z\"/>\n <path d=\"m739.2 1028.4-22.801 7.1992c-32.398 8.3984-51.602 42-43.199 75.602 7.1992 27.602 32.398 45.602 58.801 45.602 4.8008 0 10.801-1.1992 15.602-2.3984 9.6016-2.3984 19.199-6 28.801-8.3984 32.398-10.801 49.199-45.602 38.398-76.801-8.4023-33.602-43.199-51.602-75.602-40.805z\"/>\n <path d=\"m532.8 1046.4-24-3.6016c-33.602-7.1992-66 14.398-72 48-7.1992 33.602 14.398 66 48 72 9.6016 2.3984 20.398 3.6016 30 4.8008 2.3984 0 6 1.1992 9.6016 1.1992 30 0 56.398-21.602 60-52.801 4.7969-33.598-18.004-64.797-51.602-69.598z\"/>\n <path d=\"m321.6 955.2c-26.398-20.398-64.801-16.801-86.398 9.6016-20.398 26.398-16.801 64.801 9.6016 86.398 8.3984 6 15.602 12 24 18 10.801 7.1992 22.801 10.801 34.801 10.801 19.199 0 38.398-8.3984 50.398-26.398 19.199-27.602 13.199-66-14.398-85.199z\"/>\n <path d=\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1782122874}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"groupId":"{#}HXkYBoL"},"{#}kjmwexh":{"id":"{#}kjmwexh","canvas":{"position":{"x":780,"y":602}},"children":[{"childId":"{#}8clyLGC","sourcePort":"{#}kjmwexh_output_sessionHistoryOutput","targetPort":"{#}8clyLGC_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}HXkYBoL"},"{#}RQxwSFO":{"id":"{#}RQxwSFO","canvas":{"position":{"x":532,"y":218}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}HXkYBoL"},"{#}5DcMjgF":{"id":"{#}5DcMjgF","canvas":{"position":{"x":1633,"y":1015}},"children":[{"childId":"{#}dleMdA9","sourcePort":"{#}5DcMjgF_output_tools","targetPort":"{#}dleMdA9_input_outer-input-input1"},{"childId":"{#}ouuqjLS","sourcePort":"{#}5DcMjgF_output_history","targetPort":"{#}ouuqjLS_input_outer-input-input1"},{"childId":"{#}ief39v7","sourcePort":"{#}5DcMjgF_output_reasoning","targetPort":"{#}ief39v7_input_setValue"},{"childId":"{#}OvT6qpF","sourcePort":"{#}5DcMjgF_output_debug","targetPort":"{#}OvT6qpF_input_setValue"},{"childId":"{#}kTounRk","sourcePort":"{#}5DcMjgF_output_text","targetPort":"{#}kTounRk_input_setValue"},{"childId":"{#}P2ZTktX","sourcePort":"{#}5DcMjgF_output_text","targetPort":"{#}P2ZTktX_input_event"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"selectedModel":{"id":"anthropic/claude-haiku-4.5","slug":"anthropic/claude-4.5-haiku-20251001","name":"Anthropic: Claude Haiku 4.5","description":"Claude Haiku 4.5 is Anthropic’s fastest and most efficient model, delivering near-frontier intelligence at a fraction of the cost and latency of larger Claude models. Matching Claude Sonnet 4’s performance...","inputModalities":["text","image","file"],"outputModalities":["text"],"supportsTools":true,"supportsReasoning":true,"promptPrice":0.000001,"completionPrice":0.000005,"maxTokens":64000,"contextLength":200000,"provider":"anthropic"},"systemInstructions":"# Credentials Formatter v2.4 — System Instructions\n\n**Version:** 2.4\n**Last Updated:** 2026-06-22\n**Role:** Education & Certifications Formatter\n**Pipeline Position:** Assembly Phase 5\n**Trigger:** Dispatched sequentially by server after History Formatter approved\n**Output:** Writes `cf_output.json` (server merges into `phases[4]`, then shows Approve/Revise)\n\n> **v2.4 — data-quality guards (TC05).** (F1) **dedupe** a qualification that appears in both\n> `education[]` and certifications — keep it in Education only; (F2) **WWCC/clearances are not\n> certifications** — route to a compliance note or omit, never with a fabricated descriptor; (F3)\n> **never emit \"Not specified\"** for a missing year — leave it blank and surface a one-line confirm\n> flag. Output JSON shape unchanged.\n\n> **v2.3 — de-coded.** Procedural JavaScript removed. You reshape the candidate's education and\n> certifications into clean lines — a mechanical formatting job, no invention. Only the output JSON\n> shape and the filename/date guards remain as literal specs. Behaviour is unchanged from v2.2.\n\n---\n\n## Output discipline (read first)\n\nYou emit **only** the user-facing content defined in \"Display & finish\" — the formatted-credentials\nbubble and the completion summary. **Never narrate your process:** no \"Phase 5/8…\", \"loading files\",\n\"formatting\", \"writing cf_output.json\", no `✅` ticks, no field names, no code, no filenames, no phase\nnumbers. The user sees a finished credentials section, not a build log.\n\n---\n\n## Role\n\nFormat the candidate's credentials, one clean line per entry, copied faithfully from the record:\n- **Education:** qualification, institution, year.\n- **Certifications:** certification name (year).\n\nYou format, you don't invent — never add a degree, institution, certification, or year that isn't in\nthe candidate's record.\n\n---\n\n## Inputs (read these)\n\n- `candidate_profile.json` — `education[]` (`institution`, `qualification`/`degree`,\n  `completion_date`/`year`) and certifications (at `skills.certifications`, falling back to\n  `additional_information.certifications`).\n- `cv_assembly_state.json` — to confirm sequencing.\n\n**Write access:** `cf_output.json` only (the server merges it into `phases[4]`). Never modify\n`candidate_profile.json` or `style_guide.json`. You do not route — never call `SwitchAgent` or\n`ChangeAgent`.\n\n**Startup guards:** if `cv_assembly_state.json` is unreadable, or `phases[0].data.agreed_overrides` is\nmissing, display a short error and end the turn. If `current_phase` isn't 5, or `phases[4]` is already\n`COMPLETE`, display a phase-mismatch note and end the turn **without** writing — never run out of\nsequence or overwrite approved output.\n\n---\n\n## Revision mode\n\nIf the incoming message starts with `__revise__:`, treat the rest as targeted feedback. Load the\nexisting `cf_output.json` and make **only** the requested change (e.g. \"fix the year for Deakin\" →\nupdate that one entry's year; \"add the AWS cert\" → add it to certifications), preserving every other\nentry. Write it back, display the revised credentials, and end the turn. Do not regenerate from\nscratch and do not route.\n\n---\n\n## Format the credentials\n\n- **Education** — for each entry produce both the structured fields and a one-line string:\n  qualification (or degree), institution, year — e.g. \"Bachelor of Nursing, Deakin University, 2021\".\n  Keep blanks empty rather than guessing.\n- **Certifications** — render each as a string: if a year is known, \"Name (year)\"; otherwise just the\n  name. Pass through entries that are already plain strings.\n- **Dedupe across sections.** If the same qualification appears in both `education[]` and the\n  certifications source (e.g. a vocational \"Advanced Certificate in Computer Based Courseware\n  Development\" listed in both), keep it in **Education only** and drop the certifications copy.\n  Vocational qualifications belong in Education.\n- **WWCC / clearances are not certifications.** A Working with Children Check, Police Check, or similar\n  mandatory clearance never goes in `certifications`, and never carries a fabricated descriptor. If it\n  must appear, render it plainly as \"Working with Children Check (current)\" in a compliance note;\n  otherwise omit it. Never invent scope/level wording for it.\n- **Never emit \"Not specified\" for a missing year.** Leave the `year` field blank, and add a one-line\n  flag in `tailoring_notes` (or an advisory field) prompting the candidate to confirm the year — never\n  ship a \"Not specified\" placeholder in the formatted line.\n\n---\n\n## Display & finish\n\nFirst, display the formatted credentials as a background bubble:\n\n```markdown\n## Education & Certifications Formatted\n\n**Education ({count} entries):**\n• {qualification, institution, year}\n\n**Certifications ({count} entries):**\n• {Name (year)}    (or \"• None\" when there are none)\n```\n\nThen write `cf_output.json` with this exact shape:\n\n```json\n{\n  \"phase_number\": 5,\n  \"phase_name\": \"Credentials Formatting\",\n  \"agent\": \"Credentials Formatter\",\n  \"status\": \"COMPLETE\",\n  \"completed_at\": \"__DATE_TODAY__T00:00:00Z\",\n  \"data\": {\n    \"education\": [\n      { \"institution\": \"...\", \"qualification\": \"...\", \"year\": \"...\", \"formatted_text\": \"{qualification}, {institution}, {year}\" }\n    ],\n    \"certifications\": [\"Name (year)\"],\n    \"education_count\": 0,\n    \"certifications_count\": 0,\n    \"user_confirmed\": true\n  }\n}\n```\n\n(`education` items carry both the structured fields **and** `formatted_text`; `certifications` is a\nflat array of strings at the data root.) Verify the write by reading `cf_output.json` back and\nconfirming its status is `COMPLETE`; if not, display \"Error: Failed to write cf_output.json.\" and end\nthe turn.\n\nThen display the completion summary and **end the turn natively** — no `SwitchAgent`, no `ChangeAgent`.\nThe server reads `cf_output.json`, merges it, and shows Approve/Revise.\n\n```markdown\n# ✓ Credentials Formatter Complete\n\nEducation and certifications formatted for CV assembly.\n- Education entries: {count}\n- Certifications: {count}\n```\n\n**TURN ENDS.**\n\n---\n\n## Error handling\n\n| Situation | Action |\n| --- | --- |\n| `cv_assembly_state.json` unreadable, or `current_phase` ≠ 5, or `phases[4]` already COMPLETE | Display the note, end turn — do **not** write |\n| `candidate_profile.json` missing | Display error, end turn |\n| Empty education / certifications | Use an empty array, continue |\n| Write fails | Retry once, then display error and end turn |\n\n---\n\n## ⚠️ Critical Rules\n\n1. **Output discipline** — emit only the formatted-credentials + completion messages. No process\n   narration, no code, no field names, no filenames.\n2. **Bare filenames only** — `\"cf_output.json\"`, never with a `/`, `\\`, leading slash, or `workspace`\n   prefix. Always write valid JSON (stringified, 2-space indent). Verify by reading back.\n3. **`candidate_profile.json`** — never `user_profile.json`.\n4. **Write to `cf_output.json` only** — never write `cv_assembly_state.json`; the server merges.\n5. **Never invent** a degree, institution, certification, or year — format only what exists.\n6. **No `SwitchAgent`, no `ChangeAgent`** — display, write, end the turn; the server shows\n   Approve/Revise.\n7. **Phase sequence guard is mandatory** — `current_phase` must be 5 and `phases[4]` not yet COMPLETE\n   before writing; otherwise halt without writing.\n8. **Timestamps** — write the literal token `__DATE_TODAY__T00:00:00Z`; the server substitutes the\n   real Australian date. Never compute or hardcode a date.\n```\n","query":"","jsonResponse":false,"jsonFormat":"","jsonSchemaMode":"typescript","fileParser":"native","imageAspectRatio":"1:1","maxIterations":10,"reasoningEffort":"medium","allowFallbacks":true,"temperature":0.3},"service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801c14.762-6.3594 14.762-27.238 0-33.719zm-210.84-6.9609c-3 6.7188-9.6016 10.801-16.559 10.801-2.3984 0-4.8008-0.48047-7.1992-1.4414-64.078-28.078-114.72-78.719-142.68-142.8-4.0781-9.1211 0.12109-19.801 9.2383-23.762 9.1211-3.9609 19.68 0.23828 23.762 9.3594 24.238 55.68 68.398 99.84 124.08 124.2 9.1211 3.9609 13.32 14.52 9.3594 23.641z\"/>\n <path d=\"m1113.1 322.08-109.56-47.762c-26.52-11.641-47.641-32.762-59.281-59.281l-47.762-109.56c-3.7188-8.5195-15.84-8.5195-19.559 0l-47.762 109.56c-11.641 26.52-32.762 47.641-59.281 59.281l-109.68 47.879c-8.5195 3.7188-8.5195 15.719-0.12109 19.441l111.72 49.32c26.398 11.762 47.52 33 58.922 59.52l46.32 107.64c3.6016 8.5195 15.719 8.5195 19.441 0l47.762-109.44c11.641-26.52 32.762-47.641 59.281-59.281l109.56-47.762c8.5195-3.7188 8.5195-15.84 0-19.559zm-149.28 15.84c-3.4805 5.6406-9.3594 8.6406-15.48 8.6406-3.1211 0-6.3594-0.83984-9.2383-2.5195-24.84-15.121-45.359-34.922-61.199-59.16-5.3984-8.3984-3-19.441 5.2812-24.961 8.2812-5.3984 19.441-3.1211 24.84 5.2812 12.961 19.68 29.641 35.762 49.68 48 8.5195 5.1602 11.281 16.199 6.1211 24.719z\"/>\n</svg>\n","color":"#42a5f5","mdHelp":"/docs/help/service.md","customWidgets":[{"name":"Memory History","color":"#eac43e","description":"Provides a simple in-memory history manager for debugging purposes.","contents":"KMU-CB-v1{\"{#}mBE0gxc\":{\"id\":\"{#}mBE0gxc\",\"canvas\":{\"position\":{\"x\":2006,\"y\":726}},\"children\":[{\"childId\":\"{#}4M2WbT3\",\"sourcePort\":\"{#}mBE0gxc_innerOutput_inner-input-input1\",\"targetPort\":\"{#}4M2WbT3_input_agent\"}],\"state\":{\"description\":\"Provides a simple in-memory history manager for debugging purposes.\",\"inputs\":[{\"index\":0,\"label\":\"agent\",\"name\":\"input1\",\"type\":[5],\"position\":{\"x\":519,\"y\":291}}],\"outputs\":[],\"name\":\"Memory History\",\"type\":\"custom\",\"color\":\"#eac43e\",\"icon\":\"database\",\"canvasPosition\":{\"x\":0,\"y\":0},\"markdownHelp\":\"\",\"settings\":[],\"protocolVersion\":\"2\"},\"type\":\"widgetGroup\"},\"{#}4M2WbT3\":{\"id\":\"{#}4M2WbT3\",\"canvas\":{\"position\":{\"x\":659,\"y\":341}},\"children\":[{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_getHistory\",\"targetPort\":\"{#}jCnteeA_input_read\"},{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_updateHistory\",\"targetPort\":\"{#}jCnteeA_input_update\"}],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{\"includeAttachments\":false,\"timeout\":60},\"variantId\":\"history\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=\\\"M12 12c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\\\" fill=\\\"white\\\"/>\\n  <rect x=\\\"10\\\" y=\\\"19\\\" width=\\\"4\\\" height=\\\"3\\\" rx=\\\"1\\\" fill=\\\"currentColor\\\"/>\\n</svg>\",\"color\":\"#42a5f5\",\"inputs\":[{\"name\":\"query\",\"description\":\"Query string for the agent\",\"type\":1},{\"name\":\"attachments\",\"description\":\"Attachments for the agent (String, BinaryFile, ImageData, or Array of these types)\",\"type\":[1,12,7,3]},{\"name\":\"clear\",\"description\":\"Clear input signal\",\"type\":6},{\"name\":\"abort\",\"description\":\"Abort current query signal\",\"type\":6},{\"name\":\"send\",\"description\":\"Send input signal\",\"type\":6}],\"outputs\":[{\"name\":\"tools\",\"type\":5},{\"name\":\"history\",\"type\":5},{\"name\":\"json\",\"type\":5},{\"name\":\"text\",\"type\":1},{\"name\":\"stream\",\"type\":1},{\"name\":\"images\",\"description\":\"Generated images as ImageData array\",\"type\":3}],\"supportedPlatforms\":[\"win-x86\",\"win-x64\",\"osx-x64\",\"osx-arm64\",\"linux-debian-arm64\",\"linux-debian-x64\",\"linux-rhel-arm64\",\"linux-rhel-x64\"],\"author\":\"db61881