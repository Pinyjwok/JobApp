\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1784443105}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"disabled":false,"groupId":"{#}E5vjyiP"},"{#}ylXHcUx":{"id":"{#}ylXHcUx","canvas":{"position":{"x":2331,"y":882}},"children":[{"childId":"{#}AuVBkQi","sourcePort":"{#}ylXHcUx_output_error","targetPort":"{#}AuVBkQi_input_input"},{"childId":"{#}dSFgPg0","sourcePort":"{#}ylXHcUx_output_event","targetPort":"{#}dSFgPg0_input_event"}],"state":{},"type":"rescue","groupId":"{#}E5vjyiP"},"{#}AuVBkQi":{"id":"{#}AuVBkQi","canvas":{"position":{"x":2632.3304331452355,"y":1070.0785941463064}},"children":[{"childId":"{#}ijoIjG1","sourcePort":"{#}AuVBkQi_output_text","targetPort":"{#}ijoIjG1_input_input"}],"state":{"text":"Invalid Tool Arguments: {{input.error.message}}","format":"Text","size":{"width":461,"height":100}},"type":"templateString","groupId":"{#}E5vjyiP"},"{#}Z5zJhce":{"id":"{#}Z5zJhce","canvas":{"position":{"x":3210,"y":1220}},"children":[{"childId":"{#}ijoIjG1","sourcePort":"{#}Z5zJhce_output_text","targetPort":"{#}ijoIjG1_input_input"}],"state":{"text":"Failed to conduct research: {{input.error.message}}","format":"Text","size":{"width":220,"height":135}},"type":"templateString","groupId":"{#}E5vjyiP"},"{#}j6yRcNp":{"id":"{#}j6yRcNp","canvas":{"position":{"x":3359,"y":670}},"children":[{"childId":"{#}ijoIjG1","sourcePort":"{#}j6yRcNp_output_summary","targetPort":"{#}ijoIjG1_input_input"},{"childId":"{#}Z5zJhce","sourcePort":"{#}j6yRcNp_output_error","targetPort":"{#}Z5zJhce_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Tavily Search Tool","description":"Performs a token-efficient search tailored for AI agents."},"pages":{"main":{"code":"  /**                                                                                                   \n   * Name: Tavily Search Tool                                                                           \n   * Description: Performs a token-efficient search tailored for AI agents.                             \n   */\n                                                                                                        \nconst getWidgetInputs = () => [                                                                                                                                                    \n    { name: 'query', type: DataType.String },                                                                                                                                        \n    { name: 'sector', type: DataType.String }                                                                                                                                        \n  ];                                                                                                                                                                                 \n                                                                                                                                                                                     \n  const getWidgetOutputs = () => [                                                                                                                                                \n    { name: 'summary', type: DataType.String },                                                                                                                                      \n    { name: 'error', type: DataType.String }                                                                                                                                         \n  ];                                                                                                                                                                                 \n                                                                                                                                                                                     \n  Kemu.secrets.requestAccess('TAVILY_API_KEY');                                                                                                                                      \n                                                                                                                                                                                     \n  let storedSector = \"\";                                                                                                                                                             \n                                                                                                                                                                                     \n  const onParentEvent = async ({ targetPort, event }) => {                                                                                                                           \n                                                                                                                                                                                     \n    if (targetPort.name === 'sector' && event.data.value) {                                                                                                                       \n      storedSector = event.data.value;\n      return;\n    }                                                                                                                                                                                \n                                                                                                                                                                                     \n    if (targetPort.name === 'query' && event.data.value) {                                                                                                                           \n      try {                                                                                                                                                                          \n        const baseQuery = event.data.value;                                                                                                                                          \n        const secrets = await Kemu.secrets.read(['TAVILY_API_KEY']);                                                                                                                 \n        const apiKey = secrets['TAVILY_API_KEY'];                                                                                                                                    \n                                                                                                                                                                                     \n        const isAcademic = /university|college|institute|school|research|faculty|academia/i.test(storedSector);                                                                      \n                                                                                                                                                                                     \n        const keywords = isAcademic                                                                                                                                                  \n          ? \"research culture supervision expectations publication workload academic interview panel grant environment collegial HDR\"                                                \n          : \"workplace culture career progression onboarding entry level training interview format probation team structure fair work\";                                              \n                                                                                                                                                                                     \n        const fullQuery = `${baseQuery} ${keywords}`;                                                                                                                                \n                                                                                                                                                                                     \n        const response = await fetch('https://api.tavily.com/search', {                                                                                                              \n          method: 'POST',                                                                                                                                                            \n          headers: { 'Content-Type': 'application/json' },                                                                                                                        \n          body: JSON.stringify({                                                                                                                                                     \n            api_key: apiKey,                                                                                                                                                         \n            query: fullQuery,                                                                                                                                                        \n            search_depth: \"advanced\",                                                                                                                                                \n            include_answer: true,                                                                                                                                                    \n            max_results: 10,                                                                                                                                                      \n            exclude_domains: [\n              \"linkedin.com\",                                                                                                                                                        \n              \"glassdoor.com\",                                                                                                                                                       \n              \"glassdoor.com.au\"                                                                                                                                                     \n            ]                                                                                                                                                                        \n          })                                                                                                                                                                         \n        });                                                                                                                                                                       \n\n        const data = await response.json();\n                                                                                                                                                                                     \n        if (data && data.results) {                                                                                                                                                  \n          const aiAnswer = data.answer ? `AI Summary: ${data.answer}\\n\\n` : '';                                                                                                      \n          let finalContext = `${aiAnswer}Sources:\\n`;                                                                                                                                \n                                                                                                                                                                                     \n          data.results.forEach((item, i) => {                                                                                                                                        \n            finalContext += `[${i + 1}] ${item.title}\\n   URL: ${item.url}\\n   ${item.content}\\n\\n`;                                                                                 \n          });                                                                                                                                                                        \n                                                                                                                                                                                     \n          await setOutput({                                                                                                                                                       \n            port: 'summary',                                                                                                                                                         \n            data: { type: DataType.String, value: finalContext }                                                                                                                     \n          });                                                                                                                                                                        \n        } else {                                                                                                                                                                     \n          throw new Error(\"Tavily returned an empty or invalid response\");                                                                                                           \n        }                                                                                                                                                                         \n      } catch (err) {\n        console.error('Search Error:', err.message);                                                                                                                                 \n        await setOutput({                                                                                                                                                            \n          port: 'error',                                                                                                                                                             \n          data: { type: DataType.String, value: err.message }                                                                                                                        \n        });                                                                                                                                                                          \n      }                                                                                                                                                                           \n    }\n  };","language":"javascript","name":"My First Script"}}},"type":"script","groupId":"{#}E5vjyiP","secrets":{"TAVILY_API_KEY":{"name":"TAVILY_API_KEY"}}},"{#}DslXGBE":{"id":"{#}DslXGBE","canvas":{"position":{"x":2757,"y":532}},"children":[{"childId":"{#}j6yRcNp","sourcePort":"{#}DslXGBE_output_text","targetPort":"{#}j6yRcNp_input_sector"}],"state":{"text":"{{{input.sector}}}","format":"Text"},"type":"templateString","groupId":"{#}E5vjyiP"},"{#}dSFgPg0":{"id":"{#}dSFgPg0","canvas":{"position":{"x":2442,"y":820}},"children":[{"childId":"{#}5pcp96x","sourcePort":"{#}dSFgPg0_output_1","targetPort":"{#}5pcp96x_input_input"},{"childId":"{#}DslXGBE","sourcePort":"{#}dSFgPg0_output_2","targetPort":"{#}DslXGBE_input_input"}],"state":{"outputPortCount":3},"type":"sequence","groupId":"{#}E5vjyiP"},"{#}4aKSeAi":{"id":"{#}4aKSeAi","canvas":{"position":{"x":-5823,"y":-6591}},"children":[{"childId":"{#}WMz1wo5","sourcePort":"{#}4aKSeAi_output_output","targetPort":"{#}WMz1wo5_input_outer-input-config-NPd1HB"}],"state":{"inputName":"extractor_input"},"type":"input"},"{#}Gejah1a":{"id":"{#}Gejah1a","canvas":{"position":{"x":-5755,"y":-6036}},"children":[{"childId":"{#}KLZboGe","sourcePort":"{#}Gejah1a_output_output","targetPort":"{#}KLZboGe_input_outer-input-config-NPd1HB"}],"state":{"inputName":"style_negotiator_input"},"type":"input"},"{#}C2MDbua":{"id":"{#}C2MDbua","canvas":{"position":{"x":-5789,"y":-6132}},"children":[{"childId":"{#}qy3q1Yn","sourcePort":"{#}C2MDbua_output_output","targetPort":"{#}qy3q1Yn_input_outer-input-config-NPd1HB"}],"state":{"inputName":"tone_analyst_input"},"type":"input"},"{#}j3kp0br":{"id":"{#}j3kp0br","canvas":{"position":{"x":-5814,"y":-6329}},"children":[{"childId":"{#}Aemc6B1","sourcePort":"{#}j3kp0br_output_output","targetPort":"{#}Aemc6B1_input_outer-input-input1-w0lQds"}],"state":{"inputName":"analyst_background_input"},"ty