rt":"{#}y0C6emp_input_input"},{"childId":"{#}aGPUIab","sourcePort":"{#}BNtzniL_output_error","targetPort":"{#}aGPUIab_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Tavily Search Tool","description":"Performs a token-efficient search tailored for AI agents."},"pages":{"main":{"code":"  /**                                                                                                   \n   * Name: Tavily Search Tool                                                                           \n   * Description: Performs a token-efficient search tailored for AI agents.                             \n   */\n                                                                                                        \nconst getWidgetInputs = () => [                                                                                                                                                    \n    { name: 'query', type: DataType.String },                                                                                                                                        \n    { name: 'sector', type: DataType.String }                                                                                                                                        \n  ];                                                                                                                                                                                 \n                                                                                                                                                                                     \n  const getWidgetOutputs = () => [                                                                                                                                                \n    { name: 'summary', type: DataType.String },                                                                                                                                      \n    { name: 'error', type: DataType.String }                                                                                                                                         \n  ];                                                                                                                                                                                 \n                                                                                                                                                                                     \n  Kemu.secrets.requestAccess('TAVILY_API_KEY');                                                                                                                                      \n                                                                                                                                                                                     \n  let storedSector = \"\";                                                                                                                                                             \n                                                                                                                                                                                     \n  const onParentEvent = async ({ targetPort, event }) => {                                                                                                                           \n                                                                                                                                                                                     \n    if (targetPort.name === 'sector' && event.data.value) {                                                                                                                       \n      storedSector = event.data.value;\n      return;\n    }                                                                                                                                                                                \n                                                                                                                                                                                     \n    if (targetPort.name === 'query' && event.data.value) {                                                                                                                           \n      try {                                                                                                                                                                          \n        const baseQuery = event.data.value;                                                                                                                                          \n        const secrets = await Kemu.secrets.read(['TAVILY_API_KEY']);                                                                                                                 \n        const apiKey = secrets['TAVILY_API_KEY'];                                                                                                                                    \n                                                                                                                                                                                     \n        const isAcademic = /university|college|institute|school|research|faculty|academia/i.test(storedSector);                                                                      \n                                                                                                                                                                                     \n        const keywords = isAcademic                                                                                                                                                  \n          ? \"research culture supervision expectations publication workload academic interview panel grant environment collegial HDR\"                                                \n          : \"workplace culture career progression onboarding entry level training interview format probation team structure fair work\";                                              \n                                                                                                                                                                                     \n        const fullQuery = `${baseQuery} ${keywords}`;                                                                                                                                \n                                                                                                                                                                                     \n        const response = await fetch('https://api.tavily.com/search', {                                                                                                              \n          method: 'POST',                                                                                                                                                            \n          headers: { 'Content-Type': 'application/json' },                                                                                                                        \n          body: JSON.stringify({                                                                                                                                                     \n            api_key: apiKey,                                                                                                                                                         \n            query: fullQuery,                                                                                                                                                        \n            search_depth: \"advanced\",                                                                                                                                                \n            include_answer: true,                                                                                                                                                    \n            max_results: 10,                                                                                                                                                      \n            exclude_domains: [\n              \"linkedin.com\",                                                                                                                                                        \n              \"glassdoor.com\",                                                                                                                                                       \n              \"glassdoor.com.au\"                                                                                                                                                     \n            ]                                                                                                                                                                        \n          })                                                                                                                                                                         \n        });                                                                                                                                                                       \n\n        const data = await response.json();\n                                                                                                                                                                                     \n        if (data && data.results) {                                                                                                                                                  \n          const aiAnswer = data.answer ? `AI Summary: ${data.answer}\\n\\n` : '';                                                                                                      \n          let finalContext = `${aiAnswer}Sources:\\n`;                                                                                                                                \n                                                                                                                                                                                     \n          data.results.forEach((item, i) => {                                                                                                                                        \n            finalContext += `[${i + 1}] ${item.title}\\n   URL: ${item.url}\\n   ${item.content}\\n\\n`;                                                                                 \n          });                                                                                                                                                                        \n                                                                                                                                                                                     \n          await setOutput({                                                                                                                                                       \n            port: 'summary',                                                                                                                                                         \n            data: { type: DataType.String, value: finalContext }                                                                                                                     \n          });                                                                                                                                                                        \n        } else {                                                                                                                                                                     \n          throw new Error(\"Tavily returned an empty or invalid response\");                                                                                                           \n        }                                                                                                                                                                         \n      } catch (err) {\n        console.error('Search Error:', err.message);                                                                                                                                 \n        await setOutput({                                                                                                                                                            \n          port: 'error',                                                                                                                                                             \n          data: { type: DataType.String, value: err.message }                                                                                                                        \n        });                                                                                                                                                                          \n      }                                                                                                                                                                           \n    }\n  };","language":"javascript","name":"My First Script"}}},"type":"script","groupId":"{#}OpAIZUD","secrets":{"TAVILY_API_KEY":{"name":"TAVILY_API_KEY"}}},"{#}MY7Ozyd":{"id":"{#}MY7Ozyd","canvas":{"position":{"x":2757,"y":532}},"children":[{"childId":"{#}BNtzniL","sourcePort":"{#}MY7Ozyd_output_text","targetPort":"{#}BNtzniL_input_sector"}],"state":{"text":"{{{input.sector}}}","format":"Text"},"type":"templateString","groupId":"{#}OpAIZUD"},"{#}ochKvXU":{"id":"{#}ochKvXU","canvas":{"position":{"x":2442,"y":820}},"children":[{"childId":"{#}ChoZg1g","sourcePort":"{#}ochKvXU_output_1","targetPort":"{#}ChoZg1g_input_input"},{"childId":"{#}MY7Ozyd","sourcePort":"{#}ochKvXU_output_2","targetPort":"{#}MY7Ozyd_input_input"}],"state":{"outputPortCount":3},"type":"sequence","groupId":"{#}OpAIZUD"},"{#}YBdr4Ob":{"id":"{#}YBdr4Ob","canvas":{"position":{"x":-5823,"y":-6591}},"children":[{"childId":"{#}bl6upy9","sourcePort":"{#}YBdr4Ob_output_output","targetPort":"{#}bl6upy9_input_outer-input-config-NPd1HB"}],"state":{"inputName":"extractor_input"},"type":"input"},"{#}y7xyS1J":{"id":"{#}y7xyS1J","canvas":{"position":{"x":-5755,"y":-6036}},"children":[{"childId":"{#}kciARP3","sourcePort":"{#}y7xyS1J_output_output","targetPort":"{#}kciARP3_input_outer-input-config-NPd1HB"}],"state":{"inputName":"style_negotiator_input"},"type":"input"},"{#}rg3JDHf":{"id":"{#}rg3JDHf","canvas":{"position":{"x":-5789,"y":-6132}},"children":[{"childId":"{#}9W1zM85","sourcePort":"{#}rg3JDHf_output_output","targetPort":"{#}9W1zM85_input_outer-input-config-NPd1HB"}],"state":{"inputName":"tone_analyst_input"},"type":"input"},"{#}0Wad1XQ":{"id":"{#}0Wad1XQ","canvas":{"position":{"x":-5824,"y":-6329}},"children":[{"childId":"{#}dJ2tJAF","sourcePort":"{#}0Wad1XQ_output_output","targetPort":"{#}dJ2tJAF_input_outer-input-input1-w0lQds"}],"state":{"inputName":"analyst_background_input"},"type":"input"},"{#}7REF65v":{"id":"{#}7REF65v","canvas":{"position":{"x":-5837,"y":-6411}},"children":[{"childId":"{#}0Zjw9qA","sourcePort":"{#}7REF65v_output_output","targetPort":"{#}0Zjw9qA_input_outer-input-config-NPd1HB"}],"state":{"inputName":"jd_enhancer_input"},"type":"input"},"{#}G4lZr4e":{"id":"{#}G4lZr4e","canvas":{"position":{"x":-5824,"y":-6508}},"children":[{"childId":