0 74.859-15.047 102.14-42.281l199.82-199.82c2.9531-2.9531 5.1094-6.6094 6.2812-10.594l19.688-66.797 66.797-19.688c8.4375-2.4844 14.953-9.2344 17.156-17.812 2.1562-8.5312-0.28125-17.625-6.5625-23.859l-54.422-54.422 327.79-327.79 79.359-19.219 84.891-145.03-60.141-60.141zm-587.39 682.87-179.29 179.29c-4.875 4.875-11.297 7.3125-17.672 7.3125-6.4219 0-12.797-2.4375-17.672-7.3125-9.7969-9.7969-9.7969-25.594 0-35.344l179.29-179.29c9.7969-9.7969 25.594-9.7969 35.344 0 9.7969 9.7969 9.7969 25.594 0 35.344z\"/>\n</svg>\n","inputs":[{"name":"input","description":"Tool input data","type":5}],"outputs":[{"name":"arguments","description":"Tool arguments","type":5}],"color":"#42a5f5"},{"id":"submit","name":"Submit","description":"Submits data back to the agent after a tool execution or history retrieval","svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m645.28 600c0-12.516-5.0625-23.812-13.266-32.016-8.1562-8.2031-19.5-13.266-32.016-13.266s-23.812 5.0625-32.016 13.266c-8.2031 8.1562-13.266 19.5-13.266 32.016 0 12.469 5.0625 23.812 13.266 32.016 8.1562 8.2031 19.5 13.266 32.016 13.266s23.812-5.0625 32.016-13.266c8.2031-8.1562 13.266-19.5 13.266-32.016zm291.84 37.453c-0.23438 0.84375-86.812 289.13-417.14 310.13v-58.219h-0.046875c0-4.7344-1.2188-9.6094-3.7969-14.016-7.7344-13.078-24.609-17.438-37.688-9.7031l-227.95 135.37c-3.9375 2.25-7.4062 5.625-9.8906 9.8438-7.7344 13.078-3.375 29.953 9.7031 37.641l226.64 134.63c4.4062 3 9.75 4.7812 15.516 4.7812 15.234 0 27.562-12.328 27.562-27.562v-59.719c61.125-8.7656 151.6-31.031 238.13-87.703 99.375-65.062 193.4-174.89 231.89-360.24 3.8438-14.203-4.2188-29.062-18.375-33.469-14.531-4.5-29.906 3.6094-34.453 18.094zm-674.34-74.906c0.23438-0.84375 86.812-289.13 417.14-310.13v58.219h0.046875c0 4.7344 1.2188 9.6094 3.7969 14.016 7.7344 13.078 24.609 17.438 37.688 9.7031l227.95-135.37c3.9375-2.25 7.4062-5.625 9.8