781-0.75-5.1562-1.1719-7.6406l35.297-28.547z\" fill-rule=\"evenodd\"/>\n</svg>\n","inputs":[{"name":"input","description":"Data to submit","type":6}],"color":"#68bb6c"},{"id":"history","name":"History","description":"Manage conversation history and session storage for AI agents","svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m1003.2 198c-216-216-560.4-220.8-784.8-19.199l-60-60c-19.199-19.199-52.801-9.6016-58.801 16.801l-68.398 280.8c-6 25.199 16.801 49.199 43.199 43.199l280.8-68.398c26.398-6 36-39.602 16.801-58.801l-66-66c176.4-153.6 444-148.8 612 19.199 174 174 174 459.6-1.1992 634.8l-16.801 15.602c-25.199 22.801-26.398 61.199-4.8008 86.398 12 13.199 28.801 20.398 45.602 20.398 14.398 0 28.801-4.8008 40.801-15.602 7.1992-6 14.398-13.199 20.398-20.398 223.2-223.2 223.2-585.6 1.1992-808.8z\"/>\n <path d=\"m739.2 1028.4-22.801 7.1992c-32.398 8.3984-51.602 42-43.199 75.602 7.1992 27.602 32.398 45.602 58.801 45.602 4.8008 0 10.801-1.1992 15.602-2.3984 9.6016-2.3984 19.199-6 28.801-8.3984 32.398-10.801 49.199-45.602 38.398-76.801-8.4023-33.602-43.199-51.602-75.602-40.805z\"/>\n <path d=\"m532.8 1046.4-24-3.6016c-33.602-7.1992-66 14.398-72 48-7.1992 33.602 14.398 66 48 72 9.6016 2.3984 20.398 3.6016 30 4.8008 2.3984 0 6 1.1992 9.6016 1.1992 30 0 56.398-21.602 60-52.801 4.7969-33.598-18.004-64.797-51.602-69.598z\"/>\n <path d=\"m321.6 955.2c-26.398-20.398-64.801-16.801-86.398 9.6016-20.398 26.398-16.801 64.801 9.6016 86.398 8.3984 6 15.602 12 24 18 10.801 7.1992 22.801 10.801 34.801 10.801 19.199 0 38.398-8.3984 50.398-26.398 19.199-27.602 13.199-66-14.398-85.199z\"/>\n <path d=\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1781146161,"internal":false}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"groupId":"{#}M5nd2cu"},"{#}B7HshpR":{"id":"{#}B7HshpR","canvas":{"position":{"x":800,"y":622}},"children":[{"childId":"{#}8v6cxKo","sourcePort":"{#}B7HshpR_output_sessionHistoryOutput","targetPort":"{#}8v6cxKo_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}M5nd2cu"},"{#}MrfW7NV":{"id":"{#}MrfW7NV","canvas":{"position":{"x":552,"y":238}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}M5nd2cu"},"{#}DlaeLJZ":{"id":"{#}DlaeLJZ","canvas":{"position":{"x":1653,"y":1033}},"children":[{"childId":"{#}dxr3AZo","sourcePort":"{#}DlaeLJZ_output_tools","targetPort":"{#}dxr3AZo_input_outer-input-input1"},{"childId":"{#}Y6b9TRu","sourcePort":"{#}DlaeLJZ_output_history","targetPort":"{#}Y6b9TRu_input_outer-input-input1"},{"childId":"{#}91QOccG","sourcePort":"{#}DlaeLJZ_output_reasoning","targetPort":"{#}91QOccG_input_setValue"},{"childId":"{#}5nfclFL","sourcePort":"{#}DlaeLJZ_output_debug","targetPort":"{#}5nfclFL_input_setValue"},{"childId":"{#}GNPYOGH","sourcePort":"{#}DlaeLJZ_output_text","targetPort":"{#}GNPYOGH_input_setValue"},{"childId":"{#}GpkxHSR","sourcePort":"{#}DlaeLJZ_output_text","targetPort":"{#}GpkxHSR_input_event"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"selectedModel":{"id":"google/gemini-2.5-pro","slug":"google/gemini-2.5-pro","name":"Google: Gemini 2.5 Pro","description":"Gemini 2.5 Pro is Google’s state-of-the-art AI model designed for advanced reasoning, coding, mathematics, and scientific tasks. It employs “thinking” capabilities, enabling it to reason through responses with enhanced accuracy...","inputModalities":["text","image","file","audio","video"],"outputModalities":["text"],"supportsTools":true,"supportsReasoning":true,"promptPrice":0.00000125,"completionPrice":0.00001,"maxTokens":65536,"contextLength":1048576,"provider":"google"},"systemInstructions":"# Style Reviewer v2.2 — System Instructions\n\n**Version:** 2.2\n**Last Updated:** 2026-05-13\n**Role:** Style Consistency Verifier\n**Pipeline Position:** Assembly Phase 7\n**Trigger:** Dispatched sequentially by server after Cover Letter Writer approved (or gate_continue action)\n**Output:** Updates `phases[6]`, sets `current_phase = 8`\n\n---\n\n## Role\n\nYou verify all CV sections follow agreed style overrides:\n- Check for \"I\" pronouns if removed\n- Verify telegraphic formatting if applied\n- Confirm bold emphasis on metrics\n- Ensure consistent structure\n\n---\n\n## Execution Protocol\n\n### Phase 1: Load All CV Sections\n```javascript\nconst cvState = JSON.parse(ReadFile(\"cv_assembly_state.json\"))\n\n// Read agreed overrides from Phase 1 (Style Negotiator) — Object, convert to values array\nconst agreed = cvState.phases[0].data?.agreed_overrides || {}\nconst styleOverrides = Array.isArray(agreed) ? agreed : Object.values(agreed)\n\n// Read section data from completed phases\nconst profile = cvState.phases[1].data?.profile_paragraph?.formatted_text || \"\"\nconst skills = cvState.phases[2].data || {}\nconst history = cvState.phases[3].data?.work_history || cvState.phases[3].data?.formatted_entries || []\nconst credentials = cvState.phases[4].data || {}\n// Use coverletter_body for style checks (body text only, not header/sign-off)\nconst coverletter = cvState.phases[5].data?.coverletter_body || cvState.phases[5].data?.coverletter_text || \"\"\n```\n\n---\n\n### Phase 2: Check Each Override\n```javascript\nconst issues = []\n// Track per-section verdicts for detailed reporting\nconst sectionResults = {\n  profile:     { checked: true, issues: [] },\n  skills:      { checked: true, issues: [] },\n  history:     { checked: true, issues: [] },\n  credentials: { checked: true, issues: [] },\n  coverletter: { checked: !!coverletter, issues: [] }\n}\n\n// ── DIRECTIVE: semantic style audit ──────────────────────────────────────\n// For each active override below, read the assembled text and audit it semantically.\n// Do NOT use regex or pattern matching. Read the text as a human editor would.\n\n// Override: implicit-first-person (CV sections only — NOT cover letter)\nif (styleOverrides.some(o => o.toLowerCase().includes(\"implicit first-person\"))) {\n  // Read profile and all history bullets.\n  // Flag any sentence or bullet that contains \"I\" as the grammatical subject\n  // (e.g. \"I managed...\", \"I led...\", \"I was responsible for...\").\n  // Do NOT flag \"I\" appearing mid-sentence in quoted text or company names.\n  // Push a specific message naming the offending text to issues + sectionResults.\n}\n\n// Override: telegraphic bullets\nif (styleOverrides.some(o => o.toLowerCase().includes(\"telegraphic\"))) {\n  // Read all history bullets.\n  // Flag any bullet that ends with a full stop/period.\n  // Flag any bullet that starts with a filler phrase (\"Responsible for\", \"Helped to\",\n  // \"Was involved in\", \"Assisted with\") rather than a direct action verb.\n  // Do NOT flag bullets that simply don't end with a period — only flag clear violations.\n}\n\n// Override: bold metrics\nif (styleOverrides.some(o => o.toLowerCase().includes(\"bold\"))) {\n  // Read all history bullets.\n  // Check: are numeric metrics and key results wrapped in **bold**?\n  // Look for: percentages, currency figures, headcounts, multipliers, timeframes.\n  // Also look for metrics expressed as words (\"halved\", \"doubled\", \"threefold\").\n  // If NO bullets in the entire history contain any bold formatting → flag as missing.\n  // If some bullets have unbolded metrics → flag the specific bullets.\n}\n\n// ── Em dash check — ALWAYS run regardless of overrides (P1 Defect 12 fix) ───────\n// Flag any em dash (U+2014 —) in profile text and history bullets.\n// Do NOT flag en dash (–) in date ranges (e.g. \"Mar 2020 – Present\") — date ranges are correct.\n// Only flag em dash (—) and en dash used mid-sentence as punctuation substitutes.\n// DIRECTIVE: read each section and flag any — character not inside a date range pattern.\n// Push: { issue: `Em dash found: \"${context}\"`, section, category: 'em_dash', auto_fixable: true }\n{\n  const emDashChar = '—'  // em dash —\n  if (profile.includes(emDashChar)) {\n    const msg = `Em dash (—) found in profile paragraph`\n    issues.push({ issue: msg, section: 'profile', category: 'em_dash', auto_fixable: true })\n    sectionResults.profile.issues.push(msg)\n  }\n  history.forEach(entry => {\n    (entry.bullets || []).forEach(bullet => {\n      if (bullet.includes(emDashChar)) {\n        const msg = `Em dash (—) in career history bullet: \"${bullet.substring(0, 60)}\"`\n        issues.push({ issue: msg, section: 'history', category: 'em_dash', auto_fixable: true })\n        sectionResults.history.issues.push(msg)\n      }\n    })\n  })\n}\n\n// ── Passive voice check — run if assertive/action verb override agreed ──────────\nif (styleOverrides.some(o => /passive|assertive|action.verb/i.test(o))) {\n  // DIRECTIVE: read all history bullets semantically.\n  // Flag bullets using passive constructions: \"was [verb]ed\", \"were [verb]ed\", \"has been [verb]ed\",\n  // \"had been [verb]ed\", \"is [verb]ed\", and weak openers: \"Responsible for\", \"Involved in\",\n  // \"Tasked with\", \"Assisted with\", \"Helped to\", \"Helped with\".\n  // Do NOT flag descriptive statements that happen to use \"was\" for past tense facts.\n  // Push: { issue: `Passive voice: \"${bullet.substring(0,60)}\"`, section: 'history', category: 'passive_voice', auto_fixable: false }\n}\n\n// ── AI register / candidate voice check — ALWAYS run ────────────────────────────\n// Flag if assembled profile or history bullets contain corporate register in clinical role context.\n// These terms are AI tells that replace authentic candidate voice:\nconst aiRegisterTerms = ['leveraged', 'synergies', 'cross-functional', 'deliverables', 'bandwidth',\n  'stakeholder alignment', 'robust', 'scalable', 'paradigm', 'utilized', 'utilised', 'ideation', 'impactful']\naiRegisterTerms.forEach(term => {\n  if (profile.toLowerCase().includes(term)) {\n    const msg = `AI-register term \"${term}\" in profile — replace with candidate's authentic voice`\n    issues.push({ issue: msg, section: 'profile', category: 'ai_register', auto_fixable: false })\n    sectionResults.profile.issues.push(msg)\n  }\n  history.forEach(entry => {\n    (entry.bullets || []).forEach(bullet => {\n      if (bullet.toLowerCase().includes(term)) {\n        const msg = `AI-register term \"${term}\" in career history bullet`\n        issues.push({ issue: msg, section: 'history', category: 'ai_register', auto_fixable: false })\n        sectionResults.history.issues.push(msg)\n      }\n    })\n  })\n})\n\n// ── Cover letter banned phrases ────────────────────────────────────────────\n// Read the cover letter text and flag any of the following phrases.\n// This check runs regardless of style overrides.\nconst coverLetterText = cvState.phases[5].data?.cover_letter?.full_letter || \"\"\nconst coverletter = coverLetterText\n\nconst coverletterBannedPhrases = [\n  \"I am writing to\",\n  \"I am writing to express\",\n  \"I am eager to contribute\",\n  \"I am uniquely positioned\",\n  \"I am inspired by\",\n  \"I would be a great fit\",\n  \"I am passionate about\",\n  \"I look forward to the opportunity\",\n  \"I look forward to hearing from you\",\n  \"I pride myself\",\n  \"my passion for\",\n  \"I am excited to\",\n  \"I am thrilled to\",\n  \"as you can see from my\",\n  \"as outlined in my\",\n  \"I hope to be given\",\n  \"I hope to have the opportunity\",\n  \"your values align with mine\",\n  \"aligns closely with my own\",\n  \"aligns with my values\",\n  \"To whom it may concern\",\n]\n\nif (coverletter) {\n  const coverletterLower = coverletter.toLowerCase()\n  coverletterBannedPhrases.forEach(phrase => {\n    if (coverletterLower.includes(phrase.toLowerCase())) {\n      const msg = `Banned phrase in cover letter: \"${phrase}\"`\n      issues.push(msg); sectionResults.coverletter.issues.push(msg)\n    }\n  })\n} else {\n  sectionResults.coverletter.checked = false\n  sectionResults.coverletter.issues.push(\"Cover letter text not available — skipped\")\n}\n```\n\n---\n\n### Phase 3: Report & Fix (Auto-Fix Minor Issues)\n```javascript\n// Classify issues by severity (P1 Defect 12 fix)\nconst hasPassiveIssues = issues.some(i => i.category === 'passive_voice')\nconst hasAIRegIssues   = issues.some(i => i.category === 'ai_register')\nconst allAutoFixable   = issues.length > 0 && issues.every(i => i.auto_fixable === true)\n\nif (issues.length === 0) {\n  styleCompliance = \"PASS\"\n} else if (!hasPassiveIssues && !hasAIRegIssues && issues.length <= 2 && allAutoFixable) {\n  // Auto-fix minor issues (em dash only — structural issues require HF rewrite)\n  styleCompliance = \"PASS_WITH_FIXES\"\n  // Apply corrections to profile, history bullets as needed...\n} else {\n  styleCompliance = \"FAIL\"\n  // Set exception status BEFORE writing so AC exception handler sees it\n  cvState.metadata.status = \"STYLE_FAILED\"\n}\n```\n\n---\n\n### Phase 4: Update State, Display Completion, and Return\n```javascript\n// Schema preservation: restore change_log if dropped by prior agents (BUG-54 cascade)\nif (!Array.isArray(cvState.change_log)) {\n  cvState.change_log = []\n}\n\n// Prohibition: do NOT write any fields to cvState.metadata except the ones below.\n// Never add final_cv, current_phase, or any other fields inside metadata.\ncvState.phases[6].status = \"COMPLETE\"\ncvState.phases[6].completed_at = getCurrentISOTimestamp()\n// Collect auto-fixes applied (minor issues that were corrected without user input)\nconst fixesApplied = issues.filter(i => i.auto_fixed === true).map(i => i.description || String(i))\n\ncvState.phases[6].data = {\n  style_compliance: styleCompliance,\n  verdict: styleCompliance,    // alias field — AC checks integrityData.passed via style_compliance === \"PASS\"\n  issues_found: issues,\n  issues_count: issues.length,\n  fixes_applied: fixesApplied, // list of auto-applied minor corrections; empty array if none\n  sections_checked: Object.values(sectionResults).filter(s => s.checked).length,\n  sections_excluded: Object.values(sectionResults).filter(s => !s.checked).length,\n  section_verdicts: {\n    profile:     { checked: sectionResults.profile.checked,     issues: sectionResults.profile.issues,     passed: sectionResults.profile.issues.length === 0 },\n    skills:      { checked: sectionResults.skills.checked,      issues: sectionResults.skills.issues,      passed: sectionResults.skills.issues.length === 0 },\n    history:     { checked: sectionResults.history.checked,     issues: sectionResults.history.issues,     passed: sectionResults.history.issues.length === 0 },\n    credentials: { checked: sectionResults.credentials.checked, issues: sectionResults.credentials.issues, passed: sectionResults.credentials.issues.length === 0 },\n    coverletter:  { checked: sectionResults.coverletter.checked,  issues: sectionResults.coverletter.issues,  passed: sectionResults.coverletter.checked && sectionResults.coverletter.issues.length === 0 }\n  }\n}\n\ncvState.current_phase = 8\ndelete cvState.metadata.current_phase  // Remove any metadata.current_phase pollution\ncvState.metadata.completed_phases += 1\ncvState.metadata.last_updated = getCurrentISOTimestamp()\n\n// ⚠️ FILENAME GUARD — literal string only. Never prepend 'workspace' or any path.\n// WRONG: \"workspacecv_assembly_state.json\"   WRONG: \"workspace/cv_assembly_state.json\"\n// CORRECT: \"cv_assembly_state.json\"\nWriteFile(\"cv_assembly_state.json\", JSON.stringify(cvState, null, 2))\n```\n\nThen display and return:\n\n```javascript\nIF styleCompliance === \"FAIL\":\n  // Exception path — user must review before continuing\n  Display: `\n## ⚠ Style Review Failed\n\n${issues.length} style issues found that require attention:\n${issues.map(i => `• ${i}`).join('\\n')}\n\npipeline_status: STYLE_FAILED\n`\n  END TURN\n\nELSE:\n  // Happy path (PASS or PASS_WITH_FIXES) — end turn, server dispatches Integrity Checker\n  Display: `\n# ✓ Style Reviewer Complete\n\nStyle consistency check complete.\n- Compliance: {styleCompliance}\n- Issues found: {issues.length}\n- Sections checked: 5\n`\n  // TURN ENDS. No pipeline_status tag needed — server dispatches IC automatically on SR completion.\n```\n\n---\n\n## ⚠️ Critical Rules\n\n**`getCurrentISOTimestamp()` implementation** — When writing any date/time field, extract the current date from the system context (\"Today's date is YYYY-MM-DD\") and return it as ISO 8601: `YYYY-MM-DDT00:00:00Z`. **Never hardcode a specific date string** (e.g. \"2026-03-31T00:00:00Z\") — that is a fabrication error. If no system date is visible, use the most recent date mentioned in the conversation.\n\n1. **Use bare filenames** — `\"cv_assembly_state.json\"` not `\"/cv_assembly_state.json\"`\n2. **No leading slashes** — Never start filename with `/`\n3. **NEVER prepend 'workspace'** — `\"workspacecv_assembly_state.json\"` is WRONG. Never construct a filename by concatenating any prefix.\n4. **Always stringify JSON** — `WriteFile(\"file.json\", JSON.stringify(data, null, 2))`\n4. **Read section data from phases array** — `cvState.phases[N].data`, not `cvState.sections`\n5. **Read style overrides from phases[0].data** — Not from old sections schema\n6. **Update phases[6] only** — Array index 6\n7. **Advance to Phase 8** — Set current_phase = 8\n8. **No SwitchAgent on happy path** — PASS/PASS_WITH_FIXES: display completion, turn ENDS naturally; server dispatches IC automatically. Only FAIL path outputs `pipeline_status: STYLE_FAILED`.\n9. **FAIL path outputs pipeline_status tag** — `pipeline_status: STYLE_FAILED` as last line of display; no set_status call\n10. **Use actual current date** — Never hardcode timestamps\n11. **Check cover letter banned phrases** — Always run banned phrases check on `coverletter_body`. This check is mandatory and not gated on style overrides. \"I pride myself on\" and all other banned phrases must be flagged as issues if found.\n12. **Detailed section_verdicts required** — phases[6].data must include `section_verdicts` with per-section pass/fail and issue lists. A sparse data object (only compliance + count) is insufficient.\n13. **Never write extra fields to metadata** — Only update `completed_phases`, `last_updated`, and `status` (on FAIL). Never add `final_cv`, `current_phase`, or any other fields inside `cvState.metadata`.\n14. **Restore change_log if missing** — If `cvState.change_log` is absent (dropped by prior agents), initialise it as an empty array before writing.\n\n---\n\n*End of Style Reviewer v1.4*","query":"","jsonResponse":false,"jsonFormat":"","jsonSchemaMode":"typescript","fileParser":"native","imageAspectRatio":"1:1","maxIterations":12,"reasoningEffort":"medium","allowFallbacks":true,"temperature":1},"service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801c14.762-6.3594 14.762-27.238 0-33.719zm-210.84-6.9609c-3 6.7188-9.6016 10.801-16.559 10.801-2.3984 0-4.8008-0.48047-7.1992-1.4414-64.078-28.078-114.72-78.719-142.68-142.8-4.0781-9.1211 0.12109-19.801 9.2383-23.762 9.1211-3.9609 19.68 0.23828 23.762 9.3594 24.238 55.68 68.398 99.84 124.08 124.2 9.1211 3.9609 13.32 14.52 9.3594 23.641z\"/>\n <path d=\"m1113.1 322.08-109.56-47.762c-26.52-11.641-47.641-32.762-59.281-59.281l-47.762-109.56c-3.7188-8.5195-15.84-8.5195-19.559 0l-47.762 109.56c-11.641 26.52-32.762 47.641-59.281 59.281l-109.68 47.879c-8.5195 3.7188-8.5195 15.719-0.12109 19.441l111.72 49.32c26.398 11.762 47.52 33 58.922 59.52l46.32 107.64c3.6016 8.5195 15.719 8.5195 19.441 0l47.762-109.44c11.641-26.52 32.762-47.641 59.281-59.281l109.56-47.762c8.5195-3.7188 8.5195-15.84 0-19.559zm-149.28 15.84c-3.4805 5.6406-9.3594 8.6406-15.48 8.6406-3.1211 0-6.3594-0.83984-9.2383-2.5195-24.84-15.121-45.359-34.922-61.199-59.16-5.3984-8.3984-3-19.441 5.2812-24.961 8.2812-5.3984 19.441-3.1211 24.84 5.2812 12.961 19.68 29.641 35.762 49.68 48 8.5195 5.1602 11.281 16.199 6.1211 24.719z\"/>\n</svg>\n","color":"#42a5f5","mdHelp":"/docs/help/service.md","customWidgets":[{"name":"Memory History","color":"#eac43e","description":"Provides a simple in-memory history manager for debugging purposes.","contents":"KMU-CB-v1{\"{#}mBE0gxc\":{\"id\":\"{#}mBE0gxc\",\"canvas\":{\"position\":{\"x\":2006,\"y\":726}},\"children\":[{\"childId\":\"{#}4M2WbT3\",\"sourcePort\":\"{#}mBE0gxc_innerOutput_inner-input-input1\",\"targetPort\":\"{#}4M2WbT3_input_agent\"}],\"state\":{\"description\":\"Provides a simple in-memory history manager for debugging purposes.\",\"inputs\":[{\"index\":0,\"label\":\"agent\",\"name\":\"input1\",\"type\":[5],\"position\":{\"x\":519,\"y\":291}}],\"outputs\":[],\"name\":\"Memory History\",\"type\":\"custom\",\"color\":\"#eac43e\",\"icon\":\"database\",\"canvasPosition\":{\"x\":0,\"y\":0},\"markdownHelp\":\"\",\"settings\":[],\"protocolVersion\":\"2\"},\"type\":\"widgetGroup\"},\"{#}4M2WbT3\":{\"id\":\"{#}4M2WbT3\",\"canvas\":{\"position\":{\"x\":659,\"y\":341}},\"children\":[{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_getHistory\",\"targetPort\":\"{#}jCnteeA_input_read\"},{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_updateHistory\",\"targetPort\":\"{#}jCnteeA_input_update\"}],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{\"includeAttachments\":false,\"timeout\":60},\"variantId\":\"history\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=\\\"M12 12c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\\\" fill=\\\"white\\\"/>\\n  <rect x=\\\"10\\\" y=\\\"19\\\" width=\\\"4\\\" height=\\\"3\\\" rx=\\\"1\\\" fill=\\\"currentColor\\\"/>\\n</svg>\",\"color\":\"#42a5f5\",\"inputs\":[{\"name\":\"query\",\"description\":\"Query string for the agent\",\"type\":1},{\"name\":\"attachments\",\"description\":\"Attachments for the agent (String, BinaryFile, ImageData, or Array of these types)\",\"type\":[1,12,7,3]},{\"name\":\"clear\",\"description\":\"Clear input signal\",\"type\":6},{\"name\":\"abort\",\"description\":\"Abort current query signal\",\"type\":6},{\"name\":\"send\",\"description\":\"Send input signal\",\"type\":6}],\"outputs\":[{\"name\":\"tools\",\"type\":5},{\"name\":\"history\",\"type\":5},{\"name\":\"json\",\"type\":5},{\"name\":\"text\",\"type\":1},{\"name\":\"stream\",\"type\":1},{\"name\":\"images\",\"description\":\"Generated images as ImageData array\",\"type\":3}],\"supportedPlatforms\":[\"win-x86\",\"win-x64\",\"osx-x64\",\"osx-arm64\",\"linux-debian-arm64\",\"linux-debian-x64\",\"linux-rhel-arm64\",\"linux-rhel-x64\"],\"author\":\"db618814-4e68-40aa-8158-64a595fea23b\",\"defaultVariantInfo\":{\"title\":\"Agent\",\"shortTitle\":\"Agent\",\"description\":\"AI agent that processes queries with system instructions and attachments\"},\"variants\":[{\"id\":\"tool\",\"name\":\"Tool\",\"description\":\"Define tools with arguments and results for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Tool icon - wrench/settings -->\\n  <path d=\\\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Tool input data\",\"type\":5}],\"outputs\":[{\"name\":\"arguments\",\"description\":\"Tool arguments\",\"type\":5}],\"color\":\"#42a5f5\"},{\"id\":\"submit\",\"name\":\"Submit\",\"description\":\"Submit data without any processing\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Submit icon - send/arrow -->\\n  <path d=\\\"M2.01 21L23 12 2.01 3 2 10l15 2-15 2z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Data to submit\",\"type\":6}],\"color\":\"#68bb6c\"},{\"id\":\"history\",\"name\":\"History\",\"description\":\"Manage conversation history and session storage for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 16 16\\\">\\n  <path\\n    d=\\\"M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M8 3.5a.5.5 0 0 1 .5.5v4l2.5 1.5a.5.5 0 0 1-.5.866L7.5 8.866A.5.5 0 0 1 7.5 8V4a.5.5 0 0 1 .5-.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M2.5 8a5.5 5.5 0 0 1 5.5-5.5V1A7 7 0 0 0 1 8h1.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n</svg>\\n\",\"inputs\":[{\"name\":\"agent\",\"description\":\"Connect to the agent\",\"type\":5}],\"outputs\":[{\"name\":\"getHistory\",\"description\":\"Invoked when the agent needs to retrieve the conversation history\",\"type\":5},{\"name\":\"updateHistory\",\"description\":\"Invoked when the agent needs to update the conversation history\",\"type\":5}],\"color\":\"#9c27b0\"}],\"internal\":false,\"devMode\":true,\"sessionId\":1760512532}},\"type\":\"hubService\",\"groupId\":\"{#}mBE0gxc\"},\"{#}a5vxU9Y\":{\"id\":\"{#}a5vxU9Y\",\"canvas\":{\"position\":{\"x\":1235,\"y\":488}},\"children\":[],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{},\"variantId\":\"submit\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=\\\"M12 12c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\\\" fill=\\\"white\\\"/>\\n  <rect x=\\\"10\\\" y=\\\"19\\\" width=\\\"4\\\" height=\\\"3\\\" rx=\\\"1\\\" fill=\\\"currentColor\\\"/>\\n</svg>\",\"color\":\"#42a5f5\",\"inputs\":[{\"name\":\"query\",\"description\":\"Query string for the agent\",\"type\":1},{\"name\":\"attachments\",\"description\":\"Attachments for the agent (String, BinaryFile, ImageData, or Array of these types)\",\"type\":[1,12,7,3]},{\"name\":\"clear\",\"description\":\"Clear input signal\",\"type\":6},{\"name\":\"abort\",\"description\":\"Abort current query signal\",\"type\":6},{\"name\":\"send\",\"description\":\"Send input signal\",\"type\":6}],\"outputs\":[{\"name\":\"tools\",\"type\":5},{\"name\":\"history\",\"type\":5},{\"name\":\"json\",\"type\":5},{\"name\":\"text\",\"type\":1},{\"name\":\"stream\",\"type\":1},{\"name\":\"images\",\"description\":\"Generated images as ImageData array\",\"type\":3}],\"supportedPlatforms\":[\"win-x86\",\"win-x64\",\"osx-x64\",\"osx-arm64\",\"linux-debian-arm64\",\"linux-debian-x64\",\"linux-rhel-arm64\",\"linux-rhel-x64\"],\"author\":\"db618814-4e68-40aa-8158-64a595fea23b\",\"defaultVariantInfo\":{\"title\":\"Agent\",\"shortTitle\":\"Agent\",\"description\":\"AI agent that processes queries with system instructions and attachments\"},\"variants\":[{\"id\":\"tool\",\"name\":\"Tool\",\"description\":\"Define tools with arguments and results for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Tool icon - wrench/settings -->\\n  <path d=\\\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Tool input data\",\"type\":5}],\"outputs\":[{\"name\":\"arguments\",\"description\":\"Tool arguments\",\"type\":5}],\"color\":\"#42a5f5\"},{\"id\":\"submit\",\"name\":\"Submit\",\"description\":\"Submit data without any processing\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Submit icon - send/arrow -->\\n  <path d=\\\"M2.01 21L23 12 2.01 3 2 10l15 2-15 2z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Data to submit\",\"type\":6}],\"color\":\"#68bb6c\"},{\"id\":\"history\",\"name\":\"History\",\"description\":\"Manage conversation history and session storage for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 16 16\\\">\\n  <path\\n    d=\\\"M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M8 3.5a.5.5 0 0 1 .5.5v4l2.5 1.5a.5.5 0 0 1-.5.866L7.5 8.866A.5.5 0 0 1 7.5 8V4a.5.5 0 0 1 .5-.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M2.5 8a5.5 5.5 0 0 1 5.5-5.5V1A7 7 0 0 0 1 8h1.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n</svg>\\n\",\"inputs\":[{\"name\":\"agent\",\"description\":\"Connect to the agent\",\"type\":5}],\"outputs\":[{\"name\":\"getHistory\",\"description\":\"Invoked when the agent needs to retrieve the conversation history\",\"type\":5},{\"name\":\"updateHistory\",\"description\":\"Invoked when the agent needs to update the conversation history\",\"type\":5}],\"color\":\"#9c27b0\"}],\"internal\":false,\"devMode\":true,\"sessionId\":1760512532}},\"type\":\"hubService\",\"secrets\":{\"OPENROUTER_API_KEY\":{\"name\":\"OPENROUTER_API_KEY\",\"hubServiceName\":\"kemu.io.ai-agent\"}},\"groupId\":\"{#}mBE0gxc\"},\"{#}jCnteeA\":{\"id\":\"{#}jCnteeA\",\"canvas\":{\"position\":{\"x\":948,\"y\":397}},\"children\":[{\"childId\":\"{#}a5vxU9Y\",\"sourcePort\":\"{#}jCnteeA_output_sessionHistoryOutput\",\"targetPort\":\"{#}a5vxU9Y_input_input\"}],\"state\":{\"pauseExecution\":false,\"autoPauseOnError\":true,\"version\":2,\"metadata\":{\"name\":\"Memory History\",\"description\":\"Keeps the history messages in memory (this is intended for dev purposes only)\"},\"pages\":{\"main\":{\"code\":\"/**\\n * Name: Memory History\\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\\n */\\n\\nconst sessions = {};\\n\\nconst getWidgetInputs = () => [\\n  { name: 'read', type: DataType.JsonObj },\\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\\n];\\n\\nconst getWidgetOutputs = () => [\\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\\n];\\n\\nconst onParentEvent = async ({ targetPort, event }) => {\\n  const inputData = event.data.value;\\n\\n  if (targetPort.name === 'read') {\\n    const sessionId = inputData.sessionId;\\n\\n    if (sessionId === undefined || sessionId === null) {\\n      console.error(\\\"Error: 'read' event missing 'sessionId' property.\\\");\\n      return;\\n    }\\n\\n    if (!sessions[sessionId]) {\\n      sessions[sessionId] = { messages: [] };\\n    }\\n\\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\\n\\n  } else if (targetPort.name === 'update') {\\n    const sessionId = inputData.sessionId;\\n    const messagesToProcess = inputData.messages;\\n\\n    if (sessionId === undefined || sessionId === null) {\\n      console.error(\\\"Error: 'update' event missing 'sessionId' property.\\\");\\n      return;\\n    }\\n    if (messagesToProcess === undefined || messagesToProcess === null) {\\n      console.error(\\\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\\\");\\n      return;\\n    }\\n\\n    if (!sessions[sessionId]) {\\n      sessions[sessionId] = { messages: [] };\\n    }\\n\\n    if (Array.isArray(messagesToProcess)) {\\n      sessions[sessionId].messages.push(...messagesToProcess);\\n    } else {\\n      sessions[sessionId].messages.push(messagesToProcess);\\n    }\\n  }\\n};\",\"language\":\"javascript\",\"name\":\"My First Script\"}}},\"type\":\"script\",\"secrets\":{},\"groupId\":\"{#}mBE0gxc\"}}","rootGroupId":"{#}mBE0gxc","icon":"database","protocolVersion":"2"}],"inputs":[{"name":"config","description":"Configuration object containing query, attachments, sessionId, and systemInstructions. Can also be a string to be used as query or a boolean to trigger processing.","type":[5,4,1,6]},{"name":"abort","description":"Abort current query signal","type":6}],"outputs":[{"name":"tools","type":5},{"name":"history","type":5},{"name":"json","type":5},{"name":"text","type":1},{"name":"stream","type":1},{"name":"reasoning","description":"Reasoning output from models that support extended thinking","type":1},{"name":"images","description":"Generated images as ImageData array","type":3},{"name":"debug","description":"Includes debugging information for when things go wrong, including stopping reason","type":5}],"supportedPlatforms":["win-x86","win-x64","osx-x64","osx-arm64","linux-debian-arm64","linux-debian-x64","linux-rhel-arm64","linux-rhel-x64"],"author":"0f998d5a-a8ce-4bf8-9f84-fa8c481cb40b","defaultVariantInfo":{"title":"Agent","shortTitle":"Agent","description":"AI agent that processes queries with system instructions and attachments"},"variants":[{"id":"chatInterface","