01-1.1992 15.602-2.3984 9.6016-2.3984 19.199-6 28.801-8.3984 32.398-10.801 49.199-45.602 38.398-76.801-8.4023-33.602-43.199-51.602-75.602-40.805z\"/>\n <path d=\"m532.8 1046.4-24-3.6016c-33.602-7.1992-66 14.398-72 48-7.1992 33.602 14.398 66 48 72 9.6016 2.3984 20.398 3.6016 30 4.8008 2.3984 0 6 1.1992 9.6016 1.1992 30 0 56.398-21.602 60-52.801 4.7969-33.598-18.004-64.797-51.602-69.598z\"/>\n <path d=\"m321.6 955.2c-26.398-20.398-64.801-16.801-86.398 9.6016-20.398 26.398-16.801 64.801 9.6016 86.398 8.3984 6 15.602 12 24 18 10.801 7.1992 22.801 10.801 34.801 10.801 19.199 0 38.398-8.3984 50.398-26.398 19.199-27.602 13.199-66-14.398-85.199z\"/>\n <path d=\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1781146161,"internal":false}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"groupId":"{#}YCztCr0"},"{#}sqBON2U":{"id":"{#}sqBON2U","canvas":{"position":{"x":750,"y":571}},"children":[{"childId":"{#}PHHqwl7","sourcePort":"{#}sqBON2U_output_sessionHistoryOutput","targetPort":"{#}PHHqwl7_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}YCztCr0"},"{#}O9aIl9X":{"id":"{#}O9aIl9X","canvas":{"position":{"x":235,"y":178}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}YCztCr0"},"{#}4mr6Dnm":{"id":"{#}4mr6Dnm","canvas":{"position":{"x":1292,"y":1336}},"children":[{"childId":"{#}XdYUYIs","sourcePort":"{#}4mr6Dnm_output_out","targetPort":"{#}XdYUYIs_input_abort"}],"state":{},"type":"play","groupId":"{#}hW8JUW7"},"{#}ElGfBbJ":{"id":"{#}ElGfBbJ","canvas":{"position":{"x":1942,"y":895}},"children":[],"state":{"name":"Agent Outputs.validator_output","reactive":false,"lastConfiguration":{"controlType":"multilineText","controlSettings":{"value":"","placeholder":"Enter text..."},"group":"Agent Outputs","order":22}},"type":"globalVariable","groupId":"{#}hW8JUW7"},"{#}f0H3VRX":{"id":"{#}f0H3VRX","canvas":{"position":{"x":1932,"y":1018}},"children":[],"state":{"name":"agentReasoning.validator_reasoning","reactive":false,"lastConfiguration":{"controlType":"multilineText","controlSettings":{"value":"","placeholder":"Enter text..."},"group":"agentReasoning","order":23}},"type":"globalVariable","groupId":"{#}hW8JUW7"},"{#}vVUzFyK":{"id":"{#}vVUzFyK","canvas":{"position":{"x":1949,"y":1161}},"children":[],"state":{"name":"Agent Debug.validator_debug","reactive":false,"lastConfiguration":{"controlType":"anything","controlSettings":{"value":null},"group":"Agent Debug","order":26}},"type":"globalVariable","groupId":"{#}hW8JUW7"},"{#}4PbvMfY":{"id":"{#}4PbvMfY","canvas":{"position":{"x":1879,"y":956}},"children":[],"state":{},"type":"output","groupId":"{#}hW8JUW7"}},"category":"virtual","children":[],"inputPorts":[],"outputPorts":[],"na