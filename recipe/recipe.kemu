6 1.1992-808.8z\"/>\n <path d=\"m739.2 1028.4-22.801 7.1992c-32.398 8.3984-51.602 42-43.199 75.602 7.1992 27.602 32.398 45.602 58.801 45.602 4.8008 0 10.801-1.1992 15.602-2.3984 9.6016-2.3984 19.199-6 28.801-8.3984 32.398-10.801 49.199-45.602 38.398-76.801-8.4023-33.602-43.199-51.602-75.602-40.805z\"/>\n <path d=\"m532.8 1046.4-24-3.6016c-33.602-7.1992-66 14.398-72 48-7.1992 33.602 14.398 66 48 72 9.6016 2.3984 20.398 3.6016 30 4.8008 2.3984 0 6 1.1992 9.6016 1.1992 30 0 56.398-21.602 60-52.801 4.7969-33.598-18.004-64.797-51.602-69.598z\"/>\n <path d=\"m321.6 955.2c-26.398-20.398-64.801-16.801-86.398 9.6016-20.398 26.398-16.801 64.801 9.6016 86.398 8.3984 6 15.602 12 24 18 10.801 7.1992 22.801 10.801 34.801 10.801 19.199 0 38.398-8.3984 50.398-26.398 19.199-27.602 13.199-66-14.398-85.199z\"/>\n <path d=\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1781146161,"internal":false}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"groupId":"{#}htBxrfa"},"{#}6PDF7V3":{"id":"{#}6PDF7V3","canvas":{"position":{"x":750,"y":571}},"children":[{"childId":"{#}DmzwCma","sourcePort":"{#}6PDF7V3_output_sessionHistoryOutput","targetPort":"{#}DmzwCma_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}htBxrfa"},"{#}G9LfeNe":{"id":"{#}G9LfeNe","canvas":{"position":{"x":235,"y":178}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}htBxrfa"},"{#}RaT4EDT":{"id":"{#}RaT4EDT","canvas":{"position":{"x":1292,"y":1336}},"children":[{"childId":"{#}PRizcrd","sourcePort":"{#}RaT4EDT_output_out","targetPort":"{#}PRizcrd_input_abort"}],"state":{},"type":"play","groupId":"{#}G5PqWCD"},"{#}qgc5sVf":{"id":"{#}qgc5sVf","canvas":{"position":{"x":1942,"y":895}},"children":[],"state":{"name":"Agent Outputs.validator_output","reactive":false,"lastConfiguration":{"controlType":"multilineText","controlSettings":{"value":"","placeholder":"Enter text..."},"group":"Agent Outputs","order":22}},"type":"globalVariable","groupId":"{#}G5PqWCD"},"{#}sR2hWJq":{"id":"{#}sR2hWJq","canvas":{"position":{"x":1932,"y":1018}},"children":[],"state":{"name":"agentReasoning.validator_reasoning","reactive":false,"lastConfiguration":{"controlType":"multilineText","controlSettings":{"value":"","placeholder":"Enter text..."},"group":"agentReasoning","order":23}},"type":"globalVariable","groupId":"{#}G5PqWCD"},"{#}7R3zNbv":{"id":"{#}7R3zNbv","canvas":{"position":{"x":1949,"y":1161}},"children":[],"state":{"name":"Agent Debug.validator_debug","reactive":false,"lastConfiguration":{"controlType":"anything","controlSettings":{"value":null},"group":"Agent Debug","order":26}},"type":"globalVariable","groupId":"{#}G5PqWCD"},"{#}YwczVri":{"id":"{#}YwczVri","canvas":{"position":{"x":1879,"y":956}},"children":[],"state":{},"type":"output","groupId":"{#}G5PqWCD"},"{#}hW8JUW7":{"id":"{#}hW8JUW7","canvas":{"position":{"x":-5523,"y":-6544}},"children":[{"childId":"{#}XdYUYIs","sourcePort":"{#}hW8JUW7_innerOutput_inner-input-config-NPd1HB","targetPort":"{#}XdYUYIs_input_config"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":832,"y":951}}],"outputs":[],"name":"Tone Validator","type":"custom","color":"#68bb6c","icon":"check-circle","canvasPosition":{"x":1141.6322035663293,"y":456.8123200226313},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":1},"type":"widgetGroup","disabled":false},"{#}28iOhlQ":{"id":"{#}28iOhlQ","canvas":{"position":{"x":-5385,"y":-6523}},"children":[{"childId":"{#}hW8JUW7","sourcePort":"{#}28iOhlQ_output_output","targetPort":"{#}hW8JUW7_input_outer-input-config-NPd1HB"}],"state":{"inputName":"tone_validator_input"},"type":"input"},"{#}XdYUYIs":{"id":"{#}XdYUYIs","canvas":{"position":{"x":1445,"y":830}},"children":[{"childId":"{#}0Eacqhc","sourcePort":"{#}XdYUYIs_output_tools","targetPort":"{#}0Eacqhc_input_outer-input-input1"},{"childId":"{#}YCztCr0","sourcePort":"{#}XdYUYIs_output_history","targetPort":"{#}YCztCr0_input_outer-input-input1"},{"childId":"{#}f0H3VRX","sourcePort":"{#}XdYUYIs_output_reasoning","targetPort":"{#}f0H3VRX_input_setValue"},{"childId":"{#}vVUzFyK","sourcePort":"{#}XdYUYIs_output_debug","targetPort":"{#}vVUzFyK_input_setValue"},{"childId":"{#}ElGfBbJ","sourcePort":"{#}XdYUYIs_output_text","targetPort":"{#}ElGfBbJ_input_setValue"},{"childId":"{#}4PbvMfY","sourcePort":"{#}XdYUYIs_output_text","targetPort":"{#}4PbvMfY_input_event"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"selectedModel":{"id":"anthropic/claude-sonnet-4.6","slug":"anthropic/claude-4.6-sonnet-20260217","name":"Anthropic: Claude Sonnet 4.6","description":"Sonnet 4.6 is Anthropic's most capable Sonnet-class model yet, with frontier performance across coding, agents, and professional work. It excels at iterative development, complex codebase navigation, end-to-end project management with...","inputModalities":["text","image","file"],"outputModalities":["text"],"supportsTools":true,"supportsReasoning":true,"promptPrice":0.000003,"completionPrice":0.000015,"maxTokens":128000,"contextLength":1000000,"provider":"anthropic"},"systemInstructions":"# Tone Validator — Instructions v1.0\n\n**Version:** 1.0\n**Last Updated:** 2026-06-04\n**Type:** Single-role validator — server-orchestrated, fires via `_runValidator()` in `dispatch.js`\n**Pipeline Position:** Middleman between **Tone Analyst → Style Negotiator**. Verifies `style_findings.json`\nagainst the source BEFORE the Style Negotiator builds its correction interview on top of it.\n**Trigger:** Server fires `tone_validator_input` immediately after the Tone Analyst returns (parallel with the analyst path)\n**Model:** Claude Sonnet 4.6\n**Input:** `agent` — always `\"tone_analyst\"` (server constant)\n**Tools:** `ReadFile`, `WriteFile`\n\n> The Tone Analyst's read of the candidate's voice **heavily drives** the Style Negotiator's interview. This\n> validator sits between them: it confirms what TA captured is actually grounded in the source, blocks\n> fabrications, and forwards anything **unsubstantiated** to the Style Negotiator via `findings_for_sn` so the\n> interview isn't built on an over-reach.\n\n## Scope boundary — vs the Integrity Checker\nThis validator checks **style/voice-capture fidelity, pre-SN**: is the seniority / register / voice inference\nsupported by the source the candidate actually wrote? The **Integrity Checker** (assembly phase 8) checks\n**final-CV factual claims, post-assembly**. Different stage, different target — do not duplicate IC's job here.\n\n---\n\n## Verdict Scale\n\n| Verdict | Meaning |\n|---------|---------|\n| **APPROVE** | `style_findings.json` is fully grounded — proceed |\n| **FLAG** | Non-blocking concerns — recorded in `findings_for_sn` for the Style Negotiator; TA output still proceeds |\n| **REJECT** | A blocking fabrication — server clears `style_findings.json` and re-runs the Tone Analyst once |\n\n**Blocking (→ REJECT):** a quoted string that is NOT verbatim in the source, or an invalid `register` value.\nEverything else is a **non-blocking note** (→ `findings_for_sn`, verdict FLAG). Seniority/voice judgments are\n**never** blocking — the Style Negotiator and user confirm them; we only surface the doubt.\n\n---\n\n## Execution Protocol\n\n**Step 1 — Read source + output. Build the combined source text once.**\n```javascript\nconst output  = JSON.parse(ReadFile(\"style_findings.json\"))\nconst cvRaw   = ReadFile(\"cv_raw.txt\") || ''\nlet coverLetter = ''\ntry { coverLetter = ReadFile(\"cover_letter_sample.txt\") || '' } catch {}\nconst source  = cvRaw + '\\n' + coverLetter   // proofs may legitimately come from either document\n\nconst issues = []            // blocking + warning — drives the verdict\nconst findings_for_sn = []   // curated, SN-facing: unsubstantiated capture the interview must not assume\n\nconst inSource = (q) => typeof q === 'string' && q.trim().length > 0 && source.includes(q.trim())\n```\n\n**Step 2 — Verbatim verification (BLOCKING).** Every quoted string TA emitted must exist verbatim in the source.\n```javascript\n// flagged_issues[].original\n;(output.flagged_issues || []).forEach((iss, i) => {\n  const quoted = iss.original || iss.example || iss.quoted_text\n  if (quoted && quoted.trim() && !inSource(quoted)) {\n    issues.push({ field: `flagged_issues[${i}].original`, problem: `Quoted text \"${String(quoted).slice(0,60)}...\" not found verbatim in source`, severity: \"blocking\" })\n  }\n})\n\n// style_patterns proofs + signature phrases + examples\nconst sp = output.style_patterns || {}\nconst proofChecks = [\n  ['style_patterns.ownership_framing.proof',  sp.ownership_framing?.proof],\n  ['style_patterns.content_focus.proof',      sp.content_focus?.proof],\n  ['style_patterns.persuasion_strategy.proof', sp.persuasion_strategy?.proof],\n]\nproofChecks.forEach(([field, val]) => {\n  if (val && val.trim() && !inSource(val)) {\n    issues.push({ field, problem: `Proof \"${String(val).slice(0,60)}...\" not found verbatim in source`, severity: \"blocking\" })\n  }\n})\n;(sp.signature_phrases?.phrases || []).forEach((p, i) => {\n  if (p && p.trim() && !inSource(p)) {\n    issues.push({ field: `style_patterns.signature_phrases.phrases[${i}]`, problem: `Signature phrase \"${String(p).slice(0,60)}...\" not in source — would seed the CV from invented voice`, severity: \"blocking\" })\n  }\n})\n;(sp.examples || []).forEach((ex, i) => {\n  if (ex && ex.trim() && !inSource(ex)) {\n    issues.push({ field: `style_patterns.examples[${i}]`, problem: `Example \"${String(ex).slice(0,60)}...\" not found verbatim in source`, severity: \"blocking\" })\n  }\n})\n```\n\n**Step 3 — Register enum (BLOCKING).** Downstream (SN, CoverLetter Writer) enforce this exact set.\n```javascript\nconst VALID_REGISTERS = ['peer-collegial', 'confident-professional', 'direct-practical']\nif (output.register && !VALID_REGISTERS.includes(output.register)) {\n  issues.push({ field: 'register', problem: `\"${output.register}\" is not a valid register — must be one of: ${VALID_REGISTERS.join(', ')}`, severity: \"blocking\" })\n}\n```\n\n**Step 4 — Seniority support (NON-BLOCKING note for SN).**\n`seniority` is an OBJECT (v4.3 schema): `{ level, career_stage, relevant_years_experience, years_experience, evidence }`.\nValidate `level` against `relevant_years_experience` — NOT total `years_experience`. The whole point of v4.3 is that\na recent grad with years of unrelated casual work is **Junior**; comparing against total years would false-flag them.\n```javascript\nconst sen = output.seniority || {}\nconst level = String(sen.level || '').toLowerCase()\nconst stage = String(sen.career_stage || '').toLowerCase()\nconst ry    = typeof sen.relevant_years_experience === 'number' ? sen.relevant_years_experience : null\nconst evidence = sen.evidence || ''\n\n// recent-graduate is legitimately Junior regardless of relevant years — never flag that case\nconst isRecentGrad = stage === 'recent-graduate'\nif (!isRecentGrad && ry != null) {\n  // expected band from relevant years: <3 early-career/Junior, 3–8 established/Mid, 8–15 senior, 15+ senior-leader\n  const overReach = (/(senior|lead|principal)/.test(level) && ry < 8) ||\n                    (/senior-leader|principal/.test(level) && ry < 15)\n  const underCall = (/junior|entry/.test(level) && ry >= 8)\n  if ((overReach || underCall) && evidence.trim().length < 20) {\n    findings_for_sn.push({\n      axis: 'seniority',\n      claim: `level \"${sen.level}\" with ${ry} relevant year(s)`,\n      why_unsubstantiated: `Level not clearly supported by relevant years and 'evidence' does not explain the divergence — confirm with the user before anchoring tone/assertiveness to this level.`\n    })\n  }\n}\n```\n\n**Step 5 — Voice/quantification coherence (NON-BLOCKING note for SN).**\n```javascript\nconst qlevel = String(sp.quantification_level || '').toLowerCase()\nconst vdesc  = String(sp.voice_descriptor || '').toLowerCase()\nconst weak   = (sp.writing_weaknesses || []).join(' ').toLowerCase()\nif (qlevel === 'strong' && /(no metrics|no quantification|lacks? numbers|unquantified)/.test(vdesc + ' ' + weak)) {\n  findings_for_sn.push({ axis: 'quantification_level', claim: `quantification_level \"strong\"`, why_unsubstantiated: `Contradicts the voice_descriptor / writing_weaknesses, which report missing metrics.` })\n}\n// em-dash claim without an example\nif (typeof sp.sentence_structure === 'string' && sp.sentence_structure.toLowerCase().includes('em dash')) {\n  const hasEmDash = (output.flagged_issues || []).some(i => (i.category||'').toLowerCase().includes('em') || (i.original||'').includes('—'))\n  if (!hasEmDash) findings_for_sn.push({ axis: 'sentence_structure', claim: 'claims em-dash usage', why_unsubstantiated: 'No em-dash example in flagged_issues.' })\n}\n```\n\n**Step 6 — Verdict + write.**\n```javascript\nconst blockingIssues = issues.filter(i => i.severity === \"blocking\")\nconst verdict = blockingIssues.length > 0          ? \"REJECT\"\n              : (issues.length || findings_for_sn.length) ? \"FLAG\"\n              : \"APPROVE\"\n\nWriteFile(\"tone_validator_verdict.json\", JSON.stringify({\n  verdict, agent: \"tone_analyst\", issues, findings_for_sn,\n  summary: `${blockingIssues.length} blocking, ${issues.length - blockingIssues.length} warning, ${findings_for_sn.length} note(s) for SN.`\n}, null, 2))\n\n// REJECT only — clear style_findings.json so the Tone Analyst's re-run rewrites it cleanly.\n// (No failed file: TA re-analyses from scratch, it does not read prior issues.)\nif (verdict === \"REJECT\") WriteFile(\"style_findings.json\", \"{}\")\n```\n\n**Output a single word — the verdict — and stop:**\n```\nAPPROVE\n```\n(or `FLAG`, or `REJECT`)\n\nDo NOT call ChangeAgent/SwitchAgent. Do NOT output any user-facing text — the Tone Analyst is silent by design.\nThe server reads `tone_validator_verdict.json`; the Style Negotiator reads `findings_for_sn` from it.\n\n---\n\n## Gotchas\n\n1. **`seniority` is an object** — read `seniority.level` / `seniority.relevant_years_experience`. The old monolith\n   read it as a string and summed a non-existent `work_history[].duration_years` — that check was inert. Do not repeat it.\n2. **Compare against RELEVANT years, not total** — else every recent graduate with casual history false-flags.\n3. **Seniority/voice are advisory, never blocking** — only fabricated quotes and an invalid register block.\n4. **Proofs may come from the cover letter** — check against the combined `cv_raw.txt` + `cover_letter_sample.txt`.\n5. **Bare filenames; no routing tools** — output the verdict word and stop.\n","query":"","jsonResponse":false,"jsonFormat":"","jsonSchemaMode":"typescript","fileParser":"native","imageAspectRatio":"1:1","maxIterations":10,"reasoningEffort":"low","allowFallbacks":true,"temperature":1},"service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801c14.762-6.3594 14.762-27.238 0-33.719zm-210.84-6.9609c-3 6.7188-9.6016 10.801-16.559 10.801-2.3984 0-4.8008-0.48047-7.1992-1.4414-64.078-28.078-114.72-78.719-142.68-142.8-4.0781-9.1211 0.12109-19.801 9.2383-23.762 9.1211-3.9609 19.68 0.23828 23.762 9.3594 24.238 55.68 68.398 99.84 124.08 124.2 9.1211 3.9609 13.32 14.52 9.3594 23.641z\"/>\n <path d=\"m1113.1 322.08-109.56-47.762c-26.52-11.641-47.641-32.762-59.281-59.281l-47.762-109.56c-3.7188-8.5195-15.84-8.5195-19.559 0l-47.762 109.56c-11.641 26.52-32.762 47.641-59.281 59.281l-109.68 47.879c-8.5195 3.7188-8.5195 15.719-0.12109 19.441l111.72 49.32c26.398 11.762 47.52 33 58.922 59.52l46.32 107.64c3.6016 8.5195 15.719 8.5195 19.441 0l47.762-109.44c11.641-26.52 32.762-47.641 59.281-59.281l109.56-47.762c8.5195-3.7188 8.5195-15.84 0-19.559zm-149.28 15.84c-3.4805 5.6406-9.3594 8.6406-15.48 8.6406-3.1211 0-6.3594-0.83984-9.2383-2.5195-24.84-15.121-45.359-34.922-61.199-59.16-5.3984-8.3984-3-19.441 5.2812-24.961 8.2812-5.3984 19.441-3.1211 24.84 5.2812 12.961 19.68 29.641 35.762 49.68 48 8.5195 5.1602 11.281 16.199 6.1211 24.719z\"/>\n</svg>\n","color":"#42a5f5","mdHelp":"/docs/help/service.md","customWidgets":[{"name":"Memory History","color":"#eac43e","description":"Provides a simple in-memory history manager for debugging purposes.","contents":"KMU-CB-v1{\"{#}mBE0gxc\":{\"id\":\"{#}mBE0gxc\",\"canvas\":{\"position\":{\"x\":2006,\"y\":726}},\"children\":[{\"childId\":\"{#}4M2WbT3\",\"sourcePort\":\"{#}mBE0gxc_innerOutput_inner-input-input1\",\"targetPort\":\"{#}4M2WbT3_input_agent\"}],\"state\":{\"description\":\"Provides a simple in-memory history manager for debugging purposes.\",\"inputs\":[{\"index\":0,\"label\":\"agent\",\"name\":\"input1\",\"type\":[5],\"position\":{\"x\":519,\"y\":291}}],\"outputs\":[],\"name\":\"Memory History\",\"type\":\"custom\",\"color\":\"#eac43e\",\"icon\":\"database\",\"canvasPosition\":{\"x\":0,\"y\":0},\"markdownHelp\":\"\",\"settings\":[],\"protocolVersion\":\"2\"},\"type\":\"widgetGroup\"},\"{#}4M2WbT3\":{\"id\":\"{#}4M2WbT3\",\"canvas\":{\"position\":{\"x\":659,\"y\":341}},\"children\":[{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_getHistory\",\"targetPort\":\"{#}jCnteeA_input_read\"},{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_updateHistory\",\"targetPort\":\"{#}jCnteeA_input_update\"}],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{\"includeAttachments\":false,\"timeout\":60},\"variantId\":\"history\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=\\\"M12 12c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\\\" fill=\\\"white\\\"/>\\n  <rect x=\\\"10\\\" y=\\\"19\\\" width=\\\"4\\\" height=\\\"3\\\" rx=\\\"1\\\" fill=\\\"currentColor\\\"/>\\n</svg>\",\"color\":\"#42a5f5\",\"inputs\":[{\"name\":\"query\",\"description\":\"Query string for the agent\",\"type\":1},{\"name\":\"attachments\",\"description\":\"Attachments for the agent (String, BinaryFile, ImageData, or Array of these types)\",\"type\":[1,12,7,3]},{\"name\":\"clear\",\"description\":\"Clear input signal\",\"type\":6},{\"name\":\"abort\",\"description\":\"Abort current query signal\",\"type\":6},{\"name\":\"send\",\"description\":\"Send input signal\",\"type\":6}],\"outputs\":[{\"name\":\"tools\",\"type\":5},{\"name\":\"history\",\"type\":5},{\"name\":\"json\",\"type\":5},{\"name\":\"text\",\"type\":1},{\"name\":\"stream\",\"type\":1},{\"name\":\"images\",\"description\":\"Generated images as ImageData array\",\"type\":3}],\"supportedPlatforms\":[\"win-x86\",\"win-x64\",\"osx-x64\",\"osx-arm64\",\"linux-debian-arm64\",\"linux-debian-x64\",\"linux-rhel-arm64\",\"linux-rhel-x64\"],\"author\":\"db618814-4e68-40aa-8158-64a595fea23b\",\"defaultVariantInfo\":{\"title\":\"Agent\",\"shortTitle\":\"Agent\",\"description\":\"AI agent that processes queries with system instructions and attachments\"},\"variants\":[{\"id\":\"tool\",\"name\":\"Tool\",\"description\":\"Define tools with arguments and results for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Tool icon - wrench/settings -->\\n  <path d=\\\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Tool input data\",\"type\":5}],\"outputs\":[{\"name\":\"arguments\",\"description\":\"Tool arguments\",\"type\":5}],\"color\":\"#42a5f5\"},{\"id\":\"submit\",\"name\":\"Submit\",\"description\":\"Submit data without any processing\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Submit icon - send/arrow -->\\n  <path d=\\\"M2.01 21L23 12 2.01 3 2 10l15 2-15 2z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Data to submit\",\"type\":6}],\"color\":\"#68bb6c\"},{\"id\":\"history\",\"name\":\"History\",\"description\":\"Manage conversation history and session storage for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 16 16\\\">\\n  <path\\n    d=\\\"M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M8 3.5a.5.5 0 0 1 .5.5v4l2.5 1.5a.5.5 0 0 1-.5.866L7.5 8.866A.5.5 0 0 1 7.5 8V4a.5.5 0 0 1 .5-.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M2.5 8a5.5 5.5 0 0 1 5.5-5.5V1A7 7 0 0 0 1 8h1.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n</svg>\\n\",\"inputs\":[{\"name\":\"agent\",\"description\":\"Connect to the agent\",\"type\":5}],\"outputs\":[{\"name\":\"getHistory\",\"description\":\"Invoked when the agent needs to retrieve the conversation history\",\"type\":5},{\"name\":\"updateHistory\",\"description\":\"Invoked when the agent needs to update the conversation history\",\"type\":5}],\"color\":\"#9c27b0\"}],\"internal\":false,\"devMode\":true,\"sessionId\":1760512532}},\"type\":\"hubService\",\"groupId\":\"{#}mBE0gxc\"},\"{#}a5vxU9Y\":{\"id\":\"{#}a5vxU9Y\",\"canvas\":{\"position\":{\"x\":1235,\"y\":488}},\"children\":[],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{},\"variantId\":\"submit\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=\\\"M12 12c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\\\" fill=\\\"white\\\"/>\\n  <rect x=\\\"10\\\" y=\\\"19\\\" width=\\\"4\\\" height=\\\"3\\\" rx=\\\"1\\\" fill=\\\"currentColor\\\"/>\\n</svg>\",\"color\":\"#42a5f5\",\"inputs\":[{\"name\":\"query\",\"description\":\"Query string for the agent\",\"type\":1},{\"name\":\"attachments\",\"description\":\"Attachments for the agent (String, BinaryFile, ImageData, or Array of these types)\",\"type\":[1,12,7,3]},{\"name\":\"clear\",\"description\":\"Clear input signal\",\"type\":6},{\"name\":\"abort\",\"description\":\"Abort current query signal\",\"type\":6},{\"name\":\"send\",\"description\":\"Send input signal\",\"type\":6}],\"outputs\":[{\"name\":\"tools\",\"type\":5},{\"name\":\"history\",\"type\":5},{\"name\":\"json\",\"type\":5},{\"name\":\"text\",\"type\":1},{\"name\":\"stream\",\"type\":1},{\"name\":\"images\",\"description\":\"Generated images as ImageData array\",\"type\":3}],\"supportedPlatforms\":[\"win-x86\",\"win-x64\",\"osx-x64\",\"osx-arm64\",\"linux-debian-arm64\",\"linux-debian-x64\",\"linux-rhel-arm64\",\"linux-rhel-x64\"],\"author\":\"db618814-4e68-40aa-8158-64a595fea23b\",\"defaultVariantInfo\":{\"title\":\"Agent\",\"shortTitle\":\"Agent\",\"description\":\"AI agent that processes queries with system instructions and attachments\"},\"variants\":[{\"id\":\"tool\",\"name\":\"Tool\",\"description\":\"Define tools with arguments and results for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Tool icon - wrench/settings -->\\n  <path d=\\\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Tool input data\",\"type\":5}],\"outputs\":[{\"name\":\"arguments\",\"description\":\"Tool arguments\",\"type\":5}],\"color\":\"#42a5f5\"},{\"id\":\"submit\",\"name\":\"Submit\",\"description\":\"Submit data without any processing\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Submit icon - send/arrow -->\\n  <path d=\\\"M2.01 21L23 12 2.01 3 2 10l15 2-15 2z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Data to submit\",\"type\":6}],\"color\":\"#68bb6c\"},{\"id\":\"history\",\"name\":\"History\",\"description\":\"Manage conversation history and session storage for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 16 16\\\">\\n  <path\\n    d=\\\"M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M8 3.5a.5.5 0 0 1 .5.5v4l2.5 1.5a.5.5 0 0 1-.5.866L7.5 8.866A.5.5 0 0 1 7.5 8V4a.5.5 0 0 1 .5-.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M2.5 8a5.5 5.5 0 0 1 5.5-5.5V1A7 7 0 0 0 1 8h1.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n</svg>\\n\",\"inputs\":[{\"name\":\"agent\",\"description\":\"Connect to the agent\",\"type\":5}],\"outputs\":[{\"name\":\"getHistory\",\"description\":\"Invoked when the agent needs to retrieve the conversation history\",\"type\":5},{\"name\":\"updateHistory\",\"description\":\"Invoked when the agent needs to update the conversation history\",\"type\":5}],\"color\":\"#9c27b0\"}],\"internal\":false,\"devMode\":true,\"sessionId\":1760512532}},\"type\":\"hubService\",\"secrets\":{\"OPENROUTER_API_KEY\":{\"name\":\"OPENROUTER_API_KEY\",\"hubServiceName\":\"kemu.io.ai-agent\"}},\"groupId\":\"{#}mBE0gxc\"},\"{#}jCnteeA\":{\"id\":\"{#}jCnteeA\",\"canvas\":{\"position\":{\"x\":948,\"y\":397}},\"children\":[{\"childId\":\"{#}a5vxU9Y\",\"sourcePort\":\"{#}jCnteeA_output_sessionHistoryOutput\",\"targetPort\":\"{#}a5vxU9Y_input_input\"}],\"state\":{\"pauseExecution\":false,\"autoPauseOnError\":true,\"version\":2,\"metadata\":{\"name\":\"Memory History\",\"description\":\"Keeps the history messages in memory (this is intended for dev purposes only)\"},\"pages\":{\"main\":{\"code\":\"/**\\n * Name: Memory History\\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\\n */\\n\\nconst sessions = {};\\n\\nconst getWidgetInputs = () => [\\n  { name: 'read', type: DataType.JsonObj },\\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\\n];\\n\\nconst getWidgetOutputs = () => [\\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\\n];\\n\\nconst onParentEvent = async ({ targetPort, event }) => {\\n  const inputData = event.data.value;\\n\\n  if (targetPort.name === 'read') {\\n    const sessionId = inputData.sessionId;\\n\\n    if (sessionId === undefined || sessionId === null) {\\n      console.error(\\\"Error: 'read' event missing 'sessionId' property.\\\");\\n      return;\\n    }\\n\\n    if (!sessions[sessionId]) {\\n      sessions[sessionId] = { messages: [] };\\n    }\\n\\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\\n\\n  } else if (targetPort.name === 'update') {\\n    const sessionId = inputData.sessionId;\\n    const messagesToProcess = inputData.messages;\\n\\n    if (sessionId === undefined || sessionId === null) {\\n      console.error(\\\"Error: 'update' event missing 'sessionId' property.\\\");\\n      return;\\n    }\\n    if (messagesToProcess === undefined || messagesToProcess === null) {\\n      console.error(\\\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\\\");\\n      return;\\n    }\\n\\n    if (!sessions[sessionId]) {\\n      sessions[sessionId] = { messages: [] };\\n    }\\n\\n    if (Array.isArray(messagesToProcess)) {\\n      sessions[sessionId].messages.push(...messagesToProcess);\\n    } else {\\n      sessions[sessionId].messages.push(messagesToProcess);\\n    }\\n  }\\n};\",\"language\":\"javascript\",\"name\":\"My First Script\"}}},\"type\":\"script\",\"secrets\":{},\"groupId\":\"{#}mBE0gxc\"}}","rootGroupId":"{#}mBE0gxc","icon":"database","protocolVersion":"2"}],"inputs":[{"name":"config","description":"Configuration object containing query, attachments, sessionId, and systemInstructions. Can also be a string to be used as query or a boolean to trigger processing.","type":[5,4,1,6]},{"name":"abort","description":"Abort current query signal","type":6}],"outputs":[{"name":"tools","type":5},{"name":"history","type":5},{"name":"json","type":5},{"name":"text","type":1},{"name":"stream","type":1},{"name":"reasoning","description":"Reasoning output from models that support extended thinking","type":1},{"name":"images","description":"Generated images as ImageData array","type":3},{"name":"debug","description":"Includes debugging information for when things go wrong, including stopping reason","type":5}],"supportedPlatforms":["win-x86","win-x64","osx-x64","osx-arm64","linux-debian-arm64","linux-debian-x64","linux-rhel-arm64","linux-rhel-x64"],"author":"0f998d5a-a8ce-4bf