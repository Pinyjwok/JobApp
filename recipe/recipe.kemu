_input_outer-input-config-NPd1HB"}],"state":{"inputName":"integrity_checker_input"},"type":"input"},"{#}JfFu44W":{"id":"{#}JfFu44W","canvas":{"position":{"x":-5806,"y":-6215}},"children":[{"childId":"{#}QzzS04E","sourcePort":"{#}JfFu44W_output_output","targetPort":"{#}QzzS04E_input_outer-input-config-NPd1HB"}],"state":{"inputName":"reviewer_input"},"type":"input"},"{#}fRiY60j":{"id":"{#}fRiY60j","canvas":{"position":{"x":-5839,"y":-6859}},"children":[{"childId":"{#}Cs7chRY","sourcePort":"{#}fRiY60j_output_output","targetPort":"{#}Cs7chRY_input_outer-input-config-NPd1HB"}],"state":{"inputName":"main_orchestrator_input"},"type":"input"},"{#}mYAkn6k":{"id":"{#}mYAkn6k","canvas":{"position":{"x":1835,"y":947}},"children":[],"state":{},"type":"output","groupId":"{#}Cs7chRY"},"{#}5G0KDJ9":{"id":"{#}5G0KDJ9","canvas":{"position":{"x":2086,"y":1028}},"children":[],"state":{},"type":"output","groupId":"{#}jOGqICT"},"{#}fLVW51a":{"id":"{#}fLVW51a","canvas":{"position":{"x":2020.87890625,"y":1101.062744140625}},"children":[],"state":{},"type":"output","groupId":"{#}bl6upy9"},"{#}BFDqmx7":{"id":"{#}BFDqmx7","canvas":{"position":{"x":1998.820871715434,"y":765.5698979314584}},"children":[],"state":{},"type":"output","groupId":"{#}MX8BEBv"},"{#}j3wZ4pQ":{"id":"{#}j3wZ4pQ","canvas":{"position":{"x":1831,"y":864}},"children":[],"state":{},"type":"output","groupId":"{#}0Zjw9qA"},"{#}KmtKXZt":{"id":"{#}KmtKXZt","canvas":{"position":{"x":2380,"y":859}},"children":[],"state":{},"type":"output","groupId":"{#}QzzS04E"},"{#}puSLZ0G":{"id":"{#}puSLZ0G","canvas":{"position":{"x":2008,"y":902}},"children":[],"state":{},"type":"output","groupId":"{#}9W1zM85"},"{#}jrtVqWU":{"id":"{#}jrtVqWU","canvas":{"position":{"x":2122,"y":1030}},"children":[],"state":{},"type":"output","groupId":"{#}kciARP3"},"{#}SoIb0bG":{"id":"{#}SoIb0bG","canvas":{"position":{"x":2064,"y":1080}},"children":[],"state":{},"type":"output","groupId":"{#}ApyV8Tp"},"{#}TkfYkq0":{"id":"{#}TkfYkq0","canvas":{"position":{"x":2290.876953125,"y":1212.4613037109375}},"children":[],"state":{},"type":"output","groupId":"{#}lY8TYsL"},"{#}i4dxGUF":{"id":"{#}i4dxGUF","canvas":{"position":{"x":2289.876953125,"y":1129.4613037109375}},"children":[],"state":{},"type":"output","groupId":"{#}CXahwdw"},"{#}P2ZTktX":{"id":"{#}P2ZTktX","canvas":{"position":{"x":2082,"y":1093}},"children":[],"state":{},"type":"output","groupId":"{#}cd0HlNC"},"{#}jyzDpmE":{"id":"{#}jyzDpmE","canvas":{"position":{"x":2187.1788330078125,"y":1137.5985107421875}},"children":[],"state":{},"type":"output","groupId":"{#}VM6YrUA"},"{#}Xzqh1p6":{"id":"{#}Xzqh1p6","canvas":{"position":{"x":2120,"y":1143}},"children":[],"state":{},"type":"output","groupId":"{#}nCbP7zI"},"{#}0K51WV5":{"id":"{#}0K51WV5","canvas":{"position":{"x":2156,"y":1096}},"children":[],"state":{},"type":"output","groupId":"{#}tcsR5vK"},"{#}oP4v7af":{"id":"{#}oP4v7af","canvas":{"position":{"x":-5133,"y":-7057}},"children":[],"state":{},"type":"output"},"{#}Z3B89fv":{"id":"{#}Z3B89fv","canvas":{"position":{"x":-5766,"y":-5587}},"children":[{"childId":"{#}zVPgmyz","targetPort":"{#}zVPgmyz_input_config","sourcePort":"{#}Z3B89fv_innerOutput_inner-input-config-NPd1HB"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":1179,"y":1044}}],"outputs":[],"name":"Document Formatter","type":"custom","color":"#ab47bd","icon":"robot","canvasPosition":{"x":947.1481235901074,"y":470.49614946628026},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":0.6921692024009419},"type":"widgetGroup"},"{#}zVPgmyz":{"id":"{#}zVPgmyz","canvas":{"position":{"x":1661,"y":1049}},"children":[{"childId":"{#}M8xhvWM","sourcePort":"{#}zVPgmyz_output_tools","targetPort":"{#}M8xhvWM_input_outer-input-input1"},{"childId":"{#}SNyQO7I","sourcePort":"{#}zVPgmyz_output_history","targetPort":"{#}SNyQO7I_input_outer-input-input1"},{"childId":"{#}eKZ0Z8b","sourcePort":"{#}zVPgmyz_output_reasoning","targetPort":"{#}eKZ0Z8b_input_setValue"},{"childId":"{#}JHo0oiQ","sourcePort":"{#}zVPgmyz_output_debug","targetPort":"{#}JHo0oiQ_input_setValue"},{"childId":"{#}Hz7Bdjq","sourcePort":"{#}zVPgmyz_output_text","targetPort":"{#}Hz7Bdjq_input_setValue"},{"childId":"{#}NYlcNhv","sourcePort":"{#}zVPgmyz_output_text","targetPort":"{#}NYlcNhv_input_event"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"selectedModel":{"id":"anthropic/claude-sonnet-4.6","slug":"anthropic/claude-4.6-sonnet-20260217","name":"Anthropic: Claude Sonnet 4.6","description":"Sonnet 4.6 is Anthropic's most capable Sonnet-class model yet, with frontier performance across coding, agents, and professional work. It excels at iterative development, complex codebase navigation, end-to-end project management with...","inputModalities":["text","image","file"],"outputModalities":["text"],"supportsTools":true,"supportsReasoning":true,"promptPrice":0.000003,"completionPrice":0.000015,"maxTokens":128000,"contextLength":1000000,"provider":"anthropic"},"systemInstructions":"# Document Formatter v1.1 — System Instructions\n\n**Version:** 1.1\n**Last Updated:** 2026-05-04\n**Role:** Final Document Formatter\n**Pipeline Position:** Assembly Phase 9\n**Trigger:** Dispatched sequentially by server after Integrity Checker passes\n**Output:** Writes `df_output.json` (server merges into phases[8], then shows Approve/Revise)\n\n---\n\n## Role\n\nYou are a **strict spatial typesetter**. Your only job is to copy finalized text from the assembled JSON phases and slot it verbatim into the exact Markdown templates provided below.\n\n**You do NOT write prose. You do NOT improve sentences. You do NOT summarize or paraphrase.** Every word was approved in phases 1–8. Treat yourself as a copy-paste machine with a precise spatial layout to fill.\n\n---\n\n## Authority\n\n### READ Access\n- `cv_assembly_state.json`\n- `candidate_profile.json`\n- `project_meta.json`\n\n### WRITE Access\n- `df_output.json` (phase output — server merges into cv_assembly_state.json)\n- `tailored_cv.json` (final submission copy)\n\n### NEVER Modify\n- Any other workspace file\n\n---\n\n## Tools\n\n| Tool | Usage |\n| --- | --- |\n| **ReadFile** | Load JSON files using bare filenames only |\n| **WriteFile** | Write JSON strings using bare filenames only |\n\n**⚠️ CRITICAL:**\n- WriteFile accepts STRINGS only: `JSON.stringify(data, null, 2)`\n- Use bare filenames: `\"df_output.json\"` not `\"/df_output.json\"`\n\n---\n\n## Execution Protocol\n\n### Phase 0: Revision Mode Check\n\n```javascript\nconst inputMessage = getInputText()\nif (inputMessage && inputMessage.startsWith('__revise__:')) {\n  const feedback = inputMessage.replace('__revise__:', '').trim()\n\n  // Re-read all phase data and rebuild — revision is cosmetic (spacing, ordering, layout)\n  // Do NOT alter content — if user wants content changes they must go back to the relevant phase\n  // Re-render both documents and re-write df_output.json and tailored_cv.json\n  // Display revised documents in full\n  END TURN\n}\n```\n\n---\n\n### Phase 1: Load Phase Data\n\n```javascript\nconst cvState = JSON.parse(ReadFile(\"cv_assembly_state.json\"))\nconst meta    = JSON.parse(ReadFile(\"project_meta.json\"))\n\nconst sn  = cvState.phases[0].data   // Style Negotiator — agreed_overrides\nconst pb  = cvState.phases[1].data   // Profile Builder  — contact_details{}, profile_paragraph{}\nconst sc  = cvState.phases[2].data   // Skills Curator   — technical_skills[], soft_skills[], certifications[]\nconst hf  = cvState.phases[3].data   // History Formatter — work_history[]\nconst cf  = cvState.phases[4].data   // Credentials Formatter — education[], certifications[]\nconst clw = cvState.phases[5].data   // CoverLetter Writer — cover_letter{}\n\nif (!pb || !sc || !hf || !cf || !clw) {\n  Display: \"Error: One or more phase outputs are missing. Cannot format documents.\"\n  END TURN\n}\n```\n\n**Field extraction — resolve nested objects before filling templates:**\n```javascript\n// Contact and profile are objects — extract .formatted_text\nconst contactLine    = pb.contact_details?.formatted_text ?? \"\"\nconst profileText    = pb.profile_paragraph?.formatted_text ?? \"\"\n\n// Skills are flat arrays\nconst techSkills     = sc.technical_skills ?? []\nconst softSkills     = sc.soft_skills ?? []\nconst scCerts        = sc.certifications ?? []\n\n// History entries\nconst workHistory    = hf.work_history ?? []\n\n// Education\nconst education      = cf.education ?? []\nconst cfCerts        = cf.certifications ?? []\n\n// Cover letter fields — all live under clw.cover_letter\nconst cl = clw.cover_letter ?? {}\n```\n\n---\n\n### Phase 2: Render CV\n\n**DIRECTIVE — you are a typesetter. Read each slot below. Find the exact string from the extracted data above. Copy it character-for-character into that slot. Do not rephrase, omit, or add words.**\n\nFill the following template exactly. Omit a section only if the underlying data array is empty.\n\n```\n{contactLine}\n\n## Profile\n\n{profileText}\n\n## Skills\n\n**Technical:** {techSkills joined with ' · '}\n**Core:** {softSkills joined with ' · '}\n**Certifications:** {scCerts joined with ' · '}\n\n## Career History\n\n{For each entry in workHistory — repeat this block:}\n**{entry.position}** — {entry.employer}\n*{entry.duration}*\n- {entry.bullets[0]}\n- {entry.bullets[1]}\n... (one `- ` line per bullet, verbatim)\n\n## Education & Credentials\n\n{For each item in education — repeat this line:}\n**{item.qualification}** — {item.institution} ({item.year})\n\n{If cfCerts is non-empty:}\n**Additional certifications:** {cfCerts joined with ', '}\n```\n\nStore the final rendered string as `cvMarkdown`.\n\n---\n\n### Phase 3: Render Cover Letter\n\n**DIRECTIVE — same rule applies. Each slot maps 1-to-1 to a field in `cl`. Copy verbatim. If a field is empty or absent, skip that line and its blank line.**\n\nFill the following template exactly:\n\n```\n{cl.header}\n\n{cl.date}\n\n{cl.re_line}\n\n{cl.salutation}\n\n{cl.opening_paragraph}\n\n{cl.connection_paragraph}\n\n{cl.offer_paragraph}\n\n{cl.research_paragraph}\n\n{cl.closing_paragraph}\n\n{cl.sign_off}\n```\n\nStore the final rendered string as `coverLetterText`.\n\n---\n\n### Phase 4: Write Output Files\n\n```javascript\nconst cvWordCount = cvMarkdown.split(/\\s+/).filter(Boolean).length\nconst clWordCount = coverLetterText.split(/\\s+/).filter(Boolean).length\n\nconst phaseOutput = {\n  phase_number: 9,\n  phase_name: \"Document Formatting\",\n  agent: \"Document Formatter\",\n  status: \"COMPLETE\",\n  completed_at: \"__DATE_TODAY__T00:00:00Z\",\n  data: {\n    cv_markdown: cvMarkdown,\n    cover_letter_text: coverLetterText,\n    word_count_cv: cvWordCount,\n    word_count_cl: clWordCount,\n    position_title: meta.position_title,\n    company_name: meta.company_name,\n  }\n}\n\nWriteFile(\"df_output.json\", JSON.stringify(phaseOutput, null, 2))\n\nconst verified = JSON.parse(ReadFile(\"df_output.json\"))\nif (verified.status !== \"COMPLETE\") {\n  Display: \"Error: Failed to write df_output.json.\"\n  END TURN\n}\n\n// Also write final submission copy\nconst tailoredCv = {\n  generated_at: \"__DATE_TODAY__T00:00:00Z\",\n  position_title: meta.position_title,\n  company_name: meta.company_name,\n  cv_markdown: cvMarkdown,\n  cover_letter_text: coverLetterText,\n}\nWriteFile(\"tailored_cv.json\", JSON.stringify(tailoredCv, null, 2))\n```\n\n---\n\n### Phase 5: Display Both Documents in Full\n\nDisplay the CV and cover letter in full so the user can read and approve before finalising.\n\n```markdown\n# ✓ Your Documents Are Ready\n\nTailored for **{meta.position_title}** at **{meta.company_name}**\nCV: {cvWordCount} words · Cover letter: {clWordCount} words\n\n---\n\n## Tailored CV\n\n{cvMarkdown}\n\n---\n\n## Cover Letter\n\n{coverLetterText}\n\n---\n\n*Approve to finalise, or request specific revisions above.*\n```\n\n**TURN ENDS.** Server reads `df_output.json`, merges into cv_assembly_state.json, and shows Approve/Revise buttons.\n\n---\n\n## Error Handling\n\n| Error | Action |\n| --- | --- |\n| Phase data missing (pb/sc/hf/cf/clw null) | Display error listing which phases are missing, END TURN |\n| cv_assembly_state.json missing | Display error, END TURN |\n| project_meta.json missing | Use empty strings for position/company, continue |\n| WriteFile fails | Retry once, then display error and END TURN |\n\n---\n\n## Critical Rules\n\n**`getCurrentISOTimestamp()` is retired — do NOT compute dates.** For any date/time field, write the literal token `__DATE_TODAY__T00:00:00Z` exactly as written. The server substitutes the real current date (Australia) before display. Never read the system-context date or hardcode a date string.\n\n\n1. **Content is frozen** — Do NOT rewrite, improve, or alter any bullet, skill, or paragraph. Every word was approved in phases 1–8. You are a typesetter, not an author.\n2. **Templates are spatial constraints** — The Markdown templates in Phase 2 and Phase 3 define exact visual structure. Fill slots verbatim. Never reorder sections.\n3. **Use bare filenames** — `\"df_output.json\"` not `\"/df_output.json\"`\n4. **Always stringify JSON** — `JSON.stringify(data, null, 2)` before WriteFile\n5. **Verify writes** — Read file back to confirm status = \"COMPLETE\"\n6. **Write to df_output.json only** — Server merges into cv_assembly_state.json; do NOT write cv_assembly_state.json directly\n7. **No SwitchAgent on completion** — server reads `df_output.json` and shows Approve/Revise buttons\n8. **Display both documents in full** — The user must be able to read the entire CV and cover letter before approving\n9. **Never compute dates** — write the literal token `__DATE_TODAY__T00:00:00Z`; the server substitutes\n10. **JSON string escaping** — Single quotes in JSON string values must NOT be escaped. Write `\"it's\"` not `\"it\\'s\"`\n","query":"","jsonResponse":false,"jsonFormat":"","jsonSchemaMode":"typescript","fileParser":"native","imageAspectRatio":"1:1","maxIterations":15,"reasoningEffort":"high","allowFallbacks":true,"temperature":0},"service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801c14.762-6.3594 14.762-27.238 0-33.719zm-210.84-6.9609c-3 6.7188-9.6016 10.801-16.559 10.801-2.3984 0-4.8008-0.48047-7.1992-1.4414-64.078-28.078-114.72-78.719-142.68-142.8-4.0781-9.1211 0.12109-19.801 9.2383-23.762 9.1211-3.9609 19.68 0.23828 23.762 9.3594 24.238 55.68 68.398 99.84 124.08 124.2 9.1211 3.9609 13.32 14.52 9.3594 23.641z\"/>\n <path d=\"m1113.1 322.08-109.56-47.762c-26.52-11.641-47.641-32.762-59.281-59.281l-47.762-109.56c-3.7188-8.5195-15.84-8.5195-19.559 0l-47.762 109.56c-11.641 26.52-32.762 47.641-59.281 59.281l-109.68 47.879c-8.5195 3.7188-8.5195 15.719-0.12109 19.441l111.72 49.32c26.398 11.762 47.52 33 58.922 59.52l46.32 107.64c3.6016 8.5195 15.719 8.5195 19.441 0l47.762-109.44c11.641-26.52 32.762-47.641 59.281-59.281l109.56-47.762c8.5195-3.7188 8.5195-15.84 0-19.559zm-149.28 15.84c-3.4805 5.6406-9.3594 8.6406-15.48 8.6406-3.1211 0-6.3594-0.83984-9.2383-2.5195-24.84-15.121-45.359-34.922-61.199-59.16-5.3984-8.3984-3-19.441 5.2812-24.961 8.2812-5.3984 19.441-3.1211 24.84 5.2812 12.961 19.68 29.641 35.762 49.68 48 8.5195 5.1602 11.281 16.199 6.1211 24.719z\"/>\n</svg>\n","color":"#42a5f5","mdHelp":"/docs/help/service.md","customWidgets":[{"name":"Memory History","color":"#eac43e","description":"Provides a simple in-memory history manager for debugging purposes.","contents":"KMU-CB-v1{\"{#}mBE0gxc\":{\"id\":\"{#}mBE0gxc\",\"canvas\":{\"position\":{\"x\":2006,\"y\":726}},\"children\":[{\"childId\":\"{#}4M2WbT3\",\"sourcePort\":\"{#}mBE0gxc_innerOutput_inner-input-input1\",\"targetPort\":\"{#}4M2WbT3_input_agent\"}],\"state\":{\"description\":\"Provides a simple in-memory history manager for debugging purposes.\",\"inputs\":[{\"index\":0,\"label\":\"agent\",\"name\":\"input1\",\"type\":[5],\"position\":{\"x\":519,\"y\":291}}],\"outputs\":[],\"name\":\"Memory History\",\"type\":\"custom\",\"color\":\"#eac43e\",\"icon\":\"database\",\"canvasPosition\":{\"x\":0,\"y\":0},\"markdownHelp\":\"\",\"settings\":[],\"protocolVersion\":\"2\"},\"type\":\"widgetGroup\"},\"{#}4M2WbT3\":{\"id\":\"{#}4M2WbT3\",\"canvas\":{\"position\":{\"x\":659,\"y\":341}},\"children\":[{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_getHistory\",\"targetPort\":\"{#}jCnteeA_input_read\"},{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_updateHistory\",\"targetPort\":\"{#}jCnteeA_input_update\"}],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{\"includeAttachments\":false,\"timeout\":60},\"variantId\":\"history\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=\\\"M12 12c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\\\" fill=\\\"white\\\"/>\\n  <rect x=\\\"10\\\" y=\\\"19\\\" width=\\\"4\\\" height=\\\"3\\\" rx=\\\"1\\\" fill=\\\"currentColor\\\"/>\\n</svg>\",\"color\":\"#42a5f5\",\"inputs\":[{\"name\":\"query\",\"description\":\"Query string for the agent\",\"type\":1},{\"name\":\"attachments\",\"description\":\"Attachments for the agent (String, BinaryFile, ImageData, or Array of these types)\",\"type\":[1,12,7,3]},{\"name\":\"clear\",\"description\":\"Clear input signal\",\"type\":6},{\"name\":\"abort\",\"description\":\"Abort current query signal\",\"type\":6},{\"name\":\"send\",\"description\":\"Send input signal\",\"type\":6}],\"outputs\":[{\"name\":\"tools\",\"type\":5},{\"name\":\"history\",\"type\":5},{\"name\":\"json\",\"type\":5},{\"name\":\"text\",\"type\":1},{\"name\":\"stream\",\"type\":1},{\"name\":\"images\",\"description\":\"Generated images as ImageData array\",\"type\":3}],\"supportedPlatforms\":[\"win-x86\",\"win-x64\",\"osx-x64\",\"osx-arm64\",\"linux-debian-arm64\",\"linux-debian-x64\",\"linux-rhel-arm64\",\"linux-rhel-x64\"],\"author\":\"db618814-4e68-40aa-8158-64a595fea23b\",\"defaultVariantInfo\":{\"title\":\"Agent\",\"shortTitle\":\"Agent\",\"description\":\"AI agent that processes queries with system instructions and attachments\"},\"variants\":[{\"id\":\"tool\",\"name\":\"Tool\",\"description\":\"Define tools with arguments and results for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Tool icon - wrench/settings -->\\n  <path d=\\\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Tool input data\",\"type\":5}],\"outputs\":[{\"name\":\"arguments\",\"description\":\"Tool arguments\",\"type\":5}],\"color\":\"#42a5f5\"},{\"id\":\"submit\",\"name\":\"Submit\",\"description\":\"Submit data without any processing\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Submit icon - send/arrow -->\\n  <path d=\\\"M2.01 21L23 12 2.01 3 2 10l15 2-15 2z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Data to submit\",\"type\":6}],\"color\":\"#68bb6c\"},{\"id\":\"history\",\"name\":\"History\",\"description\":\"Manage conversation history and session storage for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 16 16\\\">\\n  <path\\n    d=\\\"M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M8 3.5a.5.5 0 0 1 .5.5v4l2.5 1.5a.5.5 0 0 1-.5.866L7.5 8.866A.5.5 0 0 1 7.5 8V4a.5.5 0 0 1 .5-.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M2.5 8a5.5 5.5 0 0 1 5.5-5.5V1A7 7 0 0 0 1 8h1.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n</svg>\\n\",\"inputs\":[{\"name\":\"agent\",\"description\":\"Connect to the agent\",\"type\":5}],\"outputs\":[{\"name\":\"getHistory\",\"description\":\"Invoked when the agent needs to retrieve the conversation history\",\"type\":5},{\"name\":\"updateHistory\",\"description\":\"Invoked when the agent needs to update the conversation history\",\"type\":5}],\"color\":\"#9c27b0\"}],\"internal\":false,\"devMode\":true,\"sessionId\":1760512532}},\"type\":\"hubService\",\"groupId\":\"{#}mBE0gxc\"},\"{#}a5vxU9Y\":{\"id\":\"{#}a5vxU9Y\",\"canvas\":{\"position\":{\"x\":1235,\"y\":488}},\"children\":[],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{},\"variantId\":\"submit\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=\\\"M12 12c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\\\" fill=\\\"white\\\"/>\\n  <rect x=\\\"10\\\" y=\\\"19\\\" width=\\\"4\\\" height=\\\"3\\\" rx=\\\"1\\\" fill=\\\"currentColor\\\"/>\\n</svg>\",\"color\":\"#42a5f5\",\"inputs\":[{\"name\":\"query\",\"description\":\"Query string for the agent\",\"type\":1},{\"name\":\"attachments\",\"description\":\"Attachments for the agent (String, BinaryFile, ImageData, or Array of these types)\",\"type\":[1,12,7,3]},{\"name\":\"clear\",\"description\":\"Clear input signal\",\"type\":6},{\"name\":\"abort\",\"description\":\"Abort current query signal\",\"type\":6},{\"name\":\"send\",\"description\":\"Send input signal\",\"type\":6}],\"outputs\":[{\"name\":\"tools\",\"type\":5},{\"name\":\"history\",\"type\":5},{\"name\":\"json\",\"type\":5},{\"name\":\"text\",\"type\":1},{\"name\":\"stream\",\"type\":1},{\"name\":\"images\",\"description\":\"Generated images as ImageData array\",\"type\":3}],\"supportedPlatforms\":[\"win-x86\",\"win-x64\",\"osx-x64\",\"osx-arm64\",\"linux-debian-arm64\",\"linux-debian-x64\",\"linux-rhel-arm64\",\"linux-rhel-x64\"],\"author\":\"db618814-4e68-40aa-8158-64a595fea23b\",\"defaultVariantInfo\":{\"title\":\"Agent\",\"shortTitle\":\"Agent\",\"description\":\"AI agent that processes queries with system instructions and attachments\"},\"variants\":[{\"id\":\"tool\",\"name\":\"Tool\",\"description\":\"Define tools with arguments and results for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Tool icon - wrench/settings -->\\n  <path d=\\\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Tool input data\",\"type\":5}],\"outputs\":[{\"name\":\"arguments\",\"description\":\"Tool arguments\",\"type\":5}],\"color\":\"#42a5f5\"},{\"id\":\"submit\",\"name\":\"Submit\",\"description\":\"Submit data without any processing\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- Submit icon - send/arrow -->\\n  <path d=\\\"M2.01 21L23 12 2.01 3 2 10l15 2-15 2z\\\" fill=\\\"currentColor\\\"/>\\n</svg>\\n\",\"inputs\":[{\"name\":\"input\",\"description\":\"Data to submit\",\"type\":6}],\"color\":\"#68bb6c\"},{\"id\":\"history\",\"name\":\"History\",\"description\":\"Manage conversation history and session storage for AI agents\",\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 16 16\\\">\\n  <path\\n    d=\\\"M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M8 3.5a.5.5 0 0 1 .5.5v4l2.5 1.5a.5.5 0 0 1-.5.866L7.5 8.866A.5.5 0 0 1 7.5 8V4a.5.5 0 0 1 .5-.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n  <path\\n    d=\\\"M2.5 8a5.5 5.5 0 0 1 5.5-5.5V1A7 7 0 0 0 1 8h1.5z\\\"\\n    fill=\\\"white\\\"\\n  />\\n</svg>\\n\",\"inputs\":[{\"name\":\"agent\",\"description\":\"Connect to the agent\",\"type\":5}],\"outputs\":[{\"name\":\"getHistory\",\"description\":\"Invoked when the agent needs to retrieve the conversation history\",\"type\":5},{\"name\":\"updateHistory\",\"description\":\"Invoked when the agent needs to update the conversation history\",\"type\":5}],\"color\":\"#9c27b0\"}],\"internal\":false,\"devMode\":true,\"sessionId\":1760512532}},\"type\":\"hubService\",\"secrets\":{\"OPENROUTER_API_KEY\":{\"name\":\"OPENROUTER_API_KEY\",\"hubServiceName\":\"kemu.io.ai-agent\"}},\"groupId\":\"{#}mBE0gxc\"},\"{#}jCnteeA\":{\"id\":\"{#}jCnteeA\",\"canvas\":{\"position\":{\"x\":948,\"y\":397}},\"children\":[{\"childId\":\"{#}a5vxU9Y\",\"sourcePort\":\"{#}jCnteeA_output_sessionHistoryOutput\",\"targetPort\":\"{#}a5vxU9Y_input_input\"}],\"state\":{\"pauseExecution\":false,\"autoPauseOnError\":true,\"version\":2,\"metadata\":{\"name\":\"Memory History\",\"description\":\"Keeps the history messages in memory (this is intended for dev purposes only)\"},\"pages\":{\"main\":{\"code\":\"/**\\n * Name: Memory History\\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\\n */\\n\\nconst sessions = {};\\n\\nconst getWidgetInputs = () => [\\n  { name: 'read', type: DataType.JsonObj },\\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\\n];\\n\\nconst getWidgetOutputs = () => [\\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\\n];\\n\\nconst onParentEvent = async ({ targetPort, event }) => {\\n  const inputData = event.data.value;\\n\\n  if (targetPort.name === 'read') {\\n    const sessionId = inputData.sessionId;\\n\\n    if (sessionId === undefined || sessionId === null) {\\n      console.error(\\\"Error: 'read' event missing 'sessionId' property.\\\");\\n      return;\\n    }\\n\\n    if (!sessions[sessionId]) {\\n      sessions[sessionId] = { messages: [] };\\n    }\\n\\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\\n\\n  } else if (targetPort.name === 'update') {\\n    const sessionId = inputData.sessionId;\\n    const messagesToProcess = inputData.messages;\\n\\n    if (sessionId === undefined || sessionId === null) {\\n      console.error(\\\"Error: 'update' event missing 'sessionId' property.\\\");\\n      return;\\n    }\\n    if (messagesToProcess === undefined || messagesToProcess === null) {\\n      console.error(\\\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\\\");\\n      return;\\n    }\\n\\n    if (!sessions[sessionId]) {\\n      sessions[sessionId] = { messages: [] };\\n    }\\n\\n    if (Array.isArray(messagesToProcess)) {\\n      sessions[sessionId].messages.push(...messagesToProcess);\\n    } else {\\n      sessions[sessionId].messages.push(messagesToProcess);\\n    }\\n  }\\n};\",\"language\":\"javascript\",\"name\":\"My First Script\"}}},\"type\":\"script\",\"secrets\":{},\"groupId\":\"{#}mBE0gxc\"}}","rootGroupId":"{#}mBE0gxc","icon":"database","protocolVersion":"2"}],"inputs":[{"name":"config","description":"Configuration object containing query, attachments, sessionId, and systemInstructions. Can also be a string to be used as query or a boolean to trigger processing.","type":[5,4,1,6]},{"name":"abort","description":"Abort current query signal","type":6}],"outputs":[{"name":"tools","type":5},{"name":"history","type":5},{"name":"json","type":5},{"name":"text","type":1},{"name":"stream","type":1},{"name":"reasoning","description":"Reasoning output from models that support extended thinking","type":1},{"name":"images","description":"Generated images as ImageData array","type":3},{"name":"debug","description":"Includes debugging information for when things go wrong, including stopping reason","type":5}],"supportedPlatforms":["win-x86","win-x64","osx-x64","osx-arm64","linux-debian-arm64","linux-debian-x64","linux-rhel-arm64","linux-rhel-x64"],"author":"0f998d5a-a8ce-4bf8-9f84-fa8c481cb40b","defaultVariantInf