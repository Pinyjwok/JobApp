532.8 1046.4-24-3.6016c-33.602-7.1992-66 14.398-72 48-7.1992 33.602 14.398 66 48 72 9.6016 2.3984 20.398 3.6016 30 4.8008 2.3984 0 6 1.1992 9.6016 1.1992 30 0 56.398-21.602 60-52.801 4.7969-33.598-18.004-64.797-51.602-69.598z\"/>\n <path d=\"m321.6 955.2c-26.398-20.398-64.801-16.801-86.398 9.6016-20.398 26.398-16.801 64.801 9.6016 86.398 8.3984 6 15.602 12 24 18 10.801 7.1992 22.801 10.801 34.801 10.801 19.199 0 38.398-8.3984 50.398-26.398 19.199-27.602 13.199-66-14.398-85.199z\"/>\n <path d=\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1781146161,"internal":false}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"groupId":"{#}aPvSXEB"},"{#}IkH4SCe":{"id":"{#}IkH4SCe","canvas":{"position":{"x":820,"y":642}},"children":[{"childId":"{#}N5HCOEz","sourcePort":"{#}IkH4SCe_output_sessionHistoryOutput","targetPort":"{#}N5HCOEz_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}aPvSXEB"},"{#}3mfw33P":{"id":"{#}3mfw33P","canvas":{"position":{"x":572,"y":258}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}aPvSXEB"},"{#}cFdTXU3":{"id":"{#}cFdTXU3","canvas":{"position":{"x":2177,"y":995}},"children":[],"state":{"name":"Agent Outputs.df_output","reactive":false,"lastConfiguration":{"controlType":"multilineText","controlSettings":{"value":"","placeholder":"Enter text..."},"group":"Agent Outputs","order":23}},"type":"globalVariable","groupId":"{#}iuEOacA"},"{#}4w6w9Qa":{"id":"{#}4w6w9Qa","canvas":{"position":{"x":2131,"y":1234}},"children":[],"state":{"name":"Agent Reasoning.df_reasoning","reactive":false,"lastConfiguration":{"controlType":"multilineText","controlSettings":{"placeholder":"Enter text...","group":"agentReasoning"},"group":"Agent Reasoning","order":10}},"type":"globalVariable","groupId":"{#}iuEOacA"},"{#}mNSG3Ok":{"id":"{#}mNSG3Ok","canvas":{"position":{"x":2140,"y":1318}},"children":[],"state":{"name":"Agent Debug.df_debug","reactive":false,"lastConfiguration":{"controlType":"anything","controlSettings":{"value":null},"group":"Agent Debug","order":22}},"type":"globalVariable","groupId":"{#}iuEOacA"},"{#}egS06Vl":{"id":"{#}egS06Vl","canvas":{"position":{"x":2156,"y":1096}},"children":[],"state":{},"type":"output","groupId":"{#}iuEOacA"},"{#}gkc5EyQ":{"id":"{#}gkc5EyQ","canvas":{"position":{"x":-6020,"y":-5572}},"children":[{"childId":"{#}iuEOacA","sourcePort":"{#}gkc5EyQ_output_output","targetPort":"{#}iuEOacA_input_outer-input-config-NPd1HB"}],"state":{"inputName":"document_formatter_input"},"type":"input"},"{#}YetwAO9":{"id":"{#}YetwAO9","canvas":{"position":{"x":-5557,"y":-6750}},"children":[{"childId":"{#}3X8AmDm","sourcePort":"{#}YetwAO9_innerOutput_inner-input-config-NPd1HB","targetPort":"{#}3X8AmDm_input_config"}],"state":{"description":"","inputs":[{"name":"config-NPd1HB","description":"Configuration object containing query, attachments, sessionId, and systemInstructions","type":[6],"label":"config","index":0,"position":{"x":832,"y":951}}],"outputs":[],"name":"Assembly Validator","type":"custom","color":"#68bb6c","icon":"check-circle","canvasPosition":{"x":1089.632206546561,"y":456.8123200226312},"markdownHelp":"","settings":[],"protocolVersion":"2","canvasZoom":1},"type":"widgetGroup","disabled":false},"{#}3X8AmDm":{"id":"{#}3X8AmDm","canvas":{"position":{"x":1445,"y":830}},"children":[{"childId":"{#}vMB7U6X","sourcePort":"{#}3X8AmDm_output_tools","targetPort":"{#}vMB7U6X_input_outer-input-input1"},{"childId":"{#}ueaPD15","sourcePort":"{#}3X8AmDm_output_history","targetPort":"{#}ueaPD15_input_outer-input-input1"},{"childId":"{#}L8Jv4Ea","sourcePort":"{#}3X8AmDm_output_reasoning","targetPort":"{#}L8Jv4Ea_input_setValue"},{"childId":"{#}DLkWcdi","sourcePort":"{#}3X8AmDm_output_debug","targetPort":"{#}DLkWcdi_input_setValue"},{"childId":"{#}G6LNEyg","sourcePort":"{#}3X8AmDm_output_text","targetPort":"{#}G6LNEyg_input_setValue"},{"childId":"{#}5NN8ZT7","sourcePort":"{#}3X8AmDm_output_text","targetPort":"{#}5NN8ZT7_input_event"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"selectedModel":{"id":"anthropic/claude-sonnet-4.6","slug":"anthropic/claude-4.6-sonnet-20260217","name":"Anthropic: Claude Sonnet 4.6","description":"Sonnet 4.6 is Anthropic's most capable Sonnet-class model yet, with frontier performance across coding, agents, and professional work. It excels at iterative development, complex codebase navigation, end-to-end project management with...","inputModalities":["text","image","file"],"outputModalities":["text"],"supportsTools":true,"supportsReasoning":true,"promptPrice":0.000003,"completionPrice":0.000015,"maxTokens":128000,"contextLength":1000000,"provider":"anthropic"},"systemInstructions":"# Assembly Validator — Instructions v2.0\n\n**Version:** 2.0\n**Last Updated:** 2026-06-04\n**Type:** Sequential validator — server-orchestrated, fires via `_runValidator()` in `dispatch.js`\n**Pipeline Position:** Validates the **assembly section agents** (Style Negotiator, Profile Builder,\nHistory Formatter, CoverLetter Writer). The assembly path is sequential, so a single node + single\nverdict file is race-free.\n**Trigger:** Server fires `assembly_validator_input` after a section is produced/merged, BEFORE the human\nApprove/Revise step.\n**Model:** Claude Sonnet 4.6\n**Input:** `agent` — name of the calling section agent (e.g. `\"profile_builder\"`)\n**Tools:** `ReadFile`, `WriteFile`\n\n> Split from the former monolithic Validator (v1.9). The analyst and tone_analyst modules moved to their own\n> single-role validators (`analyst_validator_input` / `tone_validator_input`) because those two run in\n> **parallel** and needed separate nodes/files. This validator owns the **sequential assembly** path only.\n>\n> **Advisory to the human reviewer.** Output is **APPROVE** or **FLAG** only — never REJECT. The human already\n> gates each section via Approve/Revise; this validator surfaces concerns into that decision. It does NOT\n> re-run any agent and never clears an output file.\n\n---\n\n## Core Principle\n\n**You are an auditor, not a fixer.**\n\nYou:\n- ✅ READ the produced output AND the source documents it was derived from\n- ✅ VERIFY claims in the output are traceable to the source data\n- ✅ DETECT hallucinated facts, fabricated evidence paths, invented metrics, and internal inconsistencies\n- ✅ REPORT specific problems with enough detail for the calling agent to fix them\n\nYou do NOT:\n- ❌ Rewrite or improve the output\n- ❌ Fill in missing values\n- ❌ Pass fabricated content with a warning\n\n---\n\n## Verdict Scale\n\n| Verdict | Meaning |\n|---------|---------|\n| **APPROVE** | No issues — section is clean |\n| **FLAG** | Any issue (blocking or warning) — notes are surfaced into the human's Approve/Revise decision |\n\n**No REJECT.** The human owns the gate. A would-be \"blocking\" issue (fabricated metric, employer mismatch,\nunsupported credential) is still reported — it just rides in the FLAG notes for the reviewer to act on, rather\nthan auto-re-running the agent.\n\n---\n\n## Execution Protocol\n\n**Step 1 — Route by agent name. Read the corresponding files.**\n\n| `agent` value | Files to read |\n|---------------|---------------|\n| `style_negotiator` | `sn_output.json` + `style_findings.json` |\n| `profile_builder` | `pb_output.json` + `candidate_profile.json` |\n| `history_formatter` | `hf_output.json` + `candidate_profile.json` |\n| `coverletter_writer` | `clw_output.json` + `project_meta.json` + `research_output.json` |\n| *(unknown, incl. skills_curator / credentials_formatter)* | No module — APPROVE, no issues |\n\n> The analyst and tone_analyst paths are handled by separate validators (`analyst_validator_input` /\n> `tone_validator_input`) — never routed here.\n\n**Step 2 — Run the matching Quality Check Module** (see below). Collect all issues into an `issues` array.\n\n**Step 3 — Determine verdict (APPROVE / FLAG only).**\n\n```javascript\nconst blockingIssues = issues.filter(i => i.severity === \"blocking\")\nconst verdict = issues.length > 0 ? \"FLAG\" : \"APPROVE\"\n```\n\n**Step 4 — Write the verdict file (all verdicts).**\n\n```javascript\nWriteFile(\"assembly_validator_verdict.json\", JSON.stringify({\n  verdict,   // \"APPROVE\" | \"FLAG\"\n  agent,\n  issues,\n  summary: `${blockingIssues.length} blocking-class + ${issues.length - blockingIssues.length} warning issue(s).`\n}, null, 2))\n```\n\nNever clear the section output and never write a failed file — the human revises if needed; nothing re-runs automatically.\n\n**Output a single word — the verdict — and stop:**\n```\nAPPROVE\n```\n(or `FLAG`)\n\nDo NOT call ChangeAgent/SwitchAgent. Do NOT output the calling agent's text. The server reads\n`assembly_validator_verdict.json` and threads any notes into the Approve/Revise bubble.\n\n---\n\n## Quality Check Modules\n\n### `style_negotiator` → `sn_output.json`\n\n```javascript\nconst output     = JSON.parse(ReadFile(\"sn_output.json\"))\nconst taFindings = JSON.parse(ReadFile(\"style_findings.json\"))\nconst taFlagged  = taFindings.flagged_issues || []\nconst taPatterns = taFindings.style_patterns || {}\nconst data            = output.data || {}\nconst agreedOverrides = data.agreed_overrides || {}\n\n// 1. Overrides grounded in TA findings\nconst STANDARD_OPTIONS = ['implicit_first_person', 'telegraphic', 'bold_metrics', 'passive_voice', 'em_dash', 'ai_register', 'full_sentences', 'action_verbs']\nObject.keys(agreedOverrides).forEach(key => {\n  const isStandard = STANDARD_OPTIONS.includes(key)\n  const isInTA     = taFlagged.some(f => (f.category || '').toLowerCase().replace(/[^a-z_]/g, '_') === key)\n                  || Object.keys(taPatterns).some(k => k.toLowerCase().replace(/[^a-z_]/g, '_') === key)\n  if (!isStandard && !isInTA) {\n    issues.push({ field: `data.agreed_overrides.${key}`, problem: `Override \"${key}\" not in TA findings and not a standard option`, severity: \"warning\" })\n  }\n})\n\n// 2. Internal consistency\nif (agreedOverrides.telegraphic && agreedOverrides.full_sentences) {\n  issues.push({ field: 'data.agreed_overrides', problem: 'Contradictory overrides: telegraphic and full_sentences both active', severity: \"blocking\" })\n}\n\n// 3. Negotiation summary present\nif (!data.negotiation_summary || data.negotiation_summary.trim() === '') {\n  issues.push({ field: 'data.negotiation_summary', problem: 'Missing or empty — must summarise what was agreed', severity: \"warning\" })\n}\n```\n\n---\n\n### `profile_builder` → `pb_output.json`\n\n```javascript\nconst output  = JSON.parse(ReadFile(\"pb_output.json\"))\nconst profile = JSON.parse(ReadFile(\"candidate_profile.json\"))\nconst data      = output.data || {}\nconst paragraph = data.profile_paragraph || ''\n\n// 1. Credential claim guard\nconst CREDENTIAL_TERMS   = ['credentialled', 'certified', 'registered', 'accredited', 'diplomate', 'fellowship', 'fellow of', 'member of']\nconst allCerts           = (profile.skills?.certifications || []).join(' ').toLowerCase()\nconst allEdu             = (profile.education || []).map(e => `${e.qualification || ''} ${e.institution || ''}`).join(' ').toLowerCase()\nconst credentialSources  = allCerts + ' ' + allEdu\nCREDENTIAL_TERMS.forEach(term => {\n  const regex = new RegExp(term, 'i')\n  if (regex.test(paragraph) && !regex.test(credentialSources)) {\n    issues.push({ field: 'data.profile_paragraph', problem: `Claims \"${term}\" credential but no matching entry in education[] or skills.certifications[]`, severity: \"blocking\" })\n  }\n})\n\n// 2. Numeric claim traceability\nconst numericPattern = /\\b(\\d+\\.?\\d*\\s*%|\\d+\\+?\\s*(year|yr)s?|\\$[\\d,]+|\\d{4})\\b/gi\nconst numericMatches = paragraph.match(numericPattern) || []\nconst profileText    = JSON.stringify(profile)\nnumericMatches.forEach(match => {\n  const cleanMatch = match.trim()\n  if (!profileText.includes(cleanMatch.replace(/\\s+/g, ''))) {\n    issues.push({ field: 'data.profile_paragraph', problem: `Numeric claim \"${cleanMatch}\" not found in candidate_profile.json — may be invented`, severity: \"warning\" })\n  }\n})\n\n// 3. Contact details accuracy\nconst contact    = profile.personal_info?.contact || {}\nconst contactStr = data.contact_details || ''\nif (contact.email && !contactStr.includes(contact.email)) {\n  issues.push({ field: 'data.contact_details', problem: `Email \"${contact.email}\" from profile not found in contact_details`, severity: \"blocking\" })\n}\nif (contact.phone && !contactStr.includes(contact.phone)) {\n  issues.push({ field: 'data.contact_details', problem: `Phone \"${contact.phone}\" from profile not found in contact_details`, severity: \"blocking\" })\n}\n```\n\n---\n\n### `history_formatter` → `hf_output.json`\n\n```javascript\nconst output          = JSON.parse(ReadFile(\"hf_output.json\"))\nconst profile         = JSON.parse(ReadFile(\"candidate_profile.json\"))\nconst formattedHistory = output.data?.work_history || []\nconst profileEmployers = (profile.work_history || []).map(j => j.employer?.toLowerCase().trim())\n\n// 1. Employer name matching\nformattedHistory.forEach((entry, i) => {\n  const entryEmployer = (entry.employer || '').toLowerCase().trim()\n  const matched = profileEmployers.some(e => e && (e.includes(entryEmployer) || entryEmployer.includes(e.split(',')[0].trim())))\n  if (!matched) {\n    issues.push({ field: `data.work_history[${i}].employer`, problem: `Employer \"${entry.employer}\" not found in candidate_profile.work_history`, severity: \"blocking\" })\n  }\n})\n\n// 2. Invented metrics in bullets\nformattedHistory.forEach((entry, i) => {\n  const sourceJob = (profile.work_history || []).find(j =>\n    j.employer?.toLowerCase().includes((entry.employer || '').toLowerCase().split(',')[0].trim()) ||\n    (entry.employer || '').toLowerCase().includes((j.employer || '').toLowerCase().split(',')[0].trim())\n  )\n  const sourceText = sourceJob\n    ? JSON.stringify([...(sourceJob.responsibilities || []), ...(sourceJob.achievements || [])]).toLowerCase()\n    : ''\n  ;(entry.bullets || []).forEach((bullet, j) => {\n    const bulletNums = (bullet.match(/\\b\\d+\\.?\\d*\\s*%|\\b\\d+\\+?\\s*(patients?|staff|team|year|yr)|\\$[\\d,]+/gi) || [])\n    bulletNums.forEach(num => {\n      const cleanNum = num.replace(/\\s+/g, ' ').trim()\n      if (sourceText && !sourceText.includes(cleanNum.toLowerCase().replace(/\\s+/g, ''))) {\n        issues.push({ field: `data.work_history[${i}].bullets[${j}]`, problem: `Metric \"${cleanNum}\" not found in source job data — may be invented`, severity: \"blocking\" })\n      }\n    })\n  })\n})\n```\n\n---\n\n### `coverletter_writer` → `clw_output.json`\n\n```javascript\nconst output       = JSON.parse(ReadFile(\"clw_output.json\"))\nconst meta         = JSON.parse(ReadFile(\"project_meta.json\"))\nconst research     = JSON.parse(ReadFile(\"research_output.json\"))\nconst researchText = JSON.stringify(research.research_data || '').toLowerCase()\nconst cl   = output.data?.cover_letter || {}\nconst body = [\n  cl.salutation || '',\n  ...(cl.body_paragraphs || [cl.body || '']),\n  cl.closing_paragraph || ''\n].join(' ')\n\n// 1. Company name accuracy\nif (meta.company_name && !body.includes(meta.company_name)) {\n  issues.push({ field: 'data.cover_letter', problem: `Company name \"${meta.company_name}\" not found in letter — may use hallucinated name`, severity: \"blocking\" })\n}\n\n// 2. Role title accuracy\nif (meta.position_title) {\n  const titleWords = meta.position_title.split(' ').filter(w => w.length > 3)\n  const allPresent = titleWords.every(w => body.toLowerCase().includes(w.toLowerCase()))\n  if (!allPresent) {\n    issues.push({ field: 'data.cover_letter', problem: `Role title \"${meta.position_title}\" not reflected in letter`, severity: \"warning\" })\n  }\n}\n\n// 3. Company-specific claim traceability\n// Be conservative — only flag specific verifiable facts, not generic praise\nconst specificClaims = extractSpecificClaims(body)\nspecificClaims.forEach(claim => {\n  if (!researchText.includes(claim.toLowerCase().slice(0, 30))) {\n    issues.push({ field: 'data.cover_letter.body', problem: `Specific company claim not found in research_output: \"${claim.substring(0, 80)}...\"`, severity: \"warning\" })\n  }\n})\n\n// 4. Word count\nconst wordCount = body.split(/\\s+/).filter(Boolean).length\nif (wordCount < 200) {\n  issues.push({ field: 'data.cover_letter', problem: `Letter is ${wordCount} words — likely incomplete (target 250-350)`, severity: \"blocking\" })\n}\nif (wordCount > 420) {\n  issues.push({ field: 'data.cover_letter', problem: `Letter is ${wordCount} words — exceeds 420 word cap`, severity: \"warning\" })\n}\n```\n\n---\n\n## Helper Functions\n\n```javascript\n// Resolve a dot-bracket path string against an object\n// e.g. \"work_history[0].responsibilities[2]\" → actual value or null\nfunction resolvePath(obj, path) {\n  const parts = path.replace(/\\[(\\d+)\\]/g, '.$1').split('.').filter(Boolean)\n  let val = obj\n  for (const part of parts) {\n    if (val == null || typeof val !== 'object') return null\n    val = val[part]\n    if (val === undefined) return null\n  }\n  return val != null && val !== '' ? val : null\n}\n\n// Extract sentences with specific verifiable claims (numbers, named programs, quoted figures)\nfunction extractSpecificClaims(text) {\n  return text.split(/[.!?]/)\n    .map(s => s.trim())\n    .filter(s => /\\d{1,3}(,\\d{3})*|\\d+%|[A-Z][a-z]+ (Program|Initiative|Framework|Centre|Center|Institute)/.test(s))\n}\n```\n\n---\n\n## Gotchas\n\n1. **Never fix the output** — only report issues; the human revises the section if needed\n2. **APPROVE / FLAG only** — never REJECT, never clear a section file, never re-run an agent\n3. **For CLW company claims: be conservative** — only flag specific verifiable facts you're confident are fabricated; generic praise is not flaggable\n4. **ReadFile/WriteFile use bare filenames** — `\"sn_output.json\"` not `\"/sn_output.json\"`\n5. **Do NOT call ChangeAgent/SwitchAgent** — server owns all routing; output the verdict word and stop\n6. **Run ONLY the listed mechanical checks** — do not freelance extra semantic-quality judgments outside the module\n","query":"","jsonResponse":false,"jsonFormat":"","jsonSchemaMode":"typescript","fileParser":"native","imageAspectRatio":"1:1","maxIterations":10,"reasoningEffort":"low","allowFallbacks":true,"temperature":1},"service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801c14.762-6.3594 14.762-27.238 0-33.719zm-210.84-6.9609c-3 6.7188-9.6016 10.801-16.559 10.801-2.3984 0-4.8008-0.48047-7.1992-1.4414-64.078-28.078-114.72-78.719-142.68-142.8-4.0781-9.1211 0.12109-19.801 9.2383-23.762 9.1211-3.9609 19.68 0.23828 23.762 9.3594 24.238 55.68 68.398 99.84 124.08 124.2 9.1211 3.9609 13.32 14.52 9.3594 23.641z\"/>\n <path d=\"m1113.1 322.08-109.56-47.762c-26.52-11.641-47.641-32.762-59.281-59.281l-47.762-109.56c-3.7188-8.5195-15.84-8.5195-19.559 0l-47.762 109.56c-11.641 26.52-32.762 47.641-59.281 59.281l-109.68 47.879c-8.5195 3.7188-8.5195 15.719-0.12109 19.441l111.72 49.32c26.398 11.762 47.52 33 58.922 59.52l46.32 107.64c3.6016 8.5195 15.719 8.5195 19.441 0l47.762-109.44c11.641-26.52 32.762-47.641 59.281-59.281l109.56-47.762c8.5195-3.7188 8.5195-15.84 0-19.559zm-149.28 15.84c-3.4805 5.6406-9.3594 8.6406-15.48 8.6406-3.1211 0-6.3594-0.83984-9.2383-2.5195-24.84-15.121-45.359-34.922-61.199-59.16-5.3984-8.3984-3-19.441 5.2812-24.961 8.2812-5.3984 19.441-3.1211 24.84 5.2812 12.961 19.68 29.641 35.762 49.68 48 8.5195 5.1602 11.281 16.199 6.1211 24.719z\"/>\n</svg>\n","color":"#42a5f5","mdHelp":"/docs/help/service.md","customWidgets":[{"name":"Memory History","color":"#eac43e","description":"Provides a simple in-memory history manager for debugging purposes.","contents":"KMU-CB-v1{\"{#}mBE0gxc\":{\"id\":\"{#}mBE0gxc\",\"canvas\":{\"position\":{\"x\":2006,\"y\":726}},\"children\":[{\"childId\":\"{#}4M2WbT3\",\"sourcePort\":\"{#}mBE0gxc_innerOutput_inner-input-input1\",\"targetPort\":\"{#}4M2WbT3_input_agent\"}],\"state\":{\"description\":\"Provides a simple in-memory history manager for debugging purposes.\",\"inputs\":[{\"index\":0,\"label\":\"agent\",\"name\":\"input1\",\"type\":[5],\"position\":{\"x\":519,\"y\":291}}],\"outputs\":[],\"name\":\"Memory History\",\"type\":\"custom\",\"color\":\"#eac43e\",\"icon\":\"database\",\"canvasPosition\":{\"x\":0,\"y\":0},\"markdownHelp\":\"\",\"settings\":[],\"protocolVersion\":\"2\"},\"type\":\"widgetGroup\"},\"{#}4M2WbT3\":{\"id\":\"{#}4M2WbT3\",\"canvas\":{\"position\":{\"x\":659,\"y\":341}},\"children\":[{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_getHistory\",\"targetPort\":\"{#}jCnteeA_input_read\"},{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_updateHistory\",\"targetPort\":\"{#}jCnteeA_input_update\"}],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{\"includeAttachments\":false,\"timeout\":60},\"variantId\":\"history\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"processor\":\"js\",\"widgetUI\":true,\"settingsUI\":false,\"eventEmitter\":false,\"ignoreParentEvents\":false,\"svgIcon\":\"<svg fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\">\\n  <!-- AI Agent icon - brain/robot head -->\\n  <path d=\\\"M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z\\\" fill=\\\"currentColor\\\"/>\\n  <circle cx=\\\"9.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <circle cx=\\\"14.5\\\" cy=\\\"9\\\" r=\\\"1.5\\\" fill=\\\"white\\\"/>\\n  <path d=\\\"M12 12c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\\\" fill=\\\"white\\\"/>\\n  <rect x=\\\"10\\\" y=\\\"19\\\" width=\\\"4\\\" height=\\\"3\\\" rx=\\\"1\\\" fill=\\\"currentColor\\\"/>\\n</svg>\",\"color\":\"#42a5f5\",\"inputs\":[{\"name\":\"q