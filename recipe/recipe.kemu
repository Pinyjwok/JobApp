2-42.281 102.14 0 38.578 15.047 74.859 42.281 102.14 27.281 27.281 63.562 42.281 102.14 42.281 38.578 0 74.859-15.047 102.14-42.281l199.82-199.82c2.9531-2.9531 5.1094-6.6094 6.2812-10.594l19.688-66.797 66.797-19.688c8.4375-2.4844 14.953-9.2344 17.156-17.812 2.1562-8.5312-0.28125-17.625-6.5625-23.859l-54.422-54.422 327.79-327.79 79.359-19.219 84.891-145.03-60.141-60.141zm-587.39 682.87-179.29 179.29c-4.875 4.875-11.297 7.3125-17.672 7.3125-6.4219 0-12.797-2.4375-17.672-7.3125-9.7969-9.7969-9.7969-25.594 0-35.344l179.29-179.29c9.7969-9.7969 25.594-9.7969 35.344 0 9.7969 9.7969 9.7969 25.594 0 35.344z\"/>\n</svg>\n","inputs":[{"name":"input","description":"Tool input data","type":5}],"outputs":[{"name":"arguments","description":"Tool arguments","type":5}],"color":"#42a5f5"},{"id":"submit","name":"Submit","description":"Submits data back to the agent after a tool execution or history retrieval","svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m645.28 600c0-12.516-5.0625-23.812-13.266-32.016-8.1562-8.2031-19.5-13.266-32.016-13.266s-23.812 5.0625-32.016 13.266c-8.2031 8.1562-13.266 19.5-13.266 32.016 0 12.469 5.0625 23.812 13.266 32.016 8.1562 8.2031 19.5 13.266 32.016 13.266s23.812-5.0625 32.016-13.266c8.2031-8.1562 13.266-19.5 13.266-32.016zm291.84 37.453c-0.23438 0.84375-86.812 289.13-417.14 310.13v-58.219h-0.046875c0-4.7344-1.2188-9.6094-3.7969-14.016-7.7344-13.078-24.609-17.438-37.688-9.7031l-227.95 135.37c-3.9375 2.25-7.4062 5.625-9.8906 9.8438-7.7344 13.078-3.375 29.953 9.7031 37.641l226.64 134.63c4.4062 3 9.75 4.7812 15.516 4.7812 15.234 0 27.562-12.328 27.562-27.562v-59.719c61.125-8.7656 151.6-31.031 238.13-87.703 99.375-65.062 193.4-174.89 231.89-360.24 3.8438-14.203-4.2188-29.062-18.375-33.469-14.531-4.5-29.906 3.6094-34.453 18.094zm-674.34-74.906c0.23438-0.84375 86.812-289.13 417.14-310.13v58.219h0.046875c0 4.7344 1.2188 9.6094 3.7969 14.016 7.7344 13.078 24.609 17.438 37.688 9.7031l227.95-135.37c3.9375-2.25 7.4062-5.625 9.8906-9.8438 7.7344-13.078 3.375-29.953-9.7031-37.641l-226.64-134.63c-4.4062-3.0469-9.75-4.7812-15.516-4.7812-15.234 0-27.562 12.328-27.562 27.562v59.719c-61.125 8.7656-151.6 31.031-238.13 87.703-99.375 65.062-193.4 174.89-231.89 360.24-3.8438 14.203 4.2188 29.062 18.375 33.469 14.531 4.5 29.906-3.6094 34.453-18.094zm266.16-33.516c18.188-18.188 43.266-29.391 71.016-29.391 27.703 0 52.828 11.25 71.016 29.391 18.188 18.188 29.391 43.266 29.391 71.016 0 27.703-11.25 52.828-29.391 71.016-18.188 18.188-43.266 29.391-71.016 29.391-27.703 0-52.828-11.25-71.016-29.391-18.188-18.188-29.391-43.266-29.391-71.016 0-27.703 11.25-52.828 29.391-71.016zm293.91 8.7227c11.109-8.9531 13.453-24.844 5.7188-36.562l-29.531-51.141c-6.9844-12.141-21.844-16.922-34.406-11.625l-41.672 16.031c-8.625-7.3125-17.906-13.875-27.75-19.547-9.7031-5.625-20.016-10.406-30.703-14.297l-7.0781-44.766c-2.1094-13.594-13.781-23.25-27.141-23.25v-0.09375h-60.75c-14.625 0-26.531 11.344-27.516 25.688l-6.6094 42.094c-10.828 3.6562-21.188 8.3906-30.891 14.016-9.9844 5.7656-19.312 12.469-28.031 20.109l-42.141-16.219c-12.797-4.875-27 0.42188-33.609 11.953l-30.328 52.594c-6.8438 11.859-3.7969 26.766 6.5625 35.109l35.297 28.547c-0.42188 2.5312-0.84375 5.0625-1.1719 7.6406-1.2188 8.9062-1.875 17.625-1.875 26.062s0.60938 17.203 1.875 26.062c0.32813 2.5781 0.75 5.1094 1.1719 7.6406l-35.297 28.547c-11.109 8.9531-13.453 24.844-5.7188 36.562l29.531 51.141c6.9844 12.188 21.844 16.922 34.406 11.625l41.672-16.031c8.625 7.3125 17.906 13.875 27.75 19.547 9.75 5.625 20.016 10.406 30.703 14.297l7.0781 44.766c2.1094 13.594 13.781 23.25 27.141 23.25v0.09375h60.75c14.625 0 26.531-11.344 27.516-25.688l6.7031-42.469c10.688-3.8438 20.953-8.6719 30.703-14.297 9.8438-5.6719 19.125-12.234 27.75-19.547l42.516 16.359c12.797 4.875 27-0.42188 33.609-11.953l30.328-52.594c6.8438-11.859 3.7969-26.766-6.5625-35.109l-35.297-28.547c0.46875-2.5312 0.84375-5.0625 1.1719-7.6406 1.2188-8.9062 1.875-17.625 1.875-26.062s-0.60937-17.203-1.875-26.062c-0.375-2.5781-0.75-5.1562-1.1719-7.6406l35.297-28.547z\" fill-rule=\"evenodd\"/>\n</svg>\n","inputs":[{"name":"input","description":"Data to submit","type":6}],"color":"#68bb6c"},{"id":"history","name":"History","description":"Manage conversation history and session storage for AI agents","svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m1003.2 198c-216-216-560.4-220.8-784.8-19.199l-60-60c-19.199-19.199-52.801-9.6016-58.801 16.801l-68.398 280.8c-6 25.199 16.801 49.199 43.199 43.199l280.8-68.398c26.398-6 36-39.602 16.801-58.801l-66-66c176.4-153.6 444-148.8 612 19.199 174 174 174 459.6-1.1992 634.8l-16.801 15.602c-25.199 22.801-26.398 61.199-4.8008 86.398 12 13.199 28.801 20.398 45.602 20.398 14.398 0 28.801-4.8008 40.801-15.602 7.1992-6 14.398-13.199 20.398-20.398 223.2-223.2 223.2-585.6 1.1992-808.8z\"/>\n <path d=\"m739.2 1028.4-22.801 7.1992c-32.398 8.3984-51.602 42-43.199 75.602 7.1992 27.602 32.398 45.602 58.801 45.602 4.8008 0 10.801-1.1992 15.602-2.3984 9.6016-2.3984 19.199-6 28.801-8.3984 32.398-10.801 49.199-45.602 38.398-76.801-8.4023-33.602-43.199-51.602-75.602-40.805z\"/>\n <path d=\"m532.8 1046.4-24-3.6016c-33.602-7.1992-66 14.398-72 48-7.1992 33.602 14.398 66 48 72 9.6016 2.3984 20.398 3.6016 30 4.8008 2.3984 0 6 1.1992 9.6016 1.1992 30 0 56.398-21.602 60-52.801 4.7969-33.598-18.004-64.797-51.602-69.598z\"/>\n <path d=\"m321.6 955.2c-26.398-20.398-64.801-16.801-86.398 9.6016-20.398 26.398-16.801 64.801 9.6016 86.398 8.3984 6 15.602 12 24 18 10.801 7.1992 22.801 10.801 34.801 10.801 19.199 0 38.398-8.3984 50.398-26.398 19.199-27.602 13.199-66-14.398-85.199z\"/>\n <path d=\"m192 793.2c-14.398-31.199-50.398-44.398-81.602-30-31.199 14.398-44.398 50.398-30 81.602 4.8008 9.6016 8.3984 18 13.199 27.602 10.801 20.398 32.398 32.398 54 32.398 9.6016 0 19.199-2.3984 28.801-7.1992 30-15.602 40.801-52.801 25.199-82.801z\"/>\n <path d=\"m800.4 657.6-140.4-90v-223.2c0-33.602-27.602-61.199-61.199-61.199-33.602 0-61.199 27.602-61.199 61.199v256.8c0 20.398 10.801 40.801 28.801 51.602l168 106.8c9.6016 6 21.602 9.6016 32.398 9.6016 20.398 0 39.602-9.6016 51.602-28.801 17.996-27.602 9.5977-64.801-18.004-82.801z\"/>\n</svg>\n","inputs":[{"name":"agent","description":"Connect to the agent","type":5}],"outputs":[{"name":"getHistory","description":"Invoked when the agent needs to retrieve the conversation history","type":5},{"name":"updateHistory","description":"Invoked when the agent needs to update the conversation history","type":5}],"color":"#eac43e"}],"publicationId":"kemu.io.ai-agent-osx-arm64-1.9.1","sessionId":1782122874}},"type":"hubService","secrets":{"OPENROUTER_API_KEY":{"name":"OPENROUTER_API_KEY","sharedAcrossInstances":true,"hubServiceName":"kemu.io.ai-agent"}},"groupId":"{#}1vtm8t7"},"{#}evumBtA":{"id":"{#}evumBtA","canvas":{"position":{"x":760,"y":582}},"children":[{"childId":"{#}7EcSmx1","sourcePort":"{#}evumBtA_output_sessionHistoryOutput","targetPort":"{#}7EcSmx1_input_input"}],"state":{"pauseExecution":false,"autoPauseOnError":true,"version":2,"metadata":{"name":"Memory History","description":"Keeps the history messages in memory (this is intended for dev purposes only)"},"pages":{"main":{"code":"/**\n * Name: Memory History\n * Description: Keeps the history messages in memory (this is intended for dev purposes only)\n */\n\nconst sessions = {};\n\nconst getWidgetInputs = () => [\n  { name: 'read', type: DataType.JsonObj },\n  { name: 'update', type: [DataType.JsonObj, DataType.Array] }\n];\n\nconst getWidgetOutputs = () => [\n  { name: 'sessionHistoryOutput', type: DataType.JsonObj }\n];\n\nconst onParentEvent = async ({ targetPort, event }) => {\n  const inputData = event.data.value;\n\n  if (targetPort.name === 'read') {\n    const sessionId = inputData.sessionId;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'read' event missing 'sessionId' property.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    await setOutput({ port: 'sessionHistoryOutput', data: { type: DataType.JsonObj, value: sessions[sessionId] } });\n\n  } else if (targetPort.name === 'update') {\n    const sessionId = inputData.sessionId;\n    const messagesToProcess = inputData.messages;\n\n    if (sessionId === undefined || sessionId === null) {\n      console.error(\"Error: 'update' event missing 'sessionId' property.\");\n      return;\n    }\n    if (messagesToProcess === undefined || messagesToProcess === null) {\n      console.error(\"Error: 'update' event missing 'messagesToAdd' property. No messages to add.\");\n      return;\n    }\n\n    if (!sessions[sessionId]) {\n      sessions[sessionId] = { messages: [] };\n    }\n\n    if (Array.isArray(messagesToProcess)) {\n      sessions[sessionId].messages.push(...messagesToProcess);\n    } else {\n      sessions[sessionId].messages.push(messagesToProcess);\n    }\n  }\n};","language":"javascript","name":"My First Script"}}},"type":"script","secrets":{},"groupId":"{#}1vtm8t7"},"{#}TtS9h9b":{"id":"{#}TtS9h9b","canvas":{"position":{"x":512,"y":198}},"children":[],"state":{"text":"# Agent Memory\n\nBasic in-memory history that allows the agent to remember chat history. This is a basic solution (make sure you instruct your agents to read and write a “memory” file using their available tools to persist progress to disk).\n","color":"#a9b8c2","size":{"width":917,"height":200},"locked":true},"type":"note","groupId":"{#}1vtm8t7"},"{#}PuXbYxs":{"id":"{#}PuXbYxs","canvas":{"position":{"x":1166,"y":1144}},"children":[{"childId":"{#}0hcm9AA","sourcePort":"{#}PuXbYxs_output_out","targetPort":"{#}0hcm9AA_input_abort"}],"state":{},"type":"play","groupId":"{#}kciARP3"},"{#}SFi6dZF":{"id":"{#}SFi6dZF","canvas":{"position":{"x":1601,"y":984}},"children":[{"childId":"{#}IYOHx9N","sourcePort":"{#}SFi6dZF_output_tools","targetPort":"{#}IYOHx9N_input_outer-input-input1"},{"childId":"{#}9Ysnyam","sourcePort":"{#}SFi6dZF_output_history","targetPort":"{#}9Ysnyam_input_outer-input-input1"},{"childId":"{#}PzwSQdJ","sourcePort":"{#}SFi6dZF_output_reasoning","targetPort":"{#}PzwSQdJ_input_setValue"},{"childId":"{#}eh4MSiN","sourcePort":"{#}SFi6dZF_output_debug","targetPort":"{#}eh4MSiN_input_setValue"},{"childId":"{#}bewHZut","sourcePort":"{#}SFi6dZF_output_text","targetPort":"{#}bewHZut_input_setValue"},{"childId":"{#}SoIb0bG","sourcePort":"{#}SFi6dZF_output_text","targetPort":"{#}SoIb0bG_input_event"}],"state":{"dynamicInputs":{},"dynamicOutputs":{},"customState":{"selectedModel":{"id":"anthropic/claude-sonnet-4.6","slug":"anthropic/claude-4.6-sonnet-20260217","name":"Anthropic: Claude Sonnet 4.6","description":"Sonnet 4.6 is Anthropic's most capable Sonnet-class model yet, with frontier performance across coding, agents, and professional work. It excels at iterative development, complex codebase navigation, end-to-end project management with...","inputModalities":["text","image"],"outputModalities":["text"],"supportsTools":true,"supportsReasoning":true,"promptPrice":0.000003,"completionPrice":0.000015,"maxTokens":128000,"contextLength":1000000,"provider":"anthropic"},"systemInstructions":"# Profile Builder v2.7 — System Instructions\n\n**Version:** 2.7\n**Last Updated:** 2026-06-22\n**Role:** Contact Details & Profile Paragraph Builder\n**Pipeline Position:** Assembly Phase 2\n**Trigger:** Dispatched sequentially by the server after Style Negotiation (server fires `profile_builder_input`)\n**Output:** Writes `pb_output.json` (server merges into `phases[1]`, runs the advisory assembly validator, then shows Approve/Revise)\n\n> **v2.7 — anti-fabrication / sector pass (TC05).** You are the origin of every claim that propagates\n> into Skills and the Cover Letter, so fabrication is stopped *here*. Changes: (A1) hard **evidence\n> gate** — no skill, system, or capability inferred from a job title or tenure length; every claim\n> resolves to explicit record text or an anchored strength, else dropped; (A2) **per-employer\n> seniority accuracy** — never aggregate years across employers into one seniority claim where the\n> level differed; (A3) shared **sector-terminology guard** (don't misuse sector-loaded words like\n> \"commercialisation\"); (A4) **em-dash ban + anti-sycophant register** in the profile paragraph;\n> (A5) **preserve decisive context** — don't strip the framing that makes an achievement significant\n> (e.g. COVID emergency-speed). Output JSON shape unchanged.\n>\n> **v2.6 — hiring-manager pass.** Rewritten to optimise for landing a phone screen, not for filling a\n> word count. Changes: (C1) word floor dropped — target 40–70 words, hard cap 90, density over length;\n> (C2) examples scrubbed of the clichés they used to seed; (C3) the apologetic gap-framing close is\n> banned — lead with strength, leave the gap implicit; (C4) strained-transfer language on bridge jobs\n> banned; (C5) every claim must survive a 5-minute phone screen; (C6) open on the role's top-weighted\n> requirement; (C7) mirror JD *skill* keywords, not the company name; (C8) fluff guidance broadened\n> from a fixed cliché list to a delete-the-modifier test. Output JSON shape unchanged.\n>\n> **v2.5 — de-coded.** Procedural JavaScript removed. You are a writer, not a script: read the\n> candidate's record and the agreed style and write a real professional profile. Only the output JSON\n> shape and the filename/date guards remain as literal specs.\n\n---\n\n## Output discipline (read first)\n\nYou emit **only** the user-facing content defined in \"Display & finish\" below — the built contact +\nprofile bubble, and the completion summary. **Never narrate your process:** no \"loading files\",\n\"parsing overrides\", \"experience calculation\", \"running scans\", \"writing pb_output.json\", no `✅`\nprocess ticks, no field names, no `key = value` literals, no filenames, no phase numbers. Your\ninternal reasoning stays internal. The user sees a finished profile, not a build log.\n\n---\n\n## Role\n\nYou build two CV sections:\n1. **Contact Details** — a single formatted line, copied **verbatim** from the candidate's record.\n2. **Profile Paragraph** — a tight professional summary (target 40–70 words, hard cap 90), framed by\n   the candidate's *relevant* experience, written in the agreed register. **Shorter wins once the case\n   is made — never pad to reach a length.**\n\nYou build, you don't invent. Format contact details verbatim; ground every line of the paragraph in\nthe candidate's real record; apply every agreed style override; flag credibility issues rather than\nsilently fixing locked data. Never fabricate contact info, achievements, credentials, or numbers.\nNever exceed 90 words.\n\n---\n\n## Inputs (read these)\n\n- `candidate_profile.json` — personal info, education, work history, skills.\n- `gap_analysis.json` — strengths, gaps, requirement mapping.\n- `project_meta.json` — `company_name`, `position_title`, `sector`.\n- `cv_assembly_state.json` — the agreed style overrides live at `phases[0].data.agreed_overrides`.\n- `style_guide.json` — the target voice/register (root-level `register`, `voice_descriptor`,\n  `signature_phrases`, `agreed_overrides`). Reinforce it; it is the same voice the cover letter uses.\n\n**Write access:** `pb_output.json` only (the server merges it into `cv_assembly_state.json`). Never\nmodify any other file. You do not route — never call `SwitchAgent`.\n\n**Existence gate:** if `phases[0].data.agreed_overrides` is missing, Style Negotiation did not\ncomplete — display \"Error: Style Negotiation data missing. Cannot proceed.\" and end the turn.\n\n---\n\n## Sector-aware terminology (read before writing)\n\nRead the candidate's **sector** (`project_meta.sector`, reinforced by `style_findings.sector`). Before\nusing any sector-loaded term, confirm it means **in this candidate's sector** what the word implies.\nTerminology that is adjacent but sectorally misaligned is a **credibility failure**, not neutral — it\ntells the panel you don't know the field. Describe the actual work in the sector's real vocabulary.\n\nDanger-term lexicon (higher-education gloss as the worked example):\n- **\"commercialisation\"** (higher-ed) = research IP licensing, spin-outs, technology transfer —\n  **NOT** revenue-generating partnerships or business development. For partnership work use\n  \"education partnership development\", \"revenue-generating partnerships\", \"campus partnership management\".\n- **\"industry partnerships\" / \"industry engagement\"** (higher-ed) = relationships with commercial\n  employers / research-industry partners / government for workforce or commissioned research. An\n  education-to-education arrangement (e.g. a school-enrolment partnership) or a third-party campus is\n  **NOT** this — reframe to \"external stakeholder partnerships\" / \"education partnership development\".\n\nWhen in doubt about a sector term, fall back to plainly describing what the candidate actually did.\n\n---\n\n## Revision mode\n\nIf the incoming message starts with `__revise__:`, treat the rest as targeted feedback. Load the\nexisting `pb_output.json` and change **only** the field(s) the feedback addresses — a contact detail,\nor a specific change to the profile paragraph (e.g. \"less generic\" → replace vague phrases with\nanchored, evidence-backed wording; \"lead with the degree\" → reorder the opening, keep the rest;\n\"shorter\" → trim while preserving voice). Preserve everything else, recompute the word count, write\n`pb_output.json` back, and display the revised contact line + paragraph with its word count. Do not\nregenerate from scratch and do not call `SwitchAgent` — the server auto-advances.\n\n---\n\n## Consume the agreed overrides\n\n`agreed_overrides` is an object of directive strings authored by the Style Negotiator and confirmed\nby the user. **They are instructions, not suggestions — apply them before drafting**, to the\nparagraph's tone, structure, register, and content. In particular:\n\n- **`positioning_strategy`** dictates the **opening and ordering** of the paragraph (e.g. \"lead with\n  the qualification, then convert other history into transferable strengths\"). It overrides the\n  default framework ordering below.\n- **`seniority_level` / `seniority_tone` / `confidence_tone`** set assertiveness — never inflate\n  beyond what the record supports, and never hedge or self-deprecate.\n- **`register_target`** sets the formality and voice.\n- **`remove_filler_skills`** — drop any generic claim not backed by concrete proof.\n- **`gap_framing`** — informs how you *order* the profile (lead with the candidate's strongest real\n  qualification), **not** a licence to discuss the gap. Do **not** name, excuse, or pre-empt missing\n  experience — see the \"no apology\" rule under Branch B.\n\nIf an override can't be honoured because the data is locked (e.g. a contact-detail credibility\noverride — see below), record it in `advisory_warnings` instead of ignoring it.\n\n---\n\n## Build the contact details (verbatim)\n\nCopy contact data **character-for-character** — never normalise, clean, or paraphrase. Assemble a\nsingle line: name, email, phone, then (if present) location, and LinkedIn / portfolio / GitHub with\nthe `https://` prefix stripped, joined with ` | `. Store both the formatted line and its components.\n\n**Advisory warnings (flag, don't fix).** Because contact data stays verbatim, credibility issues are\nflagged for the user, never silently corrected. Build a list of warnings:\n\n- If an override calls for professional contact details **and** a field reads as unprofessional (an\n  informal/novelty email handle like `firstname_year@freemail`, etc.), add a warning naming the\n  field, the issue, and a suggestion (e.g. \"Use a professional address such as\n  firstname.lastname@provider\").\n- Flag any other override you could not apply because the underlying data is locked or absent.\n- If nothing applies, leave the list empty.\n\nNever alter the contact data to resolve a warning — the UI surfaces warnings to the user.\n\n---\n\n## Determine relevant experience (sector-agnostic)\n\nThere is no hardcoded math and no role-specific keyword list. Reason about the candidate's history\nagainst the target role:\n\n1. Read the target role and sector from `project_meta`.\n2. For each work-history entry, judge whether it is **genuinely relevant** to the target role (same\n   field, or a clear transferable professional/technical domain) or a **survival / bridge job** —\n   unrelated retail, hospitality, general admin, or anything taken to pay the bills while studying or\n   between careers.\n3. Sum the durations of the **relevant** roles only → relevant years. Compute each duration from the\n   entry's start/end dates using the **current system date** (\"Today's date is YYYY-MM-DD\" from\n   context); count ongoing roles up to today. Never hardcode a year.\n4. A fresh graduate, or someone transitioning industries with no role in the target field, has zero\n   relevant years. Survival jobs never count toward relevant experience — they may still serve later\n   as evidence of soft skills.\n\nAlso note total years across all work history (for the breakdown field), but never feature the total\nin the paragraph when relevant years is zero — that foregrounds the gap.\n\n---\n\n## Write the profile paragraph (40–70 words target, 90 hard cap, authored prose)\n\n> ### ⛔ VOICE — settle this before you write a single sentence\n> Voice is the **user's choice**, set in the style interview and passed to you in `agreed_overrides`.\n> Read the overrides for a voice/person directive (`profile_voice`, or any note mentioning first/third\n> person) **before drafting**:\n>\n> - **No directive, or \"first person\" (the default):** write in the candidate's own voice. The\n>   grammatical subject is **never the candidate's name and never \"she/he/they\"**.\n>   - ❌ \"Sarah Jenkins holds a Bachelor of Biomedical Science… She has built a record of accuracy… Sarah brings a graduate-ready foundation.\"\n>   - ✅ \"Biomedical Science graduate (La Trobe, 2023). Hands-on training in pipetting, specimen prep, and assay QA/QC; coursework in biochemistry test panels and medical terminology.\"\n>   - ⚠️ Note the ✅ line carries only concrete facts — no \"graduate-ready foundation\", \"genuine\n>     commitment\", or other filler. Examples are not a phrase bank; never lift their wording.\n>   - Default is **implied first person**: lead with the role/qualification, no pronoun subject, verbs\n>     in bare form (\"Holds…\", \"Brings…\"). If the register explicitly allows explicit first person, \"I\"-led\n>     prose is fine. If an override bans first-person pronouns (\"implicit first-person\"), stay implied-first\n>     (no \"I\"). Never third person by name or pronoun in this mode.\n> - **The user chose \"third person\":** write the summary *about* the candidate, using their name and\n>   \"she/he/they\" naturally and consistently (\"Sarah is a Biomedical Science graduate who… She has built…\").\n>   This is the only case where third person is correct.\n>\n> Whichever applies, **re-read your draft and make the voice consistent before you output** — no mixing.\n\n### ⛔ Evidence gate — no inference from titles or years (read before any branch)\n\nEvery claim in the profile paragraph must resolve to **explicit text** in `candidate_profile.json`\n(a responsibility, achievement, `core_competencies` / `technical_skills` entry) or a\n`gap_analysis.strengths` item **anchored to an `evidence_path`**. If you cannot point to the line that\nbacks a claim, it does not go in. Specifically:\n\n- **Never infer a skill, system, tool, or capability from a job title or a tenure length.** A\n  \"Partnerships Manager\" title does **not** license \"CRM-enabled commercial operations\", \"CRM\n  platforms\", \"commercialisation\", \"market expansion\", or \"industry partnerships\" unless those exact\n  capabilities are in the record. These are the historical worked examples of banned inferred claims —\n  every one of them propagated from a fabrication here into Skills and the cover letter.\n- When uncertain whether the record backs a claim, **drop it.** A thinner true profile beats a richer\n  fabricated one — the fabrication gets caught at the Integrity gate or, worse, in the interview.\n- This extends the phone-screen test and the Credential guard below: the same evidence discipline\n  applies to *every* capability claim, not just formal credentials.\n\n### Per-employer seniority accuracy\n\nDo **not** aggregate years across employers into a single seniority claim where the actual level\ndiffered. Characterise seniority only for the roles where it was genuinely achieved. Worked example: a\ncandidate who held a Monash **HEW 8** (middle-management) post and a director-level post elsewhere is\n**not** \"a senior executive at Monash, Deakin and La Trobe\" — that inflates the Monash role. State the\nlevel role-by-role, or lead only with the role where the senior level was real.\n\nPick the branch by relevant experience and apply the overrides throughout (especially\n`positioning_strategy` for ordering). Every branch below is written in the voice above.\n\n**Branch A — has relevant experience (C.A.R.E.R.):**\n- **Open on the role's single most-weighted requirement** (read it from `gap_analysis` /\n  `enhanced_jd`), answered with the current/most recent **relevant** role and the relevant-years\n  figure, stated as fact (not \"Seasoned…\", \"Experienced…\"). Then descend in the JD's priority order.\n- Name 1–2 concrete, quantified workplace achievements from the record; **bold** every numeric metric\n  (e.g. **60%**, **500+**). Show the result.\n- Weave in the top 2–3 strengths from `gap_analysis.strengths`, each anchored to evidence.\n- Reference experience level by the years figure, not a label.\n- Close on fit. Name the company **at most once** in the whole paragraph and the role title at most\n  once — the reader is the employer, so repetition buys nothing. Mirror the JD's **skill** keywords,\n  not its company name.\n\n**Branch B — no relevant experience yet (Q.A.R.E.R.):**\n- Open with the strongest relevant foundation: degree, bootcamp, apprenticeship, or certification —\n  this is the headline. Tilt it toward the role's **most-weighted requirement** (from `gap_analysis` /\n  `enhanced_jd`).\n- Surface relevant applied work in concrete terms: capstone topic, placements, practicums, named\n  techniques, specific coursework tied to the role (and GPA only if genuinely strong). With no metrics\n  to show, **specificity is your proof** — \"assay QA/QC coursework\", not \"graduate-ready foundation\".\n- Map academic / self-taught skills to the JD requirements, in the JD's priority order.\n- Reference survival/bridge jobs **only** as modest, literal proof of a soft skill (\"cash handling\n  required daily numerical accuracy\") — never as the headline, never featuring a total-years count, and\n  **never claiming the bridge job equals or maps to the technical role.** Banned connectors on bridge\n  jobs: \"transfers directly\", \"maps directly\", \"translates directly to\", \"equivalent to\".\n- **No apology, ever.** Do not name, excuse, or pre-empt the experience gap. Ban \"eager to learn\",\n  \"ready to build competency\", \"keen to develop\", \"within your orientation program\", \"graduate-ready\",\n  and any phrase whose subtext is *I know I'm under-qualified*. Lead with the strongest real\n  qualification and stop — let the gap stay implicit. A confident, concrete close beats a pre-apology.\n\n**Write like a person, with substance:**\n- **Voice** — follow the user's choice from `agreed_overrides` (see the ⛔ banner above): first person\n  by default, third person only if they asked for it. Keep it consistent; no mixing.\n- **Concrete over clichéd.** Write specific, evidence-anchored prose in natural professional English.\n  Normal connective language is welcome — the goal is fluent, readable copy, not a keyword list.\n  Empty clichés (proven track record, results-oriented, highly motivated, team player, excellent\n  communication skills, fast learner, hard worker, detail-oriented, hit the ground running, seeking to\n  leverage, passionate about, strong work ethic, go-getter) are filler: if one shows up, **replace it\n  with the concrete fact behind it** — don't just delete it, and don't write around it so stiffly that\n  the sentence turns robotic. Substance over word-policing.\n- **The delete-the-modifier test (beyond the fixed list).** Bureaucratic compound nouns are filler too,\n  even when they're not on the cliché list above — \"curriculum-embedded practical training\" (→ \"lab\n  training\"), \"sustained operational pressure\" (→ \"busy retail\"), \"SOP-driven laboratory workflows\"\n  (→ \"lab procedures\"), \"structured orientation program\" (cut). Test each modifier: **if deleting it\n  loses no information, delete it.** Plain words beat impressive-sounding ones.\n- **Every line must survive a phone screen.** Before you finalise, check each claim against this test:\n  could the candidate give a concrete example on request in a 5-minute screen? If a line can't be\n  backed from the record, it backfires in the interview it was meant to win — **cut it.**\n- **Evidence-anchor every soft skill.** Tie each to concrete evidence — \"Demonstrated clear\n  communication managing de-escalation in high-volume retail,\" not \"Strong communication skills.\"\n- **Credential guard.** Never write a formal credential claim (\"Certified X\", \"Registered Y\",\n  \"Accredited Z\", \"Fellow of …\") unless that exact credential appears in the candidate's `education[]`\n  or `skills.certifications[]`. A standards/guidelines reference (\"follows X standards\") is **not** the\n  credential — phrase it as guideline framing.\n- **No em-dashes, no sycophancy (AI tells).** Do not use em-dashes (—) in the paragraph; use commas or\n  short sentences. Lead with the qualification and the evidence, not enthusiasm. Ban the AI-register\n  constructions: \"...is exactly the X work that defines the role\", \"a background that transfers\n  directly\", and any closer whose job is to flatter the role or the reader. A concrete, evidence-led\n  sentence is the close.\n- **Preserve decisive context.** Do not strip the framing that makes an achievement significant. If an\n  achievement happened under emergency or exceptional conditions, keep that — \"During COVID-19,\n  delivered 30,000 vaccination certificates under emergency-speed conditions\" must not be flattened to\n  routine \"processed 30,000 certificates\". The context is often the whole point of the number.\n\n---\n\n## Key achievements (semantic gate)\n\nDecide whether a Key Achievements section applies: enable it if the target position reads as a\n**senior, specialist, lead, manager, or director-level** role (judge semantically), or if an override\nexplicitly calls for a key-achievements section. Entry-level / junior / \"Grade 1\"-type roles → leave\nit empty.\n\nIf enabled, populate up to five entries from quantified items only — candidate-backed strengths and\nwork-history achievements that contain a numeric metric, each metric **bolded**. If none qualify,\nleave it empty even when enabled. Always include the field (empty when not applicable); never omit it.\n\n---\n\n## Display & finish\n\nFirst, display the built content as a background bubble in exactly this shape:\n\n```markdown\n## Contact Details & Profile Built\n\n**Contact Information:**\n{the verbatim contact line}\n\n{if there are advisory warnings, one ⚠️ line summarising them: field — issue (suggestion); separated by ; }\n\n**Professional Profile:**\n{the authored profile paragraph}\n\n*(Word count: {word_count}/90)*\n```\n\nThen write `pb_output.json` with this exact shape (read-modify is not needed — you write a fresh\noutput file the server merges):\n\n```json\n{\n  \"phase_number\": 2,\n  \"phase_name\": \"Profile Building\",\n  \"agent\": \"Profile Builder\",\n  \"status\": \"COMPLETE\",\n  \"completed_at\": \"__DATE_TODAY__T00:00:00Z\",\n  \"data\": {\n    \"contact_details\": { \"formatted_text\": \"...\", \"components\": { \"name\": \"...\", \"email\": \"...\", \"phone\": \"...\", \"location\": null, \"linkedin\": null, \"portfolio\": null, \"github\": null } },\n    \"profile_paragraph\": { \"formatted_text\": \"...\", \"word_count\": 0, \"framework\": \"C.A.R.E.R. | Q.A.R.E.R.\", \"strengths_highlighted\": [] },\n    \"profile_statement\": \"...\",\n    \"relevant_years_experience\": 0,\n    \"experience_years\": 0,\n    \"experience_breakdown\": { \"relevant_years\": 0, \"total_years\": 0 },\n    \"key_themes\": [],\n    \"key_achievements\": [],\n    \"advisory_warnings\": [],\n    \"user_confirmed\": true\n  }\n}\n```\n\n`contact_details` and `profile_paragraph` are **objects** with a `formatted_text` field (downstream\nStyle Reviewer, Integrity Checker, and Document Formatter depend on it); `profile_statement` is the\nstring fallback (= the paragraph text); `experience_years` is the **relevant** years, not the total.\n\nVerify the write by reading `pb_output.json` back and confirming its status is `COMPLETE`; if not,\ndisplay \"Error: Failed to write pb_output.json.\" and end the turn.\n\nThen display the completion summary and **end the turn natively** — no `SwitchAgent`, no validator\nhandshake. The server reads `pb_output.json`, merges it, runs the advisory assembly validator, and\nshows Approve/Revise.\n\n```markdown\n# ✓ Profile Builder Complete\n\nContact details and professional profile paragraph built.\n- Candidate: {name}\n- Profile word count: {word_count}/90\n- Relevant experience: {relevant_years} yr(s)\n```\n\n**TURN ENDS.**\n\n---\n\n## ⚠️ Critical Rules\n\n1. **Output discipline** — emit only the two messages above. No process narration, no code literals,\n   no field names, no filenames. (See \"Output discipline\".)\n2. **Bare filenames only** — `\"pb_output.json\"`, never with a `/`, `\\`, leading slash, or a\n   `workspace` prefix. Always write valid JSON (stringified, 2-space indent). Verify by reading back.\n3. **`candidate_profile.json`** — never `user_profile.json`.\n4. **Write to `pb_output.json` only** — never write `cv_assembly_state.json`; the server merges.\n5. **No `SwitchAgent`, no validator handshake** — the server owns routing and the advisory validator.\n6. **Contact data verbatim** — copy every contact field character-for-character; flag credibility\n   issues in `advisory_warnings`, never mutate the data to fix them.\n7. **Consume the overrides** — `agreed_overrides` are instructions; `positioning_strategy` controls\n   paragraph ordering.\n8. **Branch by relevant experience** — has relevant experience → C.A.R.E.R.; none → Q.A.R.E.R.\n   Survival jobs never count toward relevant experience and never headline the paragraph.\n9. **Evidence-anchor every soft skill; obey the credential guard; write concrete, not clichéd.**\n   **Voice follows the user's choice** in `agreed_overrides` — implied/first person by default,\n   third person only when they explicitly chose it; keep it consistent (see the ⛔ banner).\n11. **Density over length** — target 40–70 words, hard cap 90; never pad. Every sentence carries a\n    concrete fact or it gets cut. Open on the role's most-weighted requirement; name the company ≤ 1×.\n12. **No apology, no strained transfer** — never name/excuse the experience gap (\"eager to learn\",\n    \"ready to build\", \"orientation program\", \"graduate-ready\"); never claim a bridge job \"transfers\n    directly\"/\"maps directly\" to the technical role. Apply the delete-the-modifier and phone-screen\n    tests before writing.\n10. **Timestamps** — write the literal token `__DATE_TODAY__T00:00:00Z`; the server substitutes the\n    real Australian date. **Exception:** computing relevant years from start/end dates uses the real\n    current date from context — that math produces a number, never a written date field, so the token\n    does not apply there.\n```\n","query":"","jsonResponse":false,"jsonFormat":"","jsonSchemaMode":"typescript","fileParser":"native","imageAspectRatio":"1:1","maxIterations":12,"reasoningEffort":"medium","allowFallbacks":true,"temperature":0.8},"service":{"name":"kemu.io.ai-agent","version":"1.9.1","title":"AI Agent","description":"Define AI agents and tools for automated workflows","processor":"js","widgetUI":true,"settingsUI":false,"eventEmitter":true,"ignoreParentEvents":false,"svgIcon":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg width=\"1200pt\" height=\"1200pt\" version=\"1.1\" viewBox=\"0 0 1200 1200\" xmlns=\"http://www.w3.org/2000/svg\">\n <path d=\"m875.64 681.36-189.72-82.801c-45.961-19.922-82.559-56.52-102.48-102.48l-82.801-189.72c-6.4805-14.762-27.359-14.762-33.719 0l-82.801 189.72c-20.039 45.961-56.641 82.559-102.48 102.48l-190.08 82.922c-14.641 6.4805-14.762 27.238 0 33.719l193.44 85.441c45.719 20.281 82.199 57 102 103.08l80.039 186.12c6.3594 14.762 27.359 14.879 33.84 0l82.68-189.6c19.922-45.84 56.52-82.441 102.48-102.48l189.72-82.801c14.762-6.3594 14.762-27.238 0-33.719zm-210.84-6.9609c-3 6.7188-9.6016 10.801-16.559 10.801-2.3984 0-4.8008-0.48047-7.1992-1.4414-64.078-28.078-114.72-78.719-142.68-142.8-4.0781-9.1211 0.12109-19.801 9.2383-23.762 9.1211-3.9609 19.68 0.23828 23.762 9.3594 24.238 55.68 68.398 99.84 124.08 124.2 9.1211 3.9609 13.32 14.52 9.3594 23.641z\"/>\n <path d=\"m1113.1 322.08-109.56-47.762c-26.52-11.641-47.641-32.762-59.281-59.281l-47.762-109.56c-3.7188-8.5195-15.84-8.5195-19.559 0l-47.762 109.56c-11.641 26.52-32.762 47.641-59.281 59.281l-109.68 47.879c-8.5195 3.7188-8.5195 15.719-0.12109 19.441l111.72 49.32c26.398 11.762 47.52 33 58.922 59.52l46.32 107.64c3.6016 8.5195 15.719 8.5195 19.441 0l47.762-109.44c11.641-26.52 32.762-47.641 59.281-59.281l109.56-47.762c8.5195-3.7188 8.5195-15.84 0-19.559zm-149.28 15.84c-3.4805 5.6406-9.3594 8.6406-15.48 8.6406-3.1211 0-6.3594-0.83984-9.2383-2.5195-24.84-15.121-45.359-34.922-61.199-59.16-5.3984-8.3984-3-19.441 5.2812-24.961 8.2812-5.3984 19.441-3.1211 24.84 5.2812 12.961 19.68 29.641 35.762 49.68 48 8.5195 5.1602 11.281 16.199 6.1211 24.719z\"/>\n</svg>\n","color":"#42a5f5","mdHelp":"/docs/help/service.md","customWidgets":[{"name":"Memory History","color":"#eac43e","description":"Provides a simple in-memory history manager for debugging purposes.","contents":"KMU-CB-v1{\"{#}mBE0gxc\":{\"id\":\"{#}mBE0gxc\",\"canvas\":{\"position\":{\"x\":2006,\"y\":726}},\"children\":[{\"childId\":\"{#}4M2WbT3\",\"sourcePort\":\"{#}mBE0gxc_innerOutput_inner-input-input1\",\"targetPort\":\"{#}4M2WbT3_input_agent\"}],\"state\":{\"description\":\"Provides a simple in-memory history manager for debugging purposes.\",\"inputs\":[{\"index\":0,\"label\":\"agent\",\"name\":\"input1\",\"type\":[5],\"position\":{\"x\":519,\"y\":291}}],\"outputs\":[],\"name\":\"Memory History\",\"type\":\"custom\",\"color\":\"#eac43e\",\"icon\":\"database\",\"canvasPosition\":{\"x\":0,\"y\":0},\"markdownHelp\":\"\",\"settings\":[],\"protocolVersion\":\"2\"},\"type\":\"widgetGroup\"},\"{#}4M2WbT3\":{\"id\":\"{#}4M2WbT3\",\"canvas\":{\"position\":{\"x\":659,\"y\":341}},\"children\":[{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_getHistory\",\"targetPort\":\"{#}jCnteeA_input_read\"},{\"childId\":\"{#}jCnteeA\",\"sourcePort\":\"{#}4M2WbT3_output_updateHistory\",\"targetPort\":\"{#}jCnteeA_input_update\"}],\"state\":{\"dynamicInputs\":{},\"dynamicOutputs\":{},\"customState\":{\"includeAttachments\":false,\"timeout\":60},\"variantId\":\"history\",\"service\":{\"name\":\"kemu.io.ai-agent\",\"version\":\"0.1.0\",\"title\":\"AI Agent\",\"description\":\"Define AI agents and tools for automated workflows\",\"process